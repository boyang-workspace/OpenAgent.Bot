{
  "name": "openagent-yup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "node --check yup-prototype/app.js && node scripts/build-site.mjs --check",
