---
import { compactNumber, relativeDate, label } from "@/lib/registry/format";
import type { ActivityEntry } from "@/lib/registry/activity";

type Props = { entries: ActivityEntry[]; compact?: boolean; metric?: "activity" | "adoption" | "releases" };
const { entries, compact = false, metric = "activity" } = Astro.props;
const metricLabel = metric === "adoption" ? "Stars" : metric === "releases" ? "Latest release" : "Update index";
---

{entries.length ? (
  <div class:list={["activity-table", { compact }]}>
    <div class="activity-row activity-head" aria-hidden="true"><span>#</span><span>Project</span><span>Status</span><span>Latest signal</span><span>{metricLabel}</span><span>Open</span></div>
    {entries.map((entry) => (
      <a class="activity-row" href={`/project/${entry.entity.slug}`}>
        <span class="rank-number">{String(entry.rank).padStart(2, "0")}</span>
        <span class="activity-name"><strong>{entry.entity.name}</strong><small>{entry.entity.organization ?? label(entry.entity.kind)}</small></span>
        <span><i class:list={["state-dot", entry.state]}></i><span class="state-label">{entry.state}</span></span>
        <span class="signal"><strong>{label(entry.signal)}</strong><small>{relativeDate(entry.signalAt)}</small></span>
        <span class="metric-value">{metric === "adoption" ? compactNumber(entry.entity.stars) : metric === "releases" ? relativeDate(entry.entity.lastReleaseAt) : entry.score}</span>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
) : <div class="empty-state">No eligible records in this cohort yet.</div>}

<style>
  .activity-table { border: 1px solid var(--ink); overflow-x: auto; }
  .activity-row { align-items: center; border-bottom: 1px solid var(--line); display: grid; gap: 14px; grid-template-columns: 44px minmax(230px,1fr) 110px 145px 100px 20px; min-height: 52px; min-width: 760px; padding: 8px 12px; }
  .activity-row:last-child { border-bottom: 0; }
  a.activity-row:hover { background: var(--ink); color: var(--paper); }
  .activity-head { background: #e5e5e5; color: var(--muted); font-size: .75rem; font-weight: 700; letter-spacing: .035em; min-height: 36px; padding-block: 7px; text-transform: uppercase; }
  .rank-number, .metric-value { font-size: .8rem; font-variant-numeric: tabular-nums; font-weight: 700; }
  .activity-name { min-width: 0; }
  .activity-name strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .activity-name small, .signal small { color: var(--muted); display: block; font-size: .75rem; margin-top: 3px; }
  a.activity-row:hover small { color: #bdbdbd; }
  .signal strong, .state-label { font-size: .75rem; font-weight: 600; text-transform: capitalize; }
  .state-dot { background: #8b8b8b; border-radius: 50%; display: inline-block; height: 7px; margin-right: 7px; width: 7px; }
  .state-dot.active { background: #111; box-shadow: 0 0 0 2px #fff, 0 0 0 3px #111; }
  .state-dot.cooling { background: #777; }
  .state-dot.dormant, .state-dot.archived { background: transparent; border: 1px solid currentColor; }
  a.activity-row:hover .state-dot.active { background: #fff; box-shadow: none; }
  .row-arrow { font-size: .9rem; text-align: right; }
  .compact .activity-row { grid-template-columns: 34px minmax(150px,1fr) 86px 96px 70px 16px; min-height: 46px; min-width: 560px; padding: 7px 10px; }
  .compact .activity-name small, .compact .signal strong { display: none; }
  @media (max-width: 760px) {
    .activity-table { border-left: 0; border-right: 0; overflow: visible; }
    .activity-row { align-items: start; gap: 5px 10px; grid-template-columns: 28px minmax(120px,1fr) 68px 16px; min-width: 0; padding: 11px 10px; }
    .activity-row > :nth-child(1) { grid-column: 1; grid-row: 1 / 3; }
    .activity-row > :nth-child(2) { grid-column: 2; grid-row: 1; }
    .activity-row > :nth-child(3) { grid-column: 3; grid-row: 1; }
    .activity-row > :nth-child(4) { grid-column: 2; grid-row: 2; }
    .activity-row > :nth-child(5) { grid-column: 3; grid-row: 2; }
    .activity-row > :nth-child(6) { grid-column: 4; grid-row: 1 / 3; }
    .activity-head { align-items: center; grid-template-columns: 28px 1fr 68px 16px; }
    .activity-head > :nth-child(3), .activity-head > :nth-child(4) { display: none; }
    .activity-head > :nth-child(5) { grid-column: 3; grid-row: 1; }
    .activity-head > :nth-child(6) { grid-column: 4; grid-row: 1; }
    .signal strong { display: inline; margin-right: 5px; }
    .signal small { display: inline; }
    .compact .activity-row { grid-template-columns: 28px minmax(120px,1fr) 68px 16px; min-width: 0; padding: 10px; }
  }
</style>
