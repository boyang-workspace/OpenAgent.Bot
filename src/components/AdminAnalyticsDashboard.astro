---
import type { AnalyticsView } from "@/lib/analytics/dashboard";
type Props = { view: AnalyticsView; days: number; data: any; warning?: string };
const { view, days, data, warning } = Astro.props;
const views: Array<{ key: AnalyticsView; label: string }> = [
  { key: "overview", label: "Overview" }, { key: "content", label: "Content" }, { key: "acquisition", label: "Acquisition" },
  { key: "agents", label: "Agents" }, { key: "search", label: "Search" }, { key: "realtime", label: "Realtime" }, { key: "health", label: "Data Health" }
];
const compact = (value: unknown) => new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(Number(value ?? 0));
const percent = (value: number) => `${(value * 100).toFixed(1)}%`;
const trend = view === "overview" ? data?.trend ?? [] : [];
const maxTrend = Math.max(1, ...trend.flatMap((row: any) => [row.browser, row.suspected, row.search, row.ai, row.api]));
const polyline = (key: "browser" | "suspected" | "search" | "ai" | "api") => trend.map((row: any, index: number) => `${trend.length > 1 ? index / (trend.length - 1) * 960 + 20 : 500},${210 - Number(row[key] ?? 0) / maxTrend * 180}`).join(" ");
const mixTotal = view === "overview" ? (data?.mix ?? []).reduce((sum: number, row: any) => sum + Number(row.requests), 0) : 0;
const acquisition = view === "acquisition" ? data ?? { sources: [], social: [], internalSessions: 0, socialTotals: { sessions: 0, channels: 0 } } : { sources: [], social: [], internalSessions: 0, socialTotals: { sessions: 0, channels: 0 } };
const acquisitionLabel = (source: string) => source.replaceAll("_", " ");
---
<div class="analytics-console">
  <header class="console-header"><a href="/" class="brand">OPENAGENT.BOT</a><div><span>Private operations</span><a href="/admin/analytics/logout">Sign out</a></div></header>
  <div class="console-grid">
    <aside>
      <span class="nav-label">Analytics</span>
      <nav>{views.map((item) => <a class:list={{ active: item.key === view }} href={`/admin/analytics/${item.key}?days=${days}`}>{item.label}</a>)}</nav>
      <a class="secondary-nav" href="/admin/data-health">Registry integrity</a>
      <div class="range"><span class="nav-label">Range</span>{[1,7,30,90].map((range) => <a class:list={{ active: range === days }} href={`/admin/analytics/${view}?days=${range}`}>{range === 1 ? "Today" : `${range}D`}</a>)}</div>
    </aside>
    <main>
      <div class="page-heading"><div><span class="eyebrow">First-party telemetry</span><h1>{views.find((item) => item.key === view)?.label}</h1></div><p>UTC · Server requests + meaningful interactions</p></div>
      {warning && <div class="warning"><strong>Analytics temporarily unavailable.</strong><span>{warning}</span></div>}

      {view === "overview" && <>
        <section class="kpis">{[
          ["Browser visitors", data.totals.browserVisitors], ["Pageviews", data.totals.pageviews], ["Browser-like views", data.totals.browserViews],
          ["Suspected automation", data.totals.suspectedAutomationViews], ["AI / bot", data.totals.machineRequests], ["Outbound", data.totals.outboundClicks]
        ].map(([label, value]) => <div><span>{label}</span><strong>{compact(value)}</strong></div>)}</section>
        <section class="panel"><header><div><span class="eyebrow">Trend</span><h2>Traffic by actor</h2></div><div class="legend"><span class="browser">Browser-like</span><span class="suspected">Suspected</span><span class="search">Search</span><span class="ai">AI</span><span class="api">API</span></div></header>
          {trend.length ? <svg viewBox="0 0 1000 230" role="img" aria-label="Traffic trend">{[30,75,120,165,210].map((y) => <line x1="20" x2="980" y1={y} y2={y} />)}{(["browser","suspected","search","ai","api"] as const).map((key) => <polyline class={key} points={polyline(key)} />)}</svg> : <p class="empty">Rollups will appear after the first successful hourly run.</p>}
        </section>
        <section class="panel"><header><div><span class="eyebrow">Traffic mix</span><h2>Browser-like vs machine</h2></div><p class="panel-note">Browser-like is UA-based, not a claim of a human. Suspected automation is shown above and remains included in that segment.</p></header><div class="mix-table">{data.mix.map((row: any) => <div><span>{row.type}</span><i><b style={`width:${mixTotal ? row.requests / mixTotal * 100 : 0}%`}></b></i><strong>{percent(mixTotal ? row.requests / mixTotal : 0)}</strong><small>{compact(row.requests)}</small></div>)}</div></section>
      </>}

      {view === "content" && <>
        <section class="panel"><header><div><span class="eyebrow">Content</span><h2>Top pages</h2></div></header><div class="data-table quality-table"><div class="table-head"><span>Path</span><span>Type</span><span>Audience</span><span>Suspected</span><span>Agent</span><span>Total</span></div>{data.pages.map((row: any) => <div><a href={row.path}>{row.path}</a><span>{row.route_type}</span><strong>{compact(row.audience_views)}</strong><strong>{compact(row.suspected_automation_views)}</strong><strong>{compact(row.agent_views)}</strong><strong>{compact(row.pageviews)}</strong></div>)}</div></section>
        <section class="panel"><header><div><span class="eyebrow">Entities</span><h2>Audience vs Agent interest</h2></div></header><div class="data-table quality-table entities"><div class="table-head"><span>Project</span><span>Audience</span><span>Suspected</span><span>Agent</span><span>A/A</span><span>Outbound</span></div>{data.entities.map((row: any) => <div><a href={`/project/${row.entity_slug}`}>{row.entity_slug}</a><strong>{compact(row.audience_views)}</strong><strong>{compact(row.suspected_automation_views)}</strong><strong>{compact(row.agent_views)}</strong><strong>{Number(row.interest_ratio).toFixed(2)}</strong><strong>{compact(row.outbound_clicks)}</strong></div>)}</div></section>
      </>}

      {view === "acquisition" && <>
        <section class="kpis three">{[["Social sessions", acquisition.socialTotals.sessions], ["Active social channels", acquisition.socialTotals.channels], ["Internal / returning", acquisition.internalSessions]].map(([label, value]) => <div><span>{label}</span><strong>{compact(value)}</strong></div>)}</section>
        <section class="panel"><header><div><span class="eyebrow">Social &amp; community</span><h2>Social entry sessions</h2></div><p class="panel-note">X, Reddit, LinkedIn, Facebook, Instagram, YouTube, TikTok, Discord, Telegram, Bluesky, Mastodon, WeChat, Zhihu and communities.</p></header><div class="data-table acquisition"><div class="table-head"><span>Channel</span><span>Sessions</span></div>{acquisition.social.length ? acquisition.social.map((row: any) => <div><strong>{acquisitionLabel(row.source)}</strong><span>{compact(row.sessions)}</span></div>) : <p class="empty">No social entry sessions were recorded in this range. New supported channels and recognized social UTM sources will appear here automatically.</p>}</div></section>
        <section class="panel"><header><div><span class="eyebrow">Acquisition</span><h2>External session entry sources</h2></div><p class="panel-note">One source is assigned to the first client page view in a browser session. Internal referrals are deliberately excluded from acquisition.</p></header><div class="data-table acquisition"><div class="table-head"><span>Source</span><span>Sessions</span></div>{acquisition.sources.length ? acquisition.sources.map((row: any) => <div><strong>{acquisitionLabel(row.source)}</strong><span>{compact(row.sessions)}</span></div>) : <p class="empty">Collection starts with this release. Sources appear after a browser session has loaded a tracked page.</p>}</div></section>
      </>}

      {view === "agents" && <>
        <section class="panel"><header><div><span class="eyebrow">Machine traffic</span><h2>AI actors and API clients</h2></div></header><div class="data-table acquisition"><div class="table-head"><span>Actor</span><span>Type</span><span>Requests</span></div>{data.actors.map((row: any) => <div><strong>{row.actor_name}</strong><span>{row.actor_type}</span><span>{compact(row.requests)}</span></div>)}</div></section>
        <section class="panel"><header><div><span class="eyebrow">Agent interest</span><h2>Most requested entities</h2></div></header><div class="data-table acquisition"><div class="table-head"><span>Entity</span><span>AI requests</span><span>A/H ratio</span></div>{data.entities.map((row: any) => <div><a href={`/project/${row.entity_slug}`}>{row.entity_slug}</a><span>{compact(row.agent_views)}</span><span>{Number(row.interest_ratio).toFixed(2)}</span></div>)}</div></section>
      </>}

      {view === "search" && <>
        <section class="kpis three"><div><span>Searches</span><strong>{compact(data.totals.searches)}</strong></div><div><span>Zero-result rate</span><strong>{percent(data.totals.searches ? data.totals.zeroResults / data.totals.searches : 0)}</strong></div><div><span>Search CTR</span><strong>{percent(data.totals.searches ? data.totals.resultClicks / data.totals.searches : 0)}</strong></div></section>
        <section class="panel"><header><div><span class="eyebrow">Database demand</span><h2>Internal queries</h2></div></header><div class="data-table search-table"><div class="table-head"><span>Query</span><span>Searches</span><span>Zero</span><span>Clicks</span></div>{data.queries.map((row: any) => <div><strong>{row.query}</strong><span>{compact(row.searches)}</span><span>{compact(row.zero_results)}</span><span>{compact(row.result_clicks)}</span></div>)}</div></section>
      </>}

      {view === "realtime" && <section class="panel"><header><div><span class="eyebrow">Last 30 minutes</span><h2>Recent traffic</h2></div></header><div class="realtime-list">{data.length ? data.map((row: any) => <div><time>{new Date(Number(row.time_bucket) * 1000).toISOString().slice(11,16)}</time><span>{row.actor_name || row.actor_type}</span><code>{row.path}</code><small>{row.referrer || "direct"}</small><strong>{compact(row.requests)}</strong></div>) : <p class="empty">No recent data is available yet.</p>}</div></section>}

      {view === "health" && <section class="panel health"><header><div><span class="eyebrow">Pipeline status</span><h2>Data health</h2></div></header><dl><div><dt>Events today</dt><dd>{compact(data.eventsToday)}</dd></div><div><dt>Unknown bot rate</dt><dd>{percent(data.unknownBotRate)}</dd></div><div><dt>Last hourly rollup</dt><dd>{data.state?.last_hourly_rollup ?? "Pending"}</dd></div><div><dt>Daily reconciliation</dt><dd>{data.state?.last_daily_reconciliation ?? "Pending"}</dd></div><div><dt>Last success</dt><dd>{data.state?.last_success ?? "Pending"}</dd></div><div><dt>Last error</dt><dd>{data.state?.last_error ?? "None"}</dd></div></dl></section>}
    </main>
  </div>
</div>

<style>
  .analytics-console { min-height: 100dvh; }
  .console-header { align-items:center;background:var(--ink);color:var(--paper);display:flex;height:48px;justify-content:space-between;padding:0 18px; }
  .brand { color:var(--acid);font-family:var(--mono);font-size:.78rem;font-weight:700;letter-spacing:.08em; }
  .console-header div { display:flex;font-family:var(--mono);font-size:.72rem;gap:24px;text-transform:uppercase; }.console-header div span{color:#9da19b}.console-header div a{text-decoration:underline;text-underline-offset:3px}
  .console-grid { display:grid;grid-template-columns:190px minmax(0,1fr);min-height:calc(100dvh - 48px); }
  aside { border-right:1px solid var(--ink);padding:18px 12px; } .nav-label{color:var(--muted);display:block;font-family:var(--mono);font-size:.68rem;margin:4px 8px 9px;text-transform:uppercase}
  aside nav, .range { display:grid;gap:2px; } aside a{font-family:var(--mono);font-size:.76rem;padding:9px 10px;text-transform:uppercase} aside a.active,aside a:hover{background:var(--ink);color:var(--paper)} .secondary-nav{border-top:1px solid var(--line);display:block;margin-top:14px;padding-top:14px!important}.range{border-top:1px solid var(--line);grid-template-columns:1fr 1fr;margin-top:20px;padding-top:14px}.range .nav-label{grid-column:1/3}
  main { min-width:0;padding:0 24px 48px; }.page-heading{align-items:center;border-bottom:1px solid var(--ink);display:flex;justify-content:space-between;min-height:96px}.page-heading h1{font-size:1.8rem;letter-spacing:-.04em;margin:6px 0 0}.page-heading p{color:var(--muted);font-family:var(--mono);font-size:.72rem}.eyebrow{color:var(--muted);font-family:var(--mono);font-size:.68rem;text-transform:uppercase}
  .warning{background:#fff2ed;border:1px solid var(--orange);display:grid;font-size:.8rem;gap:4px;margin-top:18px;padding:12px}.warning span{color:var(--muted)}
  .kpis { border:1px solid var(--ink);display:grid;grid-template-columns:repeat(6,1fr);margin-top:20px; }.kpis.three{grid-template-columns:repeat(3,1fr)}.kpis div{border-right:1px solid var(--line);min-height:92px;padding:14px}.kpis div:last-child{border-right:0}.kpis span{color:var(--muted);font-family:var(--mono);font-size:.68rem;text-transform:uppercase}.kpis strong{display:block;font-size:1.55rem;margin-top:22px}
  .panel { border:1px solid var(--ink);margin-top:20px; }.panel>header{align-items:end;border-bottom:1px solid var(--ink);display:flex;justify-content:space-between;min-height:68px;padding:12px 16px}.panel h2{font-size:1.15rem;margin:5px 0 0}.panel-note{color:var(--muted);font-family:var(--mono);font-size:.68rem;line-height:1.45;max-width:500px;margin:0;text-align:right}.legend{display:flex;gap:15px}.legend span{font-family:var(--mono);font-size:.68rem}.legend span::before{content:"";display:inline-block;height:7px;margin-right:5px;width:7px}.legend .browser::before{background:#0b0d0c}.legend .suspected::before{background:#9b4d2b}.legend .search::before{background:#5d665f}.legend .ai::before{background:#e86032}.legend .api::before{background:#a4aa9f}
  svg{display:block;height:auto;padding:18px;width:100%}svg line{stroke:var(--line);stroke-width:1}svg polyline{fill:none;stroke-width:2}.browser{stroke:#0b0d0c}.suspected{stroke:#9b4d2b}.search{stroke:#5d665f}.ai{stroke:#e86032}.api{stroke:#a4aa9f}
  .mix-table>div{align-items:center;border-bottom:1px solid var(--line);display:grid;gap:14px;grid-template-columns:140px 1fr 70px 70px;min-height:42px;padding:0 16px}.mix-table>div:last-child{border-bottom:0}.mix-table span,.mix-table small{font-family:var(--mono);font-size:.72rem}.mix-table i{background:#dfe1da;height:8px}.mix-table b{background:var(--ink);display:block;height:100%}.mix-table strong,.mix-table small{text-align:right}
  .data-table>div{align-items:center;border-bottom:1px solid var(--line);display:grid;gap:14px;grid-template-columns:minmax(260px,2fr) 1fr repeat(3,90px);min-height:42px;padding:0 14px}.data-table>div:last-child{border-bottom:0}.data-table span,.data-table strong,.data-table a{font-family:var(--mono);font-size:.72rem}.data-table a{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.table-head{background:#e4e6df;color:var(--muted);text-transform:uppercase}.acquisition>div{grid-template-columns:2fr 1fr}.quality-table>div{grid-template-columns:minmax(220px,2fr) 1fr repeat(4,90px)}.search-table>div{grid-template-columns:2fr repeat(3,1fr)}
  .realtime-list>div{align-items:center;border-bottom:1px solid var(--line);display:grid;gap:12px;grid-template-columns:55px 130px minmax(200px,1fr) 100px 60px;min-height:40px;padding:0 14px}.realtime-list time,.realtime-list span,.realtime-list small,.realtime-list strong,.realtime-list code{font-family:var(--mono);font-size:.7rem}.realtime-list code{overflow:hidden;text-overflow:ellipsis}.realtime-list strong{text-align:right}.empty{color:var(--muted);font-family:var(--mono);font-size:.75rem;padding:24px}
  .health dl{margin:0}.health dl>div{border-bottom:1px solid var(--line);display:grid;grid-template-columns:220px 1fr;min-height:44px;padding:0 16px;align-items:center}.health dt{color:var(--muted);font-family:var(--mono);font-size:.7rem;text-transform:uppercase}.health dd{font-family:var(--mono);font-size:.75rem;margin:0;overflow-wrap:anywhere}
  @media(max-width:900px){.console-grid{grid-template-columns:1fr}aside{border-bottom:1px solid var(--ink);border-right:0;overflow-x:auto;padding:8px}aside nav{display:flex}.secondary-nav,.range,.nav-label{display:none!important}main{padding:0 12px 36px}.kpis{grid-template-columns:repeat(3,1fr)}.data-table>div{grid-template-columns:minmax(180px,2fr) repeat(4,75px)}.data-table>div span:nth-child(2){display:none}.acquisition>div{grid-template-columns:2fr 1fr}.quality-table>div{grid-template-columns:minmax(180px,2fr) repeat(4,75px)}.panel-note{display:none}.page-heading p{display:none}}
</style>
