---
import { categories } from "@/config/site";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

type Props = {
  eyebrow?: string;
  title?: string;
  description?: string;
  active?: string;
};

const { eyebrow, title, description, active } = Astro.props;
const isHome = Astro.url.pathname === "/";
const primaryLinks = [
  { label: "Agents", href: "/agents", key: "agents" },
  { label: "Models", href: "/models", key: "models" },
  { label: "Skills", href: "/skills", key: "skills" },
  { label: "Memory", href: "/memory-systems", key: "memory-systems" },
  { label: "Evaluations", href: "/evaluations", key: "evaluations" }
];
const utilityLinks = [
  { label: "Guides", href: "/blog", key: "blog" },
  { label: "Submit", href: "/submit", key: "submit" }
];
const sectionLinks = [...primaryLinks, ...utilityLinks];
---

<div class="editorial-shell">
  <aside class="editorial-sidebar" aria-label="OpenAgent.bot sections">
    <div class="sidebar-card">
      <a class="sidebar-brand" href="/" aria-label="OpenAgent.bot home">
        <span class="brand-mark">OA</span>
        <strong>OpenAgent.bot</strong>
      </a>
      <nav>
        <div class="nav-group">
          {primaryLinks.map((item) => <a class:list={{ active: active === item.key }} href={item.href} data-analytics="nav" data-analytics-payload={JSON.stringify({label: item.label, href: item.href})}>{item.label}</a>)}
        </div>
        <div class="nav-group utility-group">
          {utilityLinks.map((item) => <a class:list={{ active: active === item.key }} href={item.href} data-analytics="nav" data-analytics-payload={JSON.stringify({label: item.label, href: item.href})}>{item.label}</a>)}
        </div>
      </nav>
    </div>
  </aside>

  <div class="editorial-main">
    <Header />
    <div class="mobile-rail" aria-label="OpenAgent.bot sections">
      {sectionLinks.map((item) => <a class:list={{ active: active === item.key }} href={item.href} data-analytics="nav" data-analytics-payload={JSON.stringify({label: item.label, href: item.href, mobile: true})}>{item.label}</a>)}
    </div>
    <div class="editorial-content">
      {
        title && (
          <header class="editorial-head">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </header>
        )
      }
      <slot />
      <Footer />
    </div>
  </div>
</div>

<style>
  .editorial-shell {
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
    min-height: 100vh;
  }

  .editorial-sidebar {
    background: #ffffff;
    border-right: 1px solid var(--line);
    height: 100vh;
    left: 0;
    overflow-y: auto;
    padding: 18px 14px;
    position: sticky;
    top: 0;
  }

  .sidebar-card {
    display: grid;
    gap: 22px;
  }

  .sidebar-brand {
    align-items: center;
    display: flex;
    gap: 10px;
    min-height: 36px;
  }

  .sidebar-brand strong {
    font-size: 0.92rem;
    font-weight: 580;
  }

  .brand-mark {
    align-items: center;
    background: var(--accent-open);
    border-radius: 7px;
    color: var(--paper);
    display: inline-flex;
    font-size: 0.78rem;
    font-weight: 650;
    height: 30px;
    justify-content: center;
    width: 30px;
  }

  nav {
    display: grid;
    gap: 13px;
  }

  .nav-group {
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 2px;
    padding-bottom: 12px;
  }

  .nav-group:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  nav a,
  .mobile-rail a {
    border-radius: 7px;
    color: var(--muted);
  }

  nav a {
    font-size: 0.86rem;
    font-weight: 400;
    padding: 7px 9px;
  }

  .utility-group {
    margin-top: 4px;
  }

  .utility-group a {
    color: var(--subtle);
    font-size: 0.82rem;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.active,
  .mobile-rail a:hover,
  .mobile-rail a.active {
    background: var(--surface);
    color: var(--ink);
    font-weight: 520;
  }

  nav a.active {
    background: var(--surface-soft);
    color: var(--accent-open);
  }

  .mobile-rail {
    display: none;
  }

  .editorial-main {
    min-width: 0;
    overflow: hidden;
    padding-top: 58px;
  }

  .editorial-content {
    margin: 0 auto;
    max-width: 1180px;
    padding: 24px 26px 56px;
  }

  .editorial-content :global([id]) {
    scroll-margin-top: 82px;
  }

  .editorial-head {
    padding: 0 0 24px;
  }

  .editorial-head h1 {
    font-size: 2.8rem;
    font-weight: 520;
    letter-spacing: 0;
    line-height: 1;
    margin: 8px 0 0;
    max-width: 900px;
  }

  .editorial-head p {
    font-size: 0.96rem;
    margin: 18px 0 0;
    max-width: 720px;
  }

  @media (max-width: 920px) {
    .editorial-shell {
      display: block;
    }

    .editorial-sidebar {
      display: none;
    }

    .mobile-rail {
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      display: flex;
      gap: 8px;
      margin: 0 0 18px;
      overflow-x: auto;
      padding: 14px 18px 10px;
      position: static;
      z-index: 11;
      scrollbar-width: none;
    }

    .mobile-rail a {
      background: var(--surface);
      flex: 0 0 auto;
      font-size: 0.92rem;
      padding: 9px 12px;
      white-space: nowrap;
    }

    .editorial-main {
      padding: 0;
      padding-top: 60px;
    }

    .editorial-head h1 {
      font-size: 2.2rem;
    }

    .editorial-head {
      padding-bottom: 22px;
    }

    .editorial-content {
      padding: 18px 16px 48px;
    }
  }

  @media (max-width: 760px) {
    .editorial-main {
      padding-top: 60px;
    }

    .editorial-content :global([id]) {
      scroll-margin-top: 104px;
    }
  }

  @media (max-width: 620px) {
    .editorial-head h1 {
      font-size: 2.25rem;
    }
  }
</style>
