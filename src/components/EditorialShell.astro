---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

type Breadcrumb = {
  label: string;
  href?: string;
};

type Props = {
  eyebrow?: string;
  title?: string;
  description?: string;
  active?: string;
  variant?: boolean;
  breadcrumbs?: Breadcrumb[];
};

const { eyebrow, title, description, active, variant, breadcrumbs } = Astro.props;
const isHome = Astro.url.pathname === "/";
const homeHref = (hash: string) => (isHome ? hash : `/${hash}`);
const primaryLinks = [
  { label: "Agents", href: homeHref("#agents"), key: "agents" },
  { label: "Models", href: homeHref("#models"), key: "models" },
  { label: "Skills", href: homeHref("#skills"), key: "skills" },
  { label: "Memory", href: homeHref("#memory"), key: "memory-systems" }
];
const utilityLinks = [
  { label: "Evaluations", href: "/evaluations", key: "evaluations" },
  { label: "Guides", href: "/blog", key: "blog" }
];
const submitLink = { label: "Submit a resource", href: "/submit", key: "submit" };
const sectionLinks = [...primaryLinks, ...utilityLinks, submitLink];
---

<div class="editorial-shell">
  <aside class="editorial-sidebar" aria-label="OpenAgent.bot sections">
    <div class="sidebar-card">
      <a class="sidebar-brand" href="/" aria-label="OpenAgent.bot home">
        <span class="brand-mark">OA</span>
        <strong>OpenAgent.bot</strong>
      </a>

      <nav class="sidebar-nav" aria-label="Primary">
        <div class="nav-group">
          {primaryLinks.map((item) => <a class:list={{ active: active === item.key }} href={item.href} data-analytics="nav" data-analytics-payload={JSON.stringify({label: item.label, href: item.href})}>{item.label}</a>)}
        </div>
        <div class="nav-group utility-group">
          {utilityLinks.map((item) => <a class:list={{ active: active === item.key }} href={item.href} data-analytics="nav" data-analytics-payload={JSON.stringify({label: item.label, href: item.href})}>{item.label}</a>)}
        </div>
      </nav>

      <a class:list={["sidebar-submit", { active: active === submitLink.key }]} href={submitLink.href} data-analytics="nav" data-analytics-payload={JSON.stringify({label: submitLink.label, href: submitLink.href})}>
        {submitLink.label}
      </a>
    </div>
  </aside>

  <div class="editorial-main">
    <Header />
    <div class="mobile-rail" aria-label="OpenAgent.bot sections">
      {sectionLinks.map((item) => <a class:list={{ active: active === item.key }} href={item.href} data-analytics="nav" data-analytics-payload={JSON.stringify({label: item.label, href: item.href, mobile: true})}>{item.label}</a>)}
    </div>
    <div class:list={["editorial-content", { "is-variant": variant }]}>
      {variant && breadcrumbs && breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="variant-breadcrumb">
          {breadcrumbs.map((b, i) => (
            <>{i > 0 && <span class="bc-sep">/</span>}{b.href ? <a href={b.href}>{b.label}</a> : <span aria-current="page">{b.label}</span>}</>
          ))}
        </nav>
      )}
      {
        title && (
          <header class="editorial-head">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </header>
        )
      }
      <slot />
      <Footer />
    </div>
  </div>
</div>

<style>
  .editorial-shell {
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
    min-height: 100vh;
  }

  .editorial-sidebar {
    background: #f4f5f6;
    border-right: 1px solid var(--line);
    height: 100vh;
    left: 0;
    overflow-y: auto;
    padding: 24px 14px 18px;
    position: sticky;
    top: 0;
  }

  .sidebar-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100vh - 42px);
    row-gap: 22px;
  }

  .sidebar-brand {
    align-items: center;
    display: flex;
    gap: 10px;
    min-height: 34px;
    padding: 0;
  }

  .sidebar-brand strong {
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0;
  }

  .brand-mark {
    align-items: center;
    background: var(--ink);
    border-radius: 6px;
    color: #ffffff;
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 900;
    height: 28px;
    justify-content: center;
    letter-spacing: 0.06em;
    width: 28px;
  }

  .sidebar-nav {
    align-content: start;
    display: grid;
    row-gap: 12px;
  }

  .nav-group {
    display: grid;
    row-gap: 1px;
  }

  .utility-group {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  nav a,
  .mobile-rail a,
  .sidebar-submit {
    border-radius: 7px;
    color: var(--muted);
  }

  nav a,
  .sidebar-submit {
    align-items: center;
    display: flex;
    font-size: 0.82rem;
    font-weight: 430;
    min-height: 32px;
    padding: 0 9px;
  }

  .utility-group a {
    color: var(--muted);
    font-size: 0.82rem;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.active,
  .sidebar-submit:hover,
  .sidebar-submit:focus-visible,
  .sidebar-submit.active,
  .mobile-rail a:hover,
  .mobile-rail a.active {
    background: rgba(22, 26, 29, 0.06);
    color: var(--ink);
    font-weight: 520;
  }

  nav a.active {
    background: rgba(22, 26, 29, 0.075);
    color: var(--ink);
    font-weight: 580;
  }

  .sidebar-submit {
    align-self: stretch;
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 520;
    justify-content: center;
    min-height: 38px;
    padding: 0 14px;
    text-align: center;
  }

  .sidebar-submit:hover,
  .sidebar-submit:focus-visible,
  .sidebar-submit.active {
    background: var(--surface);
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 520;
  }

  .mobile-rail {
    display: none;
  }

  .editorial-main {
    background: var(--paper);
    min-width: 0;
    overflow: hidden;
    padding-top: 58px;
  }

  .editorial-content {
    color: var(--ink);
    margin: 0 auto;
    max-width: 1180px;
    padding: 26px 26px 56px;
  }

  .editorial-content :global([id]) {
    scroll-margin-top: 82px;
  }

  .editorial-head {
    padding: 0 0 26px;
  }

  .editorial-head h1 {
    color: var(--ink);
    font-size: 2.2rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1;
    margin: 8px 0 0;
    max-width: 900px;
  }

  .editorial-head p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 18px 0 0;
    max-width: 720px;
  }

  @media (max-width: 920px) {
    .editorial-shell {
      display: block;
    }

    .editorial-sidebar {
      display: none;
    }

    .mobile-rail {
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      display: flex;
      gap: 8px;
      margin: 0 0 18px;
      overflow-x: auto;
      padding: 14px 18px 10px;
      position: static;
      z-index: 11;
      scrollbar-width: none;
    }

    .mobile-rail a {
      background: var(--surface);
      border: 1px solid var(--line);
      color: var(--muted);
      flex: 0 0 auto;
      font-size: 0.82rem;
      padding: 9px 12px;
      white-space: nowrap;
    }

    .editorial-main {
      padding: 0;
      padding-top: 60px;
    }

    .editorial-head h1 {
      font-size: 2.2rem;
    }

    .editorial-head {
      padding-bottom: 22px;
    }

    .editorial-content {
      padding: 18px 16px 48px;
    }
  }

  .editorial-content.is-variant {
    max-width: none;
    padding: 0;
  }

  .variant-breadcrumb {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.72rem;
    gap: 6px;
    padding: 12px 32px;
  }

  .variant-breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .variant-breadcrumb a:hover { color: var(--ink); }

  .variant-breadcrumb span[aria-current="page"] {
    color: var(--subtle);
  }

  .bc-sep { color: var(--line-strong); }

  @media (max-width: 800px) {
    .variant-breadcrumb { padding: 10px 20px; }
  }

  @media (max-width: 760px) {
    .editorial-main {
      padding-top: 60px;
    }

    .editorial-content :global([id]) {
      scroll-margin-top: 104px;
    }
  }

  @media (max-width: 620px) {
    .editorial-head h1 {
      font-size: 2.25rem;
    }
  }
</style>
