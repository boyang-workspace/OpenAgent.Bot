---
import { site } from "@/config/site";
const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="OpenAgent.bot home">
    <span class="brand-mark">OA</span>
    <span class="brand-copy">OPENAGENT<small>BOT / DATABASE</small></span>
  </a>
  <nav aria-label="Primary navigation">
    {site.nav.map((item) => (
      <a class:list={["nav-link", { active: path === item.href || path.startsWith(`${item.href}/`) }]} href={item.href}>
        {item.label}
      </a>
    ))}
  </nav>
  <a class="api-link" href="/api">API <span aria-hidden="true">↗</span></a>
</header>
