---
import { compactNumber, label, relativeDate } from "@/lib/registry/format";
import type { RegistryEntity } from "@/lib/registry/types";

type Props = {
  entities: RegistryEntity[];
  total: number;
  selectedSlug?: string;
  initialCompareSlugs?: string[];
  initialCompareProjects?: Array<{ slug: string; name: string }>;
  queryString?: string;
  robotPlatformMode?: boolean;
};

const { entities, total, selectedSlug, initialCompareSlugs = [], initialCompareProjects = [], queryString = "", robotPlatformMode = false } = Astro.props;

function selectHref(slug: string): string {
  const params = new URLSearchParams(queryString);
  params.set("selected", slug);
  return `/database?${params.toString()}`;
}

function activityDate(entity: RegistryEntity): string | undefined {
  return entity.lastCommitAt ?? entity.lastReleaseAt ?? entity.lastVerifiedAt;
}

function metadataValue(entity: RegistryEntity, keys: string[]): string | undefined {
  const metadata = entity.robotics?.metadata ?? {};
  for (const key of keys) {
    const value = metadata[key];
    if (typeof value === "string" && value.trim()) return value;
    if (typeof value === "boolean") return value ? "Supported" : "Not listed";
    if (typeof value === "number") return String(value);
    if (Array.isArray(value) && value.length) return value.map(String).join(", ");
  }
}

function opennessLabel(entity: RegistryEntity, facet: "hardware" | "software"): string {
  const explicit = metadataValue(entity, facet === "hardware" ? ["hardware_openness", "hardwareOpen", "hardware"] : ["software_openness", "softwareOpen", "software"]);
  if (explicit) return explicit;
  if (facet === "hardware") return "Collecting";
  if (entity.opennessStatus === "open-source") return "Open source";
  if (entity.opennessStatus === "open-core") return "Open core";
  if (entity.opennessStatus === "source-available") return "Source available";
  return "Collecting";
}
---

{entities.length > 0 ? (
  <div class="registry-results">
    <div class="result-toolbar">
      <div class="compare-control">
        <span class="data-label">Compare</span>
        <strong data-compare-count>0 selected</strong>
        <a data-compare-link href="/compare" hidden>Compare records</a>
      </div>
      <span class="result-count">{total} results</span>
    </div>
    <div class="table-scroll">
      <table class:list={["registry-table", { "robot-mode": robotPlatformMode }]}>
        <thead>
          {robotPlatformMode ? <tr>
            <th class="select-column"><span class="sr-only">Compare</span></th>
            <th>Entity</th>
            <th>Type</th>
            <th>Hardware</th>
            <th>Software</th>
            <th>Availability</th>
            <th>Activity</th>
            <th class="numeric">Evidence</th>
          </tr> : <tr>
            <th class="select-column"><span class="sr-only">Compare</span></th>
            <th>Entity</th>
            <th>Type</th>
            <th>Openness</th>
            <th>License</th>
            <th class="numeric">Stars</th>
            <th class="numeric">30d Δ</th>
            <th>Last activity</th>
            <th class="numeric">Evidence</th>
          </tr>}
        </thead>
        <tbody>
          {entities.map((entity) => (
            <tr class:list={[{ selected: entity.slug === selectedSlug }]}>
              <td class="select-column"><input data-compare-item data-name={entity.name} type="checkbox" value={entity.slug} aria-label={`Compare ${entity.name}`} /></td>
              <td class="entity-cell">
                <a data-inspect-record data-slug={entity.slug} href={selectHref(entity.slug)} aria-current={entity.slug === selectedSlug ? "true" : undefined}>{entity.name}</a>
                <small>{entity.organization ?? entity.summary}</small>
                <a class="mobile-dossier-link" href={`/project/${entity.slug}`}>Full dossier ↗</a>
              </td>
              <td>{label(entity.kind)}</td>
              {robotPlatformMode ? <>
                <td>{opennessLabel(entity, "hardware")}</td>
                <td>{opennessLabel(entity, "software")}</td>
                <td>{metadataValue(entity, ["availability", "commercial_availability", "status"]) ?? "Collecting"}</td>
                <td>{relativeDate(activityDate(entity))}{entity.stars !== undefined && <small class="secondary-metric">{compactNumber(entity.stars)} stars</small>}</td>
                <td class="numeric"><span class="evidence-count">{entity.evidenceRecords ?? 0}</span></td>
              </> : <>
                <td><span class:list={["domain-value", entity.opennessStatus]}>{label(entity.opennessStatus)}</span></td>
                <td>{entity.licenseSpdx ?? "Not declared"}</td>
                <td class="numeric metric-value">{compactNumber(entity.stars)}</td>
                <td class="numeric delta-value">{entity.stars === undefined && !entity.sourceCount ? <span title="No repository metric subscription for this record">—</span> : entity.starsDelta30d === undefined ? <span title={`${entity.metricHistoryDays ?? 0}/30 history days collected`}>Collecting</span> : `${entity.starsDelta30d >= 0 ? "+" : ""}${compactNumber(entity.starsDelta30d)}`}</td>
                <td>{relativeDate(activityDate(entity))}</td>
                <td class="numeric"><span class="evidence-count">{entity.evidenceRecords ?? 0}</span></td>
              </>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <aside class="compare-tray" data-compare-tray data-initial={JSON.stringify(initialCompareProjects.length ? initialCompareProjects : initialCompareSlugs)} aria-label="Selected projects for comparison" hidden>
      <span class="tray-label">Compare</span>
      <div class="tray-projects" data-compare-projects></div>
      <a class="tray-add" href="/database">+ Add project</a>
      <a class="tray-action" data-tray-compare href="/compare" aria-disabled="true">Select 2 to compare</a>
    </aside>
  </div>
) : <div class="empty-state">No matching records. Clear one or more filters and try again.</div>}

<script>
  const compareBoxes = Array.from(document.querySelectorAll<HTMLInputElement>("[data-compare-item]"));
  const compareCount = document.querySelector<HTMLElement>("[data-compare-count]");
  const compareLink = document.querySelector<HTMLAnchorElement>("[data-compare-link]");
  const compareTray = document.querySelector<HTMLElement>("[data-compare-tray]");
  const trayProjects = document.querySelector<HTMLElement>("[data-compare-projects]");
  const trayCompare = document.querySelector<HTMLAnchorElement>("[data-tray-compare]");
  const tableScroll = document.querySelector<HTMLElement>(".table-scroll");
  const filterParams = new URLSearchParams(window.location.search);
  filterParams.delete("selected");
  filterParams.delete("compare");
  const scrollKey = `openagent:database-scroll:${filterParams.toString()}`;
  const compareKey = "openagent:compare-selection";
  const selectedProjects = new Map<string, string>();
  const initialSlugs = (() => {
    try { return JSON.parse(compareTray?.dataset.initial ?? "[]") as Array<string | { slug: string; name: string }>; } catch { return []; }
  })();
  try {
    const saved = JSON.parse(sessionStorage.getItem(compareKey) ?? "[]") as Array<string | { slug: string; name: string }>;
    for (const item of saved) typeof item === "string" ? selectedProjects.set(item, item) : selectedProjects.set(item.slug, item.name);
  } catch {}
  for (const item of initialSlugs) {
    const slug = typeof item === "string" ? item : item.slug;
    const name = typeof item === "string" ? compareBoxes.find((box) => box.value === item)?.dataset.name ?? item : item.name;
    selectedProjects.set(slug, name);
  }

  const updateCompare = () => {
    const selected = Array.from(selectedProjects.entries()).slice(0, 4);
    if (compareCount) compareCount.textContent = `${selected.length} selected`;
    if (compareLink) {
      compareLink.hidden = selected.length < 2;
      compareLink.href = `/compare?projects=${encodeURIComponent(selected.map(([slug]) => slug).join(","))}`;
    }
    for (const box of compareBoxes) {
      box.checked = selectedProjects.has(box.value);
      box.disabled = selected.length >= 4 && !box.checked;
    }
    if (compareTray) compareTray.hidden = selected.length === 0;
    if (trayCompare) {
      const ready = selected.length >= 2;
      trayCompare.textContent = ready ? `Compare ${selected.length} →` : "Select 2 to compare";
      trayCompare.href = ready ? `/compare?projects=${encodeURIComponent(selected.map(([slug]) => slug).join(","))}` : "/compare";
      trayCompare.setAttribute("aria-disabled", String(!ready));
    }
    if (trayProjects) {
      trayProjects.replaceChildren();
      for (const [slug, name] of selected) {
        const item = document.createElement("span");
        item.textContent = name;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.setAttribute("aria-label", `Remove ${name} from comparison`);
        remove.addEventListener("click", () => { selectedProjects.delete(slug); updateCompare(); });
        item.append(remove);
        trayProjects.append(item);
      }
    }
    sessionStorage.setItem(compareKey, JSON.stringify(selected.map(([slug, name]) => ({ slug, name }))));
  };
  for (const box of compareBoxes) box.addEventListener("change", () => {
    if (box.checked) selectedProjects.set(box.value, box.dataset.name ?? box.value);
    else selectedProjects.delete(box.value);
    updateCompare();
  });
  updateCompare();
  if (tableScroll) {
    const savedScroll = Number(sessionStorage.getItem(scrollKey) ?? 0);
    requestAnimationFrame(() => { tableScroll.scrollTop = savedScroll; });
    tableScroll.addEventListener("scroll", () => sessionStorage.setItem(scrollKey, String(tableScroll.scrollTop)), { passive: true });
  }
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-inspect-record]")) {
    if (window.matchMedia("(max-width: 760px)").matches && link.dataset.slug) link.href = `/project/${link.dataset.slug}`;
    link.addEventListener("click", () => {
      if (tableScroll) sessionStorage.setItem(scrollKey, String(tableScroll.scrollTop));
    });
  }
</script>

<style>
  .registry-results { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100%; min-height: 0; min-width: 0; }
  .result-toolbar { align-items: center; background: rgba(243, 244, 239, .98); border-bottom: 1px solid var(--ink); display: flex; justify-content: space-between; min-height: 54px; padding: 0 18px; z-index: 3; }
  .compare-control { align-items: center; display: flex; gap: 13px; }
  .compare-control strong, .compare-control a, .result-count { font-family: var(--mono); font-size: .64rem; text-transform: uppercase; }
  .compare-control a { background: var(--ink); color: var(--acid); padding: 7px 10px; }
  .table-scroll { min-height: 0; min-width: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable; }
  .registry-table { border-collapse: collapse; min-width: 1010px; table-layout: fixed; width: 100%; }
  th { background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: .59rem; font-weight: 500; height: 39px; letter-spacing: .035em; padding: 0 10px; position: sticky; text-align: left; text-transform: uppercase; top: 0; z-index: 2; }
  th:nth-child(2) { width: 25%; }
  th:nth-child(3) { width: 13%; }
  th:nth-child(4) { width: 12%; }
  th:nth-child(5) { width: 11%; }
  th:nth-child(6), th:nth-child(7) { width: 8%; }
  th:nth-child(8) { width: 10%; }
  th:nth-child(9) { width: 7%; }
  td { border-bottom: 1px solid var(--line); color: #3f423d; font-family: var(--mono); font-size: .66rem; height: 68px; padding: 9px 10px; vertical-align: middle; }
  tbody tr:hover, tbody tr.selected { background: #f7f8f2; box-shadow: inset 3px 0 0 var(--acid); }
  .select-column { text-align: center; width: 38px; }
  .select-column input { accent-color: var(--acid); height: 16px; margin: 0; width: 16px; }
  .entity-cell a { color: var(--ink); display: block; font-family: var(--sans); font-size: .92rem; font-weight: 600; }
  .entity-cell a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .entity-cell small { color: var(--muted); display: block; font-size: .58rem; margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .entity-cell .mobile-dossier-link { display: none; }
  .domain-value { font-weight: 600; text-transform: uppercase; }
  .domain-value.agent { color: var(--blue); }
  .domain-value.robotics { color: var(--orange); }
  .domain-value.shared { color: var(--muted); }
  .domain-value.open-source, .domain-value.open-weights { color: #426300; }
  .domain-value.closed { color: var(--orange); }
  .secondary-metric { color: var(--muted); display: block; font-size: .54rem; margin-top: 5px; text-transform: uppercase; }
  .robot-mode { min-width: 900px; }
  .robot-mode th:nth-child(2) { width: 26%; }
  .robot-mode th:nth-child(3) { width: 12%; }
  .robot-mode th:nth-child(4), .robot-mode th:nth-child(5) { width: 13%; }
  .robot-mode th:nth-child(6) { width: 14%; }
  .robot-mode th:nth-child(7) { width: 14%; }
  .robot-mode th:nth-child(8) { width: 8%; }
  .numeric { font-variant-numeric: tabular-nums; text-align: right; }
  .metric-value { color: var(--ink); font-size: .78rem; }
  .delta-value { color: #426300; }
  .delta-value span { color: var(--muted); font-size: .56rem; text-transform: uppercase; }
  .evidence-count { background: var(--acid); border: 1px solid var(--ink); color: var(--ink); display: inline-block; min-width: 28px; padding: 4px 5px; text-align: center; }
  .compare-tray { align-items: center; background: var(--ink); bottom: 18px; color: var(--paper); display: flex; gap: 10px; left: 50%; max-width: min(920px, calc(100vw - 36px)); min-height: 58px; padding: 9px 10px 9px 16px; position: fixed; transform: translateX(-50%); width: max-content; z-index: 90; }
  .compare-tray[hidden] { display: none; }
  .tray-label { color: var(--acid); font-family: var(--mono); font-size: .58rem; text-transform: uppercase; }
  .tray-projects { display: flex; flex-wrap: wrap; gap: 6px; }
  .tray-projects span { align-items: center; border: 1px solid #555b53; display: inline-flex; font-family: var(--mono); font-size: .6rem; gap: 8px; min-height: 34px; padding-left: 10px; text-transform: uppercase; }
  .tray-projects button { align-self: stretch; background: transparent; border: 0; border-left: 1px solid #555b53; color: var(--paper); cursor: pointer; min-width: 30px; }
  .tray-projects button:hover { background: var(--orange); color: var(--ink); }
  .tray-add, .tray-action { align-items: center; border: 1px solid #555b53; display: flex; font-family: var(--mono); font-size: .58rem; min-height: 36px; padding: 0 11px; text-transform: uppercase; }
  .tray-action { background: var(--acid); border-color: var(--acid); color: var(--ink); }
  .tray-action[aria-disabled="true"] { background: transparent; color: #8c938a; pointer-events: none; }
  .sr-only { height: 1px; margin: -1px; overflow: hidden; padding: 0; position: absolute; width: 1px; clip: rect(0,0,0,0); }

  @media (max-width: 1040px) {
    .registry-results { display: block; height: auto; }
    .table-scroll { overflow-x: auto; overflow-y: visible; }
    th { position: static; }
  }

  @media (max-width: 760px) {
    .registry-results { display: block; height: auto; }
    .result-toolbar { min-height: 50px; padding: 0 14px; }
    .compare-control .data-label { display: none; }
    .table-scroll { overflow: visible; }
    .registry-table { display: block; min-width: 0; }
    .registry-table thead { display: none; }
    .registry-table tbody { display: block; }
    .registry-table tr { border-bottom: 1px solid var(--line); display: grid; gap: 7px 12px; grid-template-columns: 24px minmax(0, 1fr) auto; padding: 15px 14px; }
    .registry-table td { border: 0; display: block; font-size: .63rem; height: auto; padding: 0; text-align: left; }
    .registry-table .select-column { grid-row: 1 / 4; padding-top: 3px; }
    .registry-table .entity-cell { grid-column: 2; }
    .registry-table td:nth-child(3) { grid-column: 3; grid-row: 1; text-align: right; }
    .registry-table td:nth-child(4) { grid-column: 2; }
    .registry-table td:nth-child(5) { grid-column: 2; color: var(--muted); }
    .registry-table td:nth-child(5)::before { content: "License · "; }
    .registry-table td:nth-child(6) { grid-column: 3; grid-row: 2; text-align: right; }
    .registry-table td:nth-child(6)::after { content: " stars"; color: var(--muted); font-size: .55rem; }
    .registry-table td:nth-child(7) { display: none; }
    .registry-table td:nth-child(8) { grid-column: 3; grid-row: 3; text-align: right; }
    .registry-table td:nth-child(9) { grid-column: 3; grid-row: 4; text-align: right; }
    .registry-table.robot-mode td:nth-child(4) { grid-column: 2; grid-row: 2; }
    .registry-table.robot-mode td:nth-child(4)::before { content: "Hardware · "; color: var(--muted); }
    .registry-table.robot-mode td:nth-child(5) { grid-column: 2; grid-row: 3; }
    .registry-table.robot-mode td:nth-child(5)::before { content: "Software · "; }
    .registry-table.robot-mode td:nth-child(6) { grid-column: 3; grid-row: 2; }
    .registry-table.robot-mode td:nth-child(6)::before { content: "Availability · "; color: var(--muted); font-size: .54rem; }
    .registry-table.robot-mode td:nth-child(6)::after { content: none; }
    .registry-table.robot-mode td:nth-child(7) { display: block; grid-column: 3; grid-row: 3; text-align: right; }
    .registry-table.robot-mode td:nth-child(8) { grid-column: 3; grid-row: 4; text-align: right; }
    .entity-cell small { max-width: 230px; }
    .mobile-dossier-link { color: var(--muted) !important; display: inline-block !important; font-family: var(--mono) !important; font-size: .54rem !important; font-weight: 500 !important; margin-top: 8px; text-transform: uppercase; }
    .compare-tray { bottom: 0; left: 0; max-width: none; padding: 9px 12px; transform: none; width: 100%; }
    .tray-label, .tray-projects, .tray-add { display: none; }
    .tray-action { margin-left: auto; }
  }
</style>
