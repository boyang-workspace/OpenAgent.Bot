---
import type { ResourceV1 } from "@/lib/content/resource-schema";
import { resourcePath } from "@/lib/content/resources";
import { resourceCategoryLabel, resourceImage, resourceSummary } from "@/lib/content/resource-display";

type Props = {
  resource: ResourceV1;
  large?: boolean;
};

const { resource, large = false } = Astro.props;
const href = resourcePath(resource);
const image = resourceImage(resource);
const fallbackImage = `/resource-fallbacks/${resource.classification.primary_category}.svg`;
const summary = resourceSummary(resource);
const categoryLabel = resourceCategoryLabel(resource);
const compactStars =
  resource.facts.github_stars !== undefined
    ? `${Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 1 }).format(resource.facts.github_stars)} stars`
    : undefined;
const sourceLabel = resource.decision_signals.open_source ? "Open source" : (resource.facts.license ?? "Source");
const trackPayload = JSON.stringify({
  name: resource.identity.name,
  slug: resource.slug,
  category: categoryLabel,
  stars: resource.facts.github_stars ?? null,
  type: resource.classification.resource_type
});
---

<article class:list={["resource-card", { large }]}>
  <a href={href} aria-label={resource.identity.name} data-analytics="resource" data-analytics-payload={trackPayload}>
    <div class="media">
      <img src={image} alt="" loading="lazy" decoding="async" onerror={`this.onerror=null;this.src='${fallbackImage}';`} />
      <div class="source-meta">
        <span>{sourceLabel}</span>
        {compactStars && <span>{compactStars}</span>}
      </div>
    </div>
    <div class="resource-body">
      <div class="meta">
        <span>{categoryLabel}</span>
        {resource.facts.license && <span>{resource.facts.license}</span>}
      </div>
      <h3>{resource.identity.name}</h3>
      <p>{summary}</p>
    </div>
  </a>
</article>

<style>
  .resource-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: 100%;
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .resource-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  a {
    display: grid;
    min-height: 100%;
  }

  .media {
    background: var(--surface-soft);
    position: relative;
  }

  img {
    aspect-ratio: 16 / 9;
    background: var(--surface-soft);
    object-fit: contain;
    padding: 18px;
    width: 100%;
  }

  .source-meta {
    align-items: flex-end;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line);
    border-radius: 7px;
    display: grid;
    gap: 2px;
    padding: 6px 7px;
    position: absolute;
    right: 10px;
    top: 10px;
    text-align: right;
  }

  .source-meta span {
    color: var(--muted);
    font-size: 0.66rem;
    line-height: 1.05;
    white-space: nowrap;
  }

  .source-meta span:first-child {
    color: var(--ink);
    font-weight: 560;
  }

  .resource-body {
    display: grid;
    gap: 7px;
    padding: 14px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meta span {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 450;
    letter-spacing: 0;
  }

  .meta span:first-child {
    color: var(--ink);
  }

  h3 {
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.16;
    margin: 0;
  }

  p {
    color: var(--muted);
    display: -webkit-box;
    font-size: 0.82rem;
    line-height: 1.48;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .large a {
    grid-template-columns: minmax(0, 1.18fr) minmax(260px, 0.82fr);
  }

  .large img {
    aspect-ratio: auto;
    height: 100%;
  }

  .large .resource-body {
    align-content: center;
    padding: 24px;
  }

  .large h3 {
    font-size: 1.7rem;
    font-weight: 560;
    line-height: 1.04;
  }

  .large .meta span {
    font-size: 0.76rem;
  }

  @media (max-width: 820px) {
    .large a {
      grid-template-columns: 1fr;
    }

    .large .resource-body {
      padding: 20px;
    }

    .large h3 {
      font-size: 1.8rem;
    }
  }
</style>
