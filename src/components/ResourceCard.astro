---
import type { ResourceV1 } from "@/lib/content/resource-schema";
import { resourcePath } from "@/lib/content/resources";
import { resourceCategoryLabel, resourceImage, resourceSummary } from "@/lib/content/resource-display";

type Props = {
  resource: ResourceV1;
  large?: boolean;
};

const { resource, large = false } = Astro.props;
const href = resourcePath(resource);
const image = resourceImage(resource);
const fallbackImage = `/resource-fallbacks/${resource.classification.primary_category}.svg`;
const summary = resourceSummary(resource);
const categoryLabel = resourceCategoryLabel(resource);
const starMeta = resource.facts.github_stars !== undefined ? `${resource.facts.github_stars.toLocaleString("en-US")} stars` : undefined;
const trackPayload = JSON.stringify({
  name: resource.identity.name,
  slug: resource.slug,
  category: categoryLabel,
  stars: resource.facts.github_stars ?? null,
  type: resource.classification.resource_type
});
---

<article class:list={["resource-card", { large }]}>
  <a href={href} aria-label={resource.identity.name} data-analytics="resource" data-analytics-payload={trackPayload}>
    <img src={image} alt="" loading="lazy" decoding="async" onerror={`this.onerror=null;this.src='${fallbackImage}';`} />
    <div class="resource-body">
      <div class="meta">
        <span>{categoryLabel}</span>
        {starMeta && <span>{starMeta}</span>}
      </div>
      <h3>{resource.identity.name}</h3>
      <p>{summary}</p>
    </div>
  </a>
</article>

<style>
  .resource-card {
    background: rgba(237, 237, 236, 0.04);
    border: 1px solid var(--dark-line);
    min-height: 100%;
    overflow: hidden;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .resource-card:hover {
    border-color: var(--dark-line-strong);
    background: rgba(237, 237, 236, 0.07);
    transform: translateY(-2px);
  }

  a {
    display: grid;
    min-height: 100%;
  }

  img {
    aspect-ratio: 16 / 9;
    background: rgba(237, 237, 236, 0.06);
    object-fit: cover;
    width: 100%;
  }

  .resource-body {
    display: grid;
    gap: 7px;
    padding: 14px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meta span {
    color: var(--dark-muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .meta span:first-child {
    color: var(--dark-muted);
  }

  h3 {
    color: var(--dark-text);
    font-size: 1.02rem;
    font-weight: 620;
    letter-spacing: 0;
    line-height: 1.16;
    margin: 0;
  }

  p {
    color: var(--dark-muted);
    display: -webkit-box;
    font-size: 0.86rem;
    line-height: 1.48;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .large a {
    grid-template-columns: minmax(0, 1.18fr) minmax(260px, 0.82fr);
  }

  .large img {
    aspect-ratio: auto;
    height: 100%;
  }

  .large .resource-body {
    align-content: center;
    padding: 24px;
  }

  .large h3 {
    font-size: 2rem;
    font-weight: 580;
    line-height: 1.04;
  }

  .large .meta span {
    font-size: 0.76rem;
  }

  @media (max-width: 820px) {
    .large a {
      grid-template-columns: 1fr;
    }

    .large .resource-body {
      padding: 20px;
    }

    .large h3 {
      font-size: 1.8rem;
    }
  }
</style>
