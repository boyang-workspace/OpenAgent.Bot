---
import type { ResourceV1 } from "@/lib/content/resource-schema";
import { resourcePath } from "@/lib/content/resources";
import { resourceCategoryLabel, resourceImage, resourceSummary } from "@/lib/content/resource-display";

type Props = {
  resource: ResourceV1;
  large?: boolean;
};

const { resource, large = false } = Astro.props;
const href = resourcePath(resource);
const image = resourceImage(resource);
const fallbackImage = `/resource-fallbacks/${resource.classification.primary_category}.svg`;
const summary = resourceSummary(resource);
const categoryLabel = resourceCategoryLabel(resource);
const compactStars =
  resource.facts.github_stars !== undefined
    ? `${Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 1 }).format(resource.facts.github_stars)} stars`
    : undefined;
const licenseLabel = resource.facts.license ?? "Source";
const trackPayload = JSON.stringify({
  name: resource.identity.name,
  slug: resource.slug,
  category: categoryLabel,
  stars: resource.facts.github_stars ?? null,
  type: resource.classification.resource_type
});
---

<article class:list={["resource-card", { large }]}>
  <a href={href} aria-label={resource.identity.name} data-analytics="resource" data-analytics-payload={trackPayload}>
    <div class="media">
      <img src={image} alt="" loading="lazy" decoding="async" onerror={`this.onerror=null;this.src='${fallbackImage}';`} />
      <div class="source-meta">
        <span>{licenseLabel}</span>
        {compactStars && <span>{compactStars}</span>}
      </div>
    </div>
    <div class="resource-body">
      <div class="meta">
        <span>{categoryLabel}</span>
        {resource.facts.license && <span>{resource.facts.license}</span>}
      </div>
      <h3>{resource.identity.name}</h3>
      <p>{summary}</p>
    </div>
  </a>
</article>

<style>
  .resource-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: 100%;
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .resource-card:hover {
    border-color: var(--line-strong);
    box-shadow: 0 6px 18px rgba(22, 26, 29, 0.045);
    transform: translateY(-2px);
  }

  a {
    display: grid;
    min-height: 100%;
  }

  .media {
    align-items: center;
    background: #f4f5f6;
    display: grid;
    min-height: 148px;
    place-items: center;
    position: relative;
  }

  img {
    background: var(--surface);
    border-radius: 22%;
    box-shadow: 0 1px 2px rgba(22, 26, 29, 0.08);
    box-sizing: border-box;
    height: 96px;
    object-fit: contain;
    padding: 0;
    width: 96px;
  }

  .source-meta {
    align-items: flex-end;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line);
    border-radius: 6px;
    display: grid;
    gap: 1px;
    padding: 5px 6px;
    position: absolute;
    right: 9px;
    top: 9px;
    text-align: right;
  }

  .source-meta span {
    color: var(--muted);
    font-size: 0.62rem;
    line-height: 1.05;
    white-space: nowrap;
  }

  .source-meta span:first-child {
    color: var(--ink);
    font-weight: 580;
  }

  .resource-body {
    display: grid;
    gap: 6px;
    padding: 13px 14px 15px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .meta span {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 430;
    letter-spacing: 0;
  }

  .meta span:first-child {
    color: var(--ink);
  }

  h3 {
    color: var(--ink);
    font-size: 0.94rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.16;
    margin: 0;
  }

  p {
    color: var(--muted);
    display: -webkit-box;
    font-size: 0.8rem;
    line-height: 1.46;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .large a {
    grid-template-columns: minmax(0, 1.18fr) minmax(260px, 0.82fr);
  }

  .large img {
    aspect-ratio: auto;
    height: 100%;
  }

  .large .resource-body {
    align-content: center;
    padding: 24px;
  }

  .large h3 {
    font-size: 1.7rem;
    font-weight: 560;
    line-height: 1.04;
  }

  .large .meta span {
    font-size: 0.76rem;
  }

  @media (max-width: 820px) {
    .large a {
      grid-template-columns: 1fr;
    }

    .large .resource-body {
      padding: 20px;
    }

    .large h3 {
      font-size: 1.8rem;
    }
  }
</style>
