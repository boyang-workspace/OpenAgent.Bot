---
import type { ResourceV1 } from "@/lib/content/resource-schema";
import { permissionSurface } from "@/lib/recommendations/stack-resolver";

type Props = {
  resource: ResourceV1;
};

const { resource } = Astro.props;
const deployment = resource.decision_signals.deployment_modes ?? [];
const permissions = permissionSurface(resource);
const trustItems = [
  resource.facts.last_verified_at ? `Verified ${resource.facts.last_verified_at.slice(0, 10)}` : "Verification date missing",
  resource.facts.license ? `License: ${resource.facts.license}` : "License needs source check",
  resource.facts.github_repo_full_name ? `Repo: ${resource.facts.github_repo_full_name}` : "No GitHub repo recorded",
  resource.decision_signals.open_source ? "Open-source signal" : "Open-source status needs review"
];
const decisionSignals = [
  resource.decision_signals.local_first ? "Local first" : undefined,
  resource.decision_signals.self_hostable ? "Self-hostable" : undefined,
  resource.decision_signals.supports_mcp ? "MCP" : undefined,
  resource.decision_signals.supports_docker ? "Docker" : undefined,
  resource.decision_signals.has_api ? "API" : undefined,
  resource.decision_signals.has_cli ? "CLI" : undefined,
  resource.decision_signals.has_gui ? "GUI" : undefined
].filter((value): value is string => Boolean(value));
const analyticsPayload = JSON.stringify({
  resource_slug: resource.slug,
  resource_category: resource.classification.primary_category,
  resource_type: resource.classification.resource_type
});
---

<section class="decision-panel" aria-labelledby="decision-title" data-analytics-view="decision_panel_view" data-analytics-payload={analyticsPayload}>
  <div class="decision-head">
    <div>
      <span>Decision brief</span>
      <h2 id="decision-title">Should you use {resource.identity.name}?</h2>
    </div>
    <a
      href={resource.machine_readable.json_url}
      data-analytics="resource_json"
      data-analytics-event="resource_json_click"
      data-analytics-payload={analyticsPayload}
    >
      JSON
    </a>
  </div>

  <div class="decision-grid">
    <article>
      <strong>Best for</strong>
      <ul>
        {(resource.positioning.best_for ?? ["Builders evaluating this category"]).slice(0, 4).map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article>
      <strong>Not for</strong>
      <ul>
        {(resource.positioning.not_for ?? ["Production adoption without checking source links, permissions, and maintenance."]).slice(0, 4).map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article>
      <strong>Trust and freshness</strong>
      <ul>
        {trustItems.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </div>

  <div class="signal-band">
    <div>
      <strong>Deployment</strong>
      <p>{deployment.length ? deployment.map((item) => item.replaceAll("_", " ")).join(", ") : "Check source"}</p>
    </div>
    <div>
      <strong>Permission surface</strong>
      <p>{permissions.length ? permissions.join(", ") : "Low explicit permission surface in metadata"}</p>
    </div>
    <div>
      <strong>Decision signals</strong>
      <p>{decisionSignals.length ? decisionSignals.join(", ") : "No extra signals recorded"}</p>
    </div>
  </div>
</section>

<style>
  .decision-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin: 24px auto 0;
    max-width: 1100px;
    padding: 18px;
  }

  .decision-head {
    align-items: start;
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding-bottom: 16px;
  }

  .decision-head span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .decision-head h2 {
    color: var(--ink);
    font-size: 1.32rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.2;
    margin: 5px 0 0;
  }

  .decision-head a {
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.75rem;
    padding: 8px 10px;
  }

  .decision-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 16px;
  }

  article {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px;
  }

  strong {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 580;
  }

  ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }

  li,
  p {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .signal-band {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 16px;
    padding-top: 16px;
  }

  .signal-band div {
    border-left: 1px solid var(--line);
    padding: 0 14px;
  }

  .signal-band div:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .signal-band p {
    margin: 6px 0 0;
  }

  @media (max-width: 840px) {
    .decision-grid,
    .signal-band {
      grid-template-columns: 1fr;
    }

    .signal-band div {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 12px 0 0;
    }

    .signal-band div:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
