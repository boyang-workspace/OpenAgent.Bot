---
import ResourceCard from "@/components/ResourceCard.astro";
import type { ResourceV1 } from "@/lib/content/resource-schema";
import type { ShowcaseArchetype, ShowcaseProfile } from "@/lib/content/showcase";

type Props = {
  resource: ResourceV1;
  profile: ShowcaseProfile;
};

const { resource, profile } = Astro.props;

const visualTracks: Record<ShowcaseArchetype, string[]> = {
  "platform-os": ["channels", "skills", "models", "sandbox"],
  "browser-automation": ["observe", "click", "type", "verify"],
  "coding-agent": ["read repo", "edit diff", "run checks", "handoff"],
  "agent-framework": ["state", "tools", "handoffs", "traces"],
  "design-agent": ["brief", "artifact", "system", "export"],
  "model-lab": ["prompts", "latency", "context", "license"],
  "vision-model": ["image", "layout", "ocr", "json"],
  "memory-graph": ["facts", "entities", "time", "recall"],
  "memory-personal": ["preference", "scope", "recall", "delete"],
  "skill-system": ["invoke", "procedure", "evidence", "ship"],
  "skill-library": ["choose", "adapt", "run", "reuse"],
  "evaluation-tool": ["case", "metric", "result", "regress"],
  "connector-tool": ["schema", "auth", "call", "log"]
};

const heroStyle = `--show-accent:${profile.theme.accent};--show-accent-2:${profile.theme.accent2};--show-accent-soft:${profile.theme.accentSoft};--show-ink:${profile.theme.ink};--show-tint:${profile.theme.heroTint};`;
const trackItems = visualTracks[profile.archetype];
const primaryAnalytics = profile.primaryCta
  ? JSON.stringify({ action: "showcase_primary_cta", name: resource.identity.name, slug: resource.slug, url: profile.primaryCta.url })
  : "";
const secondaryAnalytics = profile.secondaryCta
  ? JSON.stringify({ action: "showcase_secondary_cta", name: resource.identity.name, slug: resource.slug, url: profile.secondaryCta.url })
  : "";
const isCode = profile.heroVariant === "code";
const isBrand = profile.heroVariant === "brand";
const isStats = profile.heroVariant === "stats";
const hasCommand = profile.commandLines.length > 0;
const hasGettingStarted = profile.gettingStarted.length > 0;
const hasIntegrations = profile.integrations.length > 0;
const statItems = [
  profile.statsPromo.stars, profile.statsPromo.forks,
  profile.statsPromo.language, profile.statsPromo.license
].filter(Boolean);
---

<article class:list={["showcase-page", `archetype-${profile.archetype}`, `hero-${profile.heroVariant}`]} style={heroStyle}>
  <section class="showcase-hero" aria-labelledby="resource-title">
    <div class="hero-copy">
      <div class="product-identity">
        <img src={profile.image} alt="" loading="eager" decoding="async" onerror={`this.onerror=null;this.src='${profile.fallbackImage}';`} />
        <div>
          <span>{profile.categoryLabel}</span>
          <strong>{profile.archetypeLabel}</strong>
        </div>
      </div>

      <h1 id="resource-title">{profile.hero.headline}</h1>
      <p class="hero-deck">{profile.hero.deck}</p>
      <p class="hero-summary">{profile.hero.summary}</p>

      <div class="hero-actions">
        {profile.primaryCta && (
          <a class="button primary" href={profile.primaryCta.url} data-analytics="cta" data-analytics-payload={primaryAnalytics}>
            {profile.primaryCta.label === "Open repository" ? "View on GitHub" : profile.primaryCta.label}
          </a>
        )}
        {profile.secondaryCta && (
          <a class="button secondary" href={profile.secondaryCta.url} data-analytics="cta" data-analytics-payload={secondaryAnalytics}>
            {profile.secondaryCta.label}
          </a>
        )}
        <a class="button ghost" href="#sources" data-analytics="cta" data-analytics-payload={JSON.stringify({ action: "showcase_sources", name: resource.identity.name, slug: resource.slug })}>
          Sources
        </a>
      </div>
    </div>

    <aside class="hero-stage" aria-label={`${resource.identity.name} product signal`}>
      {isCode && (
        <div class="stage-terminal">
          <div class="term-header">
            <span></span><span></span><span></span>
            <span class="term-title">{profile.hero.visualTitle}</span>
          </div>
          <div class="term-body">
            {profile.commandLines.slice(0, 4).map((cmd) => (
              <div class="term-line">
                <span class="term-prompt">$</span>
                <code>{cmd}</code>
              </div>
            ))}
            {profile.commandLines.length === 0 && (
              <div class="term-line">
                <span class="term-prompt">$</span>
                <code># {profile.hero.visualTitle}</code>
              </div>
            )}
          </div>
        </div>
      )}
      {isBrand && (
        <div class="stage-canvas">
          <div class="brand-device">
            <div class="device-header">
              <span></span><span></span><span></span>
            </div>
            <div class="device-body">
              <div class="device-title">{profile.hero.headline}</div>
              <div class="device-line wide"></div>
              <div class="device-line"></div>
              <div class="device-grid">
                {trackItems.map((item, index) => (
                  <div class:list={["device-cell", { strong: index === 0 || index === 2 }]}>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="signal-rail">
            {trackItems.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>
      )}
      {isStats && (
        <div class="stage-stats">
          <div class="stats-header">
            <span>Key metrics</span>
          </div>
          <div class="stats-grid">
            {statItems.map((item) => {
              const [val, label] = item!.split(/\s(.+)/);
              return (
                <div class="stats-cell">
                  <strong>{val}</strong>
                  <span>{label ?? ""}</span>
                </div>
              );
            })}
            {statItems.length === 0 && (
              <>
                <div class="stats-cell"><strong>{profile.signals[0] ?? "Open source"}</strong><span>Signal</span></div>
                <div class="stats-cell"><strong>{resource.facts.license ?? "MIT"}</strong><span>License</span></div>
                <div class="stats-cell"><strong>{resource.facts.primary_language ?? "—"}</strong><span>Language</span></div>
                <div class="stats-cell"><strong>Available</strong><span>Status</span></div>
              </>
            )}
          </div>
        </div>
      )}
    </aside>
  </section>

  <section class="proof-strip" data-reveal aria-label={`${resource.identity.name} quick facts`}>
    <div>
      <span>OpenAgent view</span>
      <strong>{profile.hero.proposition}</strong>
    </div>
    <div>
      <span>First test</span>
      <strong>{profile.firstTest}</strong>
    </div>
  </section>

  <section class="meta-strip" data-reveal aria-label={`${resource.identity.name} signals and tags`}>
    <div>
      <span>Signals</span>
      <p>{profile.signals.length ? profile.signals.join(" · ") : "Source-backed profile"}</p>
    </div>
    <div>
      <span>Tags</span>
      <p>{profile.tags.length ? profile.tags.join(" · ") : profile.categoryLabel}</p>
    </div>
    <div>
      <span>Official presence</span>
      <p>{profile.officialHost ?? resource.facts.github_repo_full_name ?? "Official source links listed below"}</p>
    </div>
  </section>

  {hasCommand && (
    <section class="showcase-section cli-section" data-reveal id="cli">
      <div class="section-head">
        <h2>Quick start</h2>
        <p>Install and run {resource.identity.name} from the command line.</p>
      </div>
      <div class="cli-block">
        {profile.commandLines.slice(0, 5).map((cmd) => (
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <code>{cmd}</code>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="showcase-section intro-section" data-reveal id="overview">
    <div class="section-head">
      <h2>Independent product showcase</h2>
      <p>
        OpenAgent.bot turns official project sources into a practical product page: what it is, why it matters, how to test it, and where to verify the facts.
      </p>
    </div>
    <div class="intro-grid">
      <article class="lead-block">
        <h3>Product lens</h3>
        <p>{profile.lens}</p>
      </article>
      {profile.pillars.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {item.note && <small>{item.note}</small>}
        </article>
      ))}
    </div>
  </section>

  {hasGettingStarted && (
    <section class="showcase-section getting-started-section" data-reveal id="getting-started">
      <div class="section-head">
        <h2>Getting started</h2>
        <p>Jump directly to the resources that help you start using {resource.identity.name}.</p>
      </div>
      <div class="start-grid">
        {profile.gettingStarted.map((gs) => (
          <a class="start-card" href={gs.url}>
            <strong>{gs.label}</strong>
            <span>Open →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {hasIntegrations && (
    <section class="showcase-section integrations-section" data-reveal id="integrations">
      <div class="section-head">
        <h2>Works with</h2>
        <p>{resource.identity.name} integrates with the following tools and platforms.</p>
      </div>
      <div class="integration-strip">
        {profile.integrations.map((name) => (
          <span class="integration-chip">{name}</span>
        ))}
      </div>
    </section>
  )}

  <section class="showcase-section workflow-section" data-reveal id="workflow">
    <div class="section-head">
      <h2>How to understand {resource.identity.name}</h2>
      <p>Start from the workflow shape, then inspect official evidence before installing or adopting it.</p>
    </div>
    <div class="workflow-grid">
      {profile.workflow.map((item, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="showcase-section evaluation-section" data-reveal id="evaluation">
    <div class="section-head">
      <h2>What to inspect before using it</h2>
      <p>These checks change by product type, so a browser agent, model, memory system, and skill stack are not evaluated the same way.</p>
    </div>
    <div class="evaluation-grid">
      {profile.evaluation.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {item.note && <small>{item.note}</small>}
        </article>
      ))}
    </div>
  </section>

  <section class="showcase-section evidence-section" data-reveal id="sources">
    <div class="source-column">
      <div class="section-head">
        <h2>Official sources</h2>
        <p>Use these links as the canonical starting point. OpenAgent.bot summarizes them but does not replace the project's own repository, docs, or website.</p>
      </div>
      <div class="source-list">
        {profile.sourceLinks.map((link) => (
          <a href={link.url} data-analytics="cta" data-analytics-payload={JSON.stringify({ action: "showcase_source", name: resource.identity.name, slug: resource.slug, type: link.type, label: link.label })}>
            <span>{link.type.replaceAll("_", " ")}</span>
            <strong>{link.label}</strong>
          </a>
        ))}
      </div>
    </div>
    <aside class="fact-column">
      <h2>Source-backed facts</h2>
      <dl>
        {profile.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <div class="structured-links">
        <a href={resource.machine_readable.json_url.replace("https://www.openagent.bot", "")}>JSON profile</a>
        <a href={resource.machine_readable.markdown_url.replace("https://www.openagent.bot", "")}>Markdown profile</a>
      </div>
    </aside>
  </section>

  <section class="showcase-section compare-section" data-reveal id="compare">
    <div class="section-head">
      <h2>How it compares</h2>
      <p>Use this as a practical adoption frame, then compare nearby resources before choosing a stack.</p>
    </div>
    <div class="compare-grid">
      {profile.compare.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  {profile.faq.length > 0 && (
    <section class="showcase-section faq-section" data-reveal id="faq">
      <div class="section-head">
        <h2>Adoption questions</h2>
        <p>Short answers for readers landing from search who need to decide whether to inspect the official project.</p>
      </div>
      <div class="faq-list">
        {profile.faq.map((item) => (
          <details>
            <summary>{item.title}</summary>
            <p>{item.body}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {profile.pairings.length > 0 && (
    <section class="showcase-section pairings-section" data-reveal id="skills">
      <div class="section-head">
        <h2>Skills that pair well with {resource.identity.name}</h2>
        <p>Agent pages can become more useful when they show the reusable skills that help the agent operate safely and repeatably.</p>
      </div>
      <div class="pairing-grid">
        {profile.pairings.map((pairing) => (
          <a href={pairing.href}>
            <span>{pairing.label}</span>
            <strong>{pairing.name}</strong>
            <p>{pairing.reason}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {profile.related.length > 0 && (
    <section class="showcase-section related-section" data-reveal id="related">
      <div class="section-head">
        <h2>Related resources</h2>
        <p>Compare adjacent products by workflow fit, source quality, license, and operational boundary.</p>
      </div>
      <div class="related-grid">
        {profile.related.map((item) => <ResourceCard resource={item} />)}
      </div>
    </section>
  )}
</article>

<script>
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
    );
    document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("revealed"));
  }
</script>

<style>
  .showcase-page {
    color: var(--ink);
    display: grid;
    gap: 24px;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Hero ── */

  .showcase-hero {
    background:
      linear-gradient(120deg, var(--show-tint), #ffffff 54%),
      var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(0, 1fr) minmax(330px, 0.72fr);
    overflow: hidden;
    padding: 30px;
    position: relative;
  }

  .showcase-hero::before {
    background: var(--show-accent);
    content: "";
    height: 3px;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
  }

  .hero-copy {
    align-content: center;
    display: grid;
    min-height: 430px;
  }

  .product-identity {
    align-items: center;
    display: flex;
    gap: 12px;
    margin-bottom: 26px;
  }

  .product-identity img {
    background: #ffffff;
    border: 1px solid rgba(22, 26, 29, 0.08);
    border-radius: 22%;
    box-shadow: 0 8px 18px rgba(22, 26, 29, 0.08);
    height: 64px;
    object-fit: contain;
    width: 64px;
  }

  .product-identity div {
    display: grid;
    gap: 4px;
  }

  .product-identity span {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .product-identity strong {
    color: var(--show-ink);
    font-size: 0.88rem;
    font-weight: 560;
  }

  h1 {
    color: var(--show-ink);
    font-size: clamp(2.35rem, 5.6vw, 4.7rem);
    font-weight: 560;
    letter-spacing: 0;
    line-height: 0.94;
    margin: 0;
    max-width: 900px;
  }

  .hero-deck {
    color: var(--show-ink);
    font-size: clamp(1.02rem, 1.55vw, 1.22rem);
    line-height: 1.48;
    margin: 22px 0 0;
    max-width: 760px;
  }

  .hero-summary {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 14px 0 0;
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .hero-actions .button.primary {
    background: var(--show-ink);
    border-color: var(--show-ink);
  }

  .hero-actions .button.primary:hover {
    background: var(--show-accent);
    border-color: var(--show-accent);
  }

  .hero-actions .button.ghost {
    background: transparent;
    border-color: transparent;
    color: var(--muted);
  }

  .hero-stage {
    align-self: center;
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid rgba(22, 26, 29, 0.08);
    border-radius: 8px;
    box-shadow: 0 22px 70px rgba(22, 26, 29, 0.08);
    min-height: 390px;
    overflow: hidden;
  }

  /* ── Stage: Code (terminal) ── */

  .stage-terminal {
    display: grid;
    height: 100%;
    min-height: inherit;
  }

  .term-header {
    align-items: center;
    background: #1e1e1e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    gap: 7px;
    padding: 12px 14px;
  }

  .term-header span {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    height: 9px;
    width: 9px;
  }

  .term-title {
    color: rgba(255, 255, 255, 0.45) !important;
    font-family: var(--mono);
    font-size: 0.7rem;
    margin-left: auto;
  }

  .term-body {
    background: #1e1e1e;
    display: grid;
    gap: 8px;
    padding: 18px 16px;
  }

  .term-line {
    align-items: baseline;
    display: flex;
    gap: 10px;
  }

  .term-prompt {
    color: #4ade80;
    font-family: var(--mono);
    font-size: 0.82rem;
    flex-shrink: 0;
  }

  .term-line code {
    color: #e2e8f0;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  /* ── Stage: Brand (device mockup) ── */

  .stage-canvas {
    display: grid;
    gap: 14px;
    padding: 18px;
  }

  .brand-device {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .device-header {
    align-items: center;
    background: var(--show-accent-soft);
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 6px;
    padding: 10px 12px;
  }

  .device-header span {
    background: rgba(22, 26, 29, 0.2);
    border-radius: 50%;
    height: 8px;
    width: 8px;
  }

  .device-body {
    display: grid;
    gap: 12px;
    padding: 16px;
  }

  .device-title {
    color: var(--show-ink);
    font-size: 1rem;
    font-weight: 620;
  }

  .device-line {
    background: var(--line);
    border-radius: 999px;
    height: 7px;
    width: 62%;
  }

  .device-line.wide {
    background: color-mix(in srgb, var(--show-accent) 26%, var(--line));
    width: 86%;
  }

  .device-grid {
    display: grid;
    gap: 9px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2px;
  }

  .device-cell {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 10px;
    min-height: 92px;
    padding: 12px;
  }

  .device-cell.strong {
    background: linear-gradient(135deg, var(--show-accent-soft), #ffffff);
    border-color: color-mix(in srgb, var(--show-accent) 28%, var(--line));
  }

  .device-cell span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.64rem;
  }

  .device-cell strong {
    align-self: end;
    color: var(--show-ink);
    font-size: 0.92rem;
    font-weight: 560;
    line-height: 1.22;
  }

  .signal-rail {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .signal-rail span {
    border: 1px solid color-mix(in srgb, var(--show-accent) 28%, var(--line));
    border-radius: 999px;
    color: var(--show-ink);
    font-size: 0.68rem;
    line-height: 1;
    overflow: hidden;
    padding: 8px 7px;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Stage: Stats ── */

  .stage-stats {
    display: grid;
    height: 100%;
    min-height: inherit;
  }

  .stats-header {
    border-bottom: 1px solid var(--line);
    padding: 13px 15px;
  }

  .stats-header span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stats-grid {
    align-content: center;
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr 1fr;
    min-height: 300px;
  }

  .stats-cell {
    align-items: center;
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
    padding: 18px 10px;
    text-align: center;
  }

  .stats-cell:nth-child(even) {
    border-right: 0;
  }

  .stats-cell:nth-last-child(-n+2) {
    border-bottom: 0;
  }

  .stats-cell strong {
    color: var(--show-ink);
    font-size: 1.1rem;
    font-weight: 620;
    line-height: 1.2;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stats-cell span {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: capitalize;
  }

  /* ── Archetype overrides ── */

  .archetype-coding-agent .stage-canvas,
  .archetype-skill-system .stage-canvas,
  .archetype-skill-library .stage-canvas {
    background:
      linear-gradient(90deg, rgba(22, 26, 29, 0.035) 1px, transparent 1px),
      linear-gradient(0deg, rgba(22, 26, 29, 0.035) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  .archetype-browser-automation .brand-device {
