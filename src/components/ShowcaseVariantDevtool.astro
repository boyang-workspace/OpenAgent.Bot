---
import type { ResourceV1 } from "@/lib/content/resource-schema";
import type { ShowcaseProfile } from "@/lib/content/showcase";

type Props = {
  resource: ResourceV1;
  profile: ShowcaseProfile;
};

const { resource, profile } = Astro.props;
const t = profile.theme;
const strengths = resource.editorial?.core_strengths ?? [];
const useCases = resource.editorial?.use_case_notes ?? [];
const cmds = profile.commandLines;
const integrations = profile.integrations;
const signals = profile.signals;
const tags = resource.tags;
const allTags = [...(tags.category ?? []), ...(tags.capability ?? []), ...(tags.constraint ?? [])].slice(0, 8);
---

<section class="d-hero">
  <nav class="d-nav">
    <a href="/" class="d-logo">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none"><rect width="26" height="26" rx="5" fill={t.accent}/><text x="13" y="18" text-anchor="middle" fill="#fff" font-size="13" font-weight="700" font-family="system-ui">OA</text></svg>
      <span>OpenAgent.bot</span>
    </a>
    <a href={`/${resource.classification.primary_category}`} class="d-nav-link">← {profile.categoryLabel}</a>
  </nav>

  <div class="d-hero-split">
    <div class="d-hero-left">
      <div class="d-badge">{resource.facts.license} · {profile.categoryLabel}</div>
      <h1 class="d-title">{resource.identity.name}</h1>
      <p class="d-sub">{resource.identity.one_liner}</p>
      <div class="d-hero-actions">
        {profile.primaryCta && <a class="d-btn d-btn-primary" href={profile.primaryCta.url}><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg> GitHub</a>}
        {profile.secondaryCta && <a class="d-btn d-btn-secondary" href={profile.secondaryCta.url}>{profile.secondaryCta.label}</a>}
      </div>
      <div class="d-hero-stats">
        {resource.facts.github_stars && <span><strong>{(resource.facts.github_stars / 1000).toFixed(resource.facts.github_stars >= 10000 ? 0 : 1)}K</strong> stars</span>}
        {resource.facts.github_forks && <span><strong>{(resource.facts.github_forks / 1000).toFixed(1)}K</strong> forks</span>}
        {resource.facts.primary_language && <span><strong>{resource.facts.primary_language}</strong> language</span>}
        {resource.facts.license && <span><strong>{resource.facts.license}</strong> license</span>}
      </div>
    </div>
    <div class="d-hero-right">
      <div class="d-terminal">
        <div class="d-term-bar">
          <span></span><span></span><span></span>
          <span class="d-term-flag">bash</span>
        </div>
        <div class="d-term-body">
          {cmds.length > 0 ? cmds.slice(0, 3).map((cmd) => (
            <div class="d-term-line"><span class="d-term-pr">$</span><code>{cmd}</code></div>
          )) : (
            <>
              <div class="d-term-line"><span class="d-term-pr">$</span><code class="d-term-cm"># {resource.identity.name}</code></div>
              <div class="d-term-line"><span class="d-term-pr">$</span><code>pip install {resource.slug.replaceAll("_", "-")}</code></div>
              <div class="d-term-line"><span class="d-term-pr">$</span><code>npx {resource.slug} --help</code></div>
            </>
          )}
          <div class="d-term-dots">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>
      <div class="d-signals">
        {signals.slice(0, 4).map((s) => (
          <span class="d-signal-chip">{s}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="d-section d-section-dark">
  <div class="d-section-inner">
    <div class="d-section-head">
      <span class="d-eyebrow">Overview</span>
      <h2>What is {resource.identity.name}?</h2>
      <p>{resource.identity.short_description ?? resource.identity.one_liner}</p>
    </div>
    {strengths.length > 0 && (
      <div class="d-grid-3">
        {strengths.map((s) => (
          <div class="d-card">
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            {s.why_it_matters && <small>{s.why_it_matters}</small>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>

{cmds.length > 0 && (
  <section class="d-section d-section-white">
    <div class="d-section-inner">
      <div class="d-section-head">
        <span class="d-eyebrow">Install</span>
        <h2>One command to start</h2>
      </div>
      <div class="d-code-block">
        <div class="d-copy-line">
          <span class="d-copy-prompt">$</span>
          <code>{cmds[0]}</code>
        </div>
      </div>
      {cmds.slice(1).length > 0 && (
        <div class="d-code-block" style="margin-top:12px">
          {cmds.slice(1).map((cmd) => (
            <div class="d-copy-line"><span class="d-copy-prompt">$</span><code>{cmd}</code></div>
          ))}
        </div>
      )}
    </div>
  </section>
)}

{useCases.length > 0 && (
  <section class="d-section d-section-gray">
    <div class="d-section-inner">
      <div class="d-section-head">
        <span class="d-eyebrow">Use cases</span>
        <h2>What teams use it for</h2>
      </div>
      <div class="d-grid-3">
        {useCases.map((uc) => (
          <div class="d-card d-card-icon">
            <h3>{uc.title}</h3>
            <p>{uc.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{allTags.length > 0 && (
  <section class="d-section d-section-white">
    <div class="d-section-inner">
      <div class="d-section-head">
        <span class="d-eyebrow">Ecosystem</span>
        <h2>Tags & capabilities</h2>
      </div>
      <div class="d-tags">
        {allTags.map((tag) => <span class="d-tag">{tag.replaceAll("-", " ")}</span>)}
      </div>
      {integrations.length > 0 && (
        <>
          <div style="margin-top:24px">
            <span class="d-eyebrow" style="color:var(--muted)">Integrations</span>
          </div>
          <div class="d-tags" style="margin-top:12px">
            {integrations.map((name) => <span class="d-tag d-tag-int">{name}</span>)}
          </div>
        </>
      )}
    </div>
  </section>
)}

<section class="d-section d-section-dark" style="padding:20px 0">
  <div class="d-section-inner" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
    <span style="color:rgba(255,255,255,0.55);font-size:0.8rem">OpenAgent.bot — independent product showcase</span>
    <div style="display:flex;gap:12px">
      <a href={resource.machine_readable.json_url} style="color:rgba(255,255,255,0.6);font-size:0.8rem">JSON</a>
      <a href={`/${resource.classification.primary_category}`} style="color:rgba(255,255,255,0.6);font-size:0.8rem">Directory</a>
    </div>
  </div>
</section>

<style>
  .d-hero {
    background: linear-gradient(135deg, {t.heroTint} 0%, #ffffff 60%);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    position: relative;
  }

  .d-hero::before {
    background: {t.accent};
    content: "";
    height: 3px;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    z-index: 1;
  }

  .d-hero::after {
    background: radial-gradient(ellipse 500px 250px at 30% 0%, {t.accentSoft} 0%, transparent 60%);
    content: "";
    inset: 0;
    opacity: 0.6;
    position: absolute;
  }

  .d-nav {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 14px 32px;
  }

  .d-logo { align-items: center; display: flex; gap: 8px; text-decoration: none; }
  .d-logo span { color: var(--ink); font-size: 0.85rem; font-weight: 560; }
  .d-nav-link { color: var(--muted); font-size: 0.82rem; text-decoration: none; }
  .d-nav-link:hover { color: var(--ink); }

  .d-hero-split {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr 1fr;
    margin: 0 auto;
    max-width: 1100px;
    padding: 50px 32px 60px;
  }

  .d-hero-left { display: grid; gap: 18px; align-content: center; }

  .d-badge {
    color: {t.accent};
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .d-title {
    color: {t.ink};
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }

  .d-sub {
    color: var(--muted);
    font-size: clamp(0.95rem, 1.4vw, 1.12rem);
    line-height: 1.5;
    margin: 0;
    max-width: 520px;
  }

  .d-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .d-btn { border-radius: 7px; font-size: 0.9rem; font-weight: 540; padding: 10px 22px; text-decoration: none; transition: all 0.2s; }
  .d-btn-primary { background: {t.ink}; color: #fff; display: inline-flex; align-items: center; gap: 6px; }
  .d-btn-primary:hover { background: {t.accent}; transform: translateY(-1px); }
  .d-btn-secondary { background: transparent; border: 1px solid var(--line-strong); color: var(--ink); }
  .d-btn-secondary:hover { background: var(--surface-soft); }

  .d-hero-stats { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 6px; }
  .d-hero-stats span { color: var(--muted); font-size: 0.82rem; }
  .d-hero-stats strong { color: var(--ink); font-weight: 580; }

  .d-hero-right { display: grid; gap: 16px; }

  .d-terminal {
    background: #1e1e1e;
    border-radius: 10px;
    box-shadow: 0 20px 60px rgba(22, 26, 29, 0.12);
    overflow: hidden;
  }

  .d-term-bar {
    align-items: center;
    background: #2d2d2d;
    display: flex;
    gap: 6px;
    padding: 11px 13px;
  }

  .d-term-bar span {
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    height: 8px;
    width: 8px;
  }

  .d-term-flag {
    color: rgba(255,255,255,0.5);
    font-family: var(--mono);
    font-size: 0.65rem;
    margin-left: auto;
  }

  .d-term-body { display: grid; gap: 8px; padding: 18px 14px; }

  .d-term-line { align-items: baseline; display: flex; gap: 8px; }

  .d-term-pr { color: #4ade80; flex-shrink: 0; font-family: var(--mono); font-size: 0.85rem; }

  .d-term-line code { color: #e2e8f0; font-family: var(--mono); font-size: 0.82rem; }

  .d-term-cm { color: rgba(255,255,255,0.45) !important; }

  .d-term-dots { display: flex; gap: 4px; margin-top: 4px; }

  .d-term-dots span {
    animation: d-pulse 1.4s infinite both;
    background: rgba(255,255,255,0.25);
    border-radius: 50%;
    height: 4px;
    width: 4px;
  }

  .d-term-dots span:nth-child(2) { animation-delay: 0.2s; }
  .d-term-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes d-pulse { 0%,80%,100% { opacity: 0.3; } 40% { opacity: 1; } }

  .d-signals { display: flex; flex-wrap: wrap; gap: 6px; }

  .d-signal-chip {
    border: 1px solid {t.accent}44;
    border-radius: 999px;
    color: {t.accent};
    font-size: 0.72rem;
    font-weight: 500;
    padding: 5px 12px;
  }

  .d-section { padding: 56px 0; }
  .d-section-dark { background: #1a1d23; }
  .d-section-white { background: #fff; }
  .d-section-gray { background: var(--paper); }

  .d-section-inner { margin: 0 auto; max-width: 1080px; padding: 0 32px; }

  .d-section-head { display: grid; gap: 10px; margin-bottom: 32px; max-width: 660px; }
  .d-section-head h2 { font-size: 1.8rem; font-weight: 590; letter-spacing: -0.01em; line-height: 1.15; margin: 0; }
  .d-section-dark .d-section-head h2 { color: #fff; }
  .d-section-dark .d-section-head p { color: rgba(255,255,255,0.7); }
  .d-section-head p { color: var(--muted); font-size: 0.95rem; line-height: 1.55; margin: 0; }

  .d-eyebrow {
    color: {t.accent};
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .d-grid-3 { display: grid; gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .d-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 8px;
    padding: 20px;
  }

  .d-section-dark .d-card {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.08);
  }

  .d-section-dark .d-card h3 { color: #fff; }
  .d-section-dark .d-card p { color: rgba(255,255,255,0.68); }
  .d-section-dark .d-card small { color: rgba(255,255,255,0.45); }

  .d-card h3 { font-size: 1rem; font-weight: 580; margin: 0; }
  .d-card p { color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0; }
  .d-card small { color: var(--subtle); font-size: 0.75rem; }

  .d-card-icon h3::before { content: "→ "; color: {t.accent}; }

  .d-code-block {
    background: #1e1e1e;
    border-radius: 8px;
    display: grid;
    gap: 8px;
    padding: 16px;
  }
  .d-copy-line { align-items: baseline; display: flex; gap: 8px; }
  .d-copy-prompt { color: #4ade80; flex-shrink: 0; font-family: var(--mono); font-size: 0.85rem; }
  .d-copy-line code { color: #e2e8f0; font-family: var(--mono); font-size: 0.85rem; overflow-wrap: anywhere; }

  .d-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .d-tag {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
    padding: 6px 14px;
  }
  .d-tag-int { background: {t.accentSoft}; border-color: {t.accent}33; color: {t.accent}; }

  @media (max-width: 800px) {
    .d-hero-split { grid-template-columns: 1fr; padding: 30px 20px 40px; }
    .d-nav { padding: 12px 16px; }
    .d-grid-3 { grid-template-columns: 1fr; }
    .d-section-inner { padding: 0 20px; }
    .d-section { padding: 40px 0; }
  }
</style>
