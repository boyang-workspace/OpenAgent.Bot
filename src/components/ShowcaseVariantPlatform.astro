---
import type { ResourceV1 } from "@/lib/content/resource-schema";
import type { ShowcaseProfile } from "@/lib/content/showcase";

type Props = {
  resource: ResourceV1;
  profile: ShowcaseProfile;
};

const { resource, profile } = Astro.props;
const t = profile.theme;
const strengths = resource.editorial?.core_strengths ?? [];
const useCases = resource.editorial?.use_case_notes ?? [];
const compareNotes = resource.editorial?.compare_notes ?? [];
const faqs = profile.faq;
const cmds = profile.commandLines;
const stats = [
  { label: "Stars", value: resource.facts.github_stars, fmt: (n: number) => `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}K` },
  { label: "Forks", value: resource.facts.github_forks, fmt: (n: number) => `${(n / 1000).toFixed(1)}K` },
  { label: "License", value: resource.facts.license },
  { label: "Language", value: resource.facts.primary_language },
  { label: "Maintainer", value: resource.facts.github_repo_full_name?.split("/")[0] },
].filter((s) => s.value);
---

<section class="v-hero">
  <nav class="v-nav">
    <a href="/" class="v-logo">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect width="28" height="28" rx="6" fill={t.accent}/><text x="14" y="19" text-anchor="middle" fill="#fff" font-size="14" font-weight="700" font-family="system-ui">OA</text></svg>
      <span>OpenAgent.bot / <em>{resource.identity.name}</em></span>
    </a>
    <div class="v-nav-links">
      <a href={`/${resource.classification.primary_category}`}>Directory</a>
    </div>
  </nav>

  <div class="v-hero-inner">
    <div class="v-hero-badge">{profile.categoryLabel}</div>
    <h1 class="v-hero-title">{resource.identity.name}</h1>
    <p class="v-hero-sub">{resource.identity.one_liner}</p>
    <div class="v-hero-actions">
      {profile.primaryCta && <a class="v-btn v-btn-primary" href={profile.primaryCta.url}>{profile.primaryCta.label}</a>}
      {profile.secondaryCta && <a class="v-btn v-btn-secondary" href={profile.secondaryCta.url}>{profile.secondaryCta.label}</a>}
    </div>
  </div>

  <div class="v-hero-stats">
    {stats.map((s) => (
      <div class="v-stat">
        <strong>{s.fmt ? s.fmt(Number(s.value)) : s.value}</strong>
        <span>{s.label}</span>
      </div>
    ))}
  </div>
</section>

<section class="v-section v-section-light">
  <div class="v-section-inner">
    <div class="v-section-head">
      <span class="v-eyebrow">Overview</span>
      <h2>What is {resource.identity.name}?</h2>
      <p class="v-desc">{resource.identity.short_description ?? resource.identity.one_liner}</p>
    </div>
    {strengths.length > 0 && (
      <div class="v-strengths">
        {strengths.map((s) => (
          <div class="v-strength-card" style={`--card-accent:${t.accent}`}>
            <div class="v-strength-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={t.accent} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            </div>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            {s.why_it_matters && <small>{s.why_it_matters}</small>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>

{useCases.length > 0 && (
  <section class="v-section v-section-alt">
    <div class="v-section-inner">
      <div class="v-section-head">
        <span class="v-eyebrow">Use cases</span>
        <h2>What {resource.identity.name} is built for</h2>
      </div>
      <div class="v-steps">
        {useCases.map((uc, i) => (
          <div class="v-step">
            <div class="v-step-num" style={`background:${t.accent}`}>{String(i + 1).padStart(2, "0")}</div>
            <div>
              <h3>{uc.title}</h3>
              <p>{uc.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{cmds.length > 0 && (
  <section class="v-section v-section-dark">
    <div class="v-section-inner">
      <div class="v-section-head">
        <span class="v-eyebrow v-eyebrow-light">Quick start</span>
        <h2 style="color:#fff">Get started in seconds</h2>
      </div>
      <div class="v-terminal">
        <div class="v-term-bar">
          <span></span><span></span><span></span>
          <span class="v-term-title">terminal</span>
        </div>
        <div class="v-term-body">
          {cmds.map((cmd) => (
            <div class="v-term-line">
              <span class="v-term-prompt">$</span>
              <code>{cmd}</code>
            </div>
          ))}
        </div>
      </div>
      {profile.gettingStarted.length > 0 && (
        <div class="v-quick-links">
          {profile.gettingStarted.map((gs) => (
            <a class="v-link-card" href={gs.url}>
              <strong>{gs.label}</strong>
              <span>→</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
)}

{compareNotes.length > 0 && (
  <section class="v-section v-section-light">
    <div class="v-section-inner">
      <div class="v-section-head">
        <span class="v-eyebrow">Comparison</span>
        <h2>How it stacks up</h2>
      </div>
      <div class="v-compare">
        {compareNotes.map((c) => (
          <div class="v-compare-card">
            <h3>{c.against ? `${c.title}` : c.title}</h3>
            {c.against && <span class="v-compare-vs">vs <strong>{c.against}</strong></span>}
            <p>{c.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{faqs.length > 0 && (
  <section class="v-section v-section-alt">
    <div class="v-section-inner">
      <div class="v-section-head">
        <span class="v-eyebrow">FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="v-faqs">
        {faqs.map((faq) => (
          <details class="v-faq">
            <summary>{faq.title}</summary>
            <p>{faq.body}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<section class="v-section v-section-dark" style="padding:20px 0">
  <div class="v-section-inner" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
    <span style="color:rgba(255,255,255,0.5);font-size:0.82rem">OpenAgent.bot — independent product showcase</span>
    <div style="display:flex;gap:12px">
      <a href={resource.machine_readable.json_url} style="color:rgba(255,255,255,0.6);font-size:0.82rem">JSON</a>
      <a href={resource.machine_readable.markdown_url} style="color:rgba(255,255,255,0.6);font-size:0.82rem">Markdown</a>
      <a href={`/${resource.classification.primary_category}`} style="color:rgba(255,255,255,0.6);font-size:0.82rem">Directory</a>
    </div>
  </div>
</section>

<style>
  .v-hero {
    background: linear-gradient(135deg, {t.heroTint} 0%, #ffffff 70%);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 0;
    overflow: hidden;
    position: relative;
  }

  .v-hero::before {
    background: {t.accent};
    content: "";
    height: 4px;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
  }

  .v-nav {
    align-items: center;
    display: flex;
    gap: 12px;
    justify-content: space-between;
    padding: 16px 32px;
  }

  .v-nav a { color: var(--muted); font-size: 0.85rem; }
  .v-logo { align-items: center; display: flex; gap: 10px; text-decoration: none; }
  .v-logo span { color: var(--ink); font-size: 0.88rem; font-weight: 560; }
  .v-logo em { color: var(--muted); font-style: normal; font-weight: 400; }
  .v-nav-links { display: flex; gap: 16px; }

  .v-hero-inner {
    display: grid;
    gap: 24px;
    margin: 0 auto;
    max-width: 960px;
    padding: 60px 32px 40px;
    text-align: center;
  }

  .v-hero-badge {
    background: {t.accentSoft};
    border-radius: 999px;
    color: {t.accent};
    font-size: 0.78rem;
    font-weight: 600;
    justify-self: center;
    padding: 6px 16px;
  }

  .v-hero-title {
    color: {t.ink};
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 0.92;
    margin: 0;
  }

  .v-hero-sub {
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.5;
    margin: 0 auto;
    max-width: 700px;
  }

  .v-hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }

  .v-btn {
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 560;
    padding: 12px 28px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .v-btn-primary {
    background: {t.ink};
    color: #fff;
  }
  .v-btn-primary:hover { background: {t.accent}; transform: translateY(-1px); }

  .v-btn-secondary {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .v-btn-secondary:hover { background: var(--surface-soft); border-color: {t.accent}; color: {t.accent}; }

  .v-hero-stats {
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    margin-top: 0;
  }

  .v-stat {
    border-left: 1px solid var(--line);
    display: grid;
    gap: 4px;
    padding: 20px;
    text-align: center;
  }

  .v-stat:first-child { border-left: 0; }
  .v-stat strong { color: {t.ink}; font-size: 1.25rem; font-weight: 620; }
  .v-stat span { color: var(--muted); font-size: 0.8rem; }

  .v-section { padding: 64px 0; }
  .v-section-light { background: #ffffff; }
  .v-section-alt { background: var(--paper); }
  .v-section-dark { background: #1a1d23; }

  .v-section-inner {
    margin: 0 auto;
    max-width: 1080px;
    padding: 0 32px;
  }

  .v-section-head {
    display: grid;
    gap: 12px;
    margin-bottom: 40px;
    max-width: 700px;
  }

  .v-section-head h2 {
    font-size: 2.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.12;
    margin: 0;
  }

  .v-section-dark .v-section-head h2 { color: #fff; }

  .v-desc { color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0; }

  .v-eyebrow {
    color: {t.accent};
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .v-eyebrow-light { color: rgba(255,255,255,0.5); }

  .v-strengths {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .v-strength-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--card-accent);
    border-radius: 8px;
    display: grid;
    gap: 10px;
    padding: 24px;
  }

  .v-strength-icon { margin-bottom: 4px; }

  .v-strength-card h3 { font-size: 1.08rem; font-weight: 590; margin: 0; }
  .v-strength-card p { color: var(--muted); font-size: 0.88rem; line-height: 1.55; margin: 0; }
  .v-strength-card small { color: var(--subtle); font-size: 0.78rem; }

  .v-steps { display: grid; gap: 0; }

  .v-step {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 16px;
    grid-template-columns: 44px 1fr;
    padding: 24px 0;
  }

  .v-step:first-child { border-top: 0; }

  .v-step-num {
    border-radius: 8px;
    color: #fff;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    height: 36px;
    line-height: 36px;
    text-align: center;
    width: 36px;
  }

  .v-step h3 { font-size: 1.05rem; font-weight: 580; margin: 0 0 6px; }
  .v-step p { color: var(--muted); font-size: 0.88rem; line-height: 1.55; margin: 0; }

  .v-terminal {
    background: #1e1e1e;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    overflow: hidden;
  }

  .v-term-bar {
    align-items: center;
    background: #2d2d2d;
    display: flex;
    gap: 7px;
    padding: 12px 14px;
  }

  .v-term-bar span {
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    height: 9px;
    width: 9px;
  }

  .v-term-title {
    color: rgba(255,255,255,0.3);
    font-family: var(--mono);
    font-size: 0.7rem;
    margin-left: auto;
  }

  .v-term-body { display: grid; gap: 10px; padding: 20px 16px; }

  .v-term-line { align-items: baseline; display: flex; gap: 10px; }
  .v-term-prompt { color: #4ade80; flex-shrink: 0; font-family: var(--mono); font-size: 0.9rem; }
  .v-term-line code { color: #e2e8f0; font-family: var(--mono); font-size: 0.9rem; overflow-wrap: anywhere; }

  .v-quick-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }

  .v-link-card {
    align-items: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    display: flex;
    gap: 12px;
    padding: 12px 18px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .v-link-card:hover { background: rgba(255,255,255,0.12); }
  .v-link-card strong { color: #fff; font-weight: 520; font-size: 0.9rem; }
  .v-link-card span { color: rgba(255,255,255,0.4); }

  .v-compare { display: grid; gap: 16px; }

  .v-compare-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 8px;
    padding: 20px;
  }

  .v-compare-card h3 { font-size: 1rem; font-weight: 580; margin: 0; }
  .v-compare-vs { color: var(--muted); font-size: 0.82rem; }
  .v-compare-vs strong { color: var(--ink); font-weight: 560; }
  .v-compare-card p { color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0; }

  .v-faqs { display: grid; gap: 10px; }

  .v-faq {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 16px 18px;
  }

  .v-faq summary {
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 560;
    line-height: 1.35;
  }

  .v-faq p {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 10px 0 0;
  }

  @media (max-width: 720px) {
    .v-nav { padding: 12px 16px; flex-direction: column; gap: 8px; }
    .v-hero-inner { padding: 40px 20px 30px; }
    .v-section-inner { padding: 0 20px; }
    .v-section { padding: 40px 0; }
    .v-section-head h2 { font-size: 1.6rem; }
    .v-step { grid-template-columns: 1fr; }
    .v-strengths { grid-template-columns: 1fr; }
    .v-hero-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
