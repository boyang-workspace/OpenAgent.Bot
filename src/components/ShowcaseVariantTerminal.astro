---
import type { ResourceV1 } from "@/lib/content/resource-schema";
import type { ShowcaseProfile } from "@/lib/content/showcase";

type Props = {
  resource: ResourceV1;
  profile: ShowcaseProfile;
};

const { resource, profile } = Astro.props;
const strengths = resource.editorial?.core_strengths ?? [];
const useCases = resource.editorial?.use_case_notes ?? [];
const compareNotes = resource.editorial?.compare_notes ?? [];
const faqs = profile.faq;
const cmds = profile.commandLines;
const gettingStarted = profile.gettingStarted;
const installCmd = cmds[0] ?? `pip install ${resource.slug.replaceAll("_", "-")}`;
const runCmd = cmds[1] ?? `${resource.slug} --help`;
const stats = [
  { label: "Stars", value: resource.facts.github_stars ? `${(resource.facts.github_stars / 1000).toFixed(resource.facts.github_stars >= 10000 ? 0 : 1)}K` : null },
  { label: "Forks", value: resource.facts.github_forks ? `${(resource.facts.github_forks / 1000).toFixed(1)}K` : null },
  { label: "License", value: resource.facts.license },
  { label: "Language", value: resource.facts.primary_language },
].filter((s) => s.value);
const statStr = stats.map((s) => `${s.value} ${s.label}`).join(" · ");
---

<section class="t-hero">
  <nav class="t-nav">
    <a href="/" class="t-logo">
      <span class="t-logo-bracket">[</span>
      <span class="t-logo-text">oa</span>
      <span class="t-logo-bracket">]</span>
      <span class="t-logo-path">~/{resource.classification.primary_category}/{resource.slug}</span>
    </a>
    <a href={`/${resource.classification.primary_category}`} class="t-nav-back">cd ..</a>
  </nav>

  <div class="t-hero-grid">
    <div class="t-hero-main">
      <div class="t-hero-prompt">
        <span class="t-hero-user">openagent</span>
        <span class="t-hero-sep">@</span>
        <span class="t-hero-host">{resource.slug}</span>
        <span class="t-hero-path"> ~ $</span>
      </div>
      <h1 class="t-hero-title">cat README.md</h1>
      <h1 class="t-hero-name">{resource.identity.name}</h1>
      <p class="t-hero-desc">{resource.identity.one_liner}</p>
      <div class="t-hero-meta">
        <span class="t-hero-comment"># {statStr}</span>
      </div>
      <div class="t-hero-actions">
        {profile.primaryCta && <a class="t-btn" href={profile.primaryCta.url}><span class="t-btn-glyph">▶</span> {profile.primaryCta.label}</a>}
        {profile.secondaryCta && <a class="t-btn t-btn-ghost" href={profile.secondaryCta.url}><span class="t-btn-glyph">📄</span> {profile.secondaryCta.label}</a>}
      </div>
    </div>
    <div class="t-hero-aside">
      <div class="t-term">
        <div class="t-term-bar">
          <span></span><span></span><span></span>
          <span class="t-term-label">{resource.slug}/main</span>
        </div>
        <div class="t-term-body">
          <div class="t-term-line"><span class="t-term-prompt">$</span><code class="t-term-cmd">{installCmd}</code></div>
          <div class="t-term-out">Installing {resource.identity.name}...</div>
          <div class="t-term-out" style="color:#4ade80">{resource.identity.name} ready</div>
          <div class="t-term-line" style="margin-top:6px"><span class="t-term-prompt">$</span><code class="t-term-cmd">{runCmd}</code></div>
          <div class="t-term-out">Reading {resource.slug} configuration & environment...</div>
          <div class="t-term-line t-term-line-blink"><span class="t-term-prompt">●</span><code style="color:rgba(255,255,255,0.5)">Waiting for input...</code></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="t-section t-section-dark">
  <div class="t-inner-narrow">
    <div class="t-section-head">
      <span class="t-comment"># core strengths</span>
      <h2>What makes {resource.identity.name} different</h2>
    </div>
    {strengths.length > 0 && (
      <div class="t-grid-3">
        {strengths.map((s) => (
          <div class="t-card">
            <div class="t-card-glyph">◆</div>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            {s.why_it_matters && <small>{s.why_it_matters}</small>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<section class="t-section t-section-white">
  <div class="t-inner-narrow">
    <div class="t-section-head">
      <span class="t-comment"># quick start</span>
      <h2>Your first command</h2>
    </div>
    <div class="t-term t-term-inline">
      <div class="t-term-bar">
        <span></span><span></span><span></span>
        <span class="t-term-label">terminal</span>
      </div>
      <div class="t-term-body">
        {cmds.slice(0, 3).map((cmd) => (
          <div class="t-term-line"><span class="t-term-prompt">$</span><code class="t-term-cmd">{cmd}</code></div>
        ))}
        {cmds.length === 0 && (
          <div class="t-term-line"><span class="t-term-prompt">$</span><code class="t-term-cmd">pip install {resource.slug.replaceAll("_", "-")}</code></div>
        )}
        <div class="t-term-line t-term-line-blink"><span class="t-term-prompt">●</span><code>Ready. Run --help to explore.</code></div>
      </div>
    </div>
    {gettingStarted.length > 0 && (
      <div class="t-links">
        {gettingStarted.map((gs) => (
          <a class="t-link" href={gs.url}>
            <span class="t-link-glyph">→</span>
            <span>{gs.label}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

{useCases.length > 0 && (
  <section class="t-section t-section-gray">
    <div class="t-inner-narrow">
      <div class="t-section-head">
        <span class="t-comment"># use cases</span>
        <h2>How developers use {resource.identity.name}</h2>
      </div>
      <div class="t-steps">
        {useCases.map((uc, i) => (
          <div class="t-step">
            <div class="t-step-badge">{String(i + 1).padStart(2, "0")}</div>
            <div>
              <h3>{uc.title}</h3>
              <p>{uc.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{compareNotes.length > 0 && (
  <section class="t-section t-section-white">
    <div class="t-inner-narrow">
      <div class="t-section-head">
        <span class="t-comment"># comparison</span>
        <h2>How {resource.identity.name} compares</h2>
      </div>
      {compareNotes.length > 0 ? (
        <div class="t-table">
          {compareNotes.map((c) => (
            <div class="t-compare-row">
              <span class="t-compare-label">{c.against ? `${c.title} vs ${c.against}` : c.title}</span>
              <p>{c.summary}</p>
            </div>
          ))}
        </div>
      ) : (
        <p class="t-lead-text">Evaluate {resource.identity.name} against nearby options by workflow fit, license, and hosting model.</p>
      )}
    </div>
  </section>
)}

{faqs.length > 0 && (
  <section class="t-section t-section-gray">
    <div class="t-inner-narrow">
      <div class="t-section-head">
        <span class="t-comment"># faq</span>
        <h2>Questions</h2>
      </div>
      <div class="t-faqs">
        {faqs.slice(0, 3).map((faq) => (
          <details class="t-faq">
            <summary><span class="t-q">Q:</span> {faq.title}</summary>
            <p>{faq.body}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<section class="t-section t-section-dark" style="padding:16px 0">
  <div class="t-inner-narrow" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
    <span style="color:rgba(255,255,255,0.5);font-family:var(--mono);font-size:0.72rem">openagent.bot/{resource.slug}/</span>
    <div style="display:flex;gap:14px">
      <a href={resource.machine_readable.json_url} style="color:rgba(255,255,255,0.55);font-family:var(--mono);font-size:0.72rem">$cat json</a>
      <a href={`/${resource.classification.primary_category}`} style="color:rgba(255,255,255,0.55);font-family:var(--mono);font-size:0.72rem">$cd ..</a>
    </div>
  </div>
</section>

<style>
  .t-hero {
    background: #0d0f12;
    overflow: hidden;
    position: relative;
  }

  .t-hero::before {
    background: linear-gradient(90deg, #4ade80, #3b82f6 50%, #8b5cf6);
    content: "";
    height: 2px;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    z-index: 1;
  }

  .t-hero::after {
    background:
      radial-gradient(ellipse 800px 400px at 70% 20%, rgba(74,222,128,0.06) 0%, transparent 60%),
      repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.015) 2px, rgba(255,255,255,0.015) 4px);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .t-nav {
    align-items: center;
    display: flex;
    font-family: var(--mono);
    font-size: 0.78rem;
    justify-content: space-between;
    padding: 16px 32px;
  }

  .t-logo { align-items: center; display: flex; gap: 2px; text-decoration: none; }
  .t-logo-bracket { color: #4ade80; }
  .t-logo-text { color: #e2e8f0; font-weight: 600; }
  .t-logo-path { color: rgba(255,255,255,0.45); margin-left: 8px; }
  .t-nav-back { color: #4ade80; font-family: var(--mono); font-size: 0.78rem; text-decoration: none; }
  .t-nav-back:hover { text-decoration: underline; }

  .t-hero-grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr 1fr;
    margin: 0 auto;
    max-width: 1100px;
    min-height: 480px;
    padding: 50px 32px 70px;
  }

  .t-hero-main { align-content: center; display: grid; gap: 14px; }

  .t-hero-prompt {
    color: rgba(255,255,255,0.4);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .t-hero-user { color: #4ade80; }
  .t-hero-sep { color: rgba(255,255,255,0.3); }
  .t-hero-host { color: #fbbf24; }
  .t-hero-path { color: rgba(255,255,255,0.3); }

  .t-hero-title {
    color: #22d3ee;
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 400;
    margin: 0 0 4px;
  }

  .t-hero-name {
    color: #fff;
    font-size: clamp(2.8rem, 5.5vw, 4.2rem);
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 0.92;
    margin: 0;
  }

  .t-hero-desc {
    color: rgba(255,255,255,0.65);
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
    max-width: 480px;
  }

  .t-hero-meta { margin: 4px 0; }
  .t-hero-comment { color: rgba(255,255,255,0.4); font-family: var(--mono); font-size: 0.78rem; }

  .t-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }

  .t-btn {
    align-items: center;
    background: #4ade80;
    border-radius: 6px;
    color: #0d0f12;
    display: inline-flex;
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 600;
    gap: 6px;
    padding: 10px 20px;
    text-decoration: none;
    transition: all 0.15s;
  }

  .t-btn:hover { background: #6ee9a0; transform: translateY(-1px); }

  .t-btn-ghost {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.8);
  }
  .t-btn-ghost:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.3); }

  .t-btn-glyph { font-size: 0.7rem; }

  .t-hero-aside { align-content: center; display: grid; }

  .t-term {
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    overflow: hidden;
  }

  .t-term-bar {
    align-items: center;
    background: rgba(255,255,255,0.04);
    display: flex;
    gap: 6px;
    padding: 11px 14px;
  }

  .t-term-bar span {
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    height: 8px;
    width: 8px;
  }

  .t-term-label {
    color: rgba(255,255,255,0.45);
    font-family: var(--mono);
    font-size: 0.65rem;
    margin-left: auto;
  }

  .t-term-body { display: grid; gap: 6px; padding: 18px 14px; }

  .t-term-line { align-items: baseline; display: flex; gap: 8px; }

  .t-term-prompt {
    color: #4ade80;
    flex-shrink: 0;
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .t-term-cmd { color: #e2e8f0; font-family: var(--mono); font-size: 0.82rem; }

  .t-term-out {
    color: rgba(255,255,255,0.6);
    font-family: var(--mono);
    font-size: 0.78rem;
    padding-left: 20px;
  }

  .t-term-line-blink .t-term-prompt {
    animation: t-blink 1s step-end infinite;
    color: #4ade80;
    font-size: 0.6rem;
  }

  @keyframes t-blink { 50% { opacity: 0; } }

  .t-term-inline { margin-bottom: 20px; }

  .t-section { padding: 60px 0; }
  .t-section-dark { background: #0d0f12; }
  .t-section-white { background: #fff; }
  .t-section-gray { background: #f6f7f8; }

  .t-section-dark .t-section-head h2 { color: #fff; }

  .t-inner-narrow { margin: 0 auto; max-width: 960px; padding: 0 32px; }

  .t-section-head { display: grid; gap: 8px; margin-bottom: 32px; max-width: 640px; }

  .t-comment {
    color: rgba(255,255,255,0.4);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 400;
    margin: 0;
  }

  .t-section-head h2 {
    font-size: 1.8rem;
    font-weight: 590;
    letter-spacing: -0.01em;
    line-height: 1.18;
    margin: 0;
  }

  .t-grid-3 { display: grid; gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .t-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    display: grid;
    gap: 8px;
    padding: 20px;
  }

  .t-card-glyph { color: #4ade80; font-size: 0.85rem; }
  .t-card h3 { color: #fff; font-size: 1rem; font-weight: 580; margin: 0; }
  .t-card p { color: rgba(255,255,255,0.65); font-size: 0.85rem; line-height: 1.5; margin: 0; }
  .t-card small { color: rgba(255,255,255,0.45); font-size: 0.75rem; }

  .t-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .t-link { align-items: center; display: inline-flex; gap: 6px; padding: 8px 0; text-decoration: none; }
  .t-link-glyph { color: #4ade80; font-family: var(--mono); font-size: 0.8rem; }
  .t-link span:last-child { color: var(--ink); font-size: 0.88rem; }
  .t-link:hover span:last-child { color: #000; }

  .t-steps { display: grid; gap: 0; }

  .t-step {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 14px;
    grid-template-columns: 36px 1fr;
    padding: 20px 0;
  }

  .t-step:first-child { border-top: 0; }

  .t-step-badge {
    background: #0d0f12;
    border-radius: 6px;
    color: #4ade80;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    height: 30px;
    line-height: 30px;
    text-align: center;
    width: 30px;
  }

  .t-step h3 { font-size: 1rem; font-weight: 580; margin: 0 0 4px; }
  .t-step p { color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0; }

  .t-table {
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    overflow: hidden;
  }

  .t-table-row {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0;
    grid-template-columns: 160px 1fr;
  }

  .t-table-row:first-child { border-top: 0; }
  .t-table-header { background: var(--paper); }
  .t-table-row span { padding: 12px 16px; font-size: 0.85rem; }
  .t-table-header span { font-weight: 580; font-size: 0.82rem; }

  .t-check { color: #16a34a; font-weight: 500; }
  .t-muted { color: var(--muted); }
  .t-compare-row { border-bottom: 1px solid var(--line); padding: 14px 16px; }
  .t-compare-row:last-child { border-bottom: 0; }
  .t-compare-label { font-weight: 580; font-size: 0.85rem; display: block; margin-bottom: 4px; }
  .t-compare-row p { color: var(--muted); font-size: 0.82rem; line-height: 1.5; margin: 0; }
  .t-lead-text { color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 0; }

  .t-faqs { display: grid; gap: 8px; }

  .t-faq {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 14px 16px;
  }

  .t-faq summary { cursor: pointer; font-size: 0.92rem; font-weight: 560; line-height: 1.3; }

  .t-q { color: #4ade80; font-family: var(--mono); font-size: 0.75rem; font-weight: 700; }

  .t-faq p { color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 10px 0 0; }

  @media (max-width: 800px) {
    .t-hero-grid { grid-template-columns: 1fr; padding: 30px 20px 50px; min-height: auto; }
    .t-nav { padding: 12px 16px; }
    .t-inner-narrow { padding: 0 20px; }
    .t-section { padding: 40px 0; }
    .t-grid-3 { grid-template-columns: 1fr; }
    .t-table-row { grid-template-columns: 1fr; }
    .t-logo-path { display: none; }
  }
</style>
