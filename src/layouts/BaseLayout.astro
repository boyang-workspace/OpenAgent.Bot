---
import { site } from "@/config/site";
import { buildSeo } from "@/lib/seo";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
};

const seo = buildSeo(Astro.props);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://github.com" crossorigin />
    <link rel="dns-prefetch" href="https://github.com" />
    <slot name="head" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-92BLS0VYN1"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config","G-92BLS0VYN1");</script>
    <script is:inline>document.addEventListener("click",function(e){var t=e.target.closest("[data-analytics]");if(!t)return;var a=t.getAttribute("data-analytics"),p=t.getAttribute("data-analytics-payload");if(p)try{p=JSON.parse(p)}catch(a){p={}}p=p||{};var ev={resource:"click_resource",category:"click_category",blog:"click_blog",evaluation:"click_evaluation",signal:"click_signal",nav:"click_nav",cta:"click_cta"};var eventName=ev[a]||"click_custom";gtag("event",eventName,p)});document.addEventListener("submit",function(e){var t=e.target.closest("[data-analytics=search]");if(!t)return;var q=new FormData(t).get("q");if(!q||!q.toString().trim())return;gtag("event","search",{search_term:q.toString().trim()})});</script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
