---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="This OpenAgent.bot URL does not match a published registry record. Search the canonical database instead."
  path="/404"
  noindex
>
  <div class="page-shell">
    <div class="page-grid not-found">
      <section class="page-section">
        <span class="kicker">404 / Registry miss</span>
        <h1 class="page-title">Record not found.</h1>
        <p class="lede">The URL may belong to an older version of the index, or the record has not been published.</p>
        <form class="not-found-search" action="/database" method="get">
          <label for="missing-search">Search the canonical database</label>
          <div><input id="missing-search" name="q" type="search" placeholder="Project, organization, or keyword" /><button class="button primary" type="submit">Search</button></div>
        </form>
        <div class="button-row"><a class="button secondary" href="/database">Browse all records</a><a class="button secondary" href="/">Return home</a></div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found { min-height: calc(100vh - 170px); }
  .not-found .page-section { min-height: 460px; }
  .not-found-search { margin-top: 34px; max-width: 680px; }
  .not-found-search label { display: block; font-family: var(--mono); font-size: .75rem; margin-bottom: 9px; text-transform: uppercase; }
  .not-found-search > div { display: grid; grid-template-columns: 1fr auto; }
  .not-found-search input { background: var(--paper-raised); border: 1px solid var(--ink); border-right: 0; min-width: 0; padding: 0 14px; }
</style>
