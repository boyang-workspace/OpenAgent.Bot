---
import EditorialShell from "@/components/EditorialShell.astro";
import ShowcasePage from "@/components/ShowcasePage.astro";
import { buildShowcaseProfile } from "@/lib/content/showcase";
import { getPublishedResources, getRelatedResources, resourcePath } from "@/lib/content/resources";
import { resourceCategoryLabel, resourceMeta } from "@/lib/content/resource-display";
import type { ResourceV1 } from "@/lib/content/resource-schema";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  resource: ResourceV1;
};

export async function getStaticPaths() {
  const resources = await getPublishedResources();

  return resources.map((resource) => ({
    params: { category: resource.classification.primary_category, slug: resource.slug },
    props: { resource }
  }));
}

const { resource } = Astro.props as Props;
const allResources = await getPublishedResources();
const related = await getRelatedResources(resource);
const profile = buildShowcaseProfile(resource, { allResources, related });
const repoLink = resource.links.items.find((link) => link.type === "github");
const homepageLink = resource.links.items.find((link) => link.type === "homepage");
const docsLink = resource.links.items.find((link) => link.type === "docs");
const generatedTitle = `${resource.identity.name}: ${profile.archetypeLabel.replace(" showcase", "")} for open AI builders`;
const generatedDescription = `${resource.identity.name} independent showcase with official sources, adoption checks, facts, related resources, and OpenAgent structured data.`;
const pageTitle = resource.seo?.title?.includes("resource for open AI builders") ? generatedTitle : (resource.seo?.title ?? generatedTitle);
const pageDescription = resource.seo?.description?.includes("profile on OpenAgent.bot") ? generatedDescription : (resource.seo?.description ?? generatedDescription);

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: resource.identity.name,
  description: resource.identity.short_description ?? resource.identity.one_liner,
  codeRepository: repoLink?.url,
  url: homepageLink?.url ?? docsLink?.url ?? repoLink?.url ?? resource.links.primary_url,
  license: resource.facts.license,
  programmingLanguage: resource.facts.primary_language,
  keywords: [...resourceMeta(resource), ...profile.tags].join(", ")
};

const webpageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: resource.machine_readable.canonical_url,
  about: {
    "@type": "Thing",
    name: resource.identity.name,
    description: resource.identity.one_liner
  },
  isPartOf: {
    "@type": "WebSite",
    name: "OpenAgent.bot",
    url: "https://www.openagent.bot"
  }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "OpenAgent.bot",
      item: "https://www.openagent.bot/"
    },
    {
      "@type": "ListItem",
      position: 2,
      name: resourceCategoryLabel(resource),
      item: `https://www.openagent.bot/${resource.classification.primary_category}`
    },
    {
      "@type": "ListItem",
      position: 3,
      name: resource.identity.name,
      item: resource.machine_readable.canonical_url
    }
  ]
};

const faqJsonLd =
  profile.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: profile.faq.map((item) => ({
          "@type": "Question",
          name: item.title,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.body
          }
        }))
      }
    : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path={resourcePath(resource)}
  image={profile.image}
  noindex={resource.status !== "published"}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify([softwareJsonLd, webpageJsonLd, breadcrumbJsonLd, faqJsonLd].filter(Boolean))} />
  </Fragment>

  <EditorialShell active={resource.classification.primary_category}>
    <ShowcasePage resource={resource} profile={profile} />
  </EditorialShell>
</BaseLayout>
