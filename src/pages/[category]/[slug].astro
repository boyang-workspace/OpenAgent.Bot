---
import ResourceCard from "@/components/ResourceCard.astro";
import EditorialShell from "@/components/EditorialShell.astro";
import { categories } from "@/config/site";
import { getPublishedResources, getRelatedResources, resourcePath } from "@/lib/content/resources";
import { resourceCategoryLabel, resourceMeta, resourceSignals, resourceTags } from "@/lib/content/resource-display";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const resources = await getPublishedResources();

  return resources.map((resource) => ({
    params: { category: resource.classification.primary_category, slug: resource.slug },
    props: { resource }
  }));
}

const { resource } = Astro.props;
const isAgent = resource.classification.primary_category === "agents";
const category = categories.find((item) => item.slug === resource.classification.primary_category);
const related = await getRelatedResources(resource);
const repoLink = resource.links.items.find((link) => link.type === "github");
const homepageLink = resource.links.items.find((link) => link.type === "homepage");
const docsLink = resource.links.items.find((link) => link.type === "docs");
const primaryCta = repoLink ?? homepageLink ?? resource.links.items[0];
const seoArticle = resource.editorial?.seo_article;
const useCases =
  resource.editorial?.use_case_notes?.length
    ? resource.editorial.use_case_notes
    : (resource.positioning.use_cases ?? resource.capabilities.core_capabilities ?? []).slice(0, 4).map((item) => ({
        title: item.replaceAll("-", " ").replaceAll("_", " "),
        description: `Use ${resource.identity.name} when this workflow matches your source, deployment, and maintenance requirements.`
      }));
const compareNotes =
  resource.editorial?.compare_notes?.length
    ? resource.editorial.compare_notes
    : [
        {
          title: `When to choose ${resource.identity.name}`,
          summary: `Compare it with nearby ${resourceCategoryLabel(resource).toLowerCase()} by looking at workflow fit, license, deployment model, and official docs.`
        }
      ];
const facts = [
  ["Category", category?.label ?? resourceCategoryLabel(resource)],
  ["Type", resource.classification.resource_type.replaceAll("_", " ")],
  ["License", resource.facts.license ?? "Unknown"],
  ["Language", resource.facts.primary_language],
  ["Stars", resource.facts.github_stars?.toLocaleString("en-US")],
  ["Forks", resource.facts.github_forks?.toLocaleString("en-US")],
  ["Repository", resource.facts.github_repo_full_name],
  ["Verified", resource.facts.last_verified_at?.slice(0, 10) ?? resource.timestamps.updated_at.slice(0, 10)]
].filter((item): item is [string, string] => Boolean(item[1]));
const signals = resourceSignals(resource, 8);
const tags = resourceTags(resource, 8);
const sourceLinks = resource.links.items.slice(0, 8);
const primaryUseCase = resource.positioning.best_for?.[0] ?? useCases[0]?.title ?? `teams evaluating ${resourceCategoryLabel(resource).toLowerCase()}`;
const firstTestByCategory: Record<string, string> = {
  agents: "Run one narrow workflow in a sandbox account, then inspect logs, permissions, and failure cases before expanding scope.",
  models: "Test one real prompt set from your agent workflow, then compare latency, cost, context handling, and output reliability.",
  "memory-systems": "Run a repeated-session retrieval test and check what the system remembers, updates, forgets, and explains.",
  skills: "Try one reusable task end to end, then check how easy it is to edit, version, and recover from mistakes.",
  plugins: "Connect one low-risk service first, then inspect auth scope, logs, and failure behavior.",
  tools: "Use it on one real builder workflow and verify whether it removes manual work without adding fragile setup."
};
const firstTest = firstTestByCategory[resource.classification.primary_category] ?? "Start with one small workflow whose success and failure are easy to observe.";
const sourceConfidence = [
  repoLink ? "official repository" : undefined,
  docsLink ? "docs available" : undefined,
  resource.facts.last_verified_at ? `verified ${resource.facts.last_verified_at.slice(0, 10)}` : `updated ${resource.timestamps.updated_at.slice(0, 10)}`
].filter(Boolean).join(" · ");
const installCmd = resource.editorial?.command_line?.[0];
const installHint = installCmd?.command ?? (repoLink ? `git clone ${repoLink.url}` : `# see official docs`);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: resource.identity.name,
  description: resource.identity.short_description ?? resource.identity.one_liner,
  codeRepository: repoLink?.url,
  url: homepageLink?.url ?? repoLink?.url ?? resource.links.primary_url,
  license: resource.facts.license,
  programmingLanguage: resource.facts.primary_language,
  keywords: [...resourceMeta(resource), ...tags].join(", ")
};
---

<BaseLayout
  title={resource.seo?.title ?? `${resource.identity.name}: ${resourceCategoryLabel(resource)} profile`}
  description={resource.seo?.description ?? resource.identity.short_description ?? resource.identity.one_liner}
  path={resourcePath(resource)}
  noindex={resource.status !== "published"}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <EditorialShell active={resource.classification.primary_category}>
    <article class="profile-page">
      {isAgent ? (
        <section class="agent-hero">
          <div class="agent-hero-inner">
            <div class="agent-hero-meta mono">
              <span>{resourceCategoryLabel(resource)}</span>
              <span>{resource.decision_signals.open_source ? "open-source" : resource.facts.license ?? "source-available"}</span>
              {resource.facts.primary_language && <span>{resource.facts.primary_language}</span>}
              {resource.facts.github_stars && <span>{resource.facts.github_stars.toLocaleString("en-US")} stars</span>}
            </div>
            <h1>{resource.identity.name}</h1>
            <p class="agent-hero-tagline">{resource.identity.one_liner}</p>
            {resource.identity.short_description && <p class="agent-hero-summary">{resource.identity.short_description}</p>}
            <div class="agent-hero-terminal">
              <div class="terminal-header">
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
                <span class="terminal-title">terminal</span>
              </div>
              <div class="terminal-body">
                <div><span class="prompt-char">$</span> <span class="cmd-text">{installHint}</span></div>
                {installCmd?.description && <div class="terminal-comment"># {installCmd.description}</div>}
              </div>
            </div>
            <div class="agent-hero-actions">
              {primaryCta && <a class="button primary" href={primaryCta.url} data-analytics="cta" data-analytics-payload={JSON.stringify({action: "open_repository", name: resource.identity.name, slug: resource.slug, url: primaryCta.url})}>{primaryCta.type === "github" ? "Open repository" : primaryCta.label}</a>}
              {docsLink && <a class="button" href={docsLink.url} data-analytics="cta" data-analytics-payload={JSON.stringify({action: "read_docs", name: resource.identity.name, slug: resource.slug})}>Read docs</a>}
              <a class="button" href="#sources" data-analytics="cta" data-analytics-payload={JSON.stringify({action: "view_sources", name: resource.identity.name, slug: resource.slug})}>View sources</a>
            </div>
          </div>
        </section>
      ) : (
        <section class="profile-hero">
          <div class="hero-copy">
            <p class="eyebrow">{resourceCategoryLabel(resource)} profile</p>
            <h1>{resource.identity.name}</h1>
            <p class="answer">{resource.identity.one_liner}</p>
            {resource.identity.short_description && <p class="summary">{resource.identity.short_description}</p>}
            <div class="verdict-strip">
              <div>
                <span>Best for</span>
                <strong>{primaryUseCase}</strong>
              </div>
              <div>
                <span>First test</span>
                <strong>{firstTest}</strong>
              </div>
            </div>
            <div class="hero-actions">
              {primaryCta && <a class="button" href={primaryCta.url} data-analytics="cta" data-analytics-payload={JSON.stringify({action: "open_repository", name: resource.identity.name, slug: resource.slug, url: primaryCta.url})}>{primaryCta.type === "github" ? "Open repository" : primaryCta.label}</a>}
              {docsLink && <a class="button secondary" href={docsLink.url} data-analytics="cta" data-analytics-payload={JSON.stringify({action: "read_docs", name: resource.identity.name, slug: resource.slug})}>Read docs</a>}
              <a class="button secondary" href="#sources" data-analytics="cta" data-analytics-payload={JSON.stringify({action: "view_sources", name: resource.identity.name, slug: resource.slug})}>View sources</a>
            </div>
          </div>
          <aside class="evidence-card">
            <strong>At a glance</strong>
            <dl>
              {facts.slice(0, 6).map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        </section>
      )}

      <section class="fit-strip">
        <div>
          <span>Decision signals</span>
          <div class="chip-row">{signals.map((signal) => <em>{signal}</em>)}</div>
        </div>
        <div>
          <span>Tags</span>
          <div class="chip-row">{tags.map((tag) => <em>{tag.replaceAll("-", " ")}</em>)}</div>
        </div>
      </section>

      <section class="content-grid">
        <main class="profile-main">
          <section class="content-section" id="answer">
            <p class="eyebrow">Quick answer</p>
            <h2>What is {resource.identity.name}?</h2>
            <div class="prose">
              {seoArticle?.intro && <p>{seoArticle.intro}</p>}
              {seoArticle?.what_it_is && <p>{seoArticle.what_it_is}</p>}
              {!seoArticle?.intro && !seoArticle?.what_it_is && <p>{resource.identity.short_description ?? resource.identity.one_liner}</p>}
            </div>
          </section>

          <section class="content-section">
            <p class="eyebrow">Fit check</p>
            <h2>When to use it</h2>
            <div class="fit-grid">
              <article>
                <h3>Good fit if</h3>
                <ul>
                  {(resource.positioning.best_for ?? ["You are evaluating this category and the official source matches your workflow."]).map((item) => <li>{item}</li>)}
                </ul>
              </article>
              <article>
                <h3>Not a fit if</h3>
                <ul>
                  {(resource.positioning.not_for ?? ["You need a different hosting model, license, interface, or maturity level."]).map((item) => <li>{item}</li>)}
                </ul>
              </article>
            </div>
          </section>

          <section class="content-section">
            <p class="eyebrow">First test</p>
            <h2>How to evaluate it before committing</h2>
            <div class="test-card">
              <strong>{firstTest}</strong>
              <p>Keep the first test small enough that you can inspect the source, understand the permissions, and compare the result with nearby OpenAgent resources.</p>
            </div>
          </section>

          <section class="content-section">
            <p class="eyebrow">Workflows</p>
            <h2>Common ways to evaluate it</h2>
            <div class="stack-list">
              {useCases.slice(0, 5).map((item) => (
                <article>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="content-section">
            <p class="eyebrow">Compare</p>
            <h2>How it compares</h2>
            <div class="stack-list">
              {compareNotes.slice(0, 4).map((item) => (
                <article>
                  <h3>{item.title}{item.against ? ` vs ${item.against}` : ""}</h3>
                  <p>{item.summary}</p>
                </article>
              ))}
            </div>
            {related.length > 0 && (
              <div class="compare-table">
                <table>
                  <thead>
                    <tr>
                      <th>Resource</th>
                      <th>Category</th>
                      <th>License</th>
                      <th>Stars</th>
                    </tr>
                  </thead>
                  <tbody>
                    {related.map((item) => (
                      <tr>
                        <td><a href={resourcePath(item)}>{item.identity.name}</a></td>
                        <td>{resourceCategoryLabel(item)}</td>
                        <td>{item.facts.license ?? "Unknown"}</td>
                        <td>{item.facts.github_stars?.toLocaleString("en-US") ?? "n/a"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          {seoArticle?.faq?.length && (
            <section class="content-section">
              <p class="eyebrow">FAQ</p>
              <h2>Questions search visitors ask</h2>
              <div class="faq-list">
                {seoArticle.faq.slice(0, 6).map((item) => (
                  <details>
                    <summary>{item.question}</summary>
                    <p>{item.answer}</p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </main>

        <aside class="profile-rail">
          <section class="rail-panel">
            <h2>Source confidence</h2>
            <p class="confidence">{sourceConfidence}</p>
          </section>

          <section class="rail-panel">
            <h2>Source-backed facts</h2>
            <dl>
              {facts.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </section>

          <section class="rail-panel" id="sources">
            <h2>Official sources</h2>
            <div class="source-list">
              {sourceLinks.map((link) => (
                <a href={link.url} data-analytics="cta" data-analytics-payload={JSON.stringify({action: "source_link", name: resource.identity.name, slug: resource.slug, type: link.type, label: link.label})}>
                  <span>{link.type.replaceAll("_", " ")}</span>
                  <strong>{link.label}</strong>
                </a>
              ))}
            </div>
          </section>

          <section class="rail-panel">
            <h2>Structured outputs</h2>
            <div class="source-list">
              <a href={resource.machine_readable.json_url.replace("https://www.openagent.bot", "")} data-analytics="cta" data-analytics-payload={JSON.stringify({action: "structured_output", name: resource.identity.name, slug: resource.slug, format: "json"})}>
                <span>machine readable</span>
                <strong>JSON profile</strong>
              </a>
              <a href={resource.machine_readable.markdown_url.replace("https://www.openagent.bot", "")} data-analytics="cta" data-analytics-payload={JSON.stringify({action: "structured_output", name: resource.identity.name, slug: resource.slug, format: "markdown"})}>
                <span>agent readable</span>
                <strong>Markdown profile</strong>
              </a>
            </div>
          </section>
        </aside>
      </section>

      {related.length > 0 && (
        <section class="related-section">
          <div class="section-head">
            <p class="eyebrow">Related</p>
            <h2>More {category?.label.toLowerCase() ?? "resources"} to compare</h2>
          </div>
          <div class="related-grid">
            {related.map((item) => <ResourceCard resource={item} />)}
          </div>
        </section>
      )}
    </article>
  </EditorialShell>
</BaseLayout>

<style>
  .profile-page {
    display: grid;
    gap: 24px;
  }

  .agent-hero {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    margin: 0;
    padding: 28px;
  }

  .agent-hero-inner {
    max-width: 980px;
  }

  .agent-hero-meta {
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.7rem;
    letter-spacing: 0;
    margin-bottom: 18px;
    text-transform: none;
  }

  .agent-hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 540;
    letter-spacing: 0;
    line-height: 0.92;
    margin: 0;
    color: var(--ink);
  }

  .agent-hero-tagline {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.48;
    margin: 18px 0 0;
    max-width: 780px;
  }

  .agent-hero-summary {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 12px 0 0;
    max-width: 780px;
  }

  .agent-hero-terminal {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-top: 28px;
    max-width: 640px;
    overflow: hidden;
  }

  .terminal-header {
    align-items: center;
    background: rgba(22, 26, 29, 0.03);
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 6px;
    padding: 10px 14px;
  }

  .terminal-dot {
    background: var(--line-strong);
    border-radius: 50%;
    height: 10px;
    width: 10px;
  }

  .terminal-title {
    color: var(--subtle);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    margin-left: 8px;
  }

  .terminal-body {
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.8;
    padding: 16px 18px;
  }

  .prompt-char {
    color: var(--accent-open);
  }

  .cmd-text {
    color: var(--ink);
  }

  .terminal-comment {
    color: var(--muted);
    font-size: 0.76rem;
    margin-top: 4px;
  }

  .agent-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .agent-hero-actions .button {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
    border-radius: 7px;
    font-size: 0.82rem;
    font-weight: 520;
    letter-spacing: 0;
  }

  .agent-hero-actions .button.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: #ffffff;
  }

  .agent-hero-actions .button:hover {
    background: var(--surface-soft);
    transform: translateY(-1px);
  }

  .agent-hero-actions .button.primary:hover {
    background: #000000;
  }

  /* ── Non-agent hero ── */

  .profile-hero {
    align-items: stretch;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1fr) 330px;
    padding: 24px;
  }

  .profile-hero h1 {
    color: var(--ink);
    font-size: clamp(1.85rem, 4vw, 2.7rem);
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.02;
    margin: 8px 0 0;
  }

  .answer {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.48;
    margin: 14px 0 0;
    max-width: 780px;
  }

  .summary {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 10px 0 0;
    max-width: 780px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 18px;
  }

  .verdict-strip {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 18px;
  }

  .verdict-strip div,
  .test-card {
    background: rgba(237, 237, 236, 0.04);
    border: 1px solid var(--dark-line);
    display: grid;
    gap: 6px;
    padding: 12px;
  }

  .verdict-strip span {
    color: var(--dark-muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .verdict-strip strong,
  .test-card strong {
    color: var(--dark-text);
    font-size: 0.9rem;
    font-weight: 560;
    line-height: 1.35;
  }

  .evidence-card,
  .rail-panel {
    background: rgba(237, 237, 236, 0.04);
    border: 1px solid var(--dark-line);
    padding: 15px;
  }

  .evidence-card strong {
    color: var(--dark-muted);
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  dl div {
    border-top: 1px solid var(--dark-line);
    display: grid;
    gap: 3px;
    grid-template-columns: 105px minmax(0, 1fr);
    padding: 8px 0;
  }

  dl div:first-child {
    border-top: 0;
  }

  dt {
    color: var(--dark-muted);
    font-size: 0.72rem;
  }

  dd {
    color: var(--dark-text);
    font-size: 0.82rem;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .fit-strip {
    background: rgba(237, 237, 236, 0.04);
    border: 1px solid var(--dark-line);
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr 1fr;
    padding: 14px;
  }

  .fit-strip span {
    color: var(--dark-muted);
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .chip-row em {
    background: rgba(237, 237, 236, 0.06);
    border: 1px solid var(--dark-line);
    border-radius: 999px;
    color: var(--dark-muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-style: normal;
    letter-spacing: 0.04em;
    padding: 5px 8px;
  }

  .content-grid {
    align-items: start;
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr) 320px;
  }

  .profile-main {
    display: grid;
    gap: 0;
  }

  .content-section,
  .related-section {
    border-top: 1px solid var(--dark-line);
    padding: 26px 0;
  }

  .profile-main .content-section:first-child {
    border-top: 0;
    padding-top: 0;
  }

  h2 {
    color: var(--dark-text);
    font-size: 1.42rem;
    font-weight: 760;
    letter-spacing: 0;
    line-height: 1.14;
    margin: 5px 0 0;
  }

  h3 {
    color: var(--dark-text);
    font-size: 0.94rem;
    font-weight: 580;
    letter-spacing: 0;
    margin: 0 0 7px;
  }

  .prose {
    display: grid;
    gap: 11px;
    margin-top: 12px;
    max-width: 780px;
  }

  .prose p,
  .stack-list p,
  .fit-grid li,
  details p {
    color: var(--dark-muted);
    font-size: 0.9rem;
    line-height: 1.62;
    margin: 0;
  }

  .fit-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr 1fr;
    margin-top: 14px;
  }

  .fit-grid article {
    background: rgba(237, 237, 236, 0.04);
    border: 1px solid var(--dark-line);
    padding: 14px;
  }

  .test-card {
    margin-top: 14px;
    max-width: 780px;
  }

  .test-card p,
  .confidence {
    color: var(--dark-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    margin: 0;
  }

  ul {
    margin: 0;
    padding-left: 1.05rem;
  }

  li + li {
    margin-top: 7px;
  }

  .stack-list {
    display: grid;
    gap: 0;
    margin-top: 12px;
  }

  .stack-list article {
    border-top: 1px solid var(--dark-line);
    padding: 13px 0;
  }

  .stack-list article:first-child {
    border-top: 0;
  }

  .compare-table {
    background: rgba(237, 237, 236, 0.04);
    border: 1px solid var(--dark-line);
    margin-top: 16px;
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    min-width: 620px;
    width: 100%;
  }

