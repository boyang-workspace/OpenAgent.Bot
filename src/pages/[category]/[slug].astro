---
import EditorialShell from "@/components/EditorialShell.astro";
import ShowcaseVariantPlatform from "@/components/ShowcaseVariantPlatform.astro";
import ShowcaseVariantDevtool from "@/components/ShowcaseVariantDevtool.astro";
import ShowcaseVariantTerminal from "@/components/ShowcaseVariantTerminal.astro";
import ShowcaseVariantStats from "@/components/ShowcaseVariantStats.astro";
import ResourceDecisionPanel from "@/components/ResourceDecisionPanel.astro";
import ResourceDetailSections from "@/components/ResourceDetailSections.astro";
import { buildShowcaseProfile } from "@/lib/content/showcase";
import { getPublishedBlogPosts } from "@/lib/content/blog";
import { buildResourceDetailProfile } from "@/lib/content/resource-detail";
import { getPublishedResources, getRelatedResources, resourcePath } from "@/lib/content/resources";
import { resourceCategoryLabel, resourceMeta } from "@/lib/content/resource-display";
import type { ResourceV1 } from "@/lib/content/resource-schema";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  resource: ResourceV1;
};

export async function getStaticPaths() {
  const resources = await getPublishedResources();

  return resources.map((resource) => ({
    params: { category: resource.classification.primary_category, slug: resource.slug },
    props: { resource }
  }));
}

const { resource } = Astro.props as Props;
const allResources = await getPublishedResources();
const related = await getRelatedResources(resource);
const profile = buildShowcaseProfile(resource, { allResources, related });
const detail = buildResourceDetailProfile(resource, { related });
const allPosts = await getPublishedBlogPosts();
const resourceName = resource.identity.name.toLowerCase();
const relatedPosts = allPosts.filter((post) =>
  post.body.toLowerCase().includes(resourceName) ||
  post.tags.some((tag) => resourceName.includes(tag) || tag.includes(resourceName))
).slice(0, 3);
const repoLink = resource.links.items.find((link) => link.type === "github");
const homepageLink = resource.links.items.find((link) => link.type === "homepage");
const docsLink = resource.links.items.find((link) => link.type === "docs");
const generatedTitle = `${resource.identity.name}: ${profile.archetypeLabel.replace(" showcase", "")} — open-source AI overview`;
const generatedDescription = `${resource.identity.name} open-source overview: features, adoption signals, GitHub stats, license, and curated resources for AI builders.`;
const seoTitle = resource.seo?.title?.trim();
const seoDesc = resource.seo?.description?.trim();
const pageTitle = seoTitle && seoTitle.length > 20 ? seoTitle : generatedTitle;
const pageDescription = seoDesc && seoDesc.length > 30 ? seoDesc : generatedDescription;

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: resource.identity.name,
  description: resource.identity.short_description ?? resource.identity.one_liner,
  codeRepository: repoLink?.url,
  url: homepageLink?.url ?? docsLink?.url ?? repoLink?.url ?? resource.links.primary_url,
  license: resource.facts.license,
  programmingLanguage: resource.facts.primary_language,
  keywords: [...resourceMeta(resource), ...profile.tags].join(", ")
};

const webpageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: resource.machine_readable.canonical_url,
  about: {
    "@type": "Thing",
    name: resource.identity.name,
    description: resource.identity.one_liner
  },
  isPartOf: {
    "@type": "WebSite",
    name: "OpenAgent.bot",
    url: "https://www.openagent.bot"
  }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "OpenAgent.bot",
      item: "https://www.openagent.bot/"
    },
    {
      "@type": "ListItem",
      position: 2,
      name: resourceCategoryLabel(resource),
      item: `https://www.openagent.bot/${resource.classification.primary_category}`
    },
    {
      "@type": "ListItem",
      position: 3,
      name: resource.identity.name,
      item: resource.machine_readable.canonical_url
    }
  ]
};

const faqJsonLd =
  detail.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: detail.faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer
          }
        }))
      }
    : undefined;

const agentPacketJsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: `${resource.identity.name} agent decision packet`,
  description: `Machine-readable decision packet for agents evaluating ${resource.identity.name}.`,
  url: detail.agentPacket.machine_readable.agent_json_url,
  license: resource.facts.license,
  creator: {
    "@type": "Organization",
    name: "OpenAgent.bot"
  },
  distribution: [
    {
      "@type": "DataDownload",
      encodingFormat: "application/json",
      contentUrl: detail.agentPacket.machine_readable.agent_json_url
    },
    {
      "@type": "DataDownload",
      encodingFormat: "text/markdown",
      contentUrl: resource.machine_readable.markdown_url
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path={resourcePath(resource)}
  image={profile.image}
  noindex={resource.status !== "published"}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={profile.image} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify([softwareJsonLd, webpageJsonLd, breadcrumbJsonLd, faqJsonLd, agentPacketJsonLd].filter(Boolean))} />
  </Fragment>

  {
    (() => {
      const a = profile.archetype;
      return (
        <EditorialShell active={resource.classification.primary_category} variant breadcrumbs={[
          { label: "OpenAgent.bot", href: "/" },
          { label: resourceCategoryLabel(resource), href: `/${resource.classification.primary_category}` },
          { label: resource.identity.name }
        ]}>
          {a === "platform-os" || a === "agent-framework" || a === "design-agent" || a === "skill-system" ? (
            <ShowcaseVariantPlatform resource={resource} profile={profile} />
          ) : a === "coding-agent" ? (
            <ShowcaseVariantTerminal resource={resource} profile={profile} />
          ) : a === "browser-automation" || a === "evaluation-tool" || a === "connector-tool" || a === "skill-library" ? (
            <ShowcaseVariantDevtool resource={resource} profile={profile} />
          ) : (
            <ShowcaseVariantStats resource={resource} profile={profile} />
          )}
          <ResourceDecisionPanel resource={resource} />
          <ResourceDetailSections resource={resource} detail={detail} />
          {
            relatedPosts.length > 0 && (
              <section class="related-guides-section">
                <hr class="section-divider" />
                <h2 class="related-heading">Related guides</h2>
                <div class="related-grid">
                  {relatedPosts.map((post) => (
                    <a class="related-card" href={`/blog/${post.slug}`}>
                      <strong>{post.title}</strong>
                      <p>{post.summary}</p>
                      <span class="related-meta">{post.publishedAt}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </EditorialShell>
      );
    })()
  }
</BaseLayout>
