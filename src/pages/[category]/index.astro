---
import EditorialShell from "@/components/EditorialShell.astro";
import { categories } from "@/config/site";
import { getResourcesByCategory, resourcePath } from "@/lib/content/resources";
import { resourceSignals, resourceTags } from "@/lib/content/resource-display";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const resourceRank = (resource: (typeof categoryResources)[number]) => (resource.decision_signals.open_source ? 1 : 0);
const categoryResources = (await getResourcesByCategory(category.slug)).sort(
  (a, b) =>
    resourceRank(b) - resourceRank(a) ||
    (b.facts.github_stars ?? 0) - (a.facts.github_stars ?? 0) ||
    a.identity.name.localeCompare(b.identity.name)
);
const categorySignals = Array.from(new Set(categoryResources.flatMap((resource) => resourceSignals(resource, 4)))).slice(0, 6);
---

<BaseLayout title={category.label} description={category.description} path={`/${category.slug}`}>
  <EditorialShell active={category.slug} eyebrow="Directory" title={category.label} description={category.description}>
    <section class="directory-toolbar">
      <div>
        <strong>{categoryResources.length}</strong>
        <span>published entries</span>
      </div>
      <div class="summary-signals">
        {categorySignals.map((signal) => <small>{signal}</small>)}
      </div>
      <a class="button secondary" href="/submit">Submit</a>
    </section>

    <section class="directory-list">
      <div class="list-head">
        <span>Resource</span>
        <span>Best for</span>
        <span>License</span>
        <span>Stars</span>
        <span>Signals</span>
      </div>
      {categoryResources.map((resource) => (
        <a class="resource-row" href={resourcePath(resource)}>
          <div>
            <strong>{resource.identity.name}</strong>
            <p>{resource.identity.one_liner}</p>
          </div>
          <span data-label="Best for">{resource.positioning.best_for?.[0] ?? resource.classification.resource_type.replaceAll("_", " ")}</span>
          <span data-label="License">{resource.facts.license ?? "Unknown"}</span>
          <span data-label="Stars">{resource.facts.github_stars?.toLocaleString("en-US") ?? "n/a"}</span>
          <div class="row-tags" data-label="Signals">{[...resourceSignals(resource, 2), ...resourceTags(resource, 2)].slice(0, 3).map((tag) => <small>{tag.replaceAll("-", " ")}</small>)}</div>
        </a>
      ))}
    </section>
  </EditorialShell>
</BaseLayout>

<style>
  .directory-toolbar {
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 14px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    margin-bottom: 18px;
    padding: 14px 16px;
  }

  .directory-toolbar strong {
    color: var(--ink);
    display: block;
    font-size: 1.6rem;
    font-weight: 560;
    line-height: 1;
  }

  .directory-toolbar span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .summary-signals,
  .row-tags {
    align-items: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .summary-signals {
    justify-content: center;
  }

  small {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    line-height: 1.1;
    padding: 4px 7px;
  }

  .directory-list {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .list-head,
  .resource-row {
    display: grid;
    gap: 12px;
    grid-template-columns: minmax(240px, 1.4fr) minmax(160px, 0.9fr) 95px 80px minmax(160px, 0.8fr);
    padding: 12px 16px;
  }

  .list-head {
    background: var(--surface-soft);
    border-bottom: 1px solid var(--line);
  }

  .list-head span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resource-row {
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.84rem;
    transition: background 160ms;
  }

  .resource-row:last-child {
    border-bottom: 0;
  }

  .resource-row:hover {
    background: var(--surface-soft);
  }

  .resource-row strong {
    color: var(--ink);
    display: block;
    font-size: 0.96rem;
    font-weight: 580;
  }

  .resource-row p {
    color: var(--muted);
    display: -webkit-box;
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 4px 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .row-label {
    color: var(--muted);
    display: block;
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .directory-toolbar {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .summary-signals {
      justify-content: start;
    }

    .list-head {
      display: none;
    }

    .resource-row {
      gap: 10px;
      grid-template-columns: 1fr;
      padding: 16px 16px 18px;
    }

    .resource-row [data-label]::before {
      color: var(--muted);
      content: attr(data-label);
      display: block;
      font-family: var(--mono);
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      margin-bottom: 3px;
      text-transform: uppercase;
    }
  }
</style>
