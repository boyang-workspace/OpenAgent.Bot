---
import AdminLayout from "@/layouts/AdminLayout.astro";

const lanes = [
  {
    label: "Review inbox",
    href: "/admin/review/",
    title: "Triage submissions and drafts",
    body: "Keep the queue small. Approve only resources that have source links, useful positioning, and a reason to exist in the directory."
  },
  {
    label: "Resources",
    href: "/admin/projects/",
    title: "Maintain directory profiles",
    body: "Edit facts, tags, fit notes, source links, and publish status for agent, model, memory, skill, plugin, and tool pages."
  },
  {
    label: "Articles",
    href: "/admin/blog/",
    title: "Turn signals into articles",
    body: "Use the article workbench only for search-backed comparisons, guides, and evidence-heavy posts that support the directory."
  },
  {
    label: "Publishing",
    href: "/admin/publishing/",
    title: "Ship through GitHub",
    body: "Publish reviewed changes through PRs or direct publish actions. Keep public content static and source-controlled."
  }
];
---

<AdminLayout title="Overview" active="overview">
  <section class="admin-focus">
    <div>
      <span class="eyebrow">Simplified admin</span>
      <h2>Run the site from four queues.</h2>
      <p>
        The admin should help you review sources, maintain directory profiles, write comparison content,
        and publish cleanly. Everything else can stay hidden until it earns its way back.
      </p>
    </div>
    <a class="button" href="/admin/review/">Open review inbox</a>
  </section>

  <section class="admin-grid" style="margin-top: 16px;">
    {lanes.map((lane) => (
      <a class="admin-panel admin-lane" href={lane.href}>
        <span class="eyebrow">{lane.label}</span>
        <h2>{lane.title}</h2>
        <p>{lane.body}</p>
      </a>
    ))}
  </section>
</AdminLayout>

<style>
  .admin-focus {
    align-items: end;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 20px;
  }

  .admin-focus h2 {
    font-size: 1.8rem;
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.08;
    margin: 6px 0 0;
  }

  .admin-focus p {
    font-size: 0.9rem;
    margin: 10px 0 0;
    max-width: 720px;
  }

  .admin-lane {
    display: grid;
    gap: 10px;
    min-height: 190px;
  }

  .admin-lane h2 {
    font-size: 1.16rem;
    font-weight: 560;
    line-height: 1.18;
  }

  .admin-lane p {
    font-size: 0.86rem;
    margin: 0;
  }

  @media (max-width: 760px) {
    .admin-focus {
      grid-template-columns: 1fr;
    }
  }
</style>
