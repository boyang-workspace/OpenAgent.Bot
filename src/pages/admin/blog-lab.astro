---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="Prompt Lab" active="blog-lab">
  <section class="admin-grid">
    <div class="admin-panel">
      <span class="eyebrow">Prompt Versions</span>
      <h2>Prompt registry</h2>
      <p class="admin-note">Create a new prompt version, compare outputs in the lab, then activate it when the result looks better.</p>
      <form class="admin-form" id="prompt-form">
        <label>Kind
          <select name="kind">
            <option value="draft-generation">draft-generation</option>
            <option value="outline-generation">outline-generation</option>
            <option value="reviewer">reviewer</option>
            <option value="topic-generation">topic-generation</option>
            <option value="evidence-summarization">evidence-summarization</option>
            <option value="quality-thresholds">quality-thresholds</option>
          </select>
        </label>
        <label>Prompt content<textarea name="content" rows="10" required></textarea></label>
        <label><input name="activate" type="checkbox" /> Activate immediately</label>
        <div class="admin-actions">
          <button class="button" type="submit">Save as new version</button>
          <button class="button secondary" id="refresh-prompts" type="button">Refresh</button>
        </div>
        <p id="prompt-status" class="form-status" role="status"></p>
      </form>
      <div class="admin-list" id="prompt-list" style="margin-top: 16px;">Loading prompts...</div>
    </div>

    <div class="admin-panel">
      <span class="eyebrow">Template Versions</span>
      <h2>Outline template</h2>
      <form class="admin-form" id="template-form">
        <label>Template<textarea name="content" rows="10" required></textarea></label>
        <label><input name="activate" type="checkbox" /> Activate immediately</label>
        <div class="admin-actions">
          <button class="button" type="submit">Save template version</button>
        </div>
        <p id="template-status" class="form-status" role="status"></p>
      </form>
      <div class="admin-list" id="template-list" style="margin-top: 16px;">Loading templates...</div>
    </div>
  </section>

  <section class="admin-grid" style="margin-top: 16px;">
    <div class="admin-panel">
      <span class="eyebrow">Debug Console</span>
      <h2>Run a sandbox step</h2>
      <form class="admin-form" id="debug-form">
        <label>Action
          <select name="action">
            <option value="outline">Generate Outline</option>
            <option value="draft">Generate Draft</option>
            <option value="review">Run Review</option>
          </select>
        </label>
        <div class="admin-form-grid">
          <label>Topic id<input name="topicId" placeholder="Optional if using draft id" /></label>
          <label>Draft id<input name="draftId" placeholder="Optional if using topic id" /></label>
        </div>
        <label>Model
          <select name="model">
            <option value="qwen3.5:9b">qwen3.5:9b</option>
            <option value="gemma4:e4b">gemma4:e4b</option>
          </select>
        </label>
        <div class="admin-actions">
          <button class="button" type="submit">Run sandbox step</button>
          <button class="button secondary" id="refresh-debug" type="button">Refresh runs</button>
        </div>
        <p id="debug-status" class="form-status" role="status"></p>
      </form>
    </div>
    <div class="admin-panel">
      <span class="eyebrow">Latest Preview</span>
      <h2>Prompt / output trace</h2>
      <pre class="admin-preview" id="debug-preview">Run a debug step to inspect the prompt, template, input, and output.</pre>
    </div>
  </section>

  <section class="admin-panel" style="margin-top: 16px;">
    <span class="eyebrow">Sandbox Runs</span>
    <h2>Recent debug history</h2>
    <div class="admin-list" id="debug-runs">Loading debug runs...</div>
  </section>
</AdminLayout>

<script is:inline>
  const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[char]);

  async function api(path, options = {}) {
    const response = await fetch(path, { ...options, headers: { "content-type": "application/json", ...(options.headers ?? {}) } });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) throw new Error(result.error ?? "Request failed.");
    return result;
  }

  function setStatus(id, message, state = "") {
    const status = document.querySelector(id);
    if (status instanceof HTMLElement) {
      status.textContent = message;
      status.dataset.state = state;
    }
  }

  async function loadPrompts() {
    const result = await api("/admin/api/blog/prompt-versions");
    const list = document.querySelector("#prompt-list");
    if (!(list instanceof HTMLElement)) return;
    list.innerHTML = (result.prompts ?? []).map((prompt) => `
      <article class="admin-item">
        <div>
          <strong>${escapeHtml(prompt.kind)} ${escapeHtml(prompt.version)}</strong>
          <p>${escapeHtml(prompt.content.slice(0, 180))}${prompt.content.length > 180 ? "..." : ""}</p>
          <small>${prompt.isActive ? "active" : "inactive"}</small>
        </div>
        <div class="admin-actions">
          ${prompt.isActive ? "" : `<button class="button secondary" data-activate-prompt="${escapeHtml(prompt.id)}" type="button">Activate</button>`}
        </div>
      </article>
    `).join("") || "<p>No prompts found.</p>";
  }

  async function loadTemplates() {
    const result = await api("/admin/api/blog/template-versions");
    const list = document.querySelector("#template-list");
    if (!(list instanceof HTMLElement)) return;
    list.innerHTML = (result.templates ?? []).map((template) => `
      <article class="admin-item">
        <div>
          <strong>${escapeHtml(template.kind)} ${escapeHtml(template.version)}</strong>
          <p>${escapeHtml(template.content.slice(0, 180))}${template.content.length > 180 ? "..." : ""}</p>
          <small>${template.isActive ? "active" : "inactive"}</small>
        </div>
        <div class="admin-actions">
          ${template.isActive ? "" : `<button class="button secondary" data-activate-template="${escapeHtml(template.id)}" type="button">Activate</button>`}
        </div>
      </article>
    `).join("") || "<p>No templates found.</p>";
  }

  async function loadDebugRuns() {
    const result = await api("/admin/api/blog/debug/outline");
    const list = document.querySelector("#debug-runs");
    if (!(list instanceof HTMLElement)) return;
    list.innerHTML = (result.runs ?? []).map((run) => `
      <article class="admin-item">
        <div>
          <strong>${escapeHtml(run.action)} · ${escapeHtml(run.model)}</strong>
          <p>${escapeHtml(JSON.stringify(run.artifactsRef.output ?? {}, null, 2).slice(0, 180))}...</p>
          <small>${escapeHtml(run.createdAt)}</small>
        </div>
        <div class="admin-actions">
          <button class="button secondary" data-open-run="${escapeHtml(run.id)}" type="button">Inspect</button>
        </div>
      </article>
    `).join("") || "<p>No debug runs yet.</p>";
    window.__debugRuns = result.runs ?? [];
  }

  async function refreshAll() {
    await Promise.all([loadPrompts(), loadTemplates(), loadDebugRuns(), loadSettings()]);
  }

  async function loadSettings() {
    const result = await api("/admin/api/settings");
    const model = result.settings?.defaultModel;
    const select = document.querySelector('#debug-form select[name="model"]');
    if (typeof model === "string" && select instanceof HTMLSelectElement) {
      select.value = model;
    }
  }

  document.querySelector("#prompt-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    setStatus("#prompt-status", "Saving prompt version...");
    try {
      await api("/admin/api/blog/prompt-versions", {
        method: "POST",
        body: JSON.stringify({
          kind: String(data.get("kind") ?? ""),
          content: String(data.get("content") ?? ""),
          activate: data.get("activate") === "on"
        })
      });
      setStatus("#prompt-status", "Prompt version saved.", "success");
      await loadPrompts();
    } catch (error) {
      setStatus("#prompt-status", error instanceof Error ? error.message : "Failed to save prompt.", "error");
    }
  });

  document.querySelector("#template-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    setStatus("#template-status", "Saving template version...");
    try {
      await api("/admin/api/blog/template-versions", {
        method: "POST",
        body: JSON.stringify({
          kind: "blog-outline",
          content: String(data.get("content") ?? ""),
          activate: data.get("activate") === "on"
        })
      });
      setStatus("#template-status", "Template version saved.", "success");
      await loadTemplates();
    } catch (error) {
      setStatus("#template-status", error instanceof Error ? error.message : "Failed to save template.", "error");
    }
  });

  document.querySelector("#debug-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    const action = String(data.get("action") ?? "outline");
    setStatus("#debug-status", "Running sandbox step...");
    try {
      const result = await api(`/admin/api/blog/debug/${action}`, {
        method: "POST",
        body: JSON.stringify({
          topicId: String(data.get("topicId") ?? "").trim() || undefined,
          draftId: String(data.get("draftId") ?? "").trim() || undefined,
          model: String(data.get("model") ?? "qwen3.5:9b")
        })
      });
      const preview = document.querySelector("#debug-preview");
      if (preview instanceof HTMLElement) preview.textContent = JSON.stringify(result.preview, null, 2);
      setStatus("#debug-status", "Sandbox step finished.", "success");
      await loadDebugRuns();
    } catch (error) {
      setStatus("#debug-status", error instanceof Error ? error.message : "Debug run failed.", "error");
    }
  });

  document.querySelector("#refresh-prompts")?.addEventListener("click", refreshAll);
  document.querySelector("#refresh-debug")?.addEventListener("click", loadDebugRuns);
  document.querySelector("#prompt-list")?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.activatePrompt) return;
    await api(`/admin/api/blog/prompt-versions/${target.dataset.activatePrompt}/activate`, { method: "PATCH", body: "{}" });
    await loadPrompts();
  });
  document.querySelector("#template-list")?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.activateTemplate) return;
    await api(`/admin/api/blog/template-versions/${target.dataset.activateTemplate}/activate`, { method: "PATCH", body: "{}" });
    await loadTemplates();
  });
  document.querySelector("#debug-runs")?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.openRun) return;
    const run = (window.__debugRuns ?? []).find((item) => item.id === target.dataset.openRun);
    const preview = document.querySelector("#debug-preview");
    if (preview instanceof HTMLElement) preview.textContent = JSON.stringify(run?.artifactsRef ?? {}, null, 2);
  });

  refreshAll().catch((error) => {
    setStatus("#prompt-status", error instanceof Error ? error.message : "Failed to load prompt lab.", "error");
  });
</script>
