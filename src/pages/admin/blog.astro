---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="Articles" active="blog">
  <section class="blog-command">
    <div class="blog-command-copy">
      <span class="eyebrow">Editorial Workbench</span>
      <h2>Turn source-backed topics into publishable guides.</h2>
      <p>Keep the queue small: one decision angle, clear sources, review status, and a publish action.</p>
    </div>
    <div class="blog-command-stats">
      <article class="command-stat">
        <strong id="stat-topics">0</strong>
        <span>topics in queue</span>
      </article>
      <article class="command-stat">
        <strong id="stat-drafts">0</strong>
        <span>drafts in flight</span>
      </article>
      <article class="command-stat">
        <strong id="stat-ready">0</strong>
        <span>ready to publish</span>
      </article>
    </div>
  </section>

  <section class="blog-workbench">
    <aside class="blog-queue admin-panel">
      <div class="queue-header">
        <div>
          <span class="eyebrow">Queue</span>
          <h2>Topics & Drafts</h2>
        </div>
        <div class="admin-actions">
          <button class="button secondary" id="generate-topics" type="button">Generate topics</button>
          <button class="button secondary" id="refresh-blog" type="button">Refresh</button>
        </div>
      </div>

      <div class="queue-tabs" role="tablist" aria-label="Article queue">
        <button class="queue-tab active" id="topics-tab" type="button" data-tab="topics" aria-selected="true">Topics</button>
        <button class="queue-tab" id="drafts-tab" type="button" data-tab="drafts" aria-selected="false">Drafts</button>
      </div>

      <div class="queue-filter-row">
        <input id="queue-search" type="search" placeholder="Search title or keyword" />
        <select id="queue-filter">
          <option value="all">All</option>
          <option value="manual">Manual topics</option>
          <option value="auto">Auto topics</option>
          <option value="approved">Approved drafts</option>
          <option value="ready">Ready drafts</option>
        </select>
      </div>

      <details class="manual-topic-sheet" open>
        <summary>
          <div>
            <strong>Manual Topic</strong>
            <span>Add a hot topic or edit an existing one without leaving the queue.</span>
          </div>
        </summary>
        <form class="admin-form compact-form" id="topic-form">
          <input type="hidden" name="id" />
          <div class="admin-form-grid">
            <label>Title<input name="title" required /></label>
            <label>Lane
              <select name="lane">
                <option value="trend">trend</option>
                <option value="comparison">comparison</option>
                <option value="evergreen">evergreen</option>
              </select>
            </label>
          </div>
          <label>Angle<textarea name="angle" rows="2" required></textarea></label>
          <div class="admin-form-grid">
            <label>Primary keyword<input name="primaryKeyword" required /></label>
            <label>Search intent<input name="searchIntent" required /></label>
          </div>
          <div class="admin-form-grid">
            <label>Date<input name="date" required /></label>
            <label>Priority<input name="priority" type="number" value="100" /></label>
          </div>
          <label>Source links<textarea name="sourceLinks" rows="3" placeholder="One URL per line"></textarea></label>
          <label>Notes<textarea name="notes" rows="2"></textarea></label>
          <label class="checkbox-inline"><input name="manualOverride" type="checkbox" /> Keep even if duplicate warnings fire</label>
          <div class="admin-actions">
            <button class="button" type="submit">Save topic</button>
            <button class="button secondary" id="duplicate-topic" type="button" disabled>Duplicate</button>
            <button class="button secondary" id="promote-topic" type="button" disabled>Promote</button>
            <button class="button secondary" id="clear-topic" type="button">Clear</button>
          </div>
          <p id="topic-status" class="form-status" role="status"></p>
        </form>
      </details>

      <div class="queue-panel active" id="topics-panel">
        <div class="queue-list" id="topic-list">Loading topics...</div>
      </div>
      <div class="queue-panel" id="drafts-panel" hidden>
        <div class="queue-list" id="draft-list">Loading drafts...</div>
      </div>
    </aside>

    <section class="blog-editor admin-panel">
      <div class="editor-header">
        <div>
          <span class="eyebrow">Editor</span>
          <h2 id="editor-title">Select a draft</h2>
          <p id="editor-subtitle" class="editor-subtitle">Pick a draft from the queue to start writing.</p>
        </div>
        <div class="admin-actions">
          <a class="button secondary" href="/admin/publishing/">Publishing</a>
        </div>
      </div>

      <ol class="workflow-steps" id="workflow-steps" aria-label="Draft workflow">
        <li class="step-chip is-current">Draft</li>
        <li class="step-chip">Review</li>
        <li class="step-chip">Approve</li>
        <li class="step-chip">Publish</li>
      </ol>

      <form class="admin-form editor-form" id="blog-form">
        <section class="editor-section">
          <div class="editor-section-head">
            <h3>Article</h3>
            <p>Keep the writing surface front and center. Metadata stays tucked away until you need it.</p>
          </div>
          <label>Title<input name="title" required /></label>
          <label>Summary<textarea name="summary" rows="3" required></textarea></label>
          <div class="body-editor">
            <div class="body-editor-top">
              <label for="body-input">Body</label>
              <div class="body-view-toggle" role="tablist" aria-label="Body view">
                <button class="body-view-tab active" id="body-write-tab" type="button" data-body-view="write" aria-selected="true">Write</button>
                <button class="body-view-tab" id="body-preview-tab" type="button" data-body-view="preview" aria-selected="false">Preview</button>
              </div>
            </div>
            <div class="body-editor-panels">
              <div class="body-pane active" id="body-write-pane">
                <textarea class="editor-body" id="body-input" name="body" rows="22" required></textarea>
              </div>
              <div class="body-pane" id="body-preview-pane" hidden>
                <article class="markdown-preview" id="body-preview">Markdown preview appears here.</article>
              </div>
            </div>
          </div>
        </section>

        <details class="metadata-panel">
          <summary>
            <div>
              <strong>Metadata</strong>
              <span>SEO, slugs, tags, keyword targeting, and source links.</span>
            </div>
          </summary>
          <div class="metadata-grid">
            <label>Slug<input name="slug" required /></label>
            <label>Published date<input name="publishedAt" required /></label>
            <label class="metadata-span">Tags<input name="tags" placeholder="agents,open-source,comparison" required /></label>
            <label class="metadata-span">SEO title<input name="seoTitle" required /></label>
            <label class="metadata-span">SEO description<textarea name="seoDescription" rows="2" required></textarea></label>
            <label>Target keyword<input name="targetKeyword" /></label>
            <label>Search intent<input name="searchIntent" /></label>
            <label class="metadata-span">Source links<textarea name="sourceLinks" rows="4" placeholder="One URL per line"></textarea></label>
          </div>
        </details>

        <div class="editor-actions">
          <button class="button" type="submit" disabled>Save draft</button>
          <button class="button secondary" id="rerun-review" type="button" disabled>Re-run Review</button>
          <button class="button secondary" id="approve-draft" type="button" disabled>Approve</button>
          <button class="button secondary" id="preview-publish" type="button" disabled>Preview publish</button>
          <button class="button" id="publish-pr" type="button" disabled>Create PR</button>
          <button class="button secondary danger" id="delete-draft" type="button" disabled>Delete</button>
        </div>
        <p id="blog-status" class="form-status" role="status"></p>
      </form>
    </section>

    <aside class="blog-inspector admin-panel">
      <div class="inspector-header">
        <div>
          <span class="eyebrow">Inspector</span>
          <h2>Review & Publish</h2>
        </div>
        <span class="status-pill" id="draft-status">No draft selected</span>
      </div>

      <section class="inspector-block">
        <h3>Publish readiness</h3>
        <div class="readiness-card">
          <strong id="readiness-label">No draft selected</strong>
          <p id="readiness-copy">Choose a draft to see what blocks publish.</p>
        </div>
      </section>

      <section class="inspector-block">
        <h3>Blocking issues</h3>
        <div class="diagnostic-list" id="blocking-list">
          <p class="diagnostic-empty">No draft selected.</p>
        </div>
      </section>

      <section class="inspector-block">
        <h3>Warnings</h3>
        <div class="diagnostic-list" id="warning-list">
          <p class="diagnostic-empty">No warnings yet.</p>
        </div>
      </section>

      <section class="inspector-block">
        <h3>Sources</h3>
        <div class="source-list" id="source-list">
          <p class="diagnostic-empty">No source links yet.</p>
        </div>
      </section>

      <section class="inspector-block">
        <h3>Raw reports</h3>
        <details class="report-drawer">
          <summary>Quality report</summary>
          <pre class="admin-preview" id="quality-report">Quality report appears after selecting or saving a draft.</pre>
        </details>
        <details class="report-drawer">
          <summary>Review report</summary>
          <pre class="admin-preview" id="review-report">Review report appears after running review.</pre>
        </details>
      </section>
    </aside>
  </section>
</AdminLayout>

<script is:inline>
  const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[char]);
  let selectedDraft = null;
  let selectedTopic = null;
  let drafts = [];
  let topics = [];
  let topicActionStatus = null;

  async function api(path, options = {}) {
    const response = await fetch(path, { ...options, headers: { "content-type": "application/json", ...(options.headers ?? {}) } });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) throw new Error(result.error ?? "Request failed.");
    return result;
  }

  function setStatus(id, message, state = "") {
    const status = document.querySelector(id);
    if (status instanceof HTMLElement) {
      status.textContent = message;
      status.dataset.state = state;
    }
  }

  function setTopicActionStatus(id, message, state = "") {
    topicActionStatus = id ? { id, message, state } : null;
    renderTopicList();
  }

  function topicPayload({ duplicate = false } = {}) {
    const form = document.querySelector("#topic-form");
    if (!(form instanceof HTMLFormElement)) throw new Error("Topic form unavailable.");
    const data = new FormData(form);
    const title = String(data.get("title") ?? "").trim();
    return {
      title: duplicate ? `${title} copy` : title,
      lane: String(data.get("lane") ?? "trend"),
      angle: String(data.get("angle") ?? "").trim(),
      primaryKeyword: String(data.get("primaryKeyword") ?? "").trim(),
      searchIntent: String(data.get("searchIntent") ?? "").trim(),
      date: String(data.get("date") ?? "").trim(),
      priority: Number(data.get("priority") ?? 100),
      sourceLinks: String(data.get("sourceLinks") ?? "").split("\n").map((item) => item.trim()).filter(Boolean),
      notes: String(data.get("notes") ?? "").trim(),
      manualOverride: data.get("manualOverride") === "on"
    };
  }

  function draftPayload() {
    const form = document.querySelector("#blog-form");
    if (!(form instanceof HTMLFormElement)) throw new Error("Blog form unavailable.");
    const data = new FormData(form);
    return {
      slug: String(data.get("slug") ?? "").trim(),
      title: String(data.get("title") ?? "").trim(),
      summary: String(data.get("summary") ?? "").trim(),
      publishedAt: String(data.get("publishedAt") ?? "").trim(),
      tags: String(data.get("tags") ?? "").split(",").map((item) => item.trim()).filter(Boolean),
      author: "OpenAgent.bot Editors",
      body: String(data.get("body") ?? "").trim(),
      seoTitle: String(data.get("seoTitle") ?? "").trim(),
      seoDescription: String(data.get("seoDescription") ?? "").trim(),
      targetKeyword: String(data.get("targetKeyword") ?? "").trim(),
      searchIntent: String(data.get("searchIntent") ?? "").trim(),
      sourceLinks: String(data.get("sourceLinks") ?? "").split("\n").map((item) => item.trim()).filter(Boolean)
    };
  }

  function renderInlineMarkdown(value) {
    return escapeHtml(value)
      .replace(/`([^`]+)`/g, "<code>$1</code>")
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/\*([^*]+)\*/g, "<em>$1</em>")
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');
  }

  function renderTableBlock(lines) {
    const rows = lines
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => line.replace(/^\||\|$/g, "").split("|").map((cell) => renderInlineMarkdown(cell.trim())));
    if (rows.length < 2) return "";
    const [headers, , ...bodyRows] = rows;
    return `
      <div class="markdown-table-wrap">
        <table class="markdown-table">
          <thead><tr>${headers.map((cell) => `<th>${cell}</th>`).join("")}</tr></thead>
          <tbody>${bodyRows.map((cells) => `<tr>${cells.map((cell) => `<td>${cell}</td>`).join("")}</tr>`).join("")}</tbody>
        </table>
      </div>
    `;
  }

  function renderMarkdownPreview(value) {
    const text = String(value ?? "").trim();
    if (!text) return "<p class=\"markdown-empty\">Nothing to preview yet.</p>";
    const blocks = text.split(/\n{2,}/).map((block) => block.trim()).filter(Boolean);
    return blocks.map((block) => {
      const lines = block.split("\n");
      if (lines.length >= 2 && /^\|/.test(lines[0].trim()) && /^\|?[\s:-|]+\|?$/.test(lines[1].trim())) {
        return renderTableBlock(lines);
      }
      if (/^###\s+/.test(block)) return `<h4>${renderInlineMarkdown(block.replace(/^###\s+/, ""))}</h4>`;
      if (/^##\s+/.test(block)) return `<h3>${renderInlineMarkdown(block.replace(/^##\s+/, ""))}</h3>`;
      if (/^#\s+/.test(block)) return `<h2>${renderInlineMarkdown(block.replace(/^#\s+/, ""))}</h2>`;
      if (lines.every((line) => /^[-*]\s+/.test(line.trim()))) {
        return `<ul>${lines.map((line) => `<li>${renderInlineMarkdown(line.trim().replace(/^[-*]\s+/, ""))}</li>`).join("")}</ul>`;
      }
      return lines.map((line) => `<p>${renderInlineMarkdown(line.trim())}</p>`).join("");
    }).join("");
  }

  function updateBodyPreview() {
    const body = document.querySelector("#body-input");
    const preview = document.querySelector("#body-preview");
    if (!(body instanceof HTMLTextAreaElement) || !(preview instanceof HTMLElement)) return;
    preview.innerHTML = renderMarkdownPreview(body.value);
  }

  function setBodyView(mode) {
    const isPreview = mode === "preview";
    const writePane = document.querySelector("#body-write-pane");
    const previewPane = document.querySelector("#body-preview-pane");
    const writeTab = document.querySelector("#body-write-tab");
    const previewTab = document.querySelector("#body-preview-tab");
    if (writePane instanceof HTMLElement) writePane.hidden = isPreview;
    if (previewPane instanceof HTMLElement) previewPane.hidden = !isPreview;
    if (writePane instanceof HTMLElement) writePane.classList.toggle("active", !isPreview);
    if (previewPane instanceof HTMLElement) previewPane.classList.toggle("active", isPreview);
    if (writeTab instanceof HTMLButtonElement) {
      writeTab.classList.toggle("active", !isPreview);
      writeTab.setAttribute("aria-selected", isPreview ? "false" : "true");
    }
    if (previewTab instanceof HTMLButtonElement) {
      previewTab.classList.toggle("active", isPreview);
      previewTab.setAttribute("aria-selected", isPreview ? "true" : "false");
    }
    if (isPreview) updateBodyPreview();
  }

  function matchesQueueFilter(item, kind) {
    const query = String(document.querySelector("#queue-search")?.value ?? "").trim().toLowerCase();
    const filter = String(document.querySelector("#queue-filter")?.value ?? "all");
    const haystack = kind === "topic"
      ? `${item.title} ${item.primaryKeyword ?? ""} ${item.angle ?? ""}`.toLowerCase()
      : `${item.title} ${item.targetKeyword ?? ""} ${item.content?.summary ?? ""}`.toLowerCase();
    if (query && !haystack.includes(query)) return false;
    if (filter === "all") return true;
    if (filter === "manual") return kind === "topic" && item.sourceType === "manual";
    if (filter === "auto") return kind === "topic" && item.sourceType === "auto";
    if (filter === "approved") return kind === "draft" && item.approvedByHuman;
    if (filter === "ready") return kind === "draft" && item.status === "ready";
    return true;
  }

  function updateStats() {
    const readyCount = drafts.filter((draft) => draft.status === "ready" && draft.approvedByHuman).length;
    document.querySelector("#stat-topics").textContent = String(topics.length);
    document.querySelector("#stat-drafts").textContent = String(drafts.length);
    document.querySelector("#stat-ready").textContent = String(readyCount);
  }

  function switchTab(nextTab) {
    for (const button of document.querySelectorAll(".queue-tab")) {
      if (!(button instanceof HTMLButtonElement)) continue;
      const active = button.dataset.tab === nextTab;
      button.classList.toggle("active", active);
      button.setAttribute("aria-selected", active ? "true" : "false");
    }
    const topicsPanel = document.querySelector("#topics-panel");
    const draftsPanel = document.querySelector("#drafts-panel");
    if (topicsPanel instanceof HTMLElement) topicsPanel.hidden = nextTab !== "topics";
    if (draftsPanel instanceof HTMLElement) draftsPanel.hidden = nextTab !== "drafts";
  }

  function renderTopicForm(topic = null) {
    const form = document.querySelector("#topic-form");
    if (!(form instanceof HTMLFormElement)) return;
    selectedTopic = topic;
    form.elements.id.value = topic?.id ?? "";
    form.elements.title.value = topic?.title ?? "";
    form.elements.lane.value = topic?.lane ?? "trend";
    form.elements.angle.value = topic?.angle ?? "";
    form.elements.primaryKeyword.value = topic?.primaryKeyword ?? "";
    form.elements.searchIntent.value = topic?.searchIntent ?? "";
    form.elements.date.value = topic?.date ?? new Date().toISOString().slice(0, 10);
    form.elements.priority.value = topic?.priority ?? 100;
    form.elements.sourceLinks.value = (topic?.sourceSignals ?? []).join("\n");
    form.elements.notes.value = topic?.notes ?? "";
    form.elements.manualOverride.checked = Boolean(topic?.manualOverride);
    const duplicate = document.querySelector("#duplicate-topic");
    const promote = document.querySelector("#promote-topic");
    if (duplicate instanceof HTMLButtonElement) duplicate.disabled = !topic;
    if (promote instanceof HTMLButtonElement) promote.disabled = !topic;
  }

  function topicCard(topic) {
    const selected = selectedTopic?.id === topic.id ? " is-selected" : "";
    const actionState = topicActionStatus?.id === topic.id ? topicActionStatus : null;
    const generateDisabled = actionState?.state === "loading";
    return `
      <article class="queue-card${selected}">
        <div class="queue-card-main">
          <div class="queue-card-top">
            <strong>${escapeHtml(topic.title)}</strong>
            <span class="queue-badge ${topic.sourceType === "manual" ? "manual" : "auto"}">${escapeHtml(topic.sourceType)}</span>
          </div>
          <p>${escapeHtml(topic.angle)}</p>
          <div class="queue-meta">
            <span>${escapeHtml(topic.date)}</span>
            <span>${escapeHtml(topic.lane)}</span>
            <span>priority ${escapeHtml(topic.priority)}</span>
            <span>${escapeHtml(topic.status)}</span>
          </div>
          ${(topic.warnings ?? []).length ? `<div class="queue-alerts">${topic.warnings.map((warning) => `<span class="alert-chip">${escapeHtml(warning)}</span>`).join("")}</div>` : ""}
          ${actionState ? `<p class="queue-card-status" data-state="${escapeHtml(actionState.state ?? "")}">${escapeHtml(actionState.message)}</p>` : ""}
        </div>
        <div class="admin-actions">
          <button class="button secondary" data-edit-topic="${escapeHtml(topic.id)}" type="button">Edit</button>
          <button class="button" data-draft-topic="${escapeHtml(topic.id)}" type="button" ${generateDisabled ? "disabled" : ""}>${generateDisabled ? "Generating..." : "Generate"}</button>
        </div>
      </article>
    `;
  }

  function draftCard(draft) {
    const selected = selectedDraft?.id === draft.id ? " is-selected" : "";
    const blockingCount = draft.reviewReport?.blockingIssues?.length ?? draft.qualityReport?.issues?.length ?? 0;
    return `
      <article class="queue-card${selected}">
        <div class="queue-card-main">
          <div class="queue-card-top">
            <strong>${escapeHtml(draft.title)}</strong>
            <span class="queue-badge ${draft.approvedByHuman ? "approved" : draft.status === "ready" ? "ready" : "draft"}">${draft.approvedByHuman ? "approved" : escapeHtml(draft.status)}</span>
          </div>
          <p>${escapeHtml(draft.content?.summary ?? "")}</p>
          <div class="queue-meta">
            <span>${escapeHtml(draft.updatedAt?.slice(0, 10) ?? "")}</span>
            <span>${draft.approvedByHuman ? "human approved" : "awaiting approval"}</span>
            <span>${blockingCount} blockers</span>
          </div>
        </div>
        <div class="admin-actions">
          <button class="button secondary" data-open-draft="${escapeHtml(draft.id)}" type="button">Open</button>
        </div>
      </article>
    `;
  }

  function renderTopicList() {
    const list = document.querySelector("#topic-list");
    if (!(list instanceof HTMLElement)) return;
    const visible = topics.filter((topic) => matchesQueueFilter(topic, "topic"));
    list.innerHTML = visible.length ? visible.map(topicCard).join("") : "<p class=\"diagnostic-empty\">No topics match this filter.</p>";
  }

  function renderDraftList() {
    const list = document.querySelector("#draft-list");
    if (!(list instanceof HTMLElement)) return;
    const visible = drafts.filter((draft) => matchesQueueFilter(draft, "draft"));
    list.innerHTML = visible.length ? visible.map(draftCard).join("") : "<p class=\"diagnostic-empty\">No drafts match this filter.</p>";
  }

  function renderReports(draft) {
    const quality = document.querySelector("#quality-report");
    const review = document.querySelector("#review-report");
    if (quality instanceof HTMLElement) quality.textContent = JSON.stringify(draft?.qualityReport ?? {}, null, 2);
    if (review instanceof HTMLElement) review.textContent = JSON.stringify(draft?.reviewReport ?? {}, null, 2);
  }

  function renderDiagnostics(draft) {
    const blockingList = document.querySelector("#blocking-list");
    const warningList = document.querySelector("#warning-list");
    const sourceList = document.querySelector("#source-list");
    const readinessLabel = document.querySelector("#readiness-label");
    const readinessCopy = document.querySelector("#readiness-copy");

    if (!(blockingList instanceof HTMLElement) || !(warningList instanceof HTMLElement) || !(sourceList instanceof HTMLElement)) return;

    if (!draft) {
      blockingList.innerHTML = "<p class=\"diagnostic-empty\">No draft selected.</p>";
      warningList.innerHTML = "<p class=\"diagnostic-empty\">No warnings yet.</p>";
      sourceList.innerHTML = "<p class=\"diagnostic-empty\">No source links yet.</p>";
      if (readinessLabel instanceof HTMLElement) readinessLabel.textContent = "No draft selected";
      if (readinessCopy instanceof HTMLElement) readinessCopy.textContent = "Choose a draft to see what blocks publish.";
      return;
    }

    const blockingIssues = draft.reviewReport?.blockingIssues ?? draft.qualityReport?.issues ?? [];
    const warnings = draft.reviewReport?.warnings ?? [];
    const readyToPublish = draft.status === "ready" && draft.approvedByHuman && blockingIssues.length === 0;

    blockingList.innerHTML = blockingIssues.length
      ? blockingIssues.map((issue) => `<article class="diagnostic-card blocker"><strong>Blocking</strong><p>${escapeHtml(issue)}</p></article>`).join("")
      : "<article class=\"diagnostic-card success\"><strong>Clear</strong><p>No blocking issues remain.</p></article>";

    warningList.innerHTML = warnings.length
      ? warnings.map((warning) => `<article class="diagnostic-card warning"><strong>Warning</strong><p>${escapeHtml(warning)}</p></article>`).join("")
      : "<p class=\"diagnostic-empty\">No warnings right now.</p>";

    sourceList.innerHTML = draft.sourceLinks?.length
      ? draft.sourceLinks.map((link) => `<a class="source-link" href="${escapeHtml(link)}" target="_blank" rel="noreferrer">${escapeHtml(link)}</a>`).join("")
      : "<p class=\"diagnostic-empty\">No source links yet.</p>";

    if (readinessLabel instanceof HTMLElement) readinessLabel.textContent = readyToPublish ? "Ready to publish" : draft.approvedByHuman ? "Approved, but still blocked" : "Needs review and approval";
    if (readinessCopy instanceof HTMLElement) readinessCopy.textContent = readyToPublish
      ? "This draft passed review, has human approval, and can create a publish PR."
      : draft.approvedByHuman
        ? "Approval is in place, but at least one blocking issue still needs to be resolved."
        : "Save, run review, and approve the article before trying to publish.";
  }

  function updateWorkflow(draft) {
    const steps = [...document.querySelectorAll("#workflow-steps .step-chip")];
    const current = !draft ? 0 : draft.approvedByHuman ? (draft.status === "ready" ? 3 : 2) : draft.reviewReport ? 1 : 0;
    steps.forEach((step, index) => {
      step.classList.toggle("is-current", index === current);
      step.classList.toggle("is-done", index < current);
    });
  }

  function selectDraft(draft) {
    selectedDraft = draft;
    renderDraftList();
    const form = document.querySelector("#blog-form");
    const title = document.querySelector("#editor-title");
    const subtitle = document.querySelector("#editor-subtitle");
    const status = document.querySelector("#draft-status");
    if (!(form instanceof HTMLFormElement)) return;
    const content = draft.content ?? {};
    form.elements.title.value = content.title ?? "";
    form.elements.slug.value = content.slug ?? "";
    form.elements.summary.value = content.summary ?? "";
    form.elements.publishedAt.value = content.publishedAt ?? "";
    form.elements.tags.value = (content.tags ?? []).join(",");
    form.elements.seoTitle.value = content.seoTitle ?? "";
    form.elements.seoDescription.value = content.seoDescription ?? "";
    form.elements.targetKeyword.value = draft.targetKeyword ?? "";
    form.elements.searchIntent.value = draft.searchIntent ?? "";
    form.elements.sourceLinks.value = (draft.sourceLinks ?? []).join("\n");
    form.elements.body.value = content.body ?? "";
    updateBodyPreview();
    if (title instanceof HTMLElement) title.textContent = content.title ?? "Blog draft";
    if (subtitle instanceof HTMLElement) subtitle.textContent = draft.approvedByHuman
      ? "This draft is approved. Review blockers on the right before publishing."
      : "Edit the article in the center, then use the right rail to clear blockers and publish.";
    if (status instanceof HTMLElement) status.textContent = `${draft.status}${draft.approvedByHuman ? " · approved" : " · awaiting approval"}${draft.publishStatus ? ` · ${draft.publishStatus}` : ""}`;
    for (const button of form.querySelectorAll("button")) {
      if (button instanceof HTMLButtonElement) button.disabled = false;
    }
    const publishPr = document.querySelector("#publish-pr");
    const preview = document.querySelector("#preview-publish");
    const approve = document.querySelector("#approve-draft");
    const rerun = document.querySelector("#rerun-review");
    const canPublish = draft.status === "ready" && draft.approvedByHuman && (draft.reviewReport?.blockingIssues?.length ?? draft.qualityReport?.issues?.length ?? 0) === 0;
    if (publishPr instanceof HTMLButtonElement) publishPr.disabled = !canPublish;
    if (preview instanceof HTMLButtonElement) preview.disabled = !canPublish;
    if (approve instanceof HTMLButtonElement) approve.disabled = Boolean(draft.approvedByHuman);
    if (rerun instanceof HTMLButtonElement) rerun.disabled = false;
    renderReports(draft);
    renderDiagnostics(draft);
    updateWorkflow(draft);
  }

  async function loadTopics() {
    const result = await api("/admin/api/blog/topics");
    topics = result.topics ?? [];
    renderTopicList();
    updateStats();
  }

  async function loadDrafts() {
    const result = await api("/admin/api/blog/drafts");
    drafts = result.drafts ?? [];
    renderDraftList();
    updateStats();
    if (selectedDraft) {
      const current = drafts.find((draft) => draft.id === selectedDraft.id);
      if (current) selectDraft(current);
    } else if (drafts[0]) {
      selectDraft(drafts[0]);
    }
  }

  async function refreshAll() {
    await Promise.all([loadTopics(), loadDrafts()]);
  }

  async function generateTopics() {
    setStatus("#topic-status", "Generating topic candidates...");
    try {
      await api("/admin/api/blog/topics/generate", { method: "POST", body: "{}" });
      setStatus("#topic-status", "Topic candidates generated.", "success");
      await loadTopics();
    } catch (error) {
      setStatus("#topic-status", error instanceof Error ? error.message : "Failed to generate topics.", "error");
    }
  }

  async function saveTopic() {
    const payload = topicPayload();
    setStatus("#topic-status", selectedTopic ? "Updating topic..." : "Creating topic...");
    try {
      const result = selectedTopic
        ? await api(`/admin/api/blog/topics/${selectedTopic.id}`, { method: "PATCH", body: JSON.stringify(payload) })
        : await api("/admin/api/blog/topics/manual", { method: "POST", body: JSON.stringify(payload) });
      setStatus("#topic-status", "Topic saved.", "success");
      renderTopicForm(result.topic);
      await loadTopics();
      switchTab("topics");
    } catch (error) {
      setStatus("#topic-status", error instanceof Error ? error.message : "Failed to save topic.", "error");
    }
  }

  async function duplicateTopic() {
    if (!selectedTopic) return;
    setStatus("#topic-status", "Duplicating topic...");
    try {
      const result = await api("/admin/api/blog/topics/manual", { method: "POST", body: JSON.stringify(topicPayload({ duplicate: true })) });
      setStatus("#topic-status", "Topic duplicated.", "success");
      renderTopicForm(result.topic);
      await loadTopics();
      switchTab("topics");
    } catch (error) {
      setStatus("#topic-status", error instanceof Error ? error.message : "Failed to duplicate topic.", "error");
    }
  }

  async function promoteTopic() {
    if (!selectedTopic) return;
    setStatus("#topic-status", "Promoting topic priority...");
    try {
      const result = await api(`/admin/api/blog/topics/${selectedTopic.id}`, { method: "PATCH", body: JSON.stringify({ promote: true }) });
      setStatus("#topic-status", "Topic priority increased.", "success");
      renderTopicForm(result.topic);
      await loadTopics();
    } catch (error) {
      setStatus("#topic-status", error instanceof Error ? error.message : "Failed to promote topic.", "error");
    }
  }

  async function createDraftFromTopic(id) {
    setTopicActionStatus(id, "Creating draft from topic...", "loading");
    try {
      const result = await api(`/admin/api/blog/topics/${encodeURIComponent(id)}/draft?topicId=${encodeURIComponent(id)}`, { method: "POST", body: "{}" });
      setTopicActionStatus(id, result.duplicate ? "Draft already exists." : "Draft created.", "success");
      await refreshAll();
      if (result.draft) {
        switchTab("drafts");
        selectDraft(result.draft);
      }
    } catch (error) {
      setTopicActionStatus(id, error instanceof Error ? error.message : "Failed to create draft.", "error");
    }
  }

  async function saveDraft() {
    if (!selectedDraft) return;
    setStatus("#blog-status", "Saving draft...");
    try {
      const result = await api(`/admin/api/blog/drafts/${selectedDraft.id}`, {
        method: "PATCH",
        body: JSON.stringify(draftPayload())
      });
      setStatus("#blog-status", "Draft saved and approval reset for fresh review.", "success");
      await loadDrafts();
      selectDraft(result.draft);
    } catch (error) {
      setStatus("#blog-status", error instanceof Error ? error.message : "Failed to save draft.", "error");
    }
  }

  async function rerunReview() {
    if (!selectedDraft) return;
    setStatus("#blog-status", "Running review...");
    try {
      const result = await api(`/admin/api/blog/drafts/${selectedDraft.id}/review`, { method: "POST", body: "{}" });
      setStatus("#blog-status", "Review completed.", "success");
      await loadDrafts();
      selectDraft(result.draft);
    } catch (error) {
      setStatus("#blog-status", error instanceof Error ? error.message : "Review failed.", "error");
    }
  }

  async function approveDraft() {
    if (!selectedDraft) return;
    setStatus("#blog-status", "Approving draft...");
    try {
      const result = await api(`/admin/api/blog/drafts/${selectedDraft.id}/approve`, { method: "POST", body: "{}" });
      setStatus("#blog-status", "Draft approved and ready for publishing.", "success");
      await loadDrafts();
      selectDraft(result.draft);
    } catch (error) {
      setStatus("#blog-status", error instanceof Error ? error.message : "Approval failed.", "error");
    }
  }

  async function previewPublish() {
    if (!selectedDraft) return;
    setStatus("#blog-status", "Generating publish preview...");
    try {
      const result = await api(`/admin/api/blog/drafts/${selectedDraft.id}/publish-now?dryRun=true`, { method: "POST", body: JSON.stringify({ dryRun: true }) });
      const report = document.querySelector("#review-report");
      if (report instanceof HTMLElement) report.textContent = JSON.stringify(result.preview, null, 2);
      setStatus("#blog-status", "Preview ready. No branch or PR was created.", "success");
    } catch (error) {
      setStatus("#blog-status", error instanceof Error ? error.message : "Preview failed.", "error");
    }
  }

  async function createPublishPr() {
    if (!selectedDraft) return;
    setStatus("#blog-status", "Creating GitHub PR...");
    try {
      const result = await api(`/admin/api/blog/drafts/${selectedDraft.id}/publish-pr`, {
        method: "POST",
        body: JSON.stringify({ idempotencyKey: `blog-publish-pr:${selectedDraft.id}` })
      });
      setStatus("#blog-status", `PR created: ${result.prUrl}`, "success");
      await loadDrafts();
    } catch (error) {
      setStatus("#blog-status", error instanceof Error ? error.message : "Failed to create PR.", "error");
    }
  }

  async function deleteDraft() {
    if (!selectedDraft || !confirm("Delete this blog draft from admin? This does not delete any published GitHub file.")) return;
    setStatus("#blog-status", "Deleting draft...");
    try {
      await api(`/admin/api/blog/drafts/${selectedDraft.id}`, { method: "DELETE" });
      selectedDraft = null;
      setStatus("#blog-status", "Draft deleted.", "success");
      await loadDrafts();
      renderReports(null);
      renderDiagnostics(null);
      updateWorkflow(null);
    } catch (error) {
      setStatus("#blog-status", error instanceof Error ? error.message : "Failed to delete draft.", "error");
    }
  }

  document.querySelector("#generate-topics")?.addEventListener("click", generateTopics);
  document.querySelector("#refresh-blog")?.addEventListener("click", refreshAll);
  document.querySelector("#topic-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    saveTopic();
  });
  document.querySelector("#duplicate-topic")?.addEventListener("click", duplicateTopic);
  document.querySelector("#promote-topic")?.addEventListener("click", promoteTopic);
  document.querySelector("#clear-topic")?.addEventListener("click", () => {
    renderTopicForm(null);
    setStatus("#topic-status", "");
  });
  document.querySelectorAll(".queue-tab").forEach((button) => {
    button.addEventListener("click", () => switchTab(button.dataset.tab ?? "topics"));
  });
  document.querySelector("#queue-search")?.addEventListener("input", () => {
    renderTopicList();
    renderDraftList();
  });
  document.querySelector("#queue-filter")?.addEventListener("change", () => {
    renderTopicList();
    renderDraftList();
  });
  document.querySelector("#topic-list")?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    if (target.dataset.editTopic) {
      const topic = topics.find((item) => item.id === target.dataset.editTopic);
      if (topic) {
        renderTopicForm(topic);
        switchTab("topics");
      }
    }
    if (target.dataset.draftTopic) createDraftFromTopic(target.dataset.draftTopic);
  });
  document.querySelector("#draft-list")?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    if (target.dataset.openDraft) {
      const draft = drafts.find((item) => item.id === target.dataset.openDraft);
      if (draft) {
        switchTab("drafts");
        selectDraft(draft);
      }
    }
  });
  document.querySelector("#blog-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    saveDraft();
  });
  document.querySelector("#rerun-review")?.addEventListener("click", rerunReview);
  document.querySelector("#approve-draft")?.addEventListener("click", approveDraft);
  document.querySelector("#preview-publish")?.addEventListener("click", previewPublish);
  document.querySelector("#publish-pr")?.addEventListener("click", createPublishPr);
  document.querySelector("#delete-draft")?.addEventListener("click", deleteDraft);
  document.querySelector("#body-input")?.addEventListener("input", updateBodyPreview);
  document.querySelectorAll(".body-view-tab").forEach((button) => {
    button.addEventListener("click", () => setBodyView(button.dataset.bodyView ?? "write"));
  });

  renderTopicForm(null);
  renderDiagnostics(null);
  updateWorkflow(null);
  setBodyView("write");
  updateBodyPreview();
  refreshAll().catch((error) => {
    setStatus("#topic-status", error instanceof Error ? error.message : "Failed to load blog admin.", "error");
    setStatus("#blog-status", error instanceof Error ? error.message : "Failed to load blog admin.", "error");
  });
</script>

