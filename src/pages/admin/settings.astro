---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="Settings" active="settings">
  <section class="admin-grid">
    <div class="admin-panel">
      <span class="eyebrow">Access</span>
      <h2>Cloudflare Access</h2>
      <p class="admin-note">Admin login is handled by Cloudflare Access. Protect <code>/admin*</code>, and the APIs under <code>/admin/api/*</code> are covered by that same rule.</p>
      <div class="admin-list">
        <article class="admin-item">
          <div>
            <strong>Allowed user</strong>
            <p>Use your Google account policy in Cloudflare Access.</p>
            <small>Authentication outside the app</small>
          </div>
          <span class="status-pill">Protected</span>
        </article>
      </div>
    </div>
    <div class="admin-panel">
      <span class="eyebrow">Secrets</span>
      <h2>Required bindings</h2>
      <p class="admin-note">D1 binding <code>DB</code> powers submissions and drafts. <code>GITHUB_ADMIN_TOKEN</code> is required only when creating publish PRs.</p>
      <div class="admin-list">
        <article class="admin-item">
          <div>
            <strong>D1</strong>
            <p>Database: openagent_bot</p>
            <small>Binding: DB</small>
          </div>
          <span class="status-pill">Required</span>
        </article>
        <article class="admin-item">
          <div>
            <strong>GitHub token</strong>
            <p>Fine-grained token for contents and pull requests.</p>
            <small>Secret: GITHUB_ADMIN_TOKEN</small>
          </div>
          <span class="status-pill">Publish PRs</span>
        </article>
      </div>
    </div>
    <div class="admin-panel">
      <span class="eyebrow">Local Models</span>
      <h2>Default generation model</h2>
      <p class="admin-note">Set the global default for article generation and review. Advanced prompt tools stay hidden until the workflow needs them again.</p>
      <form class="admin-form" id="local-model-form">
        <label>Default local model
          <select name="defaultModel" id="default-local-model">
            <option value="qwen3.5:9b">qwen3.5:9b</option>
            <option value="gemma4:e4b">gemma4:e4b</option>
            <option value="qwen3.5:4b">qwen3.5:4b</option>
            <option value="qwen3.5:2b">qwen3.5:2b</option>
          </select>
        </label>
        <div class="admin-actions">
          <button class="button" type="submit">Save default model</button>
          <button class="button secondary" id="refresh-local-models" type="button">Refresh</button>
        </div>
        <p id="local-model-status" class="form-status" role="status"></p>
      </form>
      <div class="admin-list" id="available-local-models" style="margin-top: 16px;">Loading local models...</div>
    </div>
    <div class="admin-panel">
      <span class="eyebrow">Article Workbench</span>
      <h2>Review controls</h2>
      <p class="admin-note">For now the public admin keeps only topic queues, draft review, source checks, and publishing. Prompt experiments can remain off the main path.</p>
      <div class="admin-list">
        <article class="admin-item">
          <div>
            <strong>Advanced prompt tools</strong>
            <p>Hidden from the main navigation so daily publishing stays focused.</p>
            <small>Available by direct URL if needed</small>
          </div>
          <span class="status-pill">Parked</span>
        </article>
        <article class="admin-item">
          <div>
            <strong>Human approval</strong>
            <p>Article drafts must pass review and be explicitly approved before publish PR creation.</p>
            <small>Draft approval is stored in D1</small>
          </div>
          <span class="status-pill">Required</span>
        </article>
      </div>
    </div>
  </section>
</AdminLayout>

<script is:inline>
  async function api(path, options = {}) {
    const response = await fetch(path, { ...options, headers: { "content-type": "application/json", ...(options.headers ?? {}) } });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) throw new Error(result.error ?? "Request failed.");
    return result;
  }

  function setStatus(id, message, state = "") {
    const status = document.querySelector(id);
    if (status instanceof HTMLElement) {
      status.textContent = message;
      status.dataset.state = state;
    }
  }

  function renderLocalModels(settings) {
    const select = document.querySelector("#default-local-model");
    const list = document.querySelector("#available-local-models");
    if (select instanceof HTMLSelectElement) select.value = settings.defaultModel ?? "qwen3.5:9b";
    if (list instanceof HTMLElement) {
      const available = Array.isArray(settings.availableModels) ? settings.availableModels : [];
      const supported = Array.isArray(settings.supportedModels) ? settings.supportedModels : [];
      list.innerHTML = `
        <article class="admin-item">
          <div>
            <strong>Current default</strong>
            <p>${settings.defaultModel ?? "qwen3.5:9b"}</p>
            <small>Used by article generation unless you override it in an advanced run.</small>
          </div>
          <span class="status-pill">Active</span>
        </article>
        <article class="admin-item">
          <div>
            <strong>Available in Ollama</strong>
            <p>${available.length ? available.join(", ") : "No local models detected right now."}</p>
            <small>Supported defaults: ${supported.join(", ")}</small>
          </div>
          <span class="status-pill">${available.length ? `${available.length} found` : "Unavailable"}</span>
        </article>
      `;
    }
  }

  async function loadSettings() {
    const result = await api("/admin/api/settings");
    renderLocalModels(result.settings ?? {});
  }

  document.querySelector("#local-model-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    setStatus("#local-model-status", "Saving default model...");
    try {
      const result = await api("/admin/api/settings", {
        method: "PATCH",
        body: JSON.stringify({ defaultModel: String(data.get("defaultModel") ?? "").trim() })
      });
      renderLocalModels(result.settings ?? {});
      setStatus("#local-model-status", "Default model saved. New runs will use it.", "success");
    } catch (error) {
      setStatus("#local-model-status", error instanceof Error ? error.message : "Failed to save default model.", "error");
    }
  });

  document.querySelector("#refresh-local-models")?.addEventListener("click", async () => {
    try {
      await loadSettings();
      setStatus("#local-model-status", "Local model settings refreshed.", "success");
    } catch (error) {
      setStatus("#local-model-status", error instanceof Error ? error.message : "Failed to refresh local models.", "error");
    }
  });

  loadSettings().catch((error) => {
    setStatus("#local-model-status", error instanceof Error ? error.message : "Failed to load local model settings.", "error");
  });
</script>
