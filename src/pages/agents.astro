---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntityTable from "@/components/EntityTable.astro";
import { getRegistry } from "@/lib/registry/runtime";
import type { RegistryEntity } from "@/lib/registry/types";

let mostFollowed: RegistryEntity[] = [];
let recentlyActive: RegistryEntity[] = [];
let recentlyVerified: RegistryEntity[] = [];
let total = 0;
try {
  const registry = getRegistry();
  const [followed, active, recent] = await Promise.all([
    registry.listEntities({ domains: ["agent"], sort: "stars", limit: 8 }),
    registry.listEntities({ domains: ["agent"], sort: "activity", limit: 8 }),
    registry.listEntities({ domains: ["agent"], sort: "updated", limit: 6 })
  ]);
  mostFollowed = followed.items;
  recentlyActive = active.items;
  recentlyVerified = recent.items;
  total = followed.total;
} catch {}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Open-Source AI Agents Database",
  description: "Activity, openness and source evidence for open agent frameworks, coding agents and autonomous systems.",
  url: "https://www.openagent.bot/agents",
  creator: { "@type": "Organization", name: "OpenAgent.bot" },
  dateModified: new Date().toISOString()
};
---

<BaseLayout title="Open-Source AI Agents Database" description="Track open agent frameworks, coding agents and autonomous systems by activity, openness and verified source evidence." path="/agents">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="page-shell"><div class="page-grid collection-page">
    <section class="collection-hero">
      <div><span class="kicker">Software intelligence</span><h1>Open Agents</h1><p>Track open agent frameworks, coding agents and autonomous systems by activity, openness and source evidence.</p></div>
      <div class="collection-stat"><strong>{total}</strong><span>agent-field records</span><a href="/database?domain=agent">Browse all agents →</a></div>
    </section>
    <nav class="task-links" aria-label="Agent categories">
      <a href="/database?domain=agent&kind=agent">Coding and autonomous agents</a>
      <a href="/database?domain=agent&kind=agent-framework">Agent frameworks</a>
      <a href="/database?domain=agent&kind=tool">Agent tools</a>
      <a href="/database?domain=agent&sort=activity">Recently active</a>
    </nav>
    <section class="collection-section"><header><div><span class="eyebrow">Current adoption snapshot</span><h2>Most followed</h2></div><p>Repository stars are shown as an adoption baseline, not a momentum ranking.</p></header><EntityTable entities={mostFollowed} /></section>
    <section class="collection-section"><header><div><span class="eyebrow">Repository signals</span><h2>Recently active</h2></div><a href="/database?domain=agent&sort=activity">Open activity view →</a></header><EntityTable entities={recentlyActive} /></section>
    <section class="collection-section"><header><div><span class="eyebrow">Registry updates</span><h2>Recently verified</h2></div><p>Records most recently checked against their registered sources.</p></header><EntityTable entities={recentlyVerified} /></section>
  </div></div>
</BaseLayout>

<style>
  .collection-hero { align-items: end; border-bottom: 1px solid var(--ink); display: grid; gap: 44px; grid-template-columns: 1fr 220px; padding: 42px 48px 38px; }
  .collection-hero h1 { font-size: clamp(3rem, 6vw, 6.2rem); font-weight: 600; letter-spacing: -.06em; line-height: .9; margin: 20px 0; }
  .collection-hero p { color: var(--muted); font-size: 1.05rem; line-height: 1.55; margin: 0; max-width: 720px; }
  .collection-stat { border-left: 1px solid var(--ink); display: grid; gap: 9px; padding-left: 22px; }
  .collection-stat strong { font-size: 2.4rem; line-height: 1; }
  .collection-stat span, .collection-stat a { font-family: var(--mono); font-size: .61rem; text-transform: uppercase; }
  .collection-stat span { color: var(--muted); }
  .collection-stat a { margin-top: 16px; text-decoration: underline; text-underline-offset: 4px; }
  .task-links { border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: repeat(4, 1fr); }
  .task-links a { border-right: 1px solid var(--line); font-family: var(--mono); font-size: .63rem; padding: 18px; text-transform: uppercase; }
  .task-links a:last-child { border: 0; }
  .task-links a:hover { background: var(--acid); }
  .collection-section { border-bottom: 1px solid var(--ink); padding: 34px 42px 40px; }
  .collection-section > header { align-items: end; display: flex; gap: 32px; justify-content: space-between; margin-bottom: 22px; }
  .collection-section h2 { font-size: 2rem; letter-spacing: -.04em; margin: 8px 0 0; }
  .collection-section header p, .collection-section header > a { color: var(--muted); font-size: .72rem; line-height: 1.5; margin: 0; max-width: 420px; }
  .collection-section header > a { font-family: var(--mono); text-decoration: underline; text-transform: uppercase; text-underline-offset: 4px; }
  @media (max-width: 760px) {
    .collection-hero { align-items: start; gap: 25px; grid-template-columns: 1fr; padding: 30px 20px; }
    .collection-stat { border-left: 0; border-top: 1px solid var(--line); padding: 18px 0 0; }
    .task-links { grid-template-columns: 1fr 1fr; }
    .task-links a:nth-child(2n) { border-right: 0; }
    .task-links a:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .collection-section { padding: 30px 14px; }
    .collection-section > header { align-items: start; display: grid; gap: 10px; }
  }
</style>
