---
import { getPublishedBlogPosts } from "@/lib/content/blog";
import EditorialShell from "@/components/EditorialShell.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const allPosts = await getPublishedBlogPosts();

function escapeHtml(value: string): string {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function inlineMarkdown(value: string): string {
  return escapeHtml(value)
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+|\/[^)\s]+)\)/g, '<a href="$2">$1</a>');
}

function renderTable(lines: string[]): string {
  const rows = lines
    .filter((line) => !/^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?$/.test(line))
    .map((line) =>
      line
        .trim()
        .replace(/^\|/, "")
        .replace(/\|$/, "")
        .split("|")
        .map((cell) => inlineMarkdown(cell.trim()))
    );
  const [head, ...body] = rows;
  if (!head) return "";
  return `<div class="table-wrap"><table><thead><tr>${head.map((cell) => `<th>${cell}</th>`).join("")}</tr></thead><tbody>${body
    .map((row) => `<tr>${row.map((cell) => `<td>${cell}</td>`).join("")}</tr>`)
    .join("")}</tbody></table></div>`;
}

function renderBlogBody(markdown: string): string {
  const lines = markdown.split("\n");
  const html: string[] = [];
  let paragraph: string[] = [];
  let list: string[] = [];
  let table: string[] = [];

  const flushParagraph = () => {
    if (!paragraph.length) return;
    html.push(`<p>${inlineMarkdown(paragraph.join(" "))}</p>`);
    paragraph = [];
  };
  const flushList = () => {
    if (!list.length) return;
    html.push(`<ul>${list.map((item) => `<li>${inlineMarkdown(item)}</li>`).join("")}</ul>`);
    list = [];
  };
  const flushTable = () => {
    if (!table.length) return;
    html.push(renderTable(table));
    table = [];
  };
  const flushAll = () => {
    flushParagraph();
    flushList();
    flushTable();
  };

  for (const rawLine of lines) {
    const line = rawLine.trim();
    if (!line) {
      flushAll();
      continue;
    }

    if (line.startsWith("|") && line.endsWith("|")) {
      flushParagraph();
      flushList();
      table.push(line);
      continue;
    }

    flushTable();

    if (line.startsWith("### ")) {
      flushParagraph();
      flushList();
      html.push(`<h3>${inlineMarkdown(line.slice(4))}</h3>`);
      continue;
    }

    if (line.startsWith("## ")) {
      flushParagraph();
      flushList();
      html.push(`<h2>${inlineMarkdown(line.slice(3))}</h2>`);
      continue;
    }

    if (line.startsWith("- ")) {
      flushParagraph();
      list.push(line.slice(2));
      continue;
    }

    flushList();
    paragraph = [line];
    flushParagraph();
  }

  flushAll();
  return html.join("\n");
}

function uniqueLinks(links: string[]): string[] {
  return [...new Set(links)];
}

function extractLinks(markdown: string, kind: "external" | "internal"): string[] {
  const linkMatches = [...markdown.matchAll(/\[[^\]]+\]\((https?:\/\/[^)\s]+|\/[^)\s]+)\)/g)].map((match) => match[1]);
  const rawMatches = [...markdown.matchAll(/(^|\s)(https?:\/\/[^\s)]+)/g)].map((match) => match[2]);
  const links = uniqueLinks([...linkMatches, ...rawMatches]);
  return links.filter((link) => (kind === "external" ? link.startsWith("http") : link.startsWith("/")));
}

function linkLabel(link: string): string {
  if (link.startsWith("/")) return link;
  try {
    const url = new URL(link);
    if (url.hostname === "github.com") {
      const [owner, repo] = url.pathname.split("/").filter(Boolean);
      if (owner && repo) return `${owner}/${repo}`;
    }
    return url.hostname.replace(/^www\./, "");
  } catch {
    return link;
  }
}

const bodyHtml = renderBlogBody(post.body);
const sourceLinks = extractLinks(post.body, "external").slice(0, 8);
const internalLinks = extractLinks(post.body, "internal").slice(0, 8);
const relatedPosts = allPosts.filter((item) => item.slug !== post.slug).slice(0, 3);
---

<BaseLayout
  title={post.seoTitle ?? post.title}
  description={post.seoDescription ?? post.summary}
  path={`/blog/${post.slug}`}
>
  <EditorialShell active="blog">
    <div class="article-layout">
      <article class="article">
        <span class="eyebrow">Guide · {post.publishedAt} · {post.author}</span>
        <h1>{post.title}</h1>
        <p class="dek">{post.summary}</p>
        <div class="article-meta">
          {post.tags.slice(0, 5).map((tag) => <small>{tag}</small>)}
        </div>
        <div class="body" set:html={bodyHtml} />
      </article>

      <aside class="article-rail" aria-label="Guide context">
        <section>
          <span class="eyebrow">Reader intent</span>
          <strong>Compare before adopting</strong>
          <p>Use this guide to move from a broad search query to a smaller list of tools worth testing.</p>
        </section>

        <section>
          <span class="eyebrow">Sources</span>
          {
            sourceLinks.length ? (
              <div class="rail-links">
                {sourceLinks.map((link) => (
                  <a href={link} target="_blank" rel="noreferrer">{linkLabel(link)}</a>
                ))}
              </div>
            ) : (
              <p>No external source links detected in this guide.</p>
            )
          }
        </section>

        {
          internalLinks.length > 0 && (
            <section>
              <span class="eyebrow">OpenAgent links</span>
              <div class="rail-links">
                {internalLinks.map((link) => (
                  <a href={link}>{linkLabel(link)}</a>
                ))}
              </div>
            </section>
          )
        }

        {
          relatedPosts.length > 0 && (
            <section>
              <span class="eyebrow">Related guides</span>
              <div class="related-guides">
                {relatedPosts.map((item) => (
                  <a href={`/blog/${item.slug}`}>
                    <strong>{item.title}</strong>
                    <span>{item.publishedAt}</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <section class="rail-cta">
          <span class="eyebrow">Next step</span>
          <a class="button" href="/evaluations">Open evaluations</a>
          <a class="button secondary" href="/agents">Browse agents</a>
        </section>
      </aside>
    </div>
  </EditorialShell>
</BaseLayout>

<script is:inline type="application/ld+json" set:html={JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.summary,
    datePublished: post.publishedAt,
    author: {
      "@type": "Person",
      name: post.author
    },
    publisher: {
      "@type": "Organization",
      name: "OpenAgent.bot",
      url: "https://www.openagent.bot"
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `https://www.openagent.bot/blog/${post.slug}`
    }
  },
  ...(post.body.includes("|Best for") || post.body.includes("Best for")
    ? [{
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: post.title,
        description: post.summary,
        numberOfItems: (post.body.match(/\*\*([^*]+)\*\*.*?https?:\/\/[^\s)]+/g)?.length ?? 0) || 3
      }]
    : [])
].filter(Boolean))} />
</script>

<style>
  .article-layout {
    align-items: start;
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 780px) 300px;
    min-width: 0;
  }

  .article {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    min-width: 0;
    padding: 30px;
  }

  h1 {
    color: var(--ink);
    font-size: clamp(1.85rem, 4vw, 2.45rem);
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.08;
    margin: 12px 0 0;
    overflow-wrap: anywhere;
  }

  .dek {
    font-size: 0.95rem;
    margin-bottom: 0;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .article-meta small {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.74rem;
    padding: 4px 8px;
  }

  .body {
    border-top: 1px solid var(--line);
    margin-top: 32px;
    min-width: 0;
    padding-top: 28px;
  }

  .body :global(p) {
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .body :global(h2) {
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.32rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.12;
    margin: 34px 0 12px;
    padding-top: 26px;
  }

  .body :global(h3) {
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 560;
    letter-spacing: 0;
    margin: 24px 0 10px;
  }

  .body :global(ul) {
    color: var(--ink);
    margin: 12px 0 22px;
    padding-left: 1.2rem;
  }

  .body :global(li) {
    margin: 8px 0;
  }

  .body :global(a) {
    color: var(--accent-info);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .body :global(code) {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.92em;
    padding: 0.08em 0.28em;
  }

  .body :global(.table-wrap) {
    border: 1px solid var(--line);
    border-radius: 8px;
    margin: 18px 0 28px;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
  }

  .body :global(table) {
    border-collapse: collapse;
    font-size: 0.92rem;
    width: 100%;
  }

  .body :global(th),
  .body :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 12px;
    text-align: left;
    vertical-align: top;
  }

  .body :global(th) {
    background: var(--surface-soft);
    color: var(--ink);
    font-weight: 600;
  }

  .body :global(tr:last-child td) {
    border-bottom: 0;
  }

  .article-rail {
    display: grid;
    gap: 12px;
    position: sticky;
    top: 82px;
  }

  .article-rail section {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 10px;
    padding: 16px;
  }

  .article-rail strong {
    font-size: 0.98rem;
    font-weight: 560;
    line-height: 1.25;
  }

  .article-rail p {
    font-size: 0.82rem;
    margin: 0;
  }

  .rail-links,
  .related-guides {
    display: grid;
    gap: 8px;
  }

  .rail-links a,
  .related-guides a {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.82rem;
    overflow-wrap: anywhere;
    padding: 9px 10px;
  }

  .related-guides a {
    display: grid;
    gap: 4px;
  }

  .related-guides span {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .rail-cta .button {
    justify-content: center;
    width: 100%;
  }

  @media (max-width: 980px) {
    .article-layout {
      grid-template-columns: 1fr;
    }

    .article-rail {
      position: static;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2rem;
    }

    .article {
      padding: 20px;
    }
  }
</style>
