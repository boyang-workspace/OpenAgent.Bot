---
import EditorialShell from "@/components/EditorialShell.astro";
import { getPublishedBlogPosts } from "@/lib/content/blog";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = await getPublishedBlogPosts();
const featuredPost = posts[0];
const supportingPosts = posts.slice(1);
---

<BaseLayout title="Guides" description="Comparison guides, evaluation notes, and evidence-backed articles for open-source agents and AI tooling." path="/blog">
  <EditorialShell
    active="blog"
    eyebrow="Guides"
    title="Comparison guides for choosing agents and models."
    description="Search-backed notes that connect the directory, evaluations, and real source links into pages people can land on from Google."
  >
    <section class="guide-console">
      <div class="guide-console-copy">
        <span class="eyebrow">Editorial system</span>
        <h2>Every guide should point readers toward a decision.</h2>
        <p>
          Comparisons, checklists, and trend explainers work best when they end in a concrete next step:
          inspect an agent profile, read a benchmark, or subscribe to the signal.
        </p>
      </div>
      <div class="guide-metrics" aria-label="Guide metrics">
        <span><strong>{posts.length}</strong> guides</span>
        <span><strong>3</strong> intent lanes</span>
        <span><strong>SEO</strong> ready</span>
      </div>
    </section>

    {
      featuredPost && (
        <section class="featured-guide">
          <a href={`/blog/${featuredPost.slug}`}>
            <span class="eyebrow">Featured guide</span>
            <h2>{featuredPost.title}</h2>
            <p>{featuredPost.summary}</p>
            <div class="guide-tags">
              {featuredPost.tags.slice(0, 4).map((tag) => <small>{tag}</small>)}
            </div>
          </a>
          <aside>
            <span class="eyebrow">Reader intent</span>
            <ul>
              <li>Compare tools before adopting one</li>
              <li>Validate open-source claims and source links</li>
              <li>Move from research to a short candidate list</li>
            </ul>
          </aside>
        </section>
      )
    }

    <section class="guide-index" aria-label="All guides">
      <div class="guide-index-head">
        <span>Guide</span>
        <span>Tags</span>
        <span>Updated</span>
      </div>
      {
        supportingPosts.map((post) => (
          <a class="guide-row" href={`/blog/${post.slug}`}>
            <div>
              <h2>{post.title}</h2>
              <p>{post.summary}</p>
            </div>
            <div class="guide-tags">{post.tags.slice(0, 3).map((tag) => <small>{tag}</small>)}</div>
            <time>{post.publishedAt}</time>
          </a>
        ))
      }
    </section>
  </EditorialShell>
</BaseLayout>

<style>
  .guide-console {
    align-items: end;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-bottom: 18px;
    padding: 22px;
  }

  .guide-console h2 {
    font-size: 1.55rem;
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.12;
    margin: 8px 0 0;
  }

  .guide-console p {
    font-size: 0.9rem;
    margin: 10px 0 0;
    max-width: 680px;
  }

  .guide-metrics {
    display: flex;
    gap: 8px;
  }

  .guide-metrics span {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    display: grid;
    font-size: 0.76rem;
    gap: 2px;
    min-width: 92px;
    padding: 10px 12px;
  }

  .guide-metrics strong {
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 620;
  }

  .featured-guide {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1.7fr) minmax(240px, 0.8fr);
    margin-bottom: 18px;
  }

  .featured-guide a,
  .featured-guide aside,
  .guide-index {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .featured-guide a {
    display: grid;
    gap: 10px;
    padding: 24px;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .featured-guide a:hover,
  .guide-row:hover {
    border-color: var(--line-strong);
    box-shadow: 0 8px 24px rgba(21, 101, 216, 0.06);
  }

  .featured-guide h2 {
    font-size: 2rem;
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.08;
    margin: 0;
  }

  .featured-guide p {
    font-size: 0.96rem;
    margin: 0;
    max-width: 760px;
  }

  .featured-guide aside {
    padding: 20px;
  }

  .featured-guide ul {
    color: var(--ink);
    display: grid;
    font-size: 0.88rem;
    gap: 10px;
    line-height: 1.55;
    margin: 12px 0 0;
    padding-left: 1.1rem;
  }

  .guide-index {
    overflow: hidden;
  }

  .guide-index-head,
  .guide-row {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1.6fr) minmax(180px, 0.7fr) 110px;
  }

  .guide-index-head {
    background: var(--surface-soft);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    padding: 11px 16px;
    text-transform: uppercase;
  }

  .guide-row {
    border-bottom: 1px solid var(--line);
    padding: 16px;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .guide-row:last-child {
    border-bottom: 0;
  }

  .guide-row h2 {
    font-size: 1.02rem;
    font-weight: 560;
    line-height: 1.25;
    margin: 0;
  }

  .guide-row p {
    font-size: 0.84rem;
    margin: 6px 0 0;
  }

  .guide-tags {
    align-items: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
  }

  small {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.1;
    padding: 4px 8px;
  }

  time {
    color: var(--muted);
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .guide-console,
    .featured-guide,
    .guide-index-head,
    .guide-row {
      grid-template-columns: 1fr;
    }

    .guide-index-head {
      display: none;
    }

    .guide-metrics {
      flex-wrap: wrap;
    }
  }
</style>
