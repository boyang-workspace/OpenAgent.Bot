---
import EditorialShell from "@/components/EditorialShell.astro";
import { getPublishedBlogPosts } from "@/lib/content/blog";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = await getPublishedBlogPosts();
const featuredPost = posts[0];
const supportingPosts = posts.slice(1);
---

<BaseLayout title="Guides" description="Comparison guides, evaluation notes, and evidence-backed articles for open-source agents and AI tooling." path="/blog">
  <EditorialShell
    active="blog"
    eyebrow="Guides"
    title="Guides for choosing open agents and builder tools."
    description="Comparison articles, checklists, and explainers that help search visitors move from research to a short candidate list."
  >
    {
      featuredPost && (
        <section class="featured-guide">
          <a href={`/blog/${featuredPost.slug}`} data-analytics="blog" data-analytics-payload={JSON.stringify({title: featuredPost.title, slug: featuredPost.slug, featured: true})}>
            <span class="eyebrow">Featured guide</span>
            <h2>{featuredPost.title}</h2>
            <p>{featuredPost.summary}</p>
            <div class="guide-tags">
              {featuredPost.tags.slice(0, 4).map((tag) => <small>{tag}</small>)}
            </div>
          </a>
        </section>
      )
    }

    <section class="guide-grid" aria-label="All guides">
      {
        supportingPosts.map((post) => (
          <a class="guide-card" href={`/blog/${post.slug}`} data-analytics="blog" data-analytics-payload={JSON.stringify({title: post.title, slug: post.slug})}>
            <time>{post.publishedAt}</time>
            <h2>{post.title}</h2>
            <p>{post.summary}</p>
            <div class="guide-tags">{post.tags.slice(0, 3).map((tag) => <small>{tag}</small>)}</div>
          </a>
        ))
      }
    </section>
  </EditorialShell>
</BaseLayout>

<style>
  .featured-guide {
    margin-bottom: 16px;
  }

  .featured-guide a,
  .guide-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 10px;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .featured-guide a {
    padding: 24px;
  }

  .featured-guide a:hover,
  .guide-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  .featured-guide h2 {
    color: var(--ink);
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.08;
    margin: 0;
    max-width: 880px;
  }

  .featured-guide p {
    font-size: 0.92rem;
    margin: 0;
    max-width: 760px;
  }

  .guide-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .guide-card {
    min-height: 210px;
    padding: 18px;
  }

  .guide-card h2 {
    color: var(--ink);
    font-size: 1.08rem;
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.24;
    margin: 0;
  }

  .guide-card p {
    display: -webkit-box;
    font-size: 0.84rem;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  time {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .guide-tags {
    align-items: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
    min-width: 0;
  }

  small {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.1;
    padding: 4px 8px;
  }

  @media (max-width: 820px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
