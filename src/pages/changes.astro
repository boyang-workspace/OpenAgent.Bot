---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRegistry } from "@/lib/registry/runtime";
import { label, relativeDate, calendarDate } from "@/lib/registry/format";
import type { RegistryChange } from "@/lib/registry/types";

const requestedType = Astro.url.searchParams.get("type") ?? "all";
let changes: RegistryChange[] = [];
try { changes = await getRegistry().listChanges(100); } catch {}

const matchesFilter = (change: RegistryChange) => {
  if (requestedType === "agents") return change.entityKind === "agent" || change.entityKind === "agent-framework";
  if (requestedType === "robotics") return ["robot", "robotics-framework", "hardware", "simulator"].includes(change.entityKind);
  if (requestedType === "activity") return /stars|forks|issues|commit|release|downloads/.test(change.factKey);
  if (requestedType === "openness") return /open|license|weights|hardware|code/.test(change.factKey);
  if (requestedType === "metadata") return !/stars|forks|issues|commit|release|downloads|open|license|weights|hardware|code/.test(change.factKey);
  return true;
};
const filtered = changes.filter(matchesFilter);
const groups = Array.from(filtered.reduce((map, change) => {
  const minute = change.detectedAt.slice(0, 16);
  const key = `${change.entitySlug}:${minute}`;
  const group = map.get(key) ?? { entitySlug: change.entitySlug, entityName: change.entityName, entityKind: change.entityKind, detectedAt: change.detectedAt, changes: [] as RegistryChange[] };
  group.changes.push(change);
  map.set(key, group);
  return map;
}, new Map<string, { entitySlug: string; entityName: string; entityKind: RegistryChange["entityKind"]; detectedAt: string; changes: RegistryChange[] }>()).values());

function displayValue(value: unknown): string {
  if (value === undefined) return "Not recorded";
  const text = typeof value === "string" ? value : JSON.stringify(value);
  return text.length > 80 ? `${text.slice(0, 77)}…` : text;
}
---

<BaseLayout title="Agent & Robotics Project Changes" description="A timestamped feed of verified changes across open agents, robot platforms, models and infrastructure." path="/changes" noindex={Astro.url.searchParams.size > 0}>
  <div class="page-shell"><div class="page-grid changes-page">
    <section class="changes-head"><div><span class="kicker">Open ecosystem change feed</span><h1>Changes</h1><p>Verified differences between source observations, grouped by project and collection run.</p></div><div class="feed-count"><strong>{groups.length}</strong><span>change groups</span></div></section>
    <nav class="change-filters" aria-label="Change feed filters">
      {[{ key: "all", label: "All" }, { key: "agents", label: "Agents" }, { key: "robotics", label: "Robotics" }, { key: "activity", label: "Activity" }, { key: "openness", label: "Openness" }, { key: "metadata", label: "Metadata" }].map((item) => <a class:list={{ active: requestedType === item.key }} href={item.key === "all" ? "/changes" : `/changes?type=${item.key}`}>{item.label}</a>)}
    </nav>
    <section class="change-feed">
      {groups.length ? groups.map((group) => (
        <details class="change-group">
          <summary>
            <span class="change-time"><time datetime={group.detectedAt}>{calendarDate(group.detectedAt)}</time><small>{relativeDate(group.detectedAt)}</small></span>
            <span class="change-entity"><strong>{group.entityName}</strong><small>{label(group.entityKind)}</small></span>
            <span class="change-count">{group.changes.length} {group.changes.length === 1 ? "field" : "fields"} changed</span>
            <span aria-hidden="true">+</span>
          </summary>
          <div class="change-diffs">
            {group.changes.map((change) => <div><strong>{label(change.factKey)}</strong><span>{displayValue(change.previousValue)}</span><b>→</b><span>{displayValue(change.nextValue)}</span></div>)}
            <a href={`/project/${group.entitySlug}`}>Open {group.entityName} dossier →</a>
          </div>
        </details>
      )) : <div class="empty-state">No verified changes match this view yet.</div>}
    </section>
  </div></div>
</BaseLayout>

<style>
  .changes-head { align-items: end; border-bottom: 1px solid var(--ink); display: grid; gap: 40px; grid-template-columns: 1fr 170px; padding: 38px 44px 34px; }
  .changes-head h1 { font-size: clamp(3rem, 6vw, 6rem); letter-spacing: -.06em; line-height: .9; margin: 18px 0; }
  .changes-head p { color: var(--muted); line-height: 1.55; margin: 0; max-width: 700px; }
  .feed-count { border-left: 1px solid var(--ink); display: grid; gap: 7px; padding-left: 20px; }
  .feed-count strong { font-size: 2rem; }
  .feed-count span { color: var(--muted); font-family: var(--mono); font-size: .6rem; text-transform: uppercase; }
  .change-filters { border-bottom: 1px solid var(--ink); display: flex; overflow-x: auto; }
  .change-filters a { border-right: 1px solid var(--line); font-family: var(--mono); font-size: .61rem; padding: 15px 18px; text-transform: uppercase; }
  .change-filters a.active, .change-filters a:hover { background: var(--acid); }
  .change-feed { padding: 28px 36px 48px; }
  .change-group { border: 1px solid var(--line); border-bottom: 0; }
  .change-group:last-child { border-bottom: 1px solid var(--line); }
  .change-group summary { align-items: center; cursor: pointer; display: grid; gap: 18px; grid-template-columns: 120px minmax(220px, 1fr) 140px 18px; min-height: 76px; padding: 12px 18px; }
  .change-group[open] summary, .change-group summary:hover { background: var(--paper-raised); }
  .change-time span, .change-time small, .change-entity small, .change-count { color: var(--muted); display: block; font-family: var(--mono); font-size: .58rem; text-transform: uppercase; }
  .change-time small, .change-entity small { margin-top: 5px; }
  .change-count { text-align: right; }
  .change-diffs { border-top: 1px solid var(--line); padding: 0 18px 18px 156px; }
  .change-diffs > div { border-bottom: 1px solid var(--line); display: grid; gap: 14px; grid-template-columns: 130px 1fr 20px 1fr; padding: 15px 0; }
  .change-diffs strong, .change-diffs span, .change-diffs b, .change-diffs > a { font-family: var(--mono); font-size: .62rem; overflow-wrap: anywhere; }
  .change-diffs span { color: var(--muted); }
  .change-diffs > a { display: inline-block; margin-top: 18px; text-decoration: underline; text-transform: uppercase; text-underline-offset: 4px; }
  @media (max-width: 760px) {
    .changes-head { align-items: start; gap: 22px; grid-template-columns: 1fr; padding: 30px 20px; }
    .feed-count { border-left: 0; border-top: 1px solid var(--line); padding: 16px 0 0; }
    .change-feed { padding: 18px 12px 36px; }
    .change-group summary { align-items: start; grid-template-columns: 80px 1fr 18px; }
    .change-count { grid-column: 2; text-align: left; }
    .change-diffs { padding: 0 14px 16px; }
    .change-diffs > div { grid-template-columns: 90px 1fr; }
    .change-diffs b { display: none; }
  }
</style>
