---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Submit a Correction" description="Report incorrect, incomplete or outdated registry data to OpenAgent.bot with a canonical source." path="/corrections">
  <div class="page-shell"><div class="page-grid">
    <section class="page-section"><span class="kicker">Registry corrections</span><h1 class="page-title">Submit a correction</h1><p class="lede">Corrected facts are appended with evidence; earlier observations remain in history.</p></section>
    <section class="page-section correction-grid"><article><span class="eyebrow">Include</span><ol><li>The project URL or OpenAgent.bot dossier.</li><li>The field that is incorrect or missing.</li><li>A canonical source: official site, repository, documentation or release.</li><li>The value you believe should replace it.</li></ol></article><aside><span class="eyebrow">Submit</span><h2>Email the registry team</h2><p>Use a descriptive subject so we can route the correction quickly.</p><a class="button primary" href="mailto:corrections@openagent.bot?subject=Registry%20correction">corrections@openagent.bot →</a></aside></section>
  </div></div>
</BaseLayout>
<style>.correction-grid{display:grid;grid-template-columns:1fr 360px;gap:60px}.correction-grid ol{line-height:1.8;margin-top:24px;padding-left:20px}.correction-grid aside{background:var(--paper-raised);border:1px solid var(--ink);padding:28px}.correction-grid h2{font-family:var(--sans);font-size:2rem;letter-spacing:-.04em}.correction-grid p{color:var(--muted);line-height:1.55}.correction-grid .button{margin-top:20px}@media(max-width:700px){.correction-grid{grid-template-columns:1fr;gap:30px}}</style>
