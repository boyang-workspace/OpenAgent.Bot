---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RecordInspector from "@/components/RecordInspector.astro";
import RegistryTable from "@/components/RegistryTable.astro";
import { getRegistry } from "@/lib/registry/runtime";
import { entityDomains, entityKinds, opennessStatuses, roboticsLayers, type EntityDomain, type EntityKind, type OpennessStatus, type RegistryDossier, type RegistryEntity, type RegistryStats, type RoboticsLayer } from "@/lib/registry/types";
import { compactNumber, label, relativeDate } from "@/lib/registry/format";
import { domainLabel, roboticsLayerLabel } from "@/lib/registry/domains";
import { interfaceTypes } from "@/lib/registry/intake-contract";

const q = Astro.url.searchParams.get("q") ?? "";
const interfaceType = Astro.url.searchParams.get("interface") || undefined;
const useCase = Astro.url.searchParams.get("use_case") || undefined;
let useCases: Array<{ slug: string; name: string }> = [];
const requestedKind = Astro.url.searchParams.get("kind") ?? "";
const legacyDomain = requestedKind === "agent-side" ? "agent" : requestedKind === "bot-side" ? "robotics" : "";
const requestedDomain = Astro.url.searchParams.get("domain") ?? legacyDomain;
const requestedOpenness = Astro.url.searchParams.get("openness") ?? "";
const requestedLayer = Astro.url.searchParams.get("layer") ?? "";
const requestedLicense = Astro.url.searchParams.get("license") ?? "";
const requestedFreshness = Number(Astro.url.searchParams.get("freshness") ?? 0);
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage) ? Math.max(Math.floor(requestedPage), 1) : 1;
const pageSize = 50;
const sortParam = Astro.url.searchParams.get("sort");
const sort = sortParam === "stars" || sortParam === "name" || sortParam === "updated" ? sortParam : "activity";
const kind = entityKinds.includes(requestedKind as EntityKind) ? requestedKind as EntityKind : undefined;
const domain = entityDomains.includes(requestedDomain as EntityDomain) ? requestedDomain as EntityDomain : undefined;
const openness = opennessStatuses.includes(requestedOpenness as OpennessStatus) ? requestedOpenness as OpennessStatus : undefined;
const roboticsLayer = roboticsLayers.includes(requestedLayer as RoboticsLayer) ? requestedLayer as RoboticsLayer : undefined;
const freshness = [7, 30, 90].includes(requestedFreshness) ? requestedFreshness : undefined;
const licenses = ["Apache-2.0", "MIT", "BSD-3-Clause", "GPL-3.0", "MPL-2.0"];
const license = licenses.includes(requestedLicense) ? requestedLicense : undefined;
let entities: RegistryEntity[] = [];
let total = 0;
let selectedDossier: RegistryDossier | undefined;
let loadError = false;
let stats: RegistryStats = { entities: 0, agents: 0, robots: 0, infrastructure: 0, robotPlatforms: 0, robotIntelligence: 0, roboticsStack: 0, models: 0, tools: 0, sources: 0, liveSources: 0, observations: 0, metricEntities: 0, changes30d: 0 };

const registry = getRegistry();
try {
  const [result, registryStats, availableUseCases] = await Promise.all([
    registry.listEntities({ q, useCase, interfaceType, domains: domain ? [domain] : undefined, roboticsLayers: roboticsLayer ? [roboticsLayer] : undefined, kinds: kind ? [kind] : undefined, openness: openness ? [openness] : undefined, license, verifiedWithinDays: freshness, sort, limit: pageSize, offset: (page - 1) * pageSize }),
    registry.getStats(),
    registry.listUseCases()
  ]);
  useCases = availableUseCases;
  entities = result.items;
  total = result.total;
  stats = registryStats;
  const requestedSelected = Astro.url.searchParams.get("selected");
  const selectedSlug = requestedSelected && entities.some((entity) => entity.slug === requestedSelected) ? requestedSelected : entities[0]?.slug;
  if (selectedSlug) selectedDossier = await registry.getEntityDossier(selectedSlug);
} catch {
  loadError = true;
}

const selectedSlug = selectedDossier?.entity.slug;
const initialCompareSlugs = Array.from(new Set((Astro.url.searchParams.get("compare") ?? "").split(",").map((item) => item.trim()).filter(Boolean))).slice(0, 4);
let initialCompareProjects: Array<{ slug: string; name: string }> = [];
try {
  initialCompareProjects = (await Promise.all(initialCompareSlugs.map((slug) => registry.getEntity(slug))))
    .filter(Boolean)
    .map((entity) => ({ slug: entity!.slug, name: entity!.name }));
} catch {}
const pageCount = Math.max(Math.ceil(total / pageSize), 1);
function pageHref(nextPage: number): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete("selected");
  params.set("page", String(nextPage));
  return `/database?${params.toString()}`;
}

const activeFilters = [
  q && { key: "q", label: `Search: ${q}` },
  interfaceType && { key: "interface", label: `Interface: ${interfaceType.toUpperCase()}` },
  useCase && { key: "use_case", label: `Use case: ${useCases.find((item) => item.slug === useCase)?.name ?? useCase}` },
  domain && { key: "domain", label: `Field: ${domainLabel(domain)}` },
  roboticsLayer && { key: "layer", label: `Layer: ${roboticsLayerLabel(roboticsLayer)}` },
  kind && { key: "kind", label: `Artifact: ${label(kind)}` },
  openness && { key: "openness", label: `Openness: ${label(openness)}` },
  license && { key: "license", label: `License: ${license}` },
  freshness && { key: "freshness", label: `Verified: ${freshness}d` }
].filter(Boolean) as Array<{ key: string; label: string }>;

const domainTabs = [
  { label: "All", href: "/database", active: !domain },
  { label: "Agents", href: "/database?domain=agent", active: domain === "agent" },
  { label: "Robotics", href: "/database?domain=robotics", active: domain === "robotics" },
  { label: "Infrastructure", href: "/database?domain=shared", active: domain === "shared" }
];
const robotPlatformMode = domain === "robotics" && roboticsLayer === "platform";

function removeFilterHref(key: string): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete(key);
  params.delete("page");
  params.delete("selected");
  const query = params.toString();
  return query ? `/database?${query}` : "/database";
}
---

<BaseLayout
  title="Open-Source Agent & Robot Database"
  description="Search and compare open-source AI agents, robots, models and frameworks by activity, license, openness and attributed evidence."
  path="/database"
  noindex={Astro.url.searchParams.size > 0}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "DataCatalog", name: "OpenAgent.bot Open AI & Robotics Database", description: "Evidence-backed records for open models, agents, robot intelligence and robot hardware.", url: "https://www.openagent.bot/database", dataset: [{ "@type": "Dataset", name: "Open AI and robotics entity registry", description: `${stats.entities} tracked entities with ${stats.observations} attributed evidence records.`, url: "https://www.openagent.bot/database" }] })} />
  <div class="page-shell ledger-shell">
    <div class="page-grid ledger-grid">
      <section class="registry-masthead">
        <div class="masthead-title"><h1>Database</h1><span>{compactNumber(stats.entities)} entities</span></div>
        <p><span>{compactNumber(stats.observations)} evidence records</span><span>Updated {relativeDate(stats.lastSyncAt)}</span></p>
      </section>

      <nav class="domain-tabs" aria-label="Database domains">
        {domainTabs.map((item) => <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>)}
      </nav>

      <details class="filter-panel" open>
        <summary><span>Search and filters</span><strong>{activeFilters.length ? `${activeFilters.length} active` : "All records"}</strong></summary>
        <form class="ledger-filters" method="get" data-analytics-results={total}>
          <div class="field search-field"><label for="q">Search</label><input id="q" name="q" type="search" value={q} placeholder="Name, organization, summary…" /></div>
          {domain && <input type="hidden" name="domain" value={domain} />}
          {(domain === "agent" || interfaceType) && <div class="field"><label for="interface">Interface</label><select id="interface" name="interface"><option value="">All interfaces</option>{interfaceType && !interfaceTypes.includes(interfaceType as typeof interfaceTypes[number]) && <option selected value={interfaceType}>Unrecognized</option>}{interfaceTypes.map((item) => <option value={item} selected={interfaceType === item}>{item.toUpperCase()}</option>)}</select></div>}
          <div class="field"><label for="use-case">Use case</label><select id="use-case" name="use_case"><option value="">All use cases</option>{useCase && !useCases.some((item) => item.slug === useCase) && <option selected value={useCase}>{useCase} (unrecognized)</option>}{useCases.map((item) => <option value={item.slug} selected={useCase === item.slug}>{item.name}</option>)}</select></div>
          {domain === "robotics" && <div class="field"><label for="layer">Layer</label><select id="layer" name="layer"><option value="">All layers</option>{roboticsLayers.map((item) => <option value={item} selected={roboticsLayer === item}>{roboticsLayerLabel(item)}</option>)}</select></div>}
          <div class="field"><label for="kind">Type</label><select id="kind" name="kind"><option value="">All types</option>{entityKinds.map((item) => <option value={item} selected={kind === item}>{label(item)}</option>)}</select></div>
          <div class="field"><label for="openness">Openness</label><select id="openness" name="openness"><option value="">All states</option>{opennessStatuses.map((item) => <option value={item} selected={openness === item}>{label(item)}</option>)}</select></div>
          <div class="field"><label for="license">License</label><select id="license" name="license"><option value="">All licenses</option>{licenses.map((item) => <option value={item} selected={license === item}>{item}</option>)}</select></div>
          <div class="field"><label for="freshness">Freshness</label><select id="freshness" name="freshness"><option value="">Any time</option><option value="7" selected={freshness === 7}>Verified ≤ 7d</option><option value="30" selected={freshness === 30}>Verified ≤ 30d</option><option value="90" selected={freshness === 90}>Verified ≤ 90d</option></select></div>
          <div class="field"><label for="sort">Sort</label><select id="sort" name="sort"><option value="activity" selected={sort === "activity"}>Recent activity ↓</option><option value="updated" selected={sort === "updated"}>Recently verified</option><option value="stars" selected={sort === "stars"}>Most followed</option><option value="name" selected={sort === "name"}>Name</option></select></div>
          <button class="button primary" type="submit">Apply</button>
        </form>
        <div class="active-filter-row">
          <span class="data-label">Active filters</span>
          {activeFilters.length ? activeFilters.map((item) => <a class="filter-chip" href={removeFilterHref(item.key)} aria-label={`Remove ${item.label} filter`}>{item.label}<b aria-hidden="true">×</b></a>) : <span class="empty-filter">None</span>}
          {activeFilters.length > 0 && <a href="/database">Clear all</a>}
        </div>
      </details>

      {loadError && <div class="load-error" role="alert"><strong>The registry could not be loaded.</strong><span>Refresh the page or use the public JSON API while the database reconnects.</span><a href="/api/v1/entities.json">Open API response</a></div>}

      <div class="registry-workspace">
        <section class="results-panel" aria-label="Registry results">
          <RegistryTable entities={entities} total={total} selectedSlug={selectedSlug} initialCompareSlugs={initialCompareSlugs} initialCompareProjects={initialCompareProjects} queryString={Astro.url.searchParams.toString()} robotPlatformMode={robotPlatformMode} />
          {pageCount > 1 && (
            <nav class="pagination" aria-label="Database pages">
              {page > 1 ? <a class="button secondary" href={pageHref(page - 1)}>Previous</a> : <span></span>}
              <span class="mono">Page {page} / {pageCount}</span>
              {page < pageCount ? <a class="button secondary" href={pageHref(page + 1)}>Next</a> : <span></span>}
            </nav>
          )}
        </section>
        <RecordInspector dossier={selectedDossier} />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const filterPanel = document.querySelector<HTMLDetailsElement>(".filter-panel");
  if (filterPanel && window.matchMedia("(max-width: 1280px)").matches) filterPanel.removeAttribute("open");
</script>

<style>
  .ledger-shell { max-width: 1600px; padding: 0; }
  :global(body) { overflow: hidden; }
  :global(.site-footer) { display: none; }
  .ledger-grid { display: grid; grid-template-rows: auto auto auto minmax(0, 1fr); height: calc(100dvh - var(--header-height)); min-height: 0; }
  .registry-masthead { align-items: center; border-bottom: 1px solid var(--ink); display: flex; justify-content: space-between; min-height: 44px; }
  .masthead-title { align-items: center; display: flex; gap: 16px; padding: 0 18px; }
  .masthead-title h1 { font-family: var(--sans); font-size: .98rem; line-height: 1; margin: 0; }
  .masthead-title span { align-items: center; display: flex; font-family: var(--mono); font-size: .75rem; gap: 7px; text-transform: uppercase; }
  .masthead-title span::before { background: var(--acid); border: 1px solid var(--ink); content: ""; height: 7px; width: 7px; }
  .registry-masthead p { color: var(--muted); display: flex; font-family: var(--mono); font-size: .75rem; gap: 18px; margin: 0; padding: 0 18px; text-transform: uppercase; }
  .domain-tabs { align-items: stretch; border-bottom: 1px solid var(--ink); display: flex; min-height: 43px; padding: 0 18px; }
  .domain-tabs a { align-items: center; border-left: 1px solid var(--line); display: flex; font-family: var(--mono); font-size: .75rem; padding: 0 18px; text-transform: uppercase; }
  .domain-tabs a:last-child { border-right: 1px solid var(--line); }
  .domain-tabs a[aria-current="page"] { background: var(--acid); box-shadow: inset 0 -3px 0 var(--ink); }
  .filter-panel { background: rgba(243, 244, 239, .98); border-bottom: 1px solid var(--ink); min-width: 0; z-index: 6; }
  .filter-panel summary { align-items: center; cursor: pointer; display: none; font-family: var(--mono); font-size: .75rem; justify-content: space-between; min-height: 50px; padding: 0 16px; text-transform: uppercase; }
  .filter-panel summary strong { color: var(--muted); font-weight: 500; }
  .ledger-filters { align-items: end; display: flex; gap: 14px; padding: 14px 20px 10px; }
  .ledger-filters .field { flex: 1 1 118px; min-width: 105px; }
  .ledger-filters .search-field { flex: 2 1 230px; }
  .field label { display: block; font-family: var(--mono); font-size: .75rem; margin-bottom: 6px; text-transform: uppercase; }
  .field input, .field select { background: var(--paper-raised); border: 1px solid var(--ink); border-radius: 0; font-size: .76rem; height: 39px; padding: 0 10px; width: 100%; }
  .ledger-filters .button { min-height: 39px; }
  .active-filter-row { align-items: center; display: flex; flex-wrap: wrap; gap: 8px; min-height: 46px; padding: 0 20px 12px; }
  .filter-chip { align-items: center; background: #eceee4; border: 1px solid var(--line); display: inline-flex; font-family: var(--mono); font-size: .75rem; gap: 8px; padding: 6px 8px; text-transform: uppercase; }
  .filter-chip:hover { background: var(--acid); border-color: var(--ink); }
  .filter-chip b { font-size: .75rem; line-height: .7; }
  .active-filter-row .empty-filter { color: var(--muted); }
  .active-filter-row > a:not(.filter-chip) { font-family: var(--mono); font-size: .75rem; margin-left: 4px; text-decoration: underline; text-transform: uppercase; text-underline-offset: 3px; }
  .registry-workspace { display: grid; grid-template-columns: minmax(0, 1fr) 320px; min-height: 0; overflow: hidden; }
  .results-panel { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-height: 0; min-width: 0; overflow: hidden; }
  .pagination { align-items: center; display: grid; grid-template-columns: 1fr auto 1fr; padding: 22px 18px; }
  .pagination > :last-child { justify-self: end; }
  .load-error { align-items: center; background: #fff2ed; border-bottom: 1px solid var(--orange); display: flex; gap: 18px; padding: 13px 20px; }
  .load-error span { color: var(--muted); font-size: .8rem; }
  .load-error a { font-family: var(--mono); font-size: .75rem; margin-left: auto; text-decoration: underline; text-transform: uppercase; }

  @media (max-width: 1280px) {
    .filter-panel summary { display: flex; }
    .ledger-filters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .search-field { grid-column: span 2; }
  }
  @media (max-width: 1040px) {
    :global(body) { overflow: auto; }
    :global(.site-footer) { display: grid; }
    .ledger-grid { display: block; height: auto; min-height: calc(100dvh - var(--header-height)); }
    .masthead-title { min-height: 44px; }
    .registry-workspace { display: block; overflow: visible; }
    .results-panel { display: block; overflow: visible; }
  }
  @media (min-width: 761px) and (max-width: 1040px) {
    .registry-workspace { display: flex; flex-direction: column; }
    .registry-workspace :global(.record-inspector) { order: -1; }
  }
  @media (max-width: 760px) {
    .registry-masthead { min-height: 0; }
    .masthead-title { gap: 14px; min-height: 48px; padding: 0 14px; }
    .masthead-title h1 { font-size: 1.05rem; }
    .registry-masthead p { display: none; }
    .domain-tabs { overflow-x: auto; padding: 0; }
    .domain-tabs a { flex: 1 0 auto; justify-content: center; min-width: 92px; padding: 0 12px; }
    .filter-panel summary { display: flex; }
    .ledger-filters { grid-template-columns: 1fr; padding: 14px; }
    .search-field { grid-column: auto; }
    .field input, .field select, .ledger-filters .button { min-height: 48px; }
    .active-filter-row { padding: 0 14px 14px; }
    .load-error { align-items: flex-start; flex-direction: column; gap: 6px; }
    .load-error a { margin-left: 0; }
  }
</style>
