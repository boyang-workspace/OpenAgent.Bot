---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntityTable from "@/components/EntityTable.astro";
import { getRegistry } from "@/lib/registry/runtime";
import { entityDomains, entityKinds, opennessStatuses, type EntityDomain, type EntityKind, type OpennessStatus, type RegistryEntity } from "@/lib/registry/types";
import { label } from "@/lib/registry/format";
import { domainLabel } from "@/lib/registry/domains";

const q = Astro.url.searchParams.get("q") ?? "";
const requestedKind = Astro.url.searchParams.get("kind") ?? "";
const legacyDomain = requestedKind === "agent-side" ? "agent" : requestedKind === "bot-side" ? "robotics" : "";
const requestedDomain = Astro.url.searchParams.get("domain") ?? legacyDomain;
const requestedOpenness = Astro.url.searchParams.get("openness") ?? "";
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage) ? Math.max(Math.floor(requestedPage), 1) : 1;
const pageSize = 50;
const sort = Astro.url.searchParams.get("sort") === "stars" ? "stars" : Astro.url.searchParams.get("sort") === "name" ? "name" : "updated";
const kind = entityKinds.includes(requestedKind as EntityKind) ? requestedKind as EntityKind : undefined;
const domain = entityDomains.includes(requestedDomain as EntityDomain) ? requestedDomain as EntityDomain : undefined;
const openness = opennessStatuses.includes(requestedOpenness as OpennessStatus) ? requestedOpenness as OpennessStatus : undefined;
let entities: RegistryEntity[] = [];
let total = 0;

try {
  const result = await getRegistry().listEntities({ q, domains: domain ? [domain] : undefined, kinds: kind ? [kind] : undefined, openness: openness ? [openness] : undefined, sort, limit: pageSize, offset: (page - 1) * pageSize });
  entities = result.items;
  total = result.total;
} catch {}

const pageCount = Math.max(Math.ceil(total / pageSize), 1);
function pageHref(nextPage: number): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("page", String(nextPage));
  return `/database?${params.toString()}`;
}
---

<BaseLayout title="Database" description="Search the evidence-backed registry of open-source agents, models, robotics projects and infrastructure." path="/database">
  <div class="page-shell"><div class="page-grid">
    <section class="page-section">
      <span class="kicker">Registry explorer</span>
      <h1 class="page-title">Database</h1>
      <p class="lede">{total} entities with attributed sources, openness states and verification timestamps.</p>
    </section>
    <form class="filter-bar" method="get">
      <div class="field"><label for="q">Search</label><input id="q" name="q" type="search" value={q} placeholder="Name, organization, summary" /></div>
      <div class="field"><label for="domain">Field</label><select id="domain" name="domain"><option value="">All fields</option>{entityDomains.map((item) => <option value={item} selected={domain === item}>{domainLabel(item)}</option>)}</select></div>
      <div class="field"><label for="kind">Artifact type</label><select id="kind" name="kind"><option value="">All types</option>{entityKinds.map((item) => <option value={item} selected={kind === item}>{label(item)}</option>)}</select></div>
      <div class="field"><label for="openness">Openness</label><select id="openness" name="openness"><option value="">All states</option>{opennessStatuses.map((item) => <option value={item} selected={openness === item}>{label(item)}</option>)}</select></div>
      <div class="field"><label for="sort">Sort</label><select id="sort" name="sort"><option value="updated" selected={sort === "updated"}>Recently verified</option><option value="stars" selected={sort === "stars"}>GitHub stars</option><option value="name" selected={sort === "name"}>Name</option></select></div>
      <button class="button primary" type="submit">Apply</button>
    </form>
    <section class="page-section results">
      <EntityTable entities={entities} />
      {pageCount > 1 && (
        <nav class="pagination" aria-label="Database pages">
          {page > 1 ? <a class="button secondary" href={pageHref(page - 1)}>← Previous</a> : <span></span>}
          <span class="mono">Page {page} / {pageCount}</span>
          {page < pageCount ? <a class="button secondary" href={pageHref(page + 1)}>Next →</a> : <span></span>}
        </nav>
      )}
    </section>
  </div></div>
</BaseLayout>

<style>
  .filter-bar { grid-template-columns: minmax(200px, 1fr) repeat(4, minmax(130px, 160px)) auto; }
  .results { padding-top: 26px; }
  .pagination { align-items: center; display: grid; grid-template-columns: 1fr auto 1fr; margin-top: 28px; }
  .pagination > :last-child { justify-self: end; }
  @media (max-width: 1100px) { .filter-bar { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .filter-bar { grid-template-columns: 1fr; } }
</style>
