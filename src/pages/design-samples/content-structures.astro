---
import BaseLayout from "@/layouts/BaseLayout.astro";

const agentStructures = [
  {
    label: "Agent Structure 1",
    title: "Evidence-First Profile",
    bestFor: "Google 直接落到单个 agent 详情页，用户想快速判断这个项目值不值得点开 GitHub。",
    firstScreen: ["One-sentence answer", "事实卡片", "Primary CTA", "官方来源", "适合/不适合"],
    sections: [
      "Quick answer: what it is and who should care",
      "At a glance: license, stars, language, deployment, last verified",
      "Best for / not for: search visitor fit check",
      "How it works: runtime, inputs, outputs, dependencies",
      "Use cases: 3-5 concrete workflows with examples",
      "Comparison table: closest alternatives and when to choose each",
      "Setup path: official docs, install links, first safe test",
      "Evidence log: source links, dated facts, update history",
      "FAQ: open-source status, pricing, safety, alternatives"
    ],
    seo: ["Best for '[project] open source agent'", "'[project] vs alternatives'", "'what is [project]'"],
    data: ["GitHub facts", "license", "last commit", "docs link", "supported interfaces", "deployment modes"],
    conversion: "把用户送到 GitHub/docs，同时留下 OpenAgent 的比较入口。"
  },
  {
    label: "Agent Structure 2",
    title: "Workflow Playbook",
    bestFor: "用户搜索的不是项目名，而是 'browser agent for form filling' 或 'AI coding agent for GitHub issues' 这类任务。",
    firstScreen: ["Workflow answer", "任务标签", "推荐配置", "风险提示", "可执行下一步"],
    sections: [
      "Problem match: the workflow this agent is good at",
      "Workflow map: trigger, tools, permissions, output, review loop",
      "Example recipes: browser task, coding task, research task, local task",
      "Implementation choices: local, self-hosted, cloud, API, CLI",
      "Safety checklist: credentials, sandboxing, human approval, logs",
      "Integration surface: MCP, browser, GitHub, Docker, APIs",
      "Operator notes: what breaks, what needs monitoring",
      "Alternatives by workflow: choose by job-to-be-done",
      "FAQ: setup time, skill level, production readiness"
    ],
    seo: ["Best for 'AI agent for [workflow]'", "'how to use [project]'", "'browser automation agent workflow'"],
    data: ["workflow categories", "interfaces", "permissions", "recipes", "known limitations", "integration tags"],
    conversion: "让读者从搜索意图直接进入一个可试的 workflow，而不只是读项目介绍。"
  },
  {
    label: "Agent Structure 3",
    title: "Technical Due Diligence",
    bestFor: "面向 CTO、工程负责人、开源采用者，判断一个 agent 能不能进入团队技术雷达。",
    firstScreen: ["Verdict", "trust score", "repo health", "risk flags", "source trail"],
    sections: [
      "Editorial verdict: adopt, watch, or avoid for now",
      "Repository health: stars, forks, commit recency, contributors, issues",
      "Architecture notes: runtime model, tool calling, state, memory, execution boundary",
      "Security and permissions: credentials, browser sessions, code execution, audit logs",
      "Operational fit: hosting, cost, observability, upgrade path",
      "Benchmarks and claims: what is verified vs what is marketing",
      "Risk register: stale docs, unclear license, missing sandbox, narrow maintainer base",
      "Decision table: prototype, team trial, production candidate",
      "Evidence appendix: dated claims and source snapshots"
    ],
    seo: ["'[project] review'", "'is [project] production ready'", "'[project] license and security'"],
    data: ["repo health", "security notes", "issue activity", "release cadence", "claim extraction", "risk tags"],
    conversion: "建立 OpenAgent 的专业信任，适合高质量长尾 SEO 和被引用。"
  }
];

const evaluationStructures = [
  {
    label: "Evaluation Structure 1",
    title: "Leaderboard With Methodology",
    bestFor: "用户搜 'best open-source AI agents'、'AI agent benchmark'，想先看排名，再看可信度。",
    firstScreen: ["Quick recommendation", "ranking table", "last updated", "methodology link", "category filters"],
    sections: [
      "Quick answer: best overall, best browser agent, best coding agent, best local agent",
      "Leaderboard table: rank, category, score, strongest signal, limitation",
      "Category breakdown: browser, coding, orchestration, memory, local",
      "Methodology: criteria, scoring weights, source hierarchy",
      "Benchmark context: SWE-bench, WebArena, GAIA, AgentBench-style signals",
      "What scores miss: UX, setup burden, safety, maintenance",
      "Deep dives: one paragraph per ranked agent with internal links",
      "Change log: what moved since last update",
      "FAQ: best agent, benchmark meaning, open-source caveats"
    ],
    seo: ["best open-source AI agents", "AI agent leaderboard", "AI agent benchmark comparison"],
    data: ["rankings", "score weights", "benchmark links", "resource references", "last verified date", "change history"],
    conversion: "高搜索量入口，适合做 evergreen 页面，每周/每月更新。"
  },
  {
    label: "Evaluation Structure 2",
    title: "Scenario Decision Matrix",
    bestFor: "用户有明确任务，搜索 'best AI agent for browser automation/coding/research/local workflows'。",
    firstScreen: ["Choose by workflow", "matrix", "recommended shortlist", "do-not-use-if", "source freshness"],
    sections: [
      "Pick your scenario: browser, coding, research, local desktop, multi-agent, memory-heavy",
      "Decision matrix: rows are workflows, columns are agents",
      "Recommendation cards: one winner and one fallback per scenario",
      "Tradeoff analysis: capability, setup time, safety, maintenance, extensibility",
      "Example tasks: what each agent should be tested on first",
      "Failure modes: where each agent type usually disappoints",
      "Buyer/adopter checklist: solo builder, startup, enterprise, researcher",
      "Related profiles: link into agent detail pages",
      "FAQ: how to choose, what to prototype, what to avoid"
    ],
    seo: ["best AI agent for [workflow]", "AI agent comparison by use case", "which AI agent should I use"],
    data: ["scenario taxonomy", "agent capabilities", "setup complexity", "risk notes", "internal resource links"],
    conversion: "比纯排名更适合带用户继续浏览多个详情页，站内深度更好。"
  },
  {
    label: "Evaluation Structure 3",
    title: "Lab Report And Evidence Trail",
    bestFor: "需要强可信度的评测内容，尤其适合未来做原创 benchmark、测试记录和被外部引用。",
    firstScreen: ["Test question", "short verdict", "sample size", "test environment", "artifact links"],
    sections: [
      "Hypothesis: what we wanted to learn",
      "Test setup: model, agent version, environment, task set, date",
      "Task results: success, partial success, fail, notes",
      "Evidence artifacts: traces, screenshots, prompts, logs, source links",
      "Interpretation: what the results mean and what they do not mean",
      "Limitations: small sample, model dependency, website variance, evaluator bias",
      "Reproducibility: how to rerun or submit corrections",
      "Implications: which agents move up or down the shortlist",
      "Update log and corrections policy"
    ],
    seo: ["AI agent evaluation", "agent benchmark methodology", "[agent] benchmark results"],
    data: ["task traces", "screenshots", "model versions", "agent versions", "environment", "results schema"],
    conversion: "最能建立护城河，但生产成本最高。适合少量高价值页面。"
  }
];
---

<BaseLayout
  title="OpenAgent content structures"
  description="Three richer content structure options for OpenAgent agent detail pages and evaluation pages."
  path="/design-samples/content-structures"
  noindex
>
  <main class="structure-page">
    <header class="topbar">
      <a href="/design-samples">OpenAgent samples</a>
      <nav>
        <a href="/design-samples/agent-evidence-ledger">Agent A Blue</a>
        <a href="#agent">Agent structures</a>
        <a href="#evaluation">Evaluation structures</a>
      </nav>
    </header>

    <section class="hero">
      <div>
        <p>Blue-white content blueprint</p>
        <h1>Six fuller SEO content structures for OpenAgent landing pages.</h1>
      </div>
      <aside>
        <strong>Recommendation</strong>
        <span>Agent 详情页优先用 Structure 1，评测页优先用 Structure 2。它们最适合 Google landing 流量，也最容易规模化。</span>
      </aside>
    </section>

    <section id="agent" class="structure-section">
      <div class="section-head">
        <p>Agent detail page</p>
        <h2>三种详情页内容结构</h2>
      </div>
      <div class="blueprint-grid">
        {agentStructures.map((item) => (
          <article class="blueprint-card">
            <div class="card-head">
              <span>{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.bestFor}</p>
            </div>
            <div class="module-block">
              <strong>首屏模块</strong>
              <div class="chip-row">{item.firstScreen.map((chip) => <em>{chip}</em>)}</div>
            </div>
            <div class="module-block">
              <strong>页面顺序</strong>
              <ol>{item.sections.map((section) => <li>{section}</li>)}</ol>
            </div>
            <div class="meta-grid">
              <div>
                <strong>SEO targets</strong>
                <ul>{item.seo.map((entry) => <li>{entry}</li>)}</ul>
              </div>
              <div>
                <strong>Data needed</strong>
                <ul>{item.data.map((entry) => <li>{entry}</li>)}</ul>
              </div>
            </div>
            <p class="conversion">{item.conversion}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="evaluation" class="structure-section">
      <div class="section-head">
        <p>Evaluation page</p>
        <h2>三种评测页内容结构</h2>
      </div>
      <div class="blueprint-grid">
        {evaluationStructures.map((item) => (
          <article class="blueprint-card">
            <div class="card-head">
              <span>{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.bestFor}</p>
            </div>
            <div class="module-block">
              <strong>首屏模块</strong>
              <div class="chip-row">{item.firstScreen.map((chip) => <em>{chip}</em>)}</div>
            </div>
            <div class="module-block">
              <strong>页面顺序</strong>
              <ol>{item.sections.map((section) => <li>{section}</li>)}</ol>
            </div>
            <div class="meta-grid">
              <div>
                <strong>SEO targets</strong>
                <ul>{item.seo.map((entry) => <li>{entry}</li>)}</ul>
              </div>
              <div>
                <strong>Data needed</strong>
                <ul>{item.data.map((entry) => <li>{entry}</li>)}</ul>
              </div>
            </div>
            <p class="conversion">{item.conversion}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #f5fbff;
  }

  .structure-page {
    color: #09213d;
    margin: 0 auto;
    max-width: 1280px;
    min-height: 100vh;
    padding: 18px 24px 72px;
  }

  .topbar {
    align-items: center;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #c7def3;
    border-radius: 8px;
    display: flex;
    gap: 18px;
    justify-content: space-between;
    padding: 12px 14px;
    position: sticky;
    top: 12px;
    z-index: 5;
  }

  .topbar a {
    color: #09213d;
    font-size: 0.86rem;
    font-weight: 750;
  }

  .topbar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .topbar nav a {
    color: #4a647d;
  }

  .hero {
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr) 360px;
    padding: 72px 0 46px;
  }

  .hero p,
  .section-head p {
    color: #1565d8;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 850;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  h1 {
    color: #09213d;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 4.8rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.96;
    margin: 0;
    max-width: 980px;
  }

  .hero aside {
    align-self: end;
    background: #ffffff;
    border: 1px solid #c7def3;
    border-radius: 8px;
    display: grid;
    gap: 10px;
    padding: 20px;
  }

  .hero aside strong {
    color: #1565d8;
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  .hero aside span {
    color: #4a647d;
    line-height: 1.58;
  }

  .structure-section {
    border-top: 1px solid #c7def3;
    padding: 46px 0 24px;
  }

  .section-head {
    display: grid;
    gap: 8px;
    margin-bottom: 22px;
  }

  h2 {
    color: #09213d;
    font-size: 2.25rem;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
  }

  .blueprint-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .blueprint-card {
    background: #ffffff;
    border: 1px solid #c7def3;
    border-radius: 8px;
    display: grid;
    gap: 18px;
    padding: 20px;
  }

  .card-head span {
    color: #18a6c9;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  h3 {
    color: #09213d;
    font-size: 1.65rem;
    letter-spacing: 0;
    line-height: 1;
    margin: 10px 0 12px;
  }

  .card-head p,
  .conversion,
  li {
    color: #4a647d;
    line-height: 1.55;
  }

  .card-head p {
    margin: 0;
  }

  .module-block {
    background: #eef7ff;
    border: 1px solid #d8eafe;
    border-radius: 8px;
    display: grid;
    gap: 12px;
    padding: 14px;
  }

  .module-block strong,
  .meta-grid strong {
    color: #09213d;
    font-size: 0.84rem;
    text-transform: uppercase;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip-row em {
    background: #ffffff;
    border: 1px solid #c7def3;
    border-radius: 999px;
    color: #1565d8;
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 750;
    padding: 6px 9px;
  }

  ol,
  ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  li + li {
    margin-top: 8px;
  }

  .meta-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr 1fr;
  }

  .meta-grid div {
    border-top: 1px solid #d8eafe;
    display: grid;
    gap: 10px;
    padding-top: 12px;
  }

  .conversion {
    border-left: 3px solid #1565d8;
    margin: 0;
    padding-left: 12px;
  }

  @media (max-width: 980px) {
    .hero,
    .blueprint-grid,
    .meta-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 3.1rem;
    }

    .topbar {
      align-items: flex-start;
      flex-direction: column;
      position: static;
    }
  }
</style>
