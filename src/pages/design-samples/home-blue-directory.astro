---
import BaseLayout from "@/layouts/BaseLayout.astro";

const categories = [
  ["Agents", "Browser, coding, orchestration, local desktop", "42 tracked"],
  ["Models", "Open models useful for agent workflows", "31 tracked"],
  ["Benchmarks", "SWE-bench, WebArena, GAIA, custom tests", "12 pages"],
  ["Comparisons", "Best-of guides and A-vs-B decisions", "28 guides"]
];

const featuredAgents = [
  ["browser-use", "Browser automation", "MIT", "95k", "Best for website tasks"],
  ["OpenHands", "Coding agent", "Open source", "74k", "Best for repository work"],
  ["smolagents", "Code agents", "Apache-2.0", "27k", "Best for small agent libraries"],
  ["Goose", "Local workflows", "Apache-2.0", "45k", "Best for desktop developer automation"]
];

const evaluations = [
  ["Best AI agents for browser automation", "Scenario matrix", "Updated May 22"],
  ["OpenHands vs browser-use vs smolagents", "Comparison", "Updated May 21"],
  ["Which open-source agent should you test first?", "Decision guide", "Updated May 20"]
];

const signals = [
  ["GitHub", "browser-use added new browser control examples", "2h ago"],
  ["Benchmark", "SWE-bench coding-agent results changed", "6h ago"],
  ["Reddit", "Builders compare local agent runtimes", "11h ago"],
  ["Docs", "New MCP server guidance for agent tools", "1d ago"]
];
---

<BaseLayout
  title="OpenAgent homepage blue directory sample"
  description="Blue-white homepage sample for an agent directory, evaluation hub, and AI agent news flow."
  path="/design-samples/home-blue-directory"
  noindex
>
  <main class="home-sample">
    <header class="topbar">
      <a href="/design-samples">OpenAgent samples</a>
      <nav>
        <a href="/design-samples/agent-evidence-ledger">Agent template</a>
        <a href="/design-samples/evaluation-decision-matrix">Evaluation template</a>
        <a href="/design-samples/content-structures">Structures</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <p>OpenAgent.bot</p>
        <h1>Find, compare, and track open AI agents.</h1>
        <span>
          A directory and evaluation hub for agent builders who need source-backed profiles,
          workflow-specific comparisons, benchmark context, and fresh ecosystem signals.
        </span>
        <form class="search-box" action="/search">
          <input name="q" placeholder="Search browser agents, coding agents, memory systems..." />
          <button type="submit">Search</button>
        </form>
        <div class="intent-row">
          <a href="/design-samples/evaluation-decision-matrix">Best agent for my workflow</a>
          <a href="/design-samples/agent-evidence-ledger">Inspect an agent profile</a>
          <a href="#signals">Read latest signals</a>
        </div>
      </div>

      <aside class="hero-panel">
        <strong>Today’s answer</strong>
        <h2>For browser workflows, start with browser-use. For coding tasks, compare OpenHands first.</h2>
        <div class="mini-matrix">
          <span>Browser</span><b>browser-use</b>
          <span>Coding</span><b>OpenHands</b>
          <span>Local</span><b>Goose</b>
        </div>
        <a href="/design-samples/evaluation-decision-matrix">Open decision matrix</a>
      </aside>
    </section>

    <section class="category-section">
      <div class="section-head">
        <p>Directory</p>
        <h2>Browse by what you are trying to build.</h2>
      </div>
      <div class="category-grid">
        {categories.map(([name, description, count]) => (
          <a href="#">
            <strong>{name}</strong>
            <span>{description}</span>
            <em>{count}</em>
          </a>
        ))}
      </div>
    </section>

    <section class="split-section">
      <div>
        <div class="section-head">
          <p>Featured agents</p>
          <h2>Open-source agents worth comparing first.</h2>
        </div>
        <div class="agent-table">
          <table>
            <thead>
              <tr>
                <th>Agent</th>
                <th>Use case</th>
                <th>License</th>
                <th>Stars</th>
                <th>Fit</th>
              </tr>
            </thead>
            <tbody>
              {featuredAgents.map((row) => (
                <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <aside class="rail-card">
        <p>Selected template</p>
        <h3>Evidence-First Profile</h3>
        <span>Each agent page should answer what it is, whether it is open source, when to use it, what to compare it with, and which official sources support the claims.</span>
        <a href="/design-samples/agent-evidence-ledger">View agent template</a>
      </aside>
    </section>

    <section class="evaluation-section">
      <div class="section-head">
        <p>Evaluation hub</p>
        <h2>Turn benchmark noise into workflow decisions.</h2>
      </div>
      <div class="evaluation-grid">
        {evaluations.map(([title, type, date]) => (
          <a href="/design-samples/evaluation-decision-matrix">
            <span>{type}</span>
            <strong>{title}</strong>
            <em>{date}</em>
          </a>
        ))}
      </div>
    </section>

    <section id="signals" class="signals-section">
      <div class="section-head">
        <p>Signals</p>
        <h2>Fresh links that can become profiles, comparisons, or articles.</h2>
      </div>
      <div class="signal-list">
        {signals.map(([source, title, time]) => (
          <article>
            <span>{source}</span>
            <strong>{title}</strong>
            <em>{time}</em>
          </article>
        ))}
      </div>
    </section>

    <section class="article-section">
      <div class="section-head">
        <p>SEO engine</p>
        <h2>Articles should support the directory, not float away from it.</h2>
      </div>
      <div class="article-grid">
        <a href="#">Best open-source browser agents for workflow automation</a>
        <a href="#">OpenHands vs browser-use: which agent should you test first?</a>
        <a href="#">How to choose an AI agent benchmark without fooling yourself</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #f5fbff;
  }

  .home-sample {
    color: #09213d;
    margin: 0 auto;
    max-width: 1280px;
    min-height: 100vh;
    padding: 18px 24px 72px;
  }

  .topbar {
    align-items: center;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid #c7def3;
    border-radius: 8px;
    display: flex;
    gap: 18px;
    justify-content: space-between;
    padding: 12px 14px;
    position: sticky;
    top: 12px;
    z-index: 5;
  }

  .topbar a {
    color: #09213d;
    font-size: 0.86rem;
    font-weight: 760;
  }

  .topbar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .topbar nav a {
    color: #4a647d;
  }

  .hero {
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr) 410px;
    padding: 72px 0 42px;
  }

  .hero-copy p,
  .section-head p,
  .rail-card p {
    color: #1565d8;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 850;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  h1 {
    color: #09213d;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 5rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.94;
    margin: 0;
    max-width: 880px;
  }

  .hero-copy > span {
    color: #4a647d;
    display: block;
    font-size: 1.12rem;
    line-height: 1.62;
    margin-top: 24px;
    max-width: 720px;
  }

  .search-box {
    align-items: center;
    background: #ffffff;
    border: 1px solid #b9d7f5;
    border-radius: 8px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-top: 30px;
    max-width: 780px;
    overflow: hidden;
    padding: 8px;
  }

  .search-box input {
    border: 0;
    color: #09213d;
    font: inherit;
    min-height: 48px;
    min-width: 0;
    outline: 0;
    padding: 0 12px;
  }

  .search-box button {
    background: #1565d8;
    border: 0;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 820;
    min-height: 48px;
    padding: 0 20px;
  }

  .intent-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  .intent-row a {
    background: #eef7ff;
    border: 1px solid #c7def3;
    border-radius: 999px;
    color: #1565d8;
    font-size: 0.86rem;
    font-weight: 760;
    padding: 8px 11px;
  }

  .hero-panel,
  .rail-card {
    align-self: stretch;
    background: #ffffff;
    border: 1px solid #c7def3;
    border-radius: 8px;
    display: grid;
    gap: 18px;
    padding: 22px;
  }

  .hero-panel strong {
    color: #18a6c9;
    font-size: 0.82rem;
    text-transform: uppercase;
  }

  .hero-panel h2,
  h2 {
    color: #09213d;
    font-size: 2.2rem;
    letter-spacing: 0;
    line-height: 1.04;
    margin: 0;
  }

  .mini-matrix {
    background: #eef7ff;
    border: 1px solid #d8eafe;
    border-radius: 8px;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
  }

  .mini-matrix span,
  .mini-matrix b {
    border-bottom: 1px solid #d8eafe;
    color: #4a647d;
    padding: 12px;
  }

  .mini-matrix b {
    color: #09213d;
  }

  .hero-panel a,
  .rail-card a {
    align-items: center;
    background: #09213d;
    border-radius: 8px;
    color: #ffffff;
    display: inline-flex;
    font-weight: 820;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
  }

  .category-section,
  .split-section,
  .evaluation-section,
  .signals-section,
  .article-section {
    border-top: 1px solid #c7def3;
    padding: 42px 0;
  }

  .section-head {
    margin-bottom: 20px;
  }

  .category-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .category-grid a,
  .evaluation-grid a,
  .signal-list article,
  .article-grid a {
    background: #ffffff;
    border: 1px solid #c7def3;
    border-radius: 8px;
    display: grid;
    gap: 10px;
    padding: 18px;
  }

  .category-grid strong,
  .evaluation-grid strong,
  .signal-list strong,
  .article-grid a {
    color: #09213d;
    font-size: 1.08rem;
    font-weight: 820;
    line-height: 1.25;
  }

  .category-grid span,
  .rail-card span {
    color: #4a647d;
    line-height: 1.55;
  }

  em,
  .evaluation-grid span,
  .signal-list span {
    color: #1565d8;
    font-style: normal;
    font-weight: 780;
  }

  .split-section {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) 340px;
  }

  .agent-table {
    background: #ffffff;
    border: 1px solid #c7def3;
    border-radius: 8px;
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    min-width: 820px;
    width: 100%;
  }

  th,
  td {
    border-bottom: 1px solid #d8eafe;
    color: #4a647d;
    padding: 15px;
    text-align: left;
    vertical-align: top;
  }

  th {
    color: #09213d;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
    text-transform: uppercase;
  }

  td:first-child {
    color: #09213d;
    font-weight: 850;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  .rail-card h3 {
    color: #09213d;
    font-size: 1.65rem;
    line-height: 1;
    margin: 0;
  }

  .evaluation-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .signal-list {
    display: grid;
    gap: 10px;
  }

  .signal-list article {
    align-items: center;
    grid-template-columns: 120px minmax(0, 1fr) 90px;
  }

  .article-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 980px) {
    .home-sample {
      padding: 14px 16px 54px;
    }

    .topbar,
    .topbar nav {
      align-items: flex-start;
      flex-direction: column;
      position: static;
    }

    .hero,
    .split-section,
    .category-grid,
    .evaluation-grid,
    .article-grid,
    .signal-list article {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 3.2rem;
    }

    .search-box {
      grid-template-columns: 1fr;
    }

    .search-box button {
      width: 100%;
    }
  }
</style>
