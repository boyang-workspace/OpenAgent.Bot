---
import BaseLayout from "@/layouts/BaseLayout.astro";

const samples = [
  {
    href: "/design-samples/home-blue-directory",
    label: "Home",
    title: "Blue Directory Home",
    description: "Blue-white homepage direction for search, agent directory browsing, evaluation entry points, and fresh signal discovery."
  },
  {
    href: "/design-samples/agent-evidence-ledger",
    label: "Agent A",
    title: "Evidence Ledger",
    description: "Search-first resource detail page with facts, trust signals, source links, and decision support above the fold."
  },
  {
    href: "/design-samples/agent-command-center",
    label: "Agent B",
    title: "Command Center",
    description: "Dark, product-led profile page for technical users landing from Google with strong repository and workflow visuals."
  },
  {
    href: "/design-samples/agent-editorial-profile",
    label: "Agent C",
    title: "Editorial Profile",
    description: "Magazine-like profile page that makes an open-source agent feel important without losing SEO structure."
  },
  {
    href: "/design-samples/evaluation-leaderboard",
    label: "Evaluation A",
    title: "Leaderboard",
    description: "Benchmark landing page that puts rankings, methodology, and update freshness first."
  },
  {
    href: "/design-samples/evaluation-lab-report",
    label: "Evaluation B",
    title: "Lab Report",
    description: "Research-style evaluation page with evidence panels, charts, and reproducibility cues."
  },
  {
    href: "/design-samples/evaluation-decision-matrix",
    label: "Evaluation C",
    title: "Decision Matrix",
    description: "SEO guide format that maps benchmark results to real user decisions and workflows."
  },
  {
    href: "/design-samples/content-structures",
    label: "Structure",
    title: "Content Blueprints",
    description: "Three richer content structures for agent detail pages and three for evaluation pages."
  }
];
---

<BaseLayout
  title="OpenAgent design samples"
  description="Agent detail and evaluation page design samples for OpenAgent.bot."
  path="/design-samples"
  noindex
>
  <section class="sample-index">
    <div class="index-copy">
      <p>OpenAgent.bot design samples</p>
      <h1>Six possible directions for SEO landing pages.</h1>
      <span>Pick the direction with the right mix of trust, density, and visual pull. These samples are intentionally outside the current production style.</span>
    </div>
    <div class="sample-grid">
      {samples.map((sample) => (
        <a href={sample.href}>
          <small>{sample.label}</small>
          <strong>{sample.title}</strong>
          <span>{sample.description}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background: #f4f2ea;
  }

  .sample-index {
    display: grid;
    gap: 40px;
    margin: 0 auto;
    max-width: 1160px;
    min-height: 100vh;
    padding: 72px 24px;
  }

  .index-copy {
    max-width: 780px;
  }

  .index-copy p {
    color: #855a24;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    margin: 0 0 18px;
    text-transform: uppercase;
  }

  h1 {
    color: #15130f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 4.8rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.96;
    margin: 0;
  }

  .index-copy span {
    color: #5f574b;
    display: block;
    font-size: 1.12rem;
    line-height: 1.6;
    margin-top: 24px;
  }

  .sample-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .sample-grid a {
    background: #fffaf0;
    border: 1px solid #d8cdb8;
    border-radius: 8px;
    display: grid;
    gap: 14px;
    min-height: 220px;
    padding: 22px;
  }

  .sample-grid a:hover {
    border-color: #15130f;
  }

  .sample-grid small {
    color: #95651f;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sample-grid strong {
    color: #15130f;
    font-size: 1.8rem;
    letter-spacing: 0;
    line-height: 1;
  }

  .sample-grid span {
    color: #5f574b;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .sample-index {
      padding: 42px 18px;
    }

    h1 {
      font-size: 3.1rem;
    }

    .sample-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
