---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorialShell from "@/components/EditorialShell.astro";

const scenarios = [
  ["Browser automation", "browser-use", "Best first test: one narrow website flow with a test account."],
  ["Repository coding", "OpenHands", "Best first test: one small issue in a sandbox repository."],
  ["Local developer workflows", "Goose", "Best first test: one repeatable local task with clear logs."],
  ["Small code-agent library", "smolagents", "Best first test: one tool-using code agent with minimal dependencies."],
  ["Stateful memory agents", "Letta / Mem0", "Best first test: retrieval and update behavior over repeated sessions."]
];

const matrix = [
  ["browser-use", "Browser workflows", "Focused", "Medium", "Website fragility"],
  ["OpenHands", "Coding agents", "Deep", "High", "Unsafe diffs or shell commands"],
  ["Goose", "Local workflows", "Broad", "Medium", "Desktop permissions"],
  ["smolagents", "Code agents", "Small", "Low", "You build more around it"],
  ["LangGraph", "Orchestration", "Deep", "High", "Architecture complexity"]
];
---

<BaseLayout
  title="AI agent decision matrix"
  description="Choose open-source AI agents by browser, coding, local, orchestration, and memory-heavy workflows."
  path="/evaluations/agent-decision-matrix"
>
  <EditorialShell active="evaluations">
    <article class="matrix-page">
      <section class="matrix-hero">
        <div>
          <p class="eyebrow">Decision matrix</p>
          <h1>Choose the agent by the workflow you need to prove.</h1>
          <p>Do not start with the most popular repo. Start with the smallest workflow where the agent can succeed or fail visibly.</p>
        </div>
        <aside>
          <strong>Quick recommendation</strong>
          <span>Browser tasks: browser-use. Coding tasks: OpenHands. Local developer workflows: Goose. Small experiments: smolagents.</span>
        </aside>
      </section>

      <section class="scenario-section">
        <p class="eyebrow">Best by scenario</p>
        <h2>What to test first</h2>
        <div class="scenario-grid">
          {scenarios.map(([scenario, project, note]) => (
            <article>
              <span>{scenario}</span>
              <strong>{project}</strong>
              <p>{note}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="matrix-section">
        <p class="eyebrow">Comparison table</p>
        <h2>Workflow fit matrix</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Project</th>
                <th>Best for</th>
                <th>Depth</th>
                <th>Setup</th>
                <th>Main risk</th>
              </tr>
            </thead>
            <tbody>
              {matrix.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
      </section>

      <section class="method-section">
        <p class="eyebrow">Methodology</p>
        <h2>How OpenAgent evaluates agent fit</h2>
        <div class="method-grid">
          <article>
            <strong>Workflow surface</strong>
            <p>Browser, codebase, local desktop, orchestration, memory, or mixed tool workflow.</p>
          </article>
          <article>
            <strong>Source quality</strong>
            <p>Official docs, repository health, license clarity, and dated verification beat marketing claims.</p>
          </article>
          <article>
            <strong>Failure mode</strong>
            <p>The right agent is the one whose risks you can sandbox, observe, and review.</p>
          </article>
        </div>
      </section>
    </article>
  </EditorialShell>
</BaseLayout>

<style>
  .matrix-page {
    display: grid;
    gap: 26px;
  }

  .matrix-hero {
    align-items: stretch;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1fr) 330px;
    padding: 10px 0 28px;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 520;
    letter-spacing: 0;
    line-height: 1.02;
    margin: 8px 0 0;
    max-width: 820px;
  }

  .matrix-hero p:not(.eyebrow) {
    font-size: 0.95rem;
    margin: 14px 0 0;
    max-width: 720px;
  }

  .matrix-hero aside,
  .scenario-grid article,
  .method-grid article {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 9px;
    padding: 16px;
  }

  .matrix-hero aside strong,
  .scenario-grid span {
    color: var(--accent-open);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .matrix-hero aside span,
  .scenario-grid p,
  .method-grid p {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .scenario-section,
  .matrix-section,
  .method-section {
    border-top: 1px solid var(--line);
    padding-top: 26px;
  }

  h2 {
    font-size: 1.42rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.12;
    margin: 5px 0 14px;
  }

  .scenario-grid,
  .method-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .scenario-grid article:first-child,
  .scenario-grid article:nth-child(2) {
    grid-column: span 1;
  }

  .scenario-grid strong,
  .method-grid strong {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 580;
  }

  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    min-width: 760px;
    width: 100%;
  }

  th,
  td {
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.86rem;
    padding: 13px;
    text-align: left;
  }

  th {
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  td:first-child {
    color: var(--ink);
    font-weight: 580;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  @media (max-width: 900px) {
    .matrix-hero,
    .scenario-grid,
    .method-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
