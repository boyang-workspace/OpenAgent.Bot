---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorialShell from "@/components/EditorialShell.astro";

const evaluationLanes = [
  {
    href: "/evaluations/agent-decision-matrix",
    label: "Decision matrix",
    title: "Choose an open-source AI agent by workflow",
    summary: "Compare browser, coding, local, orchestration, and memory-heavy agent workflows before picking a project."
  },
  {
    href: "/blog/openclaw-vs-browser-use-vs-openhands",
    label: "Comparison guide",
    title: "OpenClaw vs browser-use vs OpenHands",
    summary: "A practical comparison for action agents, browser automation, and coding-agent workflows."
  },
  {
    href: "/blog/best-open-source-browser-agents-workflow-automation",
    label: "Best-of guide",
    title: "Best open-source browser agents",
    summary: "A shortlist for builders evaluating agents that operate real websites."
  }
];

const benchmarkNotes = [
  ["SWE-bench", "Useful for repository-level coding agents, not browser task automation."],
  ["WebArena", "Useful when the core task happens inside websites and web apps."],
  ["GAIA", "Useful for broader assistant behavior, but it does not replace workflow fit."],
  ["Repo health", "Stars, commits, license, and source quality still matter for open-source adoption."]
];
---

<BaseLayout
  title="AI agent evaluations"
  description="OpenAgent evaluations help builders choose AI agents by workflow, benchmark context, source quality, and practical tradeoffs."
  path="/evaluations"
>
  <EditorialShell active="evaluations" eyebrow="Evaluations" title="Choose agents by workflow, not hype." description="Decision guides, benchmark context, and comparison pages for open AI agents.">
    <section class="eval-hero">
      <div>
        <p class="eyebrow">Start here</p>
        <h2>Benchmarks are useful. Workflow fit decides what you should test first.</h2>
      </div>
      <a class="button" href="/evaluations/agent-decision-matrix">Open decision matrix</a>
    </section>

    <section class="eval-grid">
      {evaluationLanes.map((item) => (
        <a href={item.href}>
          <span>{item.label}</span>
          <strong>{item.title}</strong>
          <p>{item.summary}</p>
        </a>
      ))}
    </section>

    <section class="benchmark-section">
      <div class="section-head">
        <span class="eyebrow">Benchmark context</span>
        <h2>What each signal is good for</h2>
      </div>
      <div class="benchmark-list">
        {benchmarkNotes.map(([name, note]) => (
          <article>
            <strong>{name}</strong>
            <p>{note}</p>
          </article>
        ))}
      </div>
    </section>
  </EditorialShell>
</BaseLayout>

<style>
  .eval-hero {
    align-items: end;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 8px 0 26px;
  }

  h2 {
    font-size: 1.82rem;
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.08;
    margin: 6px 0 0;
    max-width: 760px;
  }

  .eval-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 24px 0;
  }

  .eval-grid a,
  .benchmark-list article {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 9px;
    padding: 16px;
  }

  .eval-grid span {
    color: var(--accent-open);
    font-size: 0.72rem;
    font-weight: 560;
    text-transform: uppercase;
  }

  .eval-grid strong,
  .benchmark-list strong {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 580;
    line-height: 1.25;
  }

  .eval-grid p,
  .benchmark-list p {
    font-size: 0.86rem;
    margin: 0;
  }

  .benchmark-section {
    border-top: 1px solid var(--line);
    padding: 26px 0;
  }

  .section-head {
    margin-bottom: 14px;
  }

  .benchmark-list {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 820px) {
    .eval-hero,
    .eval-grid,
    .benchmark-list {
      grid-template-columns: 1fr;
    }
  }
</style>
