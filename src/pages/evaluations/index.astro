---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorialShell from "@/components/EditorialShell.astro";

const evaluationLanes = [
  {
    href: "/evaluations/agent-decision-matrix",
    label: "Decision matrix",
    title: "Choose an open-source AI agent by workflow",
    summary: "Compare browser, coding, local, orchestration, and memory-heavy agent workflows before picking a project.",
    intent: "Best first page for search visitors asking which agent to try."
  },
  {
    href: "/blog/openclaw-vs-browser-use-vs-openhands",
    label: "Comparison guide",
    title: "OpenClaw vs browser-use vs OpenHands",
    summary: "A practical comparison for action agents, browser automation, and coding-agent workflows.",
    intent: "Useful when the visitor already has two or three candidate tools."
  },
  {
    href: "/blog/best-open-source-browser-agents-workflow-automation",
    label: "Best-of guide",
    title: "Best open-source browser agents",
    summary: "A shortlist for builders evaluating agents that operate real websites.",
    intent: "Useful for broad discovery queries and buyer-guide style searches."
  }
];

const benchmarkNotes = [
  ["SWE-bench", "Repository-level coding-agent signal. Good for software tasks, weak for browser task automation."],
  ["WebArena", "Website and web-app task signal. Useful when the agent must navigate browser workflows."],
  ["GAIA", "General assistant-task signal. Helpful context, but not a replacement for your own workflow test."],
  ["Repo health", "Stars, license, commits, docs, and source clarity still matter for open-source adoption."]
];
---

<BaseLayout
  title="AI agent evaluations"
  description="OpenAgent evaluations help builders choose AI agents by workflow, benchmark context, source quality, and practical tradeoffs."
  path="/evaluations"
>
  <EditorialShell active="evaluations" eyebrow="Evaluations" title="Choose agents by workflow, not hype." description="Decision guides, benchmark context, and comparison pages for open AI agents.">
    <section class="evaluation-list" aria-label="Evaluation articles">
      {evaluationLanes.map((item) => (
        <a class="evaluation-card" href={item.href} data-analytics="evaluation" data-analytics-payload={JSON.stringify({title: item.title, label: item.label})}>
          <span>{item.label}</span>
          <h2>{item.title}</h2>
          <p>{item.summary}</p>
          <small>{item.intent}</small>
        </a>
      ))}
    </section>

    <section class="benchmark-section">
      <div class="section-head">
        <span class="eyebrow">Benchmark context</span>
        <h2>What each signal is good for</h2>
      </div>
      <div class="benchmark-list">
        {benchmarkNotes.map(([name, note]) => (
          <article>
            <strong>{name}</strong>
            <p>{note}</p>
          </article>
        ))}
      </div>
    </section>
  </EditorialShell>
</BaseLayout>

<style>
  .evaluation-list {
    display: grid;
    gap: 14px;
  }

  .evaluation-card,
  .benchmark-list article {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .evaluation-card {
    display: grid;
    gap: 9px;
    padding: 20px;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .evaluation-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  .evaluation-card span,
  .evaluation-card small {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .evaluation-card h2,
  .section-head h2 {
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 540;
    letter-spacing: 0;
    line-height: 1.2;
    margin: 0;
  }

  .evaluation-card p,
  .benchmark-list p {
    font-size: 0.86rem;
    margin: 0;
  }

  .benchmark-section {
    border-top: 1px solid var(--line);
    margin-top: 28px;
    padding-top: 28px;
  }

  .section-head {
    margin-bottom: 14px;
  }

  .benchmark-list {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .benchmark-list article {
    display: grid;
    gap: 8px;
    padding: 16px;
  }

  .benchmark-list strong {
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 560;
  }

  @media (max-width: 720px) {
    .benchmark-list {
      grid-template-columns: 1fr;
    }
  }
</style>
