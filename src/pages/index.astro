---
import IndexLayout from "@/layouts/IndexLayout.astro";
import { compactNumber, label, relativeDate } from "@/lib/registry/format";
import { getHomepageData } from "@/lib/homepage-data";

const data = await getHomepageData();
const historyDays = data.stats.historyStartedAt
  ? Math.max(1, Math.ceil((Date.now() - new Date(data.stats.historyStartedAt).getTime()) / 86_400_000))
  : 0;
---

<IndexLayout
  title="Open(Source) × Agent(s) × (Ro)Bot"
  description="Track and compare open-source agents, robotics projects, models and tools in a continuously updated public database."
  path="/"
  themeColor="#0b0d0c"
>
  <div class="index-app">
    <header class="index-header">
      <a class="wordmark" href="/" aria-label="OpenAgent.bot home">
        <span class="wordmark-icon">OA</span>
        <span>OPENAGENT<small>.BOT</small></span>
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        <a href="#rankings">Rankings</a>
        <a href="/database?domain=agent">Agents</a>
        <a href="/database?domain=robotics">Robots</a>
        <a href="#signals">Signals</a>
        <a href="/database">Database</a>
      </nav>
      <a class="support-link" href="#support">Support the index <span>↗</span></a>
    </header>

    <main class="index-main">
      <div class="index-content">
      <section class="index-hero">
        <div class="hero-copy">
          <div class="live-label"><span></span> Registry online · independently tracked</div>
          <h1><span class="title-open">Open(Source) ×</span><br /><span class="title-agent"><em>Agent(s)</em> ×</span> <span class="title-bot"><em>(Ro)Bot</em></span></h1>
          <div class="hero-lower">
            <p>Open data for software agents and physical robots—plus the models and tools that connect them.</p>
            <form action="/database" method="get">
              <label for="index-search">Search the open ecosystem</label>
              <div>
                <input id="index-search" name="q" type="search" placeholder="Search projects…" />
                <button type="submit">Search <span>↗</span></button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <section class="registry-summary" aria-label="Registry coverage by layer">
        <a href="/database"><span>All entities</span><strong>{compactNumber(data.stats.entities)}</strong><small>public records</small></a>
        <a href="/database?domain=agent"><span>Agent field</span><strong>{compactNumber(data.stats.agents)}</strong><small>software ecosystem</small></a>
        <a href="/database?domain=robotics"><span>Robot field</span><strong>{compactNumber(data.stats.robots)}</strong><small>physical ecosystem</small></a>
        <a href="/database?kind=model"><span>Open models</span><strong>{compactNumber(data.stats.models)}</strong><small>weights + policies</small></a>
        <a href="/database?kind=tool"><span>Tools</span><strong>{compactNumber(data.stats.tools)}</strong><small>skills + infrastructure</small></a>
      </section>

      <div class="signal-tape" aria-label="Data collection status">
        <span class="tape-title">DATA STATUS</span>
        <div class="tape-track">
          <span>{data.stats.metricEntities}/{data.stats.entities} PROJECTS WITH METRICS</span>
          <span>{historyDays}/30 DAYS OF RANKING HISTORY</span>
          <span>{data.stats.liveSources}/{data.stats.sources} SOURCE CONNECTORS LIVE</span>
          <span>RANKINGS NEVER ACCEPT PAYMENT</span>
        </div>
      </div>

      <section class="rankings" id="rankings">
        <header class="section-head">
          <div><span class="section-index">01 / ADOPTION BASELINE</span><h2>Current leaders</h2></div>
          <span class="collection-state"><i></i> 30D history collecting</span>
        </header>

        <div class="board-grid">
          <article class="rank-board agent-board">
            <header>
              <div><span class="board-dot"></span><span>Software layer</span></div>
              <h3>Agent Index</h3>
              <p>Current adoption baseline while 30-day history is collected.</p>
            </header>
            <div class="table-head"><span>Position / Project</span><span>History</span><span>Current stars</span></div>
            <div class="rank-list">
              {data.agents.slice(0, 6).map((entity, index) => (
                <a class="rank-row" href={`/project/${entity.slug}`} style={`--i:${index}`}>
                  <span class="rank-no">{String(index + 1).padStart(2, "0")}</span>
                  <span class="project"><strong>{entity.name}</strong><small>{label(entity.kind)} · {label(entity.opennessStatus)}</small></span>
                  <span class="history-state"><i></i>Collecting</span>
                  <span class="metric"><strong>{compactNumber(entity.stars)}</strong><small>baseline</small></span>
                  <span class="row-arrow">↗</span>
                </a>
              ))}
            </div>
            <a class="board-cta" href="/database?domain=agent"><span>Explore all {data.stats.agents} agent-field records</span><b>→</b></a>
          </article>

          <article class="rank-board robot-board">
            <header>
              <div><span class="board-dot"></span><span>Physical layer</span></div>
              <h3>Robot Index</h3>
              <p>Discovery board until the robotics cohort reaches ranking eligibility.</p>
            </header>
            <div class="table-head"><span>Position / Project</span><span>History</span><span>Current stars</span></div>
            <div class="rank-list">
              {data.robots.slice(0, 6).map((entity, index) => (
                <a class="rank-row" href={`/project/${entity.slug}`} style={`--i:${index}`}>
                  <span class="rank-no">{String(index + 1).padStart(2, "0")}</span>
                  <span class="project"><strong>{entity.name}</strong><small>{label(entity.kind)} · {label(entity.opennessStatus)}</small></span>
                  <span class="history-state"><i></i>Collecting</span>
                  <span class="metric"><strong>{compactNumber(entity.stars)}</strong><small>baseline</small></span>
                  <span class="row-arrow">↗</span>
                </a>
              ))}
            </div>
            <a class="board-cta" href="/database?domain=robotics"><span>Explore all {data.stats.robots} robotics records</span><b>→</b></a>
          </article>
        </div>
      </section>

      <section class="signals" id="signals">
        <header class="section-head light-head">
          <div><span class="section-index">02 / DATA STATUS</span><h2>How complete is it?</h2></div>
          <a href="/sources">Inspect every source →</a>
        </header>
        <div class="signal-grid">
          <article class="signal-feature">
            <span class="signal-kicker">Latest verified change</span>
            {data.changes[0] ? (
              <>
                <a href={`/project/${data.changes[0].entitySlug}`}><h3>{data.changes[0].entityName}</h3></a>
                <p><b>{label(data.changes[0].changeType)}</b> · {label(data.changes[0].factKey)}</p>
                <footer><span>{data.changes[0].sourceName}</span><time datetime={data.changes[0].detectedAt}>{relativeDate(data.changes[0].detectedAt)}</time></footer>
              </>
            ) : <><h3>History is collecting.</h3><p>New verified changes will appear here.</p></>}
          </article>
          <article class="coverage-panel">
            <header><span>Coverage / live</span><small>Honest by default</small></header>
            <div class="coverage-primary"><strong>{data.stats.metricEntities}<i>/ {data.stats.entities}</i></strong><span>projects with<br />tracked metrics</span></div>
            <dl>
              <div><dt>Evidence records</dt><dd>{compactNumber(data.stats.observations)}</dd></div>
              <div><dt>Verified changes</dt><dd>{compactNumber(data.stats.changes30d)}</dd></div>
              <div><dt>Live connectors</dt><dd>{data.stats.liveSources} / {data.stats.sources}</dd></div>
              <div><dt>History window</dt><dd>{historyDays} / 30d</dd></div>
            </dl>
            <footer><span>Rank movement publishes only after the 30-day gate.</span><a href="/methodology#rankings">Read methodology →</a></footer>
          </article>
        </div>
      </section>

      </div>

      <aside class="support-rail" id="support" aria-label="Support OpenAgent.bot">
        <div class="support-rail-inner">
          <section class="support-intro">
            <div class="rail-heading"><span>SUPPORT / 01</span><small>Disclosed sponsorship</small></div>
            <span class="slot-state"><i></i> Founding slot available</span>
            <h2>Support the<br />open&nbsp;index.</h2>
            <p>Fund public data and reach builders across the open Agent and Robot ecosystem.</p>
            <a href="mailto:hello@openagent.bot?subject=Founding%20supporter%20slot">Reserve this weekly slot <b>↗</b></a>
          </section>

          <section class="support-board">
            <div class="rail-heading"><span>SUPPORT BOARD</span><small>Preview</small></div>
            <ol>
              <li><span>01</span><div><strong>Weekly index sponsor</strong><small>Available · 7 days</small></div><b>OPEN</b></li>
              <li><span>02</span><div><strong>Agent field supporter</strong><small>Available · 7 days</small></div><b>OPEN</b></li>
              <li><span>03</span><div><strong>Robot field supporter</strong><small>Available · 7 days</small></div><b>OPEN</b></li>
            </ol>
          </section>

          <section class="bounty-panel">
            <div class="rail-heading"><span>SPONSOR FORMATS</span><small>Disclosed</small></div>
            <a href="mailto:hello@openagent.bot?subject=Robot%20field%20sponsor"><span class="bounty-color robot-bounty"></span><div><strong>Robot field sponsor</strong><small>Support physical-stack coverage</small></div><b>↗</b></a>
            <a href="mailto:hello@openagent.bot?subject=Agent%20field%20sponsor"><span class="bounty-color agent-bounty"></span><div><strong>Agent field sponsor</strong><small>Support software-stack coverage</small></div><b>↗</b></a>
          </section>

          <section class="boundary-card">
            <span>THE BOUNDARY</span>
            <p>Money can buy a disclosed placement. It can never buy an organic rank.</p>
            <a href="/methodology#rankings">Read the rule →</a>
          </section>
        </div>
      </aside>
    </main>

    <footer class="index-footer">
      <a href="/">OPENAGENT.BOT</a>
      <p>Open data for software agents and physical robots.</p>
      <a href="/about">About the index →</a>
    </footer>
  </div>
</IndexLayout>

<style>
  :global(body) { background: #e8e9e4; color: #101310; font-family: "Spline Sans", sans-serif; }
  :global(::selection) { background: #b9ff38; color: #0b0d0c; }
  .index-app { --acid: #b9ff38; --support: #caff62; --agent: #43a5ff; --robot: #ff653c; --ink: #0b0d0c; --paper: #f3f4ef; background: var(--paper); margin: 0 auto; max-width: 1600px; min-height: 100vh; overflow: clip; }
  .index-app a:focus-visible, .index-app button:focus-visible, .index-app input:focus-visible { outline: 3px solid var(--robot); outline-offset: 3px; position: relative; z-index: 10; }
  .index-header { align-items: stretch; border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: 250px 1fr 250px; min-height: 74px; }
  .wordmark { align-items: center; border-right: 1px solid var(--ink); display: flex; font-family: "Azeret Mono", monospace; font-size: .78rem; font-weight: 700; gap: 12px; padding: 14px 22px; }
  .wordmark small { color: #687067; }
  .wordmark-icon { align-items: center; background: var(--ink); color: var(--acid); display: flex; height: 38px; justify-content: center; width: 38px; }
  .primary-nav { display: flex; overflow: auto; }
  .primary-nav a { align-items: center; border-right: 1px solid #c8ccc5; color: #515a51; display: flex; font-family: "Azeret Mono", monospace; font-size: .68rem; padding: 0 20px; text-transform: uppercase; }
  .primary-nav a:hover { background: #e4e6df; color: var(--ink); }
  .support-link { align-items: center; background: var(--ink); color: var(--paper); display: flex; font-family: "Azeret Mono", monospace; font-size: .68rem; justify-content: space-between; padding: 0 20px; text-transform: uppercase; }
  .support-link:hover { background: var(--acid); color: var(--ink); }
  .index-main { display: grid; grid-template-columns: minmax(0, 3fr) minmax(310px, 1fr); }
  .index-content { min-width: 0; }
  .index-hero { border-bottom: 1px solid var(--ink); }
  .hero-copy { min-height: 360px; min-width: 0; padding: 42px 3.2vw 34px; }
  .live-label { align-items: center; color: #505a50; display: flex; font-family: "Azeret Mono", monospace; font-size: .66rem; gap: 9px; letter-spacing: .04em; text-transform: uppercase; }
  .live-label span { animation: pulse 1.8s infinite; background: var(--acid); border: 1px solid var(--ink); border-radius: 50%; height: 9px; width: 9px; }
  .hero-copy h1 { font-size: clamp(3.5rem, 5.5vw, 5.9rem); letter-spacing: -.06em; line-height: .9; margin: 34px 0 28px; max-width: 900px; }
  .hero-copy h1 em { font-style: normal; }
  .hero-copy h1 .title-agent em { color: var(--agent); }
  .hero-copy h1 .title-bot em { color: var(--robot); }
  .hero-lower { align-items: end; display: grid; gap: 34px; grid-template-columns: minmax(0, 1fr) minmax(300px, .9fr); }
  .hero-lower > p { color: #424a42; font-size: clamp(.98rem, 1.2vw, 1.12rem); line-height: 1.5; margin: 0; max-width: 520px; }
  .hero-copy form { margin: 0; max-width: 480px; }
  .hero-copy form label { display: block; font-family: "Azeret Mono", monospace; font-size: .66rem; margin-bottom: 10px; text-transform: uppercase; }
  .hero-copy form > div { border: 1px solid var(--ink); display: grid; grid-template-columns: 1fr auto; }
  .hero-copy input { background: #fff; border: 0; font-size: .95rem; min-height: 50px; min-width: 0; padding: 14px 16px; }
  .hero-copy button { background: var(--ink); border: 0; color: var(--paper); cursor: pointer; font-family: "Azeret Mono", monospace; font-size: .68rem; padding: 0 22px; text-transform: uppercase; }
  .hero-copy button:hover { background: var(--acid); color: var(--ink); }
  .registry-summary { background: var(--paper); border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: repeat(5, 1fr); }
  .registry-summary a { display: flex; flex-direction: column; min-height: 108px; padding: 18px; }
  .registry-summary a + a { border-left: 1px solid #c4c8c0; }
  .registry-summary a:hover { background: #e4e6df; }
  .registry-summary span, .registry-summary small { color: #596159; font-family: "Azeret Mono", monospace; font-size: .6rem; text-transform: uppercase; }
  .registry-summary strong { font-size: 2rem; letter-spacing: -.05em; line-height: 1; margin: auto 0 5px; }
  .signal-tape { background: var(--acid); border-bottom: 1px solid var(--ink); display: grid; font-family: "Azeret Mono", monospace; font-size: .64rem; grid-template-columns: 150px 1fr; min-height: 44px; overflow: hidden; text-transform: uppercase; }
  .tape-title { align-items: center; background: var(--ink); color: var(--acid); display: flex; padding: 0 22px; }
  .tape-track { align-items: center; display: flex; gap: 46px; overflow: hidden; padding: 0 24px; white-space: nowrap; }
  .tape-track span::before { content: "◆"; margin-right: 10px; }
  .rankings, .signals { padding: 62px 3.2vw; }
  .rankings { background: #dfe1da; border-bottom: 1px solid var(--ink); }
  .section-head { align-items: end; display: flex; justify-content: space-between; margin-bottom: 28px; }
  .section-index { color: #596159; font-family: "Azeret Mono", monospace; font-size: .65rem; letter-spacing: .05em; text-transform: uppercase; }
  .section-head h2 { font-size: clamp(2.75rem, 4.4vw, 4.9rem); letter-spacing: -.055em; line-height: .94; margin: 12px 0 0; }
  .collection-state { align-items: center; border: 1px solid var(--ink); display: flex; font-family: "Azeret Mono", monospace; font-size: .64rem; gap: 8px; padding: 12px 14px; text-transform: uppercase; }
  .collection-state i { animation: pulse 1.8s infinite; background: var(--acid); border: 1px solid var(--ink); border-radius: 50%; height: 8px; width: 8px; }
  .board-grid { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
  .rank-board { background: var(--paper); border: 1px solid var(--ink); min-width: 0; }
  .rank-board > header { border-bottom: 1px solid var(--ink); min-height: 220px; padding: 26px; }
  .rank-board > header > div { align-items: center; display: flex; font-family: "Azeret Mono", monospace; font-size: .64rem; gap: 8px; text-transform: uppercase; }
  .board-dot { background: var(--agent); height: 9px; width: 9px; }
  .robot-board .board-dot { background: var(--robot); }
  .rank-board h3 { font-size: clamp(2.8rem, 4.2vw, 4.7rem); letter-spacing: -.055em; line-height: .94; margin: 42px 0 12px; }
  .rank-board header p { color: #586058; line-height: 1.45; margin-bottom: 0; }
  .table-head { background: var(--ink); color: #c1c8c0; display: grid; font-family: "Azeret Mono", monospace; font-size: .625rem; grid-template-columns: 1fr 100px 90px; padding: 11px 18px; text-transform: uppercase; }
  .rank-row { align-items: center; animation: rowIn .45s calc(var(--i) * 60ms) both; border-bottom: 1px solid #c7cac3; display: grid; gap: 14px; grid-template-columns: 34px minmax(130px, 1fr) 94px 76px 18px; min-height: 72px; padding: 9px 16px; transition: background .18s, color .18s; }
  .agent-board .rank-row:hover { background: var(--agent); color: var(--ink); }
  .robot-board .rank-row:hover { background: var(--robot); color: var(--ink); }
  .rank-no, .project small, .metric small { color: #626a61; font-family: "Azeret Mono", monospace; font-size: .625rem; text-transform: uppercase; }
  .project strong, .project small, .metric strong, .metric small { display: block; }
  .project strong { font-size: .95rem; }
  .project small { margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .metric { text-align: right; }
  .metric strong { font-family: "Azeret Mono", monospace; font-size: .74rem; }
  .metric small { margin-top: 5px; }
  .history-state { align-items: center; color: #697168; display: flex; font-family: "Azeret Mono", monospace; font-size: .6rem; gap: 7px; text-transform: uppercase; }
  .history-state i { background: #747d73; border-radius: 50%; height: 6px; width: 6px; }
  .row-arrow { opacity: 0; transform: translate(-5px, 5px); transition: opacity .18s, transform .18s; }
  .rank-row:hover .row-arrow { opacity: 1; transform: translate(0); }
  .rank-row:hover small, .rank-row:hover .rank-no { color: #202720; }
  .board-cta { align-items: center; display: flex; font-family: "Azeret Mono", monospace; font-size: .64rem; justify-content: space-between; min-height: 58px; padding: 0 18px; text-transform: uppercase; }
  .board-cta:hover { background: var(--ink); color: var(--acid); }
  .signals { background: var(--paper); border-bottom: 1px solid var(--ink); }
  .light-head > a { border-bottom: 1px solid var(--ink); font-family: "Azeret Mono", monospace; font-size: .64rem; padding-bottom: 8px; text-transform: uppercase; }
  .signal-grid { border: 1px solid var(--ink); display: grid; grid-template-columns: .9fr 1.1fr; }
  .signal-feature { background: var(--agent); display: flex; flex-direction: column; min-height: 390px; padding: 30px; }
  .signal-kicker { font-family: "Azeret Mono", monospace; font-size: .64rem; text-transform: uppercase; }
  .signal-feature h3 { font-size: clamp(3.5rem, 6vw, 6.6rem); letter-spacing: -.07em; line-height: .82; margin: auto 0 25px; }
  .signal-feature p { font-family: "Azeret Mono", monospace; font-size: .68rem; text-transform: uppercase; }
  .signal-feature footer { border-top: 1px solid var(--ink); display: flex; font-family: "Azeret Mono", monospace; font-size: .61rem; justify-content: space-between; padding-top: 14px; text-transform: uppercase; }
  .coverage-panel { background: var(--ink); color: var(--paper); display: flex; flex-direction: column; min-width: 0; padding: 30px; }
  .coverage-panel > header { color: #a8b0a6; display: flex; font-family: "Azeret Mono", monospace; font-size: .62rem; justify-content: space-between; text-transform: uppercase; }
  .coverage-primary { align-items: end; display: flex; gap: 18px; margin: 48px 0 34px; }
  .coverage-primary strong { color: var(--acid); font-size: clamp(3.7rem, 6vw, 6.2rem); letter-spacing: -.08em; line-height: .75; }
  .coverage-primary strong i { color: #899188; font-size: .34em; font-style: normal; letter-spacing: -.04em; }
  .coverage-primary span { color: #b7beb5; font-family: "Azeret Mono", monospace; font-size: .62rem; line-height: 1.5; text-transform: uppercase; }
  .coverage-panel dl { border-top: 1px solid #454c44; display: grid; grid-template-columns: 1fr 1fr; margin: 0; }
  .coverage-panel dl div { border-bottom: 1px solid #454c44; padding: 15px 0; }
  .coverage-panel dl div:nth-child(odd) { border-right: 1px solid #454c44; }
  .coverage-panel dl div:nth-child(even) { padding-left: 16px; }
  .coverage-panel dt { color: #9fa79e; font-family: "Azeret Mono", monospace; font-size: .58rem; text-transform: uppercase; }
  .coverage-panel dd { font-size: 1.05rem; margin: 7px 0 0; }
  .coverage-panel footer { align-items: end; display: flex; font-family: "Azeret Mono", monospace; font-size: .58rem; gap: 20px; justify-content: space-between; line-height: 1.45; margin-top: auto; padding-top: 20px; text-transform: uppercase; }
  .coverage-panel footer span { color: #a8b0a6; max-width: 260px; }
  .coverage-panel footer a { border-bottom: 1px solid var(--acid); color: var(--acid); flex: 0 0 auto; padding-bottom: 5px; }
  .support-rail { background: var(--ink); border-left: 1px solid var(--ink); color: var(--paper); min-width: 0; }
  .support-rail-inner { min-height: 100%; position: static; }
  .support-rail section { border-bottom: 1px solid #424941; }
  .rail-heading { display: flex; font-family: "Azeret Mono", monospace; font-size: .61rem; justify-content: space-between; letter-spacing: .03em; text-transform: uppercase; }
  .rail-heading small { opacity: .58; }
  .support-intro { background: var(--support); color: var(--ink); display: flex; flex-direction: column; min-height: 360px; padding: 24px; position: sticky; top: 0; z-index: 4; }
  .slot-state { align-items: center; display: flex; font-family: "Azeret Mono", monospace; font-size: .6rem; gap: 8px; margin-top: 34px; text-transform: uppercase; }
  .slot-state i { animation: pulse 1.8s infinite; background: var(--ink); border-radius: 50%; height: 8px; width: 8px; }
  .support-intro h2 { font-size: clamp(2.65rem, 3.8vw, 4.1rem); letter-spacing: -.055em; line-height: .88; margin: 22px 0 18px; }
  .support-intro p { font-size: .9rem; line-height: 1.55; }
  .support-intro > a { border: 1px solid var(--ink); display: flex; font-family: "Azeret Mono", monospace; font-size: .6rem; justify-content: space-between; margin-top: auto; padding: 14px; text-transform: uppercase; }
  .support-intro > a:hover { background: var(--ink); color: var(--acid); }
  .support-board { background: var(--paper); color: var(--ink); padding-top: 24px; }
  .support-board > .rail-heading, .bounty-panel > .rail-heading { padding: 0 24px 18px; }
  .support-board ol { border-top: 1px solid var(--ink); list-style: none; margin: 0; padding: 0; }
  .support-board li { align-items: center; border-bottom: 1px solid #c7cac3; display: grid; gap: 10px; grid-template-columns: 24px 1fr auto; min-height: 70px; padding: 10px 18px; }
  .support-board li:last-child { border-bottom: 0; }
  .support-board li > span, .support-board li small, .support-board li > b { font-family: "Azeret Mono", monospace; font-size: .625rem; text-transform: uppercase; }
  .support-board li strong, .support-board li small { display: block; }
