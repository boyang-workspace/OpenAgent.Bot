---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntityTable from "@/components/EntityTable.astro";
import ChangeList from "@/components/ChangeList.astro";
import { getRegistry } from "@/lib/registry/runtime";
import { officialSources } from "@/lib/registry/official-sources";
import { compactNumber, relativeDate } from "@/lib/registry/format";
import type { RegistryChange, RegistryEntity, RegistryStats } from "@/lib/registry/types";

let entities: RegistryEntity[] = [];
let changes: RegistryChange[] = [];
let stats: RegistryStats = { entities: 0, agents: 0, robots: 0, models: 0, sources: officialSources.length, observations: 0, changes30d: 0 };
let databaseReady = true;

try {
  const registry = getRegistry();
  const [entityResult, changeResult, statResult] = await Promise.all([
    registry.listEntities({ sort: "updated", limit: 8 }),
    registry.listChanges(6),
    registry.getStats()
  ]);
  entities = entityResult.items;
  changes = changeResult;
  stats = statResult;
} catch {
  databaseReady = false;
}
---

<BaseLayout title="Open(Source) × Agent(s) × (Ro)Bot" description="The database of open-source agents, robots, and everything that makes them work." path="/">
  <div class="page-shell">
    <div class="page-grid">
      <section class="page-section hero">
        <div class="kicker">Registry / Evidence / Change history</div>
        <h1 class="page-title">Open(Source) ×<br />Agent(s) × (Ro)Bot</h1>
        <p class="lede">The database of open-source agents, robots, and everything that makes them work.</p>
        <div class="button-row">
          <a class="button primary" href="/database">Explore database <span>→</span></a>
          <a class="button secondary" href="/methodology">How facts are verified</a>
        </div>
        {!databaseReady && <p class="setup-note">LOCAL STATUS · D1 migrations have not been applied in this runtime yet.</p>}
      </section>

      <section class="stat-grid" aria-label="Registry statistics">
        <div class="stat"><span class="data-label">Entities</span><strong>{compactNumber(stats.entities)}</strong></div>
        <div class="stat"><span class="data-label">Agents</span><strong>{compactNumber(stats.agents)}</strong></div>
        <div class="stat"><span class="data-label">Robotics</span><strong>{compactNumber(stats.robots)}</strong></div>
        <div class="stat"><span class="data-label">Models</span><strong>{compactNumber(stats.models)}</strong></div>
        <div class="stat"><span class="data-label">Sources</span><strong>{compactNumber(stats.sources || officialSources.length)}</strong></div>
        <div class="stat"><span class="data-label">30d changes</span><strong>{compactNumber(stats.changes30d)}</strong></div>
      </section>

      <section class="split philosophy">
        <div>
          <span class="eyebrow">01 / The thesis</span>
          <h2 class="section-title">Intelligence should be inspectable. Machines should be accountable.</h2>
        </div>
        <div class="thesis-copy">
          <p>Agents are the software layer. Robots are the physical layer. Open source—code, weights, hardware, documentation and governance—is the trust layer that lets both collaborate with people.</p>
          <a class="mono-link" href="/methodology">Read the openness framework →</a>
        </div>
      </section>

      <section class="page-section">
        <div class="section-head">
          <div><span class="eyebrow">02 / Recently verified</span><h2 class="section-title">The living registry</h2></div>
          <a class="button secondary" href="/database">View all {stats.entities || ""}</a>
        </div>
        <EntityTable entities={entities} />
      </section>

      <section class="split">
        <div>
          <span class="eyebrow">03 / Change log</span>
          <h2 class="section-title">What moved?</h2>
          <p class="lede">License changes, releases, repository activity, new model weights and robotics announcements become timestamped events—not disposable posts.</p>
          <a class="button secondary" href="/changes">Open change log</a>
        </div>
        <div>
          <ChangeList changes={changes} />
        </div>
      </section>

      <section class="page-section source-ribbon">
        <span class="eyebrow">04 / Source coverage</span>
        <div class="source-names">
          {officialSources.slice(0, 12).map((source) => <span>{source.publisher}</span>)}
        </div>
        <p class="mono">{officialSources.filter((source) => source.automationStatus === "active").length} active connectors · {officialSources.length} registered sources · last sync {relativeDate(stats.lastSyncAt)}</p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .hero { min-height: 600px; padding-top: 78px; position: relative; }
  .hero::after { border: 1px solid var(--ink); content: "DB / 0002"; font-family: var(--mono); font-size: .62rem; padding: 8px; position: absolute; right: 48px; top: 48px; }
  .setup-note { background: var(--orange); color: var(--ink); display: inline-block; font-family: var(--mono); font-size: .64rem; margin-top: 28px; padding: 8px 10px; }
  .philosophy { background: var(--ink); color: var(--paper); }
  .philosophy .eyebrow, .philosophy p { color: #aaaca1; }
  .thesis-copy { display: flex; flex-direction: column; justify-content: flex-end; }
  .thesis-copy p { font-size: 1.08rem; line-height: 1.65; }
  .mono-link { color: var(--acid); font-family: var(--mono); font-size: .7rem; margin-top: 20px; text-transform: uppercase; }
  .section-head { align-items: end; display: flex; justify-content: space-between; margin-bottom: 28px; }
  .section-head .section-title { margin-bottom: 0; }
  .source-ribbon { background: var(--acid); }
  .source-names { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0; }
  .source-names span { background: var(--paper); border: 1px solid var(--ink); font-family: var(--mono); font-size: .66rem; padding: 8px 10px; text-transform: uppercase; }
  .source-ribbon p { margin-bottom: 0; }
  @media (max-width: 760px) {
    .hero { min-height: 520px; padding-top: 60px; }
    .hero .page-title { font-size: 14vw; line-height: .92; }
    .hero::after { display: none; }
    .section-head { align-items: flex-start; flex-direction: column; gap: 20px; }
  }
</style>
