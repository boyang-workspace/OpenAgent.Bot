---
import IndexLayout from "@/layouts/IndexLayout.astro";
import ActivityLeaderboard from "@/components/ActivityLeaderboard.astro";
import { rankByActivity, type ActivityEntry } from "@/lib/registry/activity";
import { primaryCatalogPages } from "@/lib/registry/catalog-config";
import { calendarDate, compactNumber, label, relativeDate } from "@/lib/registry/format";
import { getRegistry, getUsage } from "@/lib/registry/runtime";
import { compactTokens, type UsagePageData } from "@/lib/registry/usage";
import type { RegistryChange, RegistryStats } from "@/lib/registry/types";

let stats: RegistryStats = { entities: 0, agents: 0, robots: 0, infrastructure: 0, robotPlatforms: 0, robotIntelligence: 0, roboticsStack: 0, models: 0, tools: 0, sources: 0, liveSources: 0, observations: 0, metricEntities: 0, changes30d: 0 };
let changes: RegistryChange[] = [];
let leaderboards = new Map<string, ActivityEntry[]>();
let categoryTotals = new Map<string, number>();
let loadError = false;
let agentUsage: UsagePageData | undefined;

try {
  const registry = getRegistry();
  const [registryStats, recentChanges, ...cohorts] = await Promise.all([
    registry.getStats(),
    registry.listChanges(8),
    ...primaryCatalogPages.map((page) => registry.listEntities({ category: page.category, sort: "activity", limit: 6 }))
  ]);
  stats = registryStats;
  changes = recentChanges;
  primaryCatalogPages.forEach((page, index) => {
    leaderboards.set(page.category, rankByActivity(cohorts[index].items, page.category));
    categoryTotals.set(page.category, cohorts[index].total);
  });
} catch { loadError = true; }

try { agentUsage = await getUsage().pageData("app", { openOnly: true, days: 7 }); }
catch { agentUsage = undefined; }

const historyDays = stats.historyStartedAt ? Math.max(0, Math.floor((Date.now() - new Date(stats.historyStartedAt).getTime()) / 86_400_000)) : 0;
const coverage = stats.entities ? Math.round(stats.metricEntities / stats.entities * 100) : 0;
const agentUsageSnapshot = agentUsage?.snapshot.slice(0, 6) ?? [];
const maxAgentUsage = agentUsageSnapshot.reduce((max, item) => {
  const tokens = BigInt(item.totalTokens);
  return tokens > max ? tokens : max;
}, 0n);
---

<IndexLayout title="OpenAgent.bot — Open AI & Robotics Database" description="Track open models, agents, robot intelligence and robot hardware through rankings, releases, evaluations and historical change." path="/" themeColor="#111111">
  <main class="db-home">
    <section class="db-hero">
      <div class="hero-copy">
        <span class="overline">Open AI &amp; robotics database</span>
        <h1>Track the open ecosystem.</h1>
        <p>Models, agents, robot intelligence and hardware—ranked by current activity and recorded over time.</p>
      </div>
      <dl class="hero-readout" aria-label="Database status">
        <div><dt>Records</dt><dd>{compactNumber(stats.entities)}</dd></div>
        <div><dt>Evidence</dt><dd>{compactNumber(stats.observations)}</dd></div>
        <div><dt>Coverage</dt><dd>{coverage}%</dd></div>
        <div><dt>History</dt><dd>{historyDays}/30d</dd></div>
        <div><dt>30d changes</dt><dd>{compactNumber(stats.changes30d)}</dd></div>
        <div><dt>Updated</dt><dd>{relativeDate(stats.lastSyncAt)}</dd></div>
      </dl>
    </section>

    <nav class="category-index" aria-label="Primary databases">
      {primaryCatalogPages.map((page, index) => <a href={page.href}><span>0{index + 1}</span><strong>{page.label}</strong><small>{categoryTotals.get(page.category) ?? 0} tracked records</small><b>↗</b></a>)}
    </nav>

    <section class="leaderboard-index">
      <header class="home-section-head"><div><span>Current view · update activity</span><h2>Activity rankings</h2></div><a href="/methodology#rankings">Ranking method →</a></header>
      {loadError ? <div class="empty-state">The new catalogue is initializing. Rankings will appear after migration completes.</div> : (
        <div class="leaderboard-grid">
          {primaryCatalogPages.map((page) => <article><header><div><span>{page.eyebrow}</span><h3>{page.label}</h3></div><a href={page.href}>Full ranking →</a></header><ActivityLeaderboard entries={leaderboards.get(page.category) ?? []} compact /></article>)}
        </div>
      )}
    </section>

    <section class="usage-index" aria-labelledby="agent-usage-title">
      <header class="home-section-head"><div><span>Public usage · previous complete UTC day</span><h2 id="agent-usage-title">Open agent usage</h2></div><a href="/usage?kind=app&scope=open&days=30">Full usage →</a></header>
      {agentUsageSnapshot.length ? <>
        <div class="usage-table" role="list" aria-label="Open agent and app usage by public tokens">
          {agentUsageSnapshot.map((item, index) => {
            const width = maxAgentUsage ? Math.max(1.5, Number(BigInt(item.totalTokens) * 10000n / maxAgentUsage) / 100) : 0;
            return <a href={item.entitySlug ? `/project/${item.entitySlug}` : "/usage?kind=app&scope=open&days=30"} role="listitem">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item.displayName}<small>{label(item.opennessStatus)}{item.variants > 1 ? ` · ${item.variants} variants` : ""}</small></strong>
              <i aria-hidden="true"><b style={`width:${width}%`}></b></i>
              <em>{compactTokens(item.totalTokens)}</em>
              <b aria-hidden="true">↗</b>
            </a>;
          })}
        </div>
        <footer class="usage-source-note"><span>Source: <a href={agentUsage?.sourceUrl} rel="noreferrer" target="_blank">{agentUsage?.sourceName} ↗</a></span><span>{agentUsage?.latestDate ? calendarDate(agentUsage.latestDate) : "Awaiting complete day"}</span><span>{agentUsage?.mappedSubjects}/{agentUsage?.totalSubjects} subjects mapped</span><a href="/usage?kind=model&scope=open&days=30">Model usage →</a></footer>
      </> : <div class="empty-state usage-empty">Open agent usage is collecting. The first verified source snapshot will appear here without estimated values.</div>}
    </section>

    <section class="change-index">
      <header class="home-section-head"><div><span>Change ledger</span><h2>Recent changes</h2></div><a href="/changes">Full history →</a></header>
      <div class="change-rows">
        {changes.length ? changes.map((change) => <a href={`/project/${change.entitySlug}`}><time datetime={change.detectedAt}>{relativeDate(change.detectedAt)}</time><strong>{change.entityName}</strong><span>{label(change.factKey)} {change.changeType}</span><small>{label(change.entityKind)}</small><b>↗</b></a>) : <div class="empty-state">No verified changes are available yet.</div>}
      </div>
    </section>

    <section class="database-note">
      <strong>Sources, timestamps and ranking methods stay attached to the data.</strong>
      <span>Unknown values remain unknown.</span>
      <a href="/methodology">Methodology →</a>
    </section>
  </main>
</IndexLayout>

<style>
  .db-home { background: var(--paper); margin: 0 auto; max-width: var(--max); }
  .db-hero { border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: minmax(0,1fr) minmax(520px,.85fr); min-height: 196px; }
  .hero-copy { padding: 26px 32px 28px; }
  .overline, .home-section-head span { color: var(--muted); font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .hero-copy h1 { font-size: var(--data-title); letter-spacing: -.045em; line-height: 1; margin: 14px 0 10px; }
  .hero-copy > p { color: var(--muted); font-size: .9rem; line-height: 1.5; margin: 0; max-width: 680px; }
  .hero-readout { background: #ededeb; border-left: 1px solid var(--ink); display: grid; grid-template-columns: repeat(3,1fr); margin: 0; }
  .hero-readout div { border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; min-height: 98px; padding: 16px; }
  .hero-readout div:nth-child(3n) { border-right: 0; }
  .hero-readout div:nth-last-child(-n+3) { border-bottom: 0; }
  .hero-readout dt { color: var(--muted); font-size: .75rem; }
  .hero-readout dd { font-size: 1.15rem; font-variant-numeric: tabular-nums; font-weight: 650; margin: 0; }
  .category-index { border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: repeat(4,1fr); }
  .category-index a { align-items: center; border-right: 1px solid var(--line); display: grid; gap: 5px 12px; grid-template-columns: auto 1fr auto; min-height: 72px; padding: 12px 16px; }
  .category-index a:last-child { border: 0; }
  .category-index a:hover { background: var(--ink); color: #fff; }
  .category-index span, .category-index small { color: var(--muted); font-size: .75rem; text-transform: uppercase; }
  .category-index strong { font-size: .95rem; letter-spacing: -.015em; }
  .category-index small { grid-column: 2; }
  .category-index b { grid-column: 3; grid-row: 1 / 3; }
  .leaderboard-index, .usage-index, .change-index { border-bottom: 1px solid var(--ink); padding: 28px 32px 32px; }
  .home-section-head { align-items: end; display: flex; justify-content: space-between; margin-bottom: 18px; }
  .home-section-head h2 { font-size: var(--section-title); letter-spacing: -.025em; line-height: 1.1; margin: 6px 0 0; }
  .home-section-head > a { color: var(--muted); font-size: .75rem; line-height: 1.5; margin: 0; }
  .home-section-head > a { font-weight: 700; text-align: right; text-decoration: underline; text-transform: uppercase; text-underline-offset: 4px; }
  .leaderboard-grid { display: grid; gap: 20px; grid-template-columns: 1fr 1fr; }
  .leaderboard-grid article > header { align-items: end; display: flex; justify-content: space-between; margin-bottom: 12px; }
  .leaderboard-grid article > header span { color: var(--muted); font-size: .75rem; font-weight: 700; text-transform: uppercase; }
  .leaderboard-grid h3 { font-size: 1.05rem; letter-spacing: -.02em; margin: 3px 0 0; }
  .leaderboard-grid article > header a { font-size: .75rem; font-weight: 700; text-decoration: underline; text-transform: uppercase; text-underline-offset: 4px; }
  .usage-table { border: 1px solid var(--ink); }
  .usage-table > a { align-items: center; border-bottom: 1px solid var(--line); display: grid; gap: 14px; grid-template-columns: 42px minmax(180px,.75fr) minmax(120px,1fr) 94px 16px; min-height: 48px; padding: 7px 11px; }
  .usage-table > a:last-child { border-bottom: 0; }
  .usage-table > a:hover { background: var(--ink); color: var(--paper); }
  .usage-table > a > span, .usage-table em { font-size: .78rem; font-style: normal; font-variant-numeric: tabular-nums; font-weight: 700; }
  .usage-table strong { font-size: .86rem; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .usage-table strong small { color: var(--muted); font-size: .72rem; font-weight: 500; margin-left: 7px; }
  .usage-table > a:hover small { color: #bdbdbd; }
  .usage-table > a > i { background: #dededb; display: block; height: 7px; overflow: hidden; }
  .usage-table > a > i > b { background: var(--ink); display: block; height: 100%; }
  .usage-table > a:hover > i { background: #575757; }
  .usage-table > a:hover > i > b { background: #fff; }
  .usage-table > a > b { font-size: .82rem; text-align: right; }
  .usage-source-note { align-items: center; color: var(--muted); display: flex; flex-wrap: wrap; font-size: .72rem; gap: 7px 18px; padding: 11px 1px 0; }
  .usage-source-note a { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .usage-source-note > a { margin-left: auto; text-transform: uppercase; }
  .usage-empty { border: 1px solid var(--ink); padding: 18px; }
  .change-rows { border-top: 1px solid var(--ink); }
  .change-rows > a { align-items: center; border-bottom: 1px solid var(--line); display: grid; gap: 18px; grid-template-columns: 100px minmax(170px,.7fr) 1fr 110px 20px; min-height: 50px; padding: 8px 10px; }
  .change-rows > a:hover { background: #e5e5e5; }
  .change-rows time, .change-rows span, .change-rows small { color: var(--muted); font-size: .75rem; }
  .change-rows strong { font-size: .86rem; }
  .database-note { align-items: center; background: #111; color: #fff; display: flex; gap: 18px; min-height: 60px; padding: 14px 32px; }
  .database-note strong { font-size: .82rem; }
  .database-note span { color: #aaa; font-size: .78rem; }
  .database-note a { font-size: .75rem; font-weight: 700; margin-left: auto; text-decoration: underline; text-transform: uppercase; text-underline-offset: 4px; }
  @media (max-width: 1050px) { .db-hero { grid-template-columns: 1fr; } .hero-readout { border-left: 0; border-top: 1px solid var(--ink); } .category-index, .leaderboard-grid { grid-template-columns: 1fr 1fr; } .category-index a:nth-child(2) { border-right: 0; } }
  @media (max-width: 760px) { .hero-copy { padding: 22px 18px; } .hero-copy h1 { font-size: 2rem; } .hero-readout { grid-template-columns: repeat(6, minmax(108px,1fr)); overflow-x: auto; } .hero-readout div { border-bottom: 0; min-height: 74px; padding: 11px 12px; } .category-index { display: flex; overflow-x: auto; } .category-index a:nth-child(n) { flex: 0 0 158px; min-height: 58px; padding: 9px 12px; } .leaderboard-grid { grid-template-columns: 1fr; } .leaderboard-index, .usage-index, .change-index { padding: 22px 0; } .home-section-head, .leaderboard-grid article > header { padding-inline: 18px; } .leaderboard-grid { gap: 30px; } .usage-table { border-left: 0; border-right: 0; } .usage-table > a { gap: 8px; grid-template-columns: 30px minmax(100px,1fr) 68px 14px; min-height: 54px; padding: 9px 10px; } .usage-table > a > i { display: none; } .usage-table strong small { display: block; margin: 3px 0 0; } .usage-source-note { padding: 11px 18px 0; } .usage-source-note > a { margin-left: 0; } .change-rows > a { align-items: start; grid-template-columns: 72px 1fr 18px; } .change-rows span { grid-column: 2; } .change-rows small { display: none; } .database-note { align-items: flex-start; flex-direction: column; gap: 6px; padding: 18px; } .database-note a { margin-left: 0; } }
</style>
