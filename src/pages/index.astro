---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorialShell from "@/components/EditorialShell.astro";
import AgentCard from "@/components/AgentCard.astro";
import ResourceCard from "@/components/ResourceCard.astro";
import { categories } from "@/config/site";
import { getPublishedBlogPosts } from "@/lib/content/blog";
import { getPublishedResources, resourcePath } from "@/lib/content/resources";
import { resourceCategoryLabel } from "@/lib/content/resource-display";

const resources = await getPublishedResources();
const posts = await getPublishedBlogPosts();

const allAgents = resources
  .filter((resource) => resource.classification.primary_category === "agents")
  .sort((a, b) => (b.facts.github_stars ?? 0) - (a.facts.github_stars ?? 0));

const featuredModels = resources
  .filter((resource) => resource.classification.primary_category === "models")
  .sort((a, b) => (b.facts.github_stars ?? 0) - (a.facts.github_stars ?? 0))
  .slice(0, 4);

const recentlyUpdated = [...resources]
  .sort((a, b) => b.timestamps.updated_at.localeCompare(a.timestamps.updated_at))
  .slice(0, 6);

const evaluationCards = [
  {
    title: "Best AI agent for browser automation",
    label: "Decision matrix",
    href: "/evaluations/agent-decision-matrix",
    summary: "Start with browser-use when the job happens inside live websites. Compare OpenHands when code changes are the task."
  },
  {
    title: "Open-source coding agents",
    label: "Comparison",
    href: "/blog/openclaw-vs-browser-use-vs-openhands",
    summary: "Use repository depth, setup burden, sandboxing, and review loop quality instead of one headline benchmark number."
  },
  {
    title: "Agent memory systems",
    label: "Guide",
    href: "/memory-systems",
    summary: "Compare memory by retrieval model, state ownership, deployment constraints, and whether the agent can explain what it remembers."
  }
];

const otherCategories = categories.filter((c) => c.slug !== "agents").map((category) => {
  const items = resources
    .filter((resource) => resource.classification.primary_category === category.slug)
    .sort((a, b) => (b.facts.github_stars ?? 0) - (a.facts.github_stars ?? 0))
    .slice(0, 4);
  return { ...category, items, count: resources.filter((resource) => resource.classification.primary_category === category.slug).length };
});
---

<BaseLayout>
  <EditorialShell active="agents">
    <section class="home-hero" id="directory">
      <div>
        <p class="eyebrow">OpenAgent.bot</p>
        <h1>Find open AI agents, models, and evaluation signals.</h1>
        <p>
          A source-backed directory for builders comparing agent frameworks, browser agents,
          coding agents, memory systems, open models, and the benchmarks around them.
        </p>
      </div>
      <aside>
        <strong>Start here</strong>
        <a href="#agents">Browse agents</a>
        <a href="#models">Browse models</a>
        <a href="/evaluations">Choose by workflow</a>
      </aside>
    </section>

    <section class="shelf-strip" aria-label="Featured shelves">
      <a href="/agents" data-analytics="category" data-analytics-payload='{"category":"agents"}'><span>Agents</span><strong>Browser, coding, orchestration</strong></a>
      <a href="/evaluations" data-analytics="category" data-analytics-payload='{"category":"evaluations"}'><span>Evaluations</span><strong>Workflow decision matrix</strong></a>
      <a href="/blog" data-analytics="category" data-analytics-payload='{"category":"blog"}'><span>Guides</span><strong>Comparisons and best-of pages</strong></a>
    </section>

    <section id="agents" class="section-block">
      <div class="section-head inline">
        <div>
          <span class="eyebrow">Open Agents</span>
          <h2>The agents builders are comparing right now.</h2>
        </div>
        <a class="text-link" href="/agents">View all agents</a>
      </div>
      <div class="agent-grid">
        {allAgents.map((resource) => <AgentCard resource={resource} />)}
      </div>
    </section>

    <section id="models" class="section-block">
      <div class="section-head inline">
        <div>
          <span class="eyebrow">Models</span>
          <h2>Open models that matter to agent workflows.</h2>
        </div>
        <a class="text-link" href="/models">View models</a>
      </div>
      <div class="compact-grid">
        {featuredModels.map((resource) => <ResourceCard resource={resource} />)}
      </div>
    </section>

    <section class="category-board">
      {otherCategories.map((category) => (
        <article class="category-panel">
          <div class="category-head">
            <div>
              <span>{category.count} entries</span>
              <h2><a href={`/${category.slug}`} data-analytics="category" data-analytics-payload={JSON.stringify({category: category.slug})}>{category.label}</a></h2>
            </div>
            <a href={`/${category.slug}`} data-analytics="category" data-analytics-payload={JSON.stringify({category: category.slug})}>View all</a>
          </div>
          <p>{category.description}</p>
          <div class="mini-list">
            {category.items.map((resource) => (
              <a href={resourcePath(resource)} data-analytics="resource" data-analytics-payload={JSON.stringify({name: resource.identity.name, slug: resource.slug, category: category.label})}>
                <strong>{resource.identity.name}</strong>
                <span>{resource.facts.license ?? resourceCategoryLabel(resource)}{resource.facts.github_stars ? ` · ${resource.facts.github_stars.toLocaleString("en-US")} stars` : ""}</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section id="evaluations" class="section-block">
      <div class="section-head">
        <span class="eyebrow">Evaluations</span>
        <h2>Choose by workflow, not by the biggest benchmark number.</h2>
      </div>
      <div class="evaluation-grid">
        {evaluationCards.map((card) => (
          <a href={card.href} data-analytics="evaluation" data-analytics-payload={JSON.stringify({title: card.title, label: card.label})}>
            <span>{card.label}</span>
            <h3>{card.title}</h3>
            <p>{card.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section-block split-block lower">
      <div>
        <div class="section-head">
          <span class="eyebrow">Recently updated</span>
          <h2>Latest directory changes.</h2>
        </div>
        <div class="recent-list">
          {recentlyUpdated.map((resource) => (
            <a href={resourcePath(resource)} data-analytics="resource" data-analytics-payload={JSON.stringify({name: resource.identity.name, slug: resource.slug, category: resourceCategoryLabel(resource)})}>
              <strong>{resource.identity.name}</strong>
              <span>{resourceCategoryLabel(resource)} · {resource.timestamps.updated_at.slice(0, 10)}</span>
            </a>
          ))}
        </div>
      </div>
      <div>
        <div class="section-head">
          <span class="eyebrow">Guides</span>
          <h2>Guides that support the directory.</h2>
        </div>
        <div class="article-grid">
          {posts.slice(0, 3).map((post) => (
            <a href={`/blog/${post.slug}`} data-analytics="blog" data-analytics-payload={JSON.stringify({title: post.title, slug: post.slug})}>
              <span>{post.publishedAt}</span>
              <strong>{post.title}</strong>
              <p>{post.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </EditorialShell>
</BaseLayout>

<style>
  .home-hero {
    align-items: stretch;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1fr) 270px;
    padding: 12px 0 28px;
  }

  .home-hero h1 {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    font-weight: 520;
    letter-spacing: 0;
    line-height: 1.02;
    margin: 8px 0 0;
    max-width: 820px;
  }

  .home-hero p {
    font-size: 0.95rem;
    margin: 14px 0 0;
    max-width: 720px;
  }

  .home-hero aside,
  .category-panel,
  .evaluation-grid a,
  .shelf-strip a,
  .article-grid a {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .shelf-strip {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 18px 0 8px;
  }

  .shelf-strip a {
    display: grid;
    gap: 5px;
    padding: 13px 14px;
  }

  .shelf-strip span {
    color: var(--accent-open);
    font-size: 0.7rem;
    font-weight: 560;
    text-transform: uppercase;
  }

  .shelf-strip strong {
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 560;
  }

  .home-hero aside {
    align-content: start;
    display: grid;
    gap: 8px;
    padding: 14px;
  }

  .home-hero aside strong {
    color: var(--accent-open);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .home-hero aside a {
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.88rem;
    padding: 10px 0 2px;
  }

  .category-board {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 24px 0 8px;
  }

  .category-panel {
    display: grid;
    gap: 12px;
    padding: 16px;
  }

  .category-head {
    align-items: start;
    display: flex;
    gap: 16px;
    justify-content: space-between;
  }

  .category-head span,
  .evaluation-grid span,
  .article-grid span {
    color: var(--accent-open);
    display: block;
    font-size: 0.72rem;
    font-weight: 560;
    text-transform: uppercase;
  }

  .category-head h2,
  .section-head h2 {
    font-size: 1.42rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.12;
    margin: 4px 0 0;
  }

  .category-head > a,
  .text-link {
    color: var(--accent-open);
    font-size: 0.82rem;
    font-weight: 520;
    white-space: nowrap;
  }

  .category-panel p {
    font-size: 0.86rem;
    margin: 0;
  }

  .mini-list,
  .recent-list {
    display: grid;
    gap: 0;
  }

  .mini-list a,
  .recent-list a {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 3px;
    padding: 10px 0;
  }

  .mini-list strong,
  .recent-list strong,
  .article-grid strong,
  .evaluation-grid h3 {
    color: var(--ink);
    font-size: 0.94rem;
    font-weight: 560;
    line-height: 1.28;
  }

  .mini-list span,
  .recent-list span {
    color: var(--muted);
    font-size: 0.78rem;
    font-style: normal;
  }

  .section-block {
    border-top: 1px solid var(--line);
    padding: 28px 0;
  }

  .section-head {
    margin-bottom: 14px;
  }

  .section-head.inline {
    align-items: end;
    display: flex;
    gap: 18px;
    justify-content: space-between;
  }

  .split-block {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 1fr) 300px;
  }

  .split-block.lower {
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.75fr);
  }

  .compact-grid,
  .evaluation-grid,
  .article-grid {
    display: grid;
    gap: 12px;
  }

  .compact-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .evaluation-grid,
  .article-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .evaluation-grid a,
  .article-grid a {
    display: grid;
    gap: 9px;
    min-height: 160px;
    padding: 15px;
  }

  .evaluation-grid p,
  .article-grid p {
    font-size: 0.84rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .home-hero,
    .shelf-strip,
    .category-board,
    .split-block,
    .split-block.lower,
    .compact-grid,
    .evaluation-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }

    .section-head.inline {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
