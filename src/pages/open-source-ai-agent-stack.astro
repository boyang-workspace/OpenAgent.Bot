---
import EditorialShell from "@/components/EditorialShell.astro";
import ResourceCard from "@/components/ResourceCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/config/site";
import { getPublishedBlogPosts } from "@/lib/content/blog";
import { getPublishedResources, resourcePath } from "@/lib/content/resources";

const resources = await getPublishedResources();
const posts = await getPublishedBlogPosts();

const pageTitle = "The Open-Source AI Agent Stack";
const seoTitle = "Open-Source AI Agent Stack: Models, Frameworks, Memory, MCP, and Tools";
const pageDescription =
  "A practical map of open-source AI agents, models, skills, memory systems, plugins, tools, and bots for builders choosing an agent stack.";
const canonicalPath = "/open-source-ai-agent-stack";

const resourceBySlug = new Map(resources.map((resource) => [resource.slug, resource]));
const pickResources = (slugs: string[]) => slugs.map((slug) => resourceBySlug.get(slug)).filter(Boolean).slice(0, 3);
const guideBySlug = new Map(posts.map((post) => [post.slug, post]));
const pickGuides = (slugs: string[]) => slugs.map((slug) => guideBySlug.get(slug)).filter(Boolean);

const stackLayers = [
  {
    id: "models",
    label: "Layer 1",
    title: "Models",
    href: "/models",
    summary: "Choose the model family that matches your agent workload: tool calling, coding, reasoning, multimodal work, local inference, or hosted speed.",
    checks: ["Open weights or hosted API", "Context length and latency", "Tool-calling and coding behavior", "License and deployment constraints"],
    resources: pickResources(["qwen3-6", "deepseek-r1", "gpt4all"])
  },
  {
    id: "agents",
    label: "Layer 2",
    title: "Agent frameworks and runtimes",
    href: "/agents",
    summary: "Pick the runtime that controls how work gets planned, executed, supervised, and recovered when something goes wrong.",
    checks: ["Action surface: browser, code, CLI, workflow", "Human approval model", "Logs, replay, and sandbox boundaries", "MCP, API, and local runtime support"],
    resources: pickResources(["openhands", "autogen", "crewai"])
  },
  {
    id: "skills",
    label: "Layer 3",
    title: "Skills",
    href: "/skills",
    summary: "Use skills to package repeatable procedures, team rules, evaluation habits, and task-specific agent behavior.",
    checks: ["Clear trigger conditions", "Inputs and outputs the agent can inspect", "Versionable instructions", "Evidence-gathering or verification steps"],
    resources: pickResources(["gbrain", "ai-agents-skills", "browser-act-skills"])
  },
  {
    id: "memory",
    label: "Layer 4",
    title: "Memory systems",
    href: "/memory-systems",
    summary: "Add memory when agents need durable user facts, project context, workflow state, graph recall, or private knowledge retrieval.",
    checks: ["What gets stored", "How recall is explained", "Deletion and export controls", "Self-hosted or managed deployment"],
    resources: pickResources(["mem0", "letta", "graphiti"])
  },
  {
    id: "plugins",
    label: "Layer 5",
    title: "Plugins and MCP",
    href: "/plugins",
    summary: "Connect agents to external systems through protocol-based tools, MCP servers, SDKs, and platform-specific connectors.",
    checks: ["Protocol portability", "Authentication and permission model", "Available client/server SDKs", "Failure handling and observability"],
    resources: pickResources(["model-context-protocol-python-sdk", "model-context-protocol-typescript-sdk", "fastmcp"])
  },
  {
    id: "tools",
    label: "Layer 6",
    title: "Evaluation and operations tools",
    href: "/tools",
    summary: "Test, trace, benchmark, and operate agent systems before giving them wider access to production workflows.",
    checks: ["Prompt and agent eval support", "Trace and session inspection", "Regression testing", "Dataset and benchmark workflows"],
    resources: pickResources(["promptfoo", "ragas", "langfuse"])
  }
];

const decisionRows = [
  { need: "Automate websites or back-office workflows", start: "Browser and action agents", href: "/agents", examples: "OpenClaw, browser-use, OpenHands" },
  { need: "Edit repositories and resolve code tasks", start: "Coding agents", href: "/agents", examples: "OpenHands, SWE-agent, Aider, Cline" },
  { need: "Build multi-agent workflows", start: "Agent frameworks", href: "/agents", examples: "AutoGen, CrewAI, LangGraph, OpenAI Agents SDK" },
  { need: "Run privately or locally", start: "Models plus local runtimes", href: "/models", examples: "Qwen, DeepSeek, Gemma, GPT4All" },
  { need: "Persist user or project context", start: "Memory systems", href: "/memory-systems", examples: "mem0, Letta, Graphiti, Cognee" },
  { need: "Connect files, APIs, tools, and services", start: "Plugins and MCP", href: "/plugins", examples: "MCP SDKs, FastMCP, MCP Inspector" },
  { need: "Measure reliability before adoption", start: "Evaluation tools", href: "/tools", examples: "promptfoo, Ragas, Langfuse" }
];

const quickRecommendations = [
  {
    title: "Best open-source coding agent stack",
    recommendation: "Start with OpenHands or SWE-agent, add repository skills, then evaluate changes with promptfoo or Langfuse traces.",
    href: "/agents#coding-agents",
    cta: "Browse coding agents"
  },
  {
    title: "Best browser automation stack",
    recommendation: "Start with browser-use or OpenClaw, keep human approval on risky actions, and test one website workflow before expanding scope.",
    href: "/agents#browser-action-agents",
    cta: "Browse browser agents"
  },
  {
    title: "Best local-first agent stack",
    recommendation: "Start with an open or local model, choose a local runtime, then add only the tools and memory layer your workflow actually needs.",
    href: "/models",
    cta: "Browse open models"
  },
  {
    title: "Best MCP and tool integration stack",
    recommendation: "Start with MCP SDKs or FastMCP, define permissions clearly, then add observability before connecting production systems.",
    href: "/plugins",
    cta: "Browse MCP tools"
  },
  {
    title: "Best evaluation-heavy stack",
    recommendation: "Start with promptfoo, Ragas, or Langfuse, create task fixtures, and compare failures before changing models or frameworks.",
    href: "/tools#evaluation-benchmark-tools",
    cta: "Browse eval tools"
  }
];

const useCases = [
  {
    title: "Coding agent stack",
    path: "Start with a coding agent, add repository-specific skills, then evaluate with regression tasks before wider use.",
    links: [
      { label: "Browse coding agents", href: "/agents#coding-agents" },
      { label: "Read OpenHands vs AutoGen vs CrewAI", href: "/blog/openhands-vs-autogen-vs-crewai" }
    ]
  },
  {
    title: "Browser automation stack",
    path: "Start with the web surface, choose an approval boundary, then test one narrow workflow with logs and rollback.",
    links: [
      { label: "Browse browser agents", href: "/agents#browser-action-agents" },
      { label: "Read the browser agents guide", href: "/blog/best-open-source-browser-agents-workflow-automation" }
    ]
  },
  {
    title: "Local-first agent stack",
    path: "Choose a local model or open-weight model first, then add a local runtime, memory, and only the tools the agent truly needs.",
    links: [
      { label: "Browse open models", href: "/models" },
      { label: "Browse local runtimes", href: "/agents#local-agent-runtimes" }
    ]
  },
  {
    title: "Evaluation-heavy agent stack",
    path: "Treat the agent like software: create task fixtures, trace every run, and compare failures before changing models or tools.",
    links: [
      { label: "Browse evaluation tools", href: "/tools#evaluation-benchmark-tools" },
      { label: "Read the evaluation stack guide", href: "/blog/agent-evaluation-stack-promptfoo-ragas-langfuse" }
    ]
  }
];

const relatedGuides = pickGuides([
  "openhands-vs-autogen-vs-crewai",
  "mcp-tools-and-sdks-for-agent-builders",
  "agent-evaluation-stack-promptfoo-ragas-langfuse",
  "best-open-source-browser-agents-workflow-automation"
]);

const faq = [
  {
    question: "What is an open-source AI agent stack?",
    answer:
      "An open-source AI agent stack is the set of components used to build an agent system: models, agent runtimes, tools, skills, memory, evaluation, and deployment surfaces."
  },
  {
    question: "What is the difference between an AI model and an AI agent?",
    answer:
      "A model predicts text, code, or actions from context. An agent wraps a model with planning, tool use, state, approvals, and execution logic."
  },
  {
    question: "Do AI agents need memory?",
    answer:
      "Agents need memory when they must preserve user preferences, project facts, task history, or knowledge across sessions. Simple one-shot workflows may not need a dedicated memory system."
  },
  {
    question: "Is MCP part of the AI agent stack?",
    answer:
      "MCP is best understood as an integration layer. It gives agents a more portable way to discover and use external tools, data sources, and services."
  },
  {
    question: "Which open-source agent framework should I start with?",
    answer:
      "Start from the workflow surface. Coding tasks point toward coding agents, browser tasks toward browser agents, and complex multi-step systems toward orchestration frameworks."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    description: pageDescription,
    url: `${site.url}${canonicalPath}`,
    isPartOf: {
      "@type": "WebSite",
      name: site.name,
      url: site.url
    },
    about: [
      "open-source AI agents",
      "AI agent frameworks",
      "open models",
      "agent memory systems",
      "Model Context Protocol",
      "LLM evaluation"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "OpenAgent.bot", item: site.url },
      { "@type": "ListItem", position: 2, name: pageTitle, item: `${site.url}${canonicalPath}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<BaseLayout title={seoTitle} description={pageDescription} path={canonicalPath}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <EditorialShell active="stack">
    <article class="pillar">
      <header class="pillar-hero">
        <span class="eyebrow">OpenAgent.bot field guide</span>
        <h1>The Open-Source AI Agent Stack</h1>
        <p>
          The open-source AI agent stack usually includes a model, an agent runtime, a tool or plugin
          layer, reusable skills, memory, and evaluation tools. If you only want a ranked list of
          frameworks, start with agents. If you are building a real workflow, use the stack map below.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#quick-recommendations" data-analytics="cta" data-analytics-payload={JSON.stringify({label: "See quick recommendations"})}>See quick recommendations</a>
          <a class="button secondary" href="/agents" data-analytics="cta" data-analytics-payload={JSON.stringify({label: "Browse agents"})}>Browse agents</a>
        </div>
      </header>

      <section class="quick-recommendations" id="quick-recommendations" aria-labelledby="quick-title">
        <div class="section-head">
          <span class="eyebrow">Quick recommendations</span>
          <h2 id="quick-title">Pick a starting stack by the workflow you need to ship.</h2>
          <p>These are practical starting points for search visitors who need a shortlist before reading the full stack map.</p>
        </div>
        <div class="quick-grid">
          {quickRecommendations.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.recommendation}</p>
              <a href={item.href}>{item.cta}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="definition" aria-labelledby="definition-title">
        <div>
          <span class="eyebrow">Definition</span>
          <h2 id="definition-title">An agent stack is more than a model.</h2>
        </div>
        <p>
          The model is only one layer. A useful agent system also needs a runtime that decides what to do,
          tools it can call, instructions it can reuse, memory it can control, and evaluation loops that
          catch failures before a workflow becomes expensive or risky.
        </p>
      </section>

      <section class="decision-map" id="decision-map" aria-labelledby="decision-title">
        <div class="section-head">
          <span class="eyebrow">Decision map</span>
          <h2 id="decision-title">Start with the job, then choose the layer.</h2>
          <p>Most agent mistakes come from starting with a popular framework instead of the workflow surface.</p>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>What you need</th>
                <th>Start with</th>
                <th>Example projects</th>
              </tr>
            </thead>
            <tbody>
              {decisionRows.map((row) => (
                <tr>
                  <td>{row.need}</td>
                  <td><a href={row.href}>{row.start}</a></td>
                  <td>{row.examples}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="layers" aria-labelledby="layers-title">
        <div class="section-head">
          <span class="eyebrow">Stack layers</span>
          <h2 id="layers-title">The six layers to compare before adopting an agent stack.</h2>
          <p>Each layer answers a different adoption question: what powers the agent, what controls it, what it can do, what it remembers, what it connects to, and how you know it works.</p>
        </div>

        {stackLayers.map((layer) => (
          <section class="layer" id={layer.id}>
            <div class="layer-copy">
              <span>{layer.label}</span>
              <h3><a href={layer.href}>{layer.title}</a></h3>
              <p>{layer.summary}</p>
              <ul>
                {layer.checks.map((check) => <li>{check}</li>)}
              </ul>
            </div>
            <div class="layer-resources">
              {layer.resources.map((resource) => <ResourceCard resource={resource} />)}
            </div>
          </section>
        ))}
      </section>

      <section class="use-cases" aria-labelledby="use-cases-title">
        <div class="section-head">
          <span class="eyebrow">Recommended paths</span>
          <h2 id="use-cases-title">Common open-source agent stacks by use case.</h2>
          <p>These are starting paths, not fixed recipes. The right stack depends on workflow risk, deployment constraints, and how much supervision the agent needs.</p>
        </div>
        <div class="use-case-grid">
          {useCases.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.path}</p>
              <div>
                {item.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="guide-links" aria-labelledby="guide-links-title">
        <div class="section-head">
          <span class="eyebrow">Supporting guides</span>
          <h2 id="guide-links-title">Go deeper with comparisons and evaluations.</h2>
        </div>
        <div class="guide-grid">
          {relatedGuides.map((post) => (
            <a href={`/blog/${post.slug}`} data-analytics="blog" data-analytics-payload={JSON.stringify({title: post.title, slug: post.slug, from: "agent-stack-pillar"})}>
              <span>{post.publishedAt}</span>
              <strong>{post.title}</strong>
              <p>{post.summary}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <div class="section-head">
          <span class="eyebrow">FAQ</span>
          <h2 id="faq-title">Open-source AI agent stack FAQ.</h2>
        </div>
        <div class="faq-list">
          {faq.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </section>
    </article>
  </EditorialShell>
</BaseLayout>

<style>
  .pillar {
    display: grid;
    gap: 0;
  }

  .pillar-hero {
    border-bottom: 1px solid var(--line);
    padding: 6px 0 30px;
  }

  .pillar-hero h1 {
    color: var(--ink);
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1;
    margin: 10px 0 0;
    max-width: 880px;
  }

  .pillar-hero p {
    font-size: 0.98rem;
    line-height: 1.65;
    margin: 18px 0 0;
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .definition,
  .quick-recommendations,
  .decision-map,
  .layers,
  .use-cases,
  .guide-links,
  .faq {
    border-bottom: 1px solid var(--line);
    padding: 30px 0;
  }

  .definition {
    align-items: start;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
  }

  .definition h2,
  .section-head h2 {
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.18;
    margin: 7px 0 0;
    max-width: 780px;
  }

  .definition p,
  .section-head p {
    font-size: 0.9rem;
    margin: 8px 0 0;
    max-width: 760px;
  }

  .quick-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 16px;
  }

  .quick-grid article {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 10px;
    grid-template-rows: auto 1fr auto;
    min-height: 210px;
    padding: 15px;
  }

  .quick-grid h3 {
    color: var(--ink);
    font-size: 0.94rem;
    font-weight: 580;
    line-height: 1.25;
    margin: 0;
  }

  .quick-grid p {
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
  }

  .quick-grid a {
    color: var(--accent-open);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-top: 16px;
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    min-width: 760px;
    width: 100%;
  }

  th,
  td {
    border-bottom: 1px solid var(--line);
    font-size: 0.82rem;
    line-height: 1.45;
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--ink);
    font-weight: 620;
  }

  td {
    color: var(--muted);
  }

  td a {
    color: var(--accent-open);
    font-weight: 560;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  .layer {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 330px) minmax(0, 1fr);
    padding: 24px 0;
  }

  .layer:first-of-type {
    margin-top: 18px;
  }

  .layer-copy span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .layer-copy h3 {
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.2;
    margin: 8px 0 0;
  }

  .layer-copy p {
    font-size: 0.86rem;
    margin: 10px 0 0;
  }

  .layer-copy ul {
    display: grid;
    gap: 7px;
    list-style: none;
    margin: 15px 0 0;
    padding: 0;
  }

  .layer-copy li {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
    padding-left: 14px;
    position: relative;
  }

  .layer-copy li::before {
    background: var(--accent-open);
    border-radius: 50%;
    content: "";
    height: 4px;
    left: 1px;
    position: absolute;
    top: 8px;
    width: 4px;
  }

  .layer-resources,
  .use-case-grid,
  .guide-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .use-case-grid,
  .guide-grid {
    margin-top: 16px;
  }

  .use-case-grid article,
  .guide-grid a,
  .faq-list article {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 16px;
  }

  .use-case-grid h3,
  .faq-list h3 {
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 560;
    line-height: 1.3;
    margin: 0;
  }

  .use-case-grid p,
  .faq-list p {
    font-size: 0.82rem;
    line-height: 1.52;
    margin: 9px 0 0;
  }

  .use-case-grid article div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .use-case-grid a {
    border: 1px solid var(--line);
    border-radius: 7px;
    color: var(--accent-open);
    font-size: 0.76rem;
    font-weight: 560;
    padding: 6px 8px;
  }

  .guide-grid a {
    display: grid;
    gap: 8px;
    min-height: 148px;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .guide-grid a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  .guide-grid span {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .guide-grid strong {
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 560;
    line-height: 1.3;
  }

  .guide-grid p {
    display: -webkit-box;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .faq {
    border-bottom: 0;
  }

  .faq-list {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 16px;
  }

  @media (max-width: 1060px) {
    .quick-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .layer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .definition,
    .faq-list {
      grid-template-columns: 1fr;
    }

    .layer-resources,
    .quick-grid,
    .use-case-grid,
    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .layer-resources,
    .quick-grid,
    .use-case-grid,
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
