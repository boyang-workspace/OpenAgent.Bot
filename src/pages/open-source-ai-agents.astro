---
import RegistryLanding from "@/components/RegistryLanding.astro";
import { getRegistryLanding } from "@/lib/registry/landings";

const data = await getRegistryLanding({ kinds: ["agent"], sort: "stars" });
---
<RegistryLanding
  title="Open-source AI agents"
  eyebrow="Primary entities / Agents"
  description="Inspect open-source AI agents by current repository evidence, upstream activity and attributed sources."
  path="/open-source-ai-agents"
  entities={data.entities}
  total={data.total}
  databaseHref="/database?kind=agent"
/>
