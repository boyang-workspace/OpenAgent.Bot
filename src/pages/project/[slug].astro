---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectAgentDetail from "@/components/ProjectAgentDetail.astro";
import ProjectRobotDetail from "@/components/ProjectRobotDetail.astro";
import { getRegistry } from "@/lib/registry/runtime";
import { domainLabel, roboticsLayerLabel } from "@/lib/registry/domains";
import { label } from "@/lib/registry/format";
import type { RegistryDossier, RegistryEntity } from "@/lib/registry/types";

const slug = Astro.params.slug ?? "";
const registry = getRegistry();
let dossier: RegistryDossier | undefined;
let related: RegistryEntity[] = [];
try {
  dossier = await registry.getEntityDossier(slug);
  if (dossier) {
    const result = await registry.listEntities({
      domains: dossier.entity.primaryDomain ? [dossier.entity.primaryDomain] : undefined,
      kinds: [dossier.entity.kind],
      sort: "activity",
      limit: 6
    });
    related = result.items.filter((item) => item.slug !== slug).slice(0, 4);
  }
} catch {}
if (!dossier) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const { entity } = dossier;
const isRobotPlatform = entity.primaryDomain === "robotics" && entity.robotics?.layer === "platform";
const schema = {
  "@context": "https://schema.org",
  "@type": isRobotPlatform ? "Product" : entity.kind === "model" ? "CreativeWork" : "SoftwareSourceCode",
  name: entity.name,
  description: entity.description ?? entity.summary,
  url: `https://www.openagent.bot/project/${entity.slug}`,
  category: [entity.primaryDomain ? domainLabel(entity.primaryDomain) : undefined, entity.robotics ? roboticsLayerLabel(entity.robotics.layer) : undefined, label(entity.kind)].filter(Boolean).join(" / "),
  ...(entity.organization ? { [isRobotPlatform ? "brand" : "author"]: { "@type": "Organization", name: entity.organization } } : {}),
  ...(!isRobotPlatform && entity.repositoryUrl ? { codeRepository: entity.repositoryUrl } : {}),
  ...(entity.licenseSpdx ? { license: entity.licenseSpdx } : {}),
  ...(entity.heroImageUrl ? { image: entity.heroImageUrl } : {}),
  sameAs: [entity.canonicalUrl, entity.repositoryUrl, entity.documentationUrl].filter(Boolean)
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Database", item: "https://www.openagent.bot/database" },
    { "@type": "ListItem", position: 2, name: entity.name, item: `https://www.openagent.bot/project/${entity.slug}` }
  ]
};
const seoTitle = isRobotPlatform
  ? `${entity.name} — Robot Specs, Software & Openness`
  : `${entity.name} — Activity, Openness & Evidence`;
const seoDescription = `${entity.name}: ${entity.summary} Compare activity, openness, license, changes and attributed source evidence.`;
---

<BaseLayout title={seoTitle} description={seoDescription} path={`/project/${entity.slug}`} image={entity.heroImageUrl ?? entity.logoUrl}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify([schema, breadcrumbSchema])} />
  <div class="page-shell">
    {isRobotPlatform
      ? <ProjectRobotDetail dossier={dossier} related={related} />
      : <ProjectAgentDetail dossier={dossier} related={related} />}
  </div>
</BaseLayout>
