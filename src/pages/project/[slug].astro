---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectAgentDetail from "@/components/ProjectAgentDetail.astro";
import ProjectRobotDetail from "@/components/ProjectRobotDetail.astro";
import CatalogRecordSections from "@/components/CatalogRecordSections.astro";
import { getCatalog, getRegistry } from "@/lib/registry/runtime";
import { domainLabel, roboticsLayerLabel } from "@/lib/registry/domains";
import { label } from "@/lib/registry/format";
import type { RegistryDossier, RegistryEntity } from "@/lib/registry/types";
import type { CatalogDetail } from "@/lib/registry/catalog";
import { projectIndexability } from "@/lib/seo/indexability";

const slug = Astro.params.slug ?? "";
const registry = getRegistry();
let dossier: RegistryDossier | undefined;
let related: RegistryEntity[] = [];
let catalogDetail: CatalogDetail = { releases: [], papers: [], evaluations: [] };
try {
  dossier = await registry.getEntityDossier(slug);
  if (dossier) {
    const [result, detail] = await Promise.all([registry.listEntities({ domains: dossier.entity.primaryDomain ? [dossier.entity.primaryDomain] : undefined, kinds: [dossier.entity.kind], sort: "activity", limit: 6 }), getCatalog().getDetail(dossier.entity.id)]);
    related = result.items.filter((item) => item.slug !== slug).slice(0, 4);
    catalogDetail = detail;
  }
} catch {}
if (!dossier) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const { entity } = dossier;
const isRobotPlatform = entity.primaryDomain === "robotics" && entity.robotics?.layer === "platform";
const categoryPath = isRobotPlatform ? "/robots" : entity.primaryDomain === "robotics" ? "/robot-models" : entity.kind === "model" ? "/models" : "/agents";
const categoryName = isRobotPlatform ? "Robots" : entity.primaryDomain === "robotics" ? "Robot Models" : entity.kind === "model" ? "Models" : "Agents";
const indexability = projectIndexability(entity, dossier.record.observationCount, dossier.subscriptions.length);
const schema = {
  "@context": "https://schema.org",
  "@type": isRobotPlatform ? "Product" : entity.kind === "model" ? "CreativeWork" : "SoftwareSourceCode",
  name: entity.name,
  description: entity.description ?? entity.summary,
  url: `https://www.openagent.bot/project/${entity.slug}`,
  category: [entity.primaryDomain ? domainLabel(entity.primaryDomain) : undefined, entity.robotics ? roboticsLayerLabel(entity.robotics.layer) : undefined, label(entity.kind)].filter(Boolean).join(" / "),
  ...(entity.organization ? { [isRobotPlatform ? "brand" : "author"]: { "@type": "Organization", name: entity.organization } } : {}),
  ...(!isRobotPlatform && entity.repositoryUrl ? { codeRepository: entity.repositoryUrl } : {}),
  ...(entity.licenseSpdx ? { license: entity.licenseSpdx } : {}),
  ...(entity.heroImageUrl ? { image: entity.heroImageUrl } : {}),
  sameAs: [entity.canonicalUrl, entity.repositoryUrl, entity.documentationUrl].filter(Boolean)
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.openagent.bot/" },
    { "@type": "ListItem", position: 2, name: categoryName, item: `https://www.openagent.bot${categoryPath}` },
    { "@type": "ListItem", position: 3, name: entity.name, item: `https://www.openagent.bot/project/${entity.slug}` }
  ]
};
const seoTitle = isRobotPlatform
  ? `${entity.name} — Open Source Robot Data & Evidence`
  : `${entity.name} — Open Source Status, License & Activity`;
const seoDescription = `Verify ${entity.name}'s openness, license evidence, repository activity, original sources and historical changes in the OpenAgent database.`;
const curatedLinks: Record<string, Array<{ label: string; href: string }>> = {
  "openclaw": [{ label: "OpenClaw vs OpenHands", href: "/compare/openclaw-vs-openhands" }, { label: "OpenClaw vs Browser Use vs OpenHands", href: "/compare/openclaw-vs-browser-use-vs-openhands" }],
  "browser-use": [{ label: "OpenClaw vs Browser Use vs OpenHands", href: "/compare/openclaw-vs-browser-use-vs-openhands" }],
  "openhands": [{ label: "OpenClaw vs OpenHands", href: "/compare/openclaw-vs-openhands" }, { label: "OpenClaw vs Browser Use vs OpenHands", href: "/compare/openclaw-vs-browser-use-vs-openhands" }],
  "langfuse": [{ label: "Langfuse vs MLflow", href: "/compare/langfuse-vs-mlflow" }],
  "mlflow": [{ label: "Langfuse vs MLflow", href: "/compare/langfuse-vs-mlflow" }],
  "continue": [{ label: "Continue vs Cursor guide", href: "/blog/continue-vs-cursor" }]
};
const projectLinks = curatedLinks[entity.slug] ?? [];
---

<BaseLayout title={seoTitle} description={seoDescription} path={`/project/${entity.slug}`} noindex={!indexability.indexable}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify([schema, breadcrumbSchema])} />
  <div class="page-shell">
    <nav class="project-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={categoryPath}>{categoryName}</a><span>/</span><span aria-current="page">{entity.name}</span></nav>
    {isRobotPlatform
      ? <ProjectRobotDetail dossier={dossier} related={related} />
      : <ProjectAgentDetail dossier={dossier} related={related} />}
    {projectLinks.length > 0 && <nav class="curated-links" aria-label={`Research and comparisons for ${entity.name}`}><span>Research & comparisons</span>{projectLinks.map((item) => <a href={item.href}>{item.label} →</a>)}</nav>}
    <CatalogRecordSections detail={catalogDetail} />
  </div>
</BaseLayout>

<style>
  .project-breadcrumbs { align-items: center; border-left: 1px solid var(--line); border-right: 1px solid var(--line); color: var(--muted); display: flex; font-family: var(--mono); font-size: .75rem; gap: 9px; margin: 0 auto; max-width: var(--max); min-height: 36px; padding: 0 18px; text-transform: uppercase; }
  .project-breadcrumbs a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .curated-links{align-items:center;border:1px solid var(--ink);display:flex;flex-wrap:wrap;margin:0 auto;max-width:var(--max);padding:0 18px}.curated-links span,.curated-links a{font-family:var(--mono);font-size:.75rem;text-transform:uppercase}.curated-links span{color:var(--muted);margin-right:18px}.curated-links a{border-left:1px solid var(--line);padding:13px 18px}.curated-links a:hover{background:var(--ink);color:var(--paper)}
  @media (max-width: 620px) { .project-breadcrumbs { border-left: 0; border-right: 0; overflow-x: auto; white-space: nowrap; } }
</style>
