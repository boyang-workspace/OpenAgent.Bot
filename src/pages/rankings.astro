---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { primaryCatalogPages } from "@/lib/registry/catalog-config";
---
<BaseLayout title="Open AI & Robotics Rankings" description="Category-specific activity, adoption, release and evaluation rankings for open models, agents and robotics." path="/rankings">
  <div class="ranking-hub">
    <section class="ranking-head"><div><span class="kicker">Ranking index</span><h1>Category rankings</h1><p>Each view declares its category, metric family, time window and methodology version.</p></div><dl><div><dt>Databases</dt><dd>4</dd></div><div><dt>Families</dt><dd>4</dd></div><div><dt>Method</dt><dd>v0.1</dd></div></dl></section>
    <div class="ranking-categories">{primaryCatalogPages.map((page, index) => <a href={page.href}><span>0{index + 1}</span><h2>{page.label}</h2><p>{page.description}</p><b>Open rankings ↗</b></a>)}</div>
    <aside><strong>Publication threshold</strong><p>Momentum appears after 30 history days, 80% required-metric coverage and at least 10 eligible records.</p><a href="/methodology#rankings">Methodology →</a></aside>
  </div>
</BaseLayout>
<style>
  .ranking-hub { background: var(--paper); margin: 0 auto; max-width: var(--max); }
  .ranking-head { align-items: stretch; border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: minmax(0,1fr) minmax(480px,.7fr); min-height: 150px; }
  .ranking-head > div { align-self: center; padding: 24px 28px; }
  .ranking-hub h1 { font-size: var(--data-title); letter-spacing: -.045em; line-height: 1; margin: 11px 0 9px; }
  .ranking-head > div p { color: var(--muted); font-size: .88rem; line-height: 1.5; margin: 0; max-width: 700px; }
  .ranking-head dl { border-left: 1px solid var(--ink); display: grid; grid-template-columns: repeat(3,1fr); margin: 0; }
  .ranking-head dl div { border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; padding: 20px; }
  .ranking-head dl div:last-child { border: 0; }
  .ranking-head dt { color: var(--muted); font-size: .75rem; text-transform: uppercase; }
  .ranking-head dd { font-size: 1.2rem; font-weight: 650; margin: 0; }
  .ranking-categories { border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: repeat(4,1fr); }
  .ranking-categories a { border-right: 1px solid var(--line); min-height: 178px; padding: 20px; }
  .ranking-categories a:last-child { border: 0; }
  .ranking-categories a:hover { background: var(--ink); color: var(--paper); }
  .ranking-categories span, .ranking-categories b { color: var(--muted); font-size: .75rem; text-transform: uppercase; }
  .ranking-categories h2 { font-size: 1.25rem; letter-spacing: -.025em; margin: 26px 0 10px; }
  .ranking-categories p { color: var(--muted); font-size: .8rem; line-height: 1.5; min-height: 48px; }
  .ranking-categories b { display: block; margin-top: 18px; }
  .ranking-hub aside { align-items: center; background: #e5e5e5; display: grid; gap: 32px; grid-template-columns: 180px 1fr auto; padding: 20px 28px; }
  .ranking-hub aside p { color: var(--muted); font-size: .78rem; line-height: 1.55; margin: 0; }
  .ranking-hub aside a { font-size: .75rem; font-weight: 700; text-decoration: underline; text-transform: uppercase; }
  @media (max-width: 900px) { .ranking-head { grid-template-columns: 1fr; } .ranking-head dl { border-left: 0; border-top: 1px solid var(--ink); min-height: 88px; } .ranking-categories { grid-template-columns: 1fr 1fr; } .ranking-hub aside { grid-template-columns: 1fr; gap: 10px; } }
  @media (max-width: 600px) { .ranking-head > div { padding: 24px 18px; } .ranking-head dl div { padding: 13px 12px; } .ranking-categories { grid-template-columns: 1fr; } .ranking-categories a { border-bottom: 1px solid var(--line); border-right: 0; min-height: 150px; padding: 18px; } .ranking-hub aside { padding: 20px 18px; } }
</style>
