---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { compactNumber, label, relativeDate } from "@/lib/registry/format";
import { evaluateRankingGate } from "@/lib/registry/rankings";
import { getRegistry } from "@/lib/registry/runtime";
import type { RegistryEntity, RegistryStats } from "@/lib/registry/types";

let stats: RegistryStats = {
  entities: 0, agents: 0, robots: 0, infrastructure: 0, robotPlatforms: 0,
  robotIntelligence: 0, roboticsStack: 0, models: 0, tools: 0, sources: 0,
  liveSources: 0, observations: 0, metricEntities: 0, changes30d: 0
};
let candidates: RegistryEntity[] = [];
let dataError = false;
try {
  const registry = getRegistry();
  [stats, candidates] = await Promise.all([
    registry.getStats(),
    registry.listEntities({ sort: "stars", limit: 12 }).then((result) => result.items)
  ]);
} catch { dataError = true; }

const historyDays = stats.historyStartedAt
  ? Math.max(0, Math.floor((Date.now() - new Date(stats.historyStartedAt).getTime()) / 86_400_000))
  : 0;
const coverage = stats.entities > 0 ? stats.metricEntities / stats.entities : 0;
const gate = evaluateRankingGate({ historyDays, coverage, entityCount: stats.entities });
const historyProgress = Math.min(100, Math.round(historyDays / 30 * 100));
const coverageProgress = Math.min(100, Math.round(coverage * 100));
const cohorts = [
  { name: "Agents", count: stats.agents, href: "/database?domain=agent" },
  { name: "Robot platforms", count: stats.robotPlatforms, href: "/database?domain=robotics&layer=platform" },
  { name: "Robot intelligence", count: stats.robotIntelligence, href: "/database?domain=robotics&layer=intelligence" },
  { name: "Robotics stack", count: stats.roboticsStack, href: "/database?domain=robotics&layer=stack" }
];
---

<BaseLayout title="Open-Source Agent & Robotics Rankings" description="Transparent, reproducible rankings for open-source agents and robotics projects, with live publication gates and auditable inputs." path="/rankings">
  <div class="ranking-shell">
    <header class="ranking-head">
      <div>
        <span class="kicker">Open Momentum / v0.1</span>
        <h1>Rankings, without the popularity theatre.</h1>
        <p>Open Momentum will measure sustained activity and openness inside comparable cohorts. Until the history gate is met, this page shows the live inputs—not a made-up score.</p>
      </div>
      <div class:list={["gate-state", { eligible: gate.eligible }]}>
        <span class="data-label">Publication state</span>
        <strong>{gate.eligible ? "Eligible" : "Collecting"}</strong>
        <span>{gate.eligible ? "Inputs passed" : `${Math.max(0, 30 - historyDays)} days remaining`}</span>
      </div>
    </header>

    {dataError && <div class="data-alert">The registry could not be read during this request. Ranking inputs remain unpublished.</div>}

    <section class="gate-grid">
      <article>
        <div><span class="data-label">History window</span><strong>{historyDays}<small>/30 days</small></strong></div>
        <div class="progress"><i style={`width:${historyProgress}%`}></i></div>
        <p>Daily snapshots must span a full 30-day window.</p>
      </article>
      <article>
        <div><span class="data-label">Entity coverage</span><strong>{coverageProgress}<small>%</small></strong></div>
        <div class="progress"><i style={`width:${coverageProgress}%`}></i></div>
        <p>{stats.metricEntities} of {stats.entities} public records have metric history.</p>
      </article>
      <article>
        <div><span class="data-label">Live sources</span><strong>{stats.liveSources}<small>/{stats.sources}</small></strong></div>
        <div class="progress"><i style={`width:${stats.sources ? Math.round(stats.liveSources / stats.sources * 100) : 0}%`}></i></div>
        <p>Registered sources are activated and audited incrementally.</p>
      </article>
      <article>
        <div><span class="data-label">Observations</span><strong>{compactNumber(stats.observations)}</strong></div>
        <div class="progress"><i style={`width:${stats.observations > 0 ? 100 : 0}%`}></i></div>
        <p>Append-only evidence records currently available to scoring.</p>
      </article>
    </section>

    <section class="cohort-section">
      <div class="section-head">
        <div><span class="eyebrow">Independent cohorts</span><h2>Different things should not share one leaderboard.</h2></div>
        <p>Agents, robot platforms, robot intelligence and robotics infrastructure will each have their own eligible set.</p>
      </div>
      <div class="cohort-grid">
        {cohorts.map((cohort) => <a href={cohort.href}><span>{cohort.name}</span><strong>{cohort.count}</strong><small>Browse cohort →</small></a>)}
      </div>
    </section>

    <section class="preview-section">
      <div class="section-head">
        <div><span class="eyebrow">Input preview · not a ranking</span><h2>Projects currently visible to the collector.</h2></div>
        <p>Ordered by repository stars only to inspect data coverage. This order is not, and will not become, the Open Momentum score.</p>
      </div>
      {candidates.length > 0 ? (
        <div class="preview-table">
          <div class="preview-row header"><span>Project</span><span>Cohort</span><span>License</span><span>Stars</span><span>History</span><span>Activity</span></div>
          {candidates.map((entity) => (
            <a class="preview-row" href={`/project/${entity.slug}`}>
              <span><strong>{entity.name}</strong><small>{entity.organization ?? label(entity.kind)}</small></span>
              <span>{entity.primaryDomain ? label(entity.primaryDomain) : label(entity.kind)}</span>
              <span>{entity.licenseSpdx ?? "Not declared"}</span>
              <span>{compactNumber(entity.stars)}</span>
              <span>{entity.metricHistoryDays ?? 0}/30d</span>
              <span>{relativeDate(entity.lastCommitAt ?? entity.lastReleaseAt ?? entity.lastVerifiedAt)}</span>
            </a>
          ))}
        </div>
      ) : <div class="empty-state">Candidate metrics have not been collected yet.</div>}
    </section>

    <footer class="ranking-footer">
      <div><span class="data-label">Current blockers</span><p>{gate.eligible ? "No publication blockers remain." : gate.reasons.join(" · ")}</p></div>
      <div class="button-row"><a class="button primary" href="/methodology#rankings">Ranking methodology</a><a class="button secondary" href="/changes">View change ledger</a></div>
    </footer>
  </div>
</BaseLayout>

<style>
  .ranking-shell { border-left: 1px solid var(--line); border-right: 1px solid var(--line); margin: 0 auto; max-width: var(--max); }
  .ranking-head { align-items: end; border-bottom: 1px solid var(--ink); display: grid; gap: 42px; grid-template-columns: minmax(0, 1fr) 230px; padding: 32px 44px 30px; }
  .ranking-head h1 { font-family: var(--sans); font-size: clamp(2.4rem, 4.4vw, 4.7rem); font-weight: 500; letter-spacing: -.06em; line-height: .93; margin: 18px 0 15px; max-width: 980px; }
  .ranking-head p { color: var(--muted); font-size: .94rem; line-height: 1.6; margin: 0; max-width: 750px; }
  .gate-state { border-left: 4px solid var(--orange); display: grid; gap: 8px; padding: 5px 0 5px 20px; }
  .gate-state.eligible { border-color: var(--acid); }
  .gate-state strong { font-family: var(--mono); font-size: 1.5rem; text-transform: uppercase; }
  .gate-state > span:last-child { color: var(--muted); font-family: var(--mono); font-size: .62rem; text-transform: uppercase; }
  .data-alert { background: #ffe2d8; border-bottom: 1px solid var(--ink); font-family: var(--mono); font-size: .66rem; padding: 13px 44px; }
  .gate-grid { border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: repeat(4, 1fr); }
  .gate-grid article { border-right: 1px solid var(--line); min-height: 165px; padding: 22px; }
  .gate-grid article:last-child { border: 0; }
  .gate-grid article > div:first-child { align-items: end; display: flex; justify-content: space-between; }
  .gate-grid strong { font-family: var(--mono); font-size: 1.4rem; }
  .gate-grid strong small { color: var(--muted); font-size: .65rem; font-weight: 400; }
  .progress { background: #d8d7ce; height: 7px; margin: 22px 0 17px; overflow: hidden; }
  .progress i { background: var(--acid); border-right: 1px solid var(--ink); display: block; height: 100%; }
  .gate-grid p { color: var(--muted); font-size: .72rem; line-height: 1.5; margin: 0; }
  .cohort-section, .preview-section { border-bottom: 1px solid var(--ink); padding: 32px 44px 36px; }
  .section-head { align-items: end; display: grid; gap: 48px; grid-template-columns: minmax(0, 1fr) 360px; margin-bottom: 28px; }
  .section-head h2 { font-family: var(--sans); font-size: 2.15rem; font-weight: 500; letter-spacing: -.045em; line-height: 1.04; margin: 10px 0 0; }
  .section-head p { color: var(--muted); font-size: .76rem; line-height: 1.55; margin: 0; }
  .cohort-grid { border: 1px solid var(--ink); display: grid; grid-template-columns: repeat(4, 1fr); }
  .cohort-grid a { border-right: 1px solid var(--line); display: grid; min-height: 120px; padding: 16px; }
  .cohort-grid a:last-child { border: 0; }
  .cohort-grid a:hover { background: var(--acid); }
  .cohort-grid span, .cohort-grid small { font-family: var(--mono); font-size: .61rem; text-transform: uppercase; }
  .cohort-grid strong { align-self: end; font-family: var(--mono); font-size: 1.65rem; }
  .cohort-grid small { color: var(--muted); margin-top: 7px; }
  .preview-table { border: 1px solid var(--ink); }
  .preview-row { align-items: center; border-bottom: 1px solid var(--line); display: grid; gap: 14px; grid-template-columns: minmax(220px, 1.6fr) 110px 125px 80px 85px 105px; min-height: 62px; padding: 9px 14px; }
  .preview-row:last-child { border: 0; }
  a.preview-row:hover { background: var(--acid); }
  .preview-row span { font-family: var(--mono); font-size: .64rem; }
  .preview-row strong { display: block; font-family: var(--sans); font-size: .87rem; }
  .preview-row small { color: var(--muted); display: block; font-size: .55rem; margin-top: 3px; }
  .preview-row.header { background: var(--ink); color: var(--paper); font-size: .58rem; min-height: 36px; text-transform: uppercase; }
  .ranking-footer { align-items: center; display: flex; justify-content: space-between; padding: 30px 44px; }
  .ranking-footer p { color: var(--muted); font-family: var(--mono); font-size: .65rem; margin: 8px 0 0; text-transform: uppercase; }
  .ranking-footer .button-row { margin: 0; }
  @media (max-width: 900px) {
    .gate-grid { grid-template-columns: repeat(2, 1fr); }
    .gate-grid article:nth-child(2) { border-right: 0; }
    .gate-grid article:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .cohort-grid { grid-template-columns: repeat(2, 1fr); }
    .cohort-grid a:nth-child(2) { border-right: 0; }
    .cohort-grid a:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .ranking-shell { border: 0; }
    .ranking-head { align-items: start; gap: 24px; grid-template-columns: 1fr; padding: 28px 18px; }
    .ranking-head h1 { font-size: 2.7rem; }
    .gate-state { border-left-width: 3px; }
    .gate-grid article { min-height: 165px; padding: 18px 14px; }
    .cohort-section, .preview-section { padding: 30px 14px; }
    .section-head { align-items: start; gap: 12px; grid-template-columns: 1fr; }
    .section-head h2 { font-size: 1.75rem; }
    .preview-table { border: 0; }
    .preview-row.header { display: none; }
    .preview-row { border: 1px solid var(--line); border-bottom: 0; gap: 8px; grid-template-columns: 1fr auto; padding: 14px; }
    .preview-row span:nth-child(3), .preview-row span:nth-child(6) { display: none; }
    .preview-row span:nth-child(2), .preview-row span:nth-child(4), .preview-row span:nth-child(5) { text-align: right; }
    .ranking-footer { align-items: start; display: grid; gap: 24px; padding: 26px 18px; }
  }
</style>
