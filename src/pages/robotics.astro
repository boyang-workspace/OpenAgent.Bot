---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { catalogPages } from "@/lib/registry/catalog-config";
---
<BaseLayout title="Open Robotics Database" description="Choose between robot intelligence models, physical robot hardware and supporting robotics infrastructure." path="/robotics">
  <div class="robotics-hub"><section><div><span class="kicker">Robotics index</span><h1>Robotics, by system layer</h1><p>Intelligence, physical platforms and supporting infrastructure remain separate records.</p></div><dl><div><dt>Primary rankings</dt><dd>2</dd></div><div><dt>Supporting layer</dt><dd>1</dd></div></dl></section><div><a href={catalogPages["robot-model"].href}><span>01 / Intelligence</span><h2>Robot Models</h2><p>{catalogPages["robot-model"].description}</p><b>Open database →</b></a><a href={catalogPages["robot-hardware"].href}><span>02 / Physical systems</span><h2>Robot Hardware</h2><p>{catalogPages["robot-hardware"].description}</p><b>Open database →</b></a><a href="/database?domain=robotics&layer=stack"><span>03 / Supporting layer</span><h2>Robotics Stack</h2><p>Simulators, SDKs, datasets, runtimes and training infrastructure.</p><b>Explore stack →</b></a></div></div>
</BaseLayout>
<style>
  .robotics-hub { background: var(--paper); margin: 0 auto; max-width: var(--max); }
  .robotics-hub > section { border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: minmax(0,1fr) 360px; min-height: 150px; }
  .robotics-hub > section > div { align-self: center; padding: 24px 28px; }
  .robotics-hub h1 { font-size: var(--data-title); letter-spacing: -.045em; line-height: 1; margin: 11px 0 9px; }
  .robotics-hub > section p, .robotics-hub a p { color: var(--muted); font-size: .84rem; line-height: 1.5; margin-bottom: 0; max-width: 720px; }
  .robotics-hub dl { border-left: 1px solid var(--ink); display: grid; grid-template-columns: repeat(2,1fr); margin: 0; }
  .robotics-hub dl div { border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; padding: 20px; }
  .robotics-hub dl div:last-child { border: 0; }
  .robotics-hub dt { color: var(--muted); font-size: .75rem; text-transform: uppercase; }
  .robotics-hub dd { font-size: 1.25rem; font-weight: 650; margin: 0; }
  .robotics-hub > div { display: grid; grid-template-columns: repeat(3,1fr); }
  .robotics-hub a { border-right: 1px solid var(--line); min-height: 190px; padding: 20px; }
  .robotics-hub a:last-child { border: 0; }
  .robotics-hub a:hover { background: var(--ink); color: var(--paper); }
  .robotics-hub a span, .robotics-hub a b { color: var(--muted); font-size: .75rem; text-transform: uppercase; }
  .robotics-hub a h2 { font-size: 1.35rem; letter-spacing: -.03em; margin: 30px 0 10px; }
  .robotics-hub a b { display: block; margin-top: 20px; }
  @media (max-width:760px) { .robotics-hub > section { grid-template-columns: 1fr; } .robotics-hub > section > div { padding: 24px 18px; } .robotics-hub dl { border-left: 0; border-top: 1px solid var(--ink); min-height: 88px; } .robotics-hub dl div { padding: 13px 18px; } .robotics-hub > div { grid-template-columns: 1fr; } .robotics-hub a { border-bottom: 1px solid var(--line); border-right: 0; min-height: 155px; padding: 18px; } }
</style>
