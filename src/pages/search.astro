---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorialShell from "@/components/EditorialShell.astro";
---

<BaseLayout title="Search" description="Search open AI resources, projects, guides, and editorial notes." path="/search">
  <EditorialShell>
    <section class="search-page">
      <div class="search-head">
        <span class="eyebrow">Search</span>
        <h1>Search open AI resources.</h1>
        <p>Find models, agents, skills, memory systems, plugins, tools, guides, and evaluation notes.</p>
      </div>

      <form class="search-form" action="/search" method="get" role="search">
        <label>
          <span>Search query</span>
          <input id="search-input" type="search" name="q" placeholder="Search open AI resources" autofocus />
        </label>
        <button class="search-btn" type="submit">Search</button>
      </form>

      <div class="search-meta" id="search-meta">Enter a keyword to search the directory.</div>
      <div class="search-results" id="search-results"></div>
    </section>

    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      const query = (params.get("q") || "").trim();
      const input = document.querySelector("#search-input");
      const meta = document.querySelector("#search-meta");
      const results = document.querySelector("#search-results");

      if (input instanceof HTMLInputElement) {
        input.value = query;
      }

      function escapeHtml(value) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }

      function scoreItem(item, terms) {
        const title = item.title.toLowerCase();
        let score = 0;
        for (const term of terms) {
          if (title.includes(term)) score += 4;
          if (item.searchable.includes(term)) score += 1;
        }
        return score;
      }

      async function loadIndex() {
        const response = await fetch("/search-index.json", { credentials: "omit" });
        if (!response.ok) throw new Error(`Failed to load search index: ${response.status}`);
        return response.json();
      }

      async function render() {
        if (!(meta instanceof HTMLElement) || !(results instanceof HTMLElement)) return;
        const terms = query.toLowerCase().split(/\s+/).filter(Boolean);

        if (terms.length === 0) {
          results.innerHTML = "";
          meta.textContent = "Enter a keyword to search the directory.";
          return;
        }

        let items;
        try {
          items = await loadIndex();
        } catch (error) {
          results.innerHTML = "";
          meta.textContent = "Search index unavailable. Try again shortly.";
          return;
        }

        const matches = items
          .map((item) => ({ item, score: scoreItem(item, terms) }))
          .filter((entry) => entry.score > 0)
          .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title))
          .map((entry) => entry.item);

        meta.textContent =
          matches.length === 1 ? `1 result for "${query}".` : `${matches.length} results for "${query}".`;

        if (matches.length === 0) {
          results.innerHTML = `
            <div class="empty-state">
              <strong>No results yet.</strong>
              <p>Try a category like agents, memory, model, plugin, browser, or local AI.</p>
            </div>
          `;
          return;
        }

        results.innerHTML = matches
          .map(
            (item) => `
              <a class="result-card" href="${escapeHtml(item.href)}">
                <div class="result-body">
                  <span class="result-bread">${escapeHtml(item.category)}${item.type ? ` · ${escapeHtml(item.type)}` : ""}</span>
                  <h2 class="result-title">${escapeHtml(item.title)}</h2>
                  <p class="result-summary">${escapeHtml(item.summary)}</p>
                  <div class="result-meta">
                    ${(item.meta || []).slice(0, 4).map((meta) => `<small>${escapeHtml(meta)}</small>`).join("")}
                  </div>
                </div>
                <div class="result-side">
                  <div class="result-signals">
                    ${(item.signals || []).slice(0, 4).map((signal) => `<small>${escapeHtml(signal)}</small>`).join("")}
                  </div>
                  <div class="result-tags">
                    ${(item.tags || []).slice(0, 4).map((tag) => `<small>${escapeHtml(tag)}</small>`).join("")}
                  </div>
                </div>
              </a>
            `
          )
          .join("");
      }

      render();
    </script>
  </EditorialShell>
</BaseLayout>

<style>
  .search-page {
    display: grid;
    gap: 22px;
  }

  .search-head {
    max-width: 780px;
  }

  h1 {
    font-size: 2.8rem;
    font-weight: 520;
    letter-spacing: 0;
    line-height: 1;
    margin: 10px 0 0;
  }

  .search-form {
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: flex;
    gap: 12px;
    padding: 12px;
  }

  label {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
  }

  label span {
    height: 1px;
    left: -999px;
    overflow: hidden;
    position: absolute;
    top: auto;
    width: 1px;
  }

  #search-input {
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    min-height: 42px;
    outline: none;
    padding: 0 14px;
    width: 100%;
  }

  #search-input::placeholder {
    color: var(--subtle);
    font-weight: 400;
  }

  #search-input:focus {
    border-color: var(--line-strong);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 10%, transparent);
  }

  .search-btn {
    background: var(--ink);
    border: none;
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 550;
    min-height: 42px;
    padding: 0 20px;
    transition: opacity 0.15s;
  }

  .search-btn:hover { opacity: 0.85; }

  .search-meta {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .search-results {
    display: grid;
    gap: 12px;
  }

  .result-card,
  .empty-state {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    gap: 12px;
    padding: 16px;
    text-decoration: none;
  }

  .result-card {
    grid-template-columns: minmax(0, 1fr) minmax(200px, 0.38fr);
    transition:
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .result-card:hover {
    background: var(--surface-soft);
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }

  .result-bread {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .result-title {
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 580;
    letter-spacing: 0;
    line-height: 1.15;
    margin: 6px 0 0;
  }

  .result-summary {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 6px 0 0;
  }

  .result-meta,
  .result-signals,
  .result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .result-meta {
    margin-top: 10px;
  }

  .result-side {
    align-content: start;
    display: grid;
    gap: 10px;
    justify-items: end;
  }

  .result-signals,
  .result-tags {
    justify-content: flex-end;
  }

  .result-meta small,
  .result-signals small,
  .result-tags small {
    background: var(--surface-tint);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.72rem;
    padding: 4px 8px;
  }

  .result-signals small {
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 620px) {
    h1 {
      font-size: 2.25rem;
    }

    .search-form {
      align-items: stretch;
      flex-direction: column;
    }

    .result-card {
      grid-template-columns: 1fr;
    }

    .result-side,
    .result-signals,
    .result-tags {
      justify-items: start;
      justify-content: flex-start;
    }
  }
</style>
